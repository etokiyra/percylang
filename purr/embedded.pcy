public fn embedded_runtime_header() -> string {
    string h0 = embedded_runtime_header_chunk_0() + embedded_runtime_header_chunk_1();
    string h1 = embedded_runtime_header_chunk_2() + embedded_runtime_header_chunk_3();
    string h2 = embedded_runtime_header_chunk_4() + embedded_runtime_header_chunk_5();
    string h3 = h0 + h1;
    string h4 = h2 + embedded_runtime_header_chunk_6();
    string h5 = h3 + h4;
    return h5;
}

