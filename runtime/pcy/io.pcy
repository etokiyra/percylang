// write_executable writes data to path with mode 0755, creating or
// truncating the file. It returns 0 on success or a negative errno. The path
// is copied into a NUL-terminated byte array because constructed strings are
// not guaranteed to carry a terminator in every runtime.
public fn write_executable(string path, byte[] data) -> int {
    byte[] terminated = new byte[length(path) + 1];
    int index = 0;
    while (index < length(path)) {
        terminated[index] = byte_from_int(path[index]);
        index++;
    }
    terminated[length(path)] = byte_from_int(0);
    int descriptor = syscall(2, address_of(terminated), 577, 493, 0, 0, 0);
    if (descriptor < 0) {
        return descriptor;
    }
    int total = 0;
    while (total < length(data)) {
        int written = syscall(1, descriptor, address_of(data) + total, length(data) - total, 0, 0, 0);
        if (written <= 0) {
            syscall(3, descriptor, 0, 0, 0, 0, 0);
            if (written < 0) {
                return written;
            }
            return -5;
        }
        total = total + written;
    }
    int closed = syscall(3, descriptor, 0, 0, 0, 0, 0);
    if (closed < 0) {
        return closed;
    }
    return 0;
}

// write_bytes writes data to path with mode 0644, creating or truncating the
// file. It is the non-executable sibling of write_executable.
public fn write_bytes(string path, byte[] data) -> int {
    byte[] terminated = new byte[length(path) + 1];
    int index = 0;
    while (index < length(path)) {
        terminated[index] = byte_from_int(path[index]);
        index++;
    }
    terminated[length(path)] = byte_from_int(0);
    int descriptor = syscall(2, address_of(terminated), 577, 420, 0, 0, 0);
    if (descriptor < 0) {
        return descriptor;
    }
    int total = 0;
    while (total < length(data)) {
        int written = syscall(1, descriptor, address_of(data) + total, length(data) - total, 0, 0, 0);
        if (written <= 0) {
            syscall(3, descriptor, 0, 0, 0, 0, 0);
            if (written < 0) {
                return written;
            }
            return -5;
        }
        total = total + written;
    }
    int closed = syscall(3, descriptor, 0, 0, 0, 0, 0);
    if (closed < 0) {
        return closed;
    }
    return 0;
}
