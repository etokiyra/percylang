    if (failed(lowering)) {
        return -1;
    }
    int[] call_arguments = new int[3];
    call_arguments[0] = destination;
    call_arguments[1] = source;
    call_arguments[2] = count;
    push_instruction(lowering.body, Instruction.CallVoid { function = lowering.strings.copy, arguments = call_arguments, argument_count = 3 });
    return -1;
}

