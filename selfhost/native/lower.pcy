// lower_raw_load_call lowers raw_load8/raw_load64(address).
fn lower_raw_load_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren, int width) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "raw load is supported with exactly one argument");
        return -1;
    }
    int address = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Int);
    if (width == 8) {
        push_instruction(lowering.body, Instruction.RawLoad8 { target = target, address = address, offset = 0 });
    } else {
        push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
    }
    return target;
}

// lower_raw_store_call lowers raw_store8/raw_store64(address, value).
fn lower_raw_store_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren, int width) -> int {
    if (argument_count != 2) {
        fail_at(lowering, open_paren, "raw store is supported with exactly two arguments");
        return -1;
    }
    int address = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int value = lower_expression(lowering, arguments[1]);
    if (failed(lowering)) {
        return -1;
    }
    if (width == 8) {
        push_instruction(lowering.body, Instruction.RawStore8 { address = address, offset = 0, value = value });
    } else {
        push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = value });
    }
    return -1;
}

