// lower.pcy - reduce a checked program into a NativeScene.
//
// This is the native backend's lowering, the step proposals/zero-dependency-
// toolchain.md Section 9 step 2 needs: it walks a checked program's semantic
// model and fills one scene of functions, bindings, instructions, and data
// blobs, which check_scene, the selector, and the ELF writer then consume.
// The lowering covers the slice's scalar, allocation-free subset:
//
//   - functions with int, bool, and string parameters returning int, bool,
//     or void, with string carrying a reference to a static literal object;
//   - int, bool, and string literals and local variables of those types;
//   - the arithmetic operators + - * / %, unary -, and the wrap, wrap
//     remainder, and guard rules the scene already defines for division;
//   - the comparisons == and < (with != > <= >= lowered through them), and
//     the boolean operators ! && ||, with && and || short-circuiting exactly
//     as the C pipeline's generated C does;
//   - assignment =, compound += and -=, and ++ and -- in both positions;
//   - if/else, while, and for statements, and return in both forms;
//   - calls to user functions in this or any loaded module;
//   - arrays of int, bool, float, string, reference, and byte elements:
//     new T[n], a[i], element and compound assignment, length(a), array
//     parameters, and array returns;
//   - struct declarations, literals, member reads, and member assignment,
//     with the header-first aligned layout and nested structs;
//   - enum declarations and case references, flat union construction, and
//     enum/union match with payload bindings;
//   - string indexing (a byte value) and substring;
//   - string-keyed maps: new map[string]V, indexing, insertion, compound
//     int/float updates, has(m, k), and length(m);
//   - the built-ins print and eprint, for one or more string, int, float,
//     bool, or byte arguments, plus exit, length, substring, argv, and the
//     byte/string conversions. Since the Phase 10.6 runtime foundations, the runtime
//     shells live in selfhost/native/runtime.pcy: the lowering registers the
//     bump allocator with `$heap`, `$map`, and `$alloc` into every program
//     and one print helper per argument kind, whose integer rendering goes
//     through the shared digit writer.
//
// Anything outside the subset fails with one deterministic message naming
// the unsupported construct and its position, so a caller never receives a
// partially lowered scene.
//
// Binding order is the walk order: a function's parameters first, then its
// locals and temporaries in the order the lowering creates them. String
// literals pool into data blobs exactly as the C generator pools its
// literals, so equal literals share one blob. The boolean operators and the
// derived comparisons lower into the branch forms the scene already
// carries: `!`, `!=`, `<=`, and `>=` materialize a bool through a branch on
// their flipped condition, and `&&` and `||` evaluate the right operand
// only when the first one did not decide.

import "../lexer/tokens.pcy";
import "../parser/ast.pcy";
import "../parser/parser.pcy";
import "../checker/model.pcy";
import "../checker/state.pcy";
import "ir.pcy";
import "runtime.pcy";
import "floats.pcy";

// LowerResult is the lowering's outcome. Ok carries the whole scene, with
// the entry index already set; Failed carries one message naming the
// unsupported construct at its position, in the language's diagnostic
// spelling `<path>:<line>:<column>: <message>`.
public union LowerResult {
    Ok { NativeScene scene; }
    Failed { string message; }
}

// ScopeFrame is one lexical scope: the local names declared inside it,
// mapped to their binding indices in the enclosing function's table.
struct ScopeFrame {
    map[string]int names;
}

// Lowering is one lowering run's state: the scene being filled, the checked
// module's annotations, the function and literal tables, the runtime shells
// the program needs, and the current function's body, scopes, labels, and
// first failure. The allocator's shells are registered into every run; the
// string, integer, and bool print helpers are registered by the print-kind
// prescan, one per argument kind the program prints, with -1 as "absent".
struct Lowering {
    NativeScene scene;
    SemanticModel model;
    ModuleModel module;
    string path;
    map[string]int functions;
    map[string]int literal_pool;
    AllocShell allocator;
    StringShell strings;
    ArrayShell arrays;
    MapShell maps;
    bool maps_needed;
    int string_print;
    int string_print_raw;
    int int_print;
    int int_print_raw;
    int bool_print;
    int bool_print_raw;
    int float_print;
    int float_print_raw;
    int print_newline;
    int print_space;
    int print_tail;
    bool argv_needed;
    int argv;
    int args_blob;
    bool current_directory_needed;
    int current_directory;
    bool read_file_needed;
    int read_file;
    bool read_file_fatal_needed;
    int read_file_fatal;
    bool write_needed;
    int write_common;
    int write_file;
    int write_bytes;
    bool getenv_needed;
    int getenv;
    int env_blob;
    bool create_directory_needed;
    int create_directory;
    bool remove_needed;
    int remove;
    bool file_info_needed;
    int file_info;
    bool list_directory_needed;
    int list_directory;
    bool temp_directory_needed;
    int temp_directory;
    bool run_needed;
    int run;
    bool capture_needed;
    int capture;
    int valid_temp_prefix;
    int temp_failed;
    int string_join_path;
    int is_dot_entry;
    int string_greater;
    int c_path;
    bool c_path_needed;
    int file_failed;
    int file_ok;
    int errno_reason;

    NativeFunction body;
    int label_next;
    // The innermost loop's break/continue targets, or -1 outside a loop.
    int break_label;
    int continue_label;
    ScopeFrame[] scopes;
    int scope_count;
    int scope_capacity;
    int main_index;
    string failure;
}

// PrintNeeds collects the print argument kinds one prescan found: a walk's
// result OR-merges into the run's needs through the three booleans, which
// the language has no bitwise form for.
struct PrintNeeds {
    bool string_kind;
    bool int_kind;
    bool bool_kind;
    bool float_kind;
}

// merge_print_needs OR-folds two walks' needs.
fn merge_print_needs(PrintNeeds left, PrintNeeds right) -> PrintNeeds {
    return PrintNeeds {
        string_kind = left.string_kind || right.string_kind,
        int_kind = left.int_kind || right.int_kind,
        bool_kind = left.bool_kind || right.bool_kind,
        float_kind = left.float_kind || right.float_kind
    };
}

// print_needs_of_kind is the one-kind needs record a print call's argument
// type denotes.
fn print_needs_of_kind(string kind) -> PrintNeeds {
    return PrintNeeds {
        string_kind = kind == "string",
        int_kind = kind == "int" || kind == "byte",
        bool_kind = kind == "bool",
        float_kind = kind == "float64"
    };
}

// lower_decimal renders a non-negative integer in decimal for messages.
fn lower_decimal(int value) -> string {
    if (value == 0) {
        return "0";
    }
    string result = "";
    while (value > 0) {
        int digit = value % 10;
        result = substring("0123456789", digit, digit + 1) + result;
        value = value / 10;
    }
    return result;
}

// fail records the run's first failure; later failures leave it untouched,
// so the reported message is the first unsupported construct the walk hits.
fn fail(Lowering lowering, string message) {
    if (length(lowering.failure) == 0) {
        lowering.failure = message;
    }
}

// fail_at records a failure at a source position, with the module path for
// the exact spelling a diagnostic elsewhere in the toolchain uses.
fn fail_at(Lowering lowering, Position at, string message) {
    fail(lowering, lowering.path + ":" + lower_decimal(at.line) + ":" + lower_decimal(at.column) + ": " + message);
}

// failed reports whether the run has already failed.
fn failed(Lowering lowering) -> bool {
    return length(lowering.failure) != 0;
}

// new_lowering opens one lowering run for a successfully checked model.
fn new_lowering(SemanticModel model) -> Lowering {
    ModuleModel module = module_model(model, 0);
    return Lowering {
        scene = new_scene(),
        model = model,
        module = module,
        path = module.path,
        functions = new map[string]int,
        literal_pool = new map[string]int,
        allocator = AllocShell { alloc = 0, map_shell = 0, collect = 0, mark_at = 0, scan_heap = 0, ledger_at = 0, heap_blob = 0 },
        strings = StringShell { length = 0, equal = 0, concat = 0, copy = 0 },
        arrays = ArrayShell { new_array = 0, at = 0, length = 0, push = 0, zero_bytes = 0, string_to_bytes = 0, bytes_to_string = 0, string_at = 0, substring = 0, fail_shift = 0, fail_blob = 0, write_blob_fd = 0, write_int_fd = 0, eprint_space = 0, eprint_newline = 0, eprint_true = 0, eprint_false = 0 },
        maps = MapShell { new_map = 0, at = 0, set = 0, has = 0, length = 0, fail_blob = 0 },
        maps_needed = false,
        string_print = -1,
        string_print_raw = -1,
        int_print = -1,
        int_print_raw = -1,
        bool_print = -1,
        bool_print_raw = -1,
        float_print = -1,
        float_print_raw = -1,
        print_newline = -1,
        print_space = -1,
        print_tail = -1,
        argv_needed = false,
        argv = -1,
        args_blob = -1,
        current_directory_needed = false,
        current_directory = -1,
        read_file_needed = false,
        read_file = -1,
        read_file_fatal_needed = false,
        read_file_fatal = -1,
        write_needed = false,
        write_common = -1,
        write_file = -1,
        write_bytes = -1,
        getenv_needed = false,
        getenv = -1,
        env_blob = -1,
        create_directory_needed = false,
        create_directory = -1,
        remove_needed = false,
        remove = -1,
        file_info_needed = false,
        file_info = -1,
        list_directory_needed = false,
        list_directory = -1,
        temp_directory_needed = false,
        temp_directory = -1,
        run_needed = false,
        run = -1,
        capture_needed = false,
        capture = -1,
        valid_temp_prefix = -1,
        temp_failed = -1,
        string_join_path = -1,
        is_dot_entry = -1,
        string_greater = -1,
        c_path = -1,
        c_path_needed = false,
        file_failed = -1,
        file_ok = -1,
        errno_reason = -1,
        body = new_function("", NativeType.Void),
        label_next = 0,
        break_label = -1,
        continue_label = -1,
        scopes = new ScopeFrame[4],
        scope_count = 0,
        scope_capacity = 4,
        main_index = -1,
        failure = ""
    };
}

// --- Scopes -------------------------------------------------------------------

// grow_scopes doubles the scope stack.
fn grow_scopes(Lowering lowering) {
    int capacity = lowering.scope_capacity * 2;
    ScopeFrame[] grown = new ScopeFrame[capacity];
    int index = 0;
    while (index < lowering.scope_count) {
        grown[index] = lowering.scopes[index];
        index++;
    }
    lowering.scopes = grown;
    lowering.scope_capacity = capacity;
}

// push_scope opens one lexical scope.
fn push_scope(Lowering lowering) {
    if (lowering.scope_count == lowering.scope_capacity) {
        grow_scopes(lowering);
    }
    lowering.scopes[lowering.scope_count] = ScopeFrame { names = new map[string]int };
    lowering.scope_count++;
}

// pop_scope closes the innermost scope.
fn pop_scope(Lowering lowering) {
    lowering.scope_count--;
}

// declare binds one name in the innermost scope to a binding index.
fn declare(Lowering lowering, string name, int binding) {
    lowering.scopes[lowering.scope_count - 1].names[name] = binding;
}

// lookup walks the scope stack outward and returns the binding one name
// denotes, or -1 when no scope holds it. The checker resolved every name
// before the lowering ran, so the miss case is unreachable for a checked
// program; it stays reported so a lowering bug cannot pass silently.
fn lookup(Lowering lowering, string name, Position at) -> int {
    int index = lowering.scope_count - 1;
    while (index >= 0) {
        if (has(lowering.scopes[index].names, name)) {
            return lowering.scopes[index].names[name];
        }
        index--;
    }
    fail_at(lowering, at, "identifier " + quoted(name) + " is not in scope");
    return -1;
}

// --- Values -------------------------------------------------------------------

// value_shape maps a checked type onto the scene's shapes. Int, bool,
// float, and string lower; string is a reference to a static literal
// object. Every other kind fails with its unsupported-construct message.
fn value_shape(Lowering lowering, Type type, Position at) -> NativeType {
    match (type.kind) {
        Int { return NativeType.Int; }
        Bool { return NativeType.Bool; }
        String { return NativeType.Ref; }
        Float { return NativeType.Float; }
        Byte { return NativeType.Int; }
        Struct { return NativeType.Ref; }
        Array { return NativeType.Ref; }
        Enum { return NativeType.Int; }
        Union { return NativeType.Ref; }
        Map { return NativeType.Ref; }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return NativeType.Void; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return NativeType.Void; }
    }
}

// type_ref_shape resolves one declared type reference to a scene shape.
// Declarations already resolved their references, so the absent case is
// unreachable; it stays reported.
fn type_ref_shape(Lowering lowering, TypeRef reference) -> NativeType {
    OptionalResolvedType resolved = type_ref_type(lowering.module, type_ref_node_id(reference));
    match (resolved) {
        Present(type) {
            return value_shape(lowering, type, type_position(reference));
        }
        Absent {
            fail_at(lowering, type_position(reference), "a type reference is not resolved");
            return NativeType.Void;
        }
    }
}

// expr_type returns an expression's resolved type, or the absent type when
// the checker did not annotate the node. A call's callee is exactly such a
// node: it resolves to a function, not to a value.
fn expr_type(Lowering lowering, Expr expression) -> Type {
    ExprInfo info = expression_info(lowering.module, expr_node_id(expression));
    match (info.type) {
        Present(type) { return type; }
        Absent { return none_type(); }
    }
}

// literal_blob returns the blob index an encoded string literal denotes,
// pooling equal literals into one blob exactly as the C generator pools its
// literals.
fn literal_blob(Lowering lowering, string bytes) -> int {
    if (!has(lowering.literal_pool, bytes)) {
        lowering.literal_pool[bytes] = add_blob(lowering.scene, bytes);
    }
    return lowering.literal_pool[bytes];
}

// parse_int_literal reads an integer literal's bit pattern. The checker
// bounded decimal literals to int64 and already accepted the base prefixes,
// so the walk only needs the 64-bit wrap the machine arithmetic gives it.
fn parse_int_literal(string text) -> int {
    int size = length(text);
    int base = 10;
    int start = 0;
    if (size > 2 && text[0] == 48 && text[1] == 120) {
        base = 16;
        start = 2;
    } else if (size > 2 && text[0] == 48 && text[1] == 98) {
        base = 2;
        start = 2;
    }
    int value = 0;
    int index = start;
    while (index < size) {
        int character = text[index];
        int digit = -1;
        if (character >= 48 && character <= 57) {
            digit = character - 48;
        } else if (character >= 97 && character <= 102) {
            digit = character - 87;
        } else if (character >= 65 && character <= 70) {
            digit = character - 55;
        }
        if (digit >= 0 && digit < base) {
            value = value * base + digit;
        }
        index++;
    }
    return value;
}

// new_label allocates the next label index of the current function.
fn new_label(Lowering lowering) -> int {
    int label = lowering.label_next;
    lowering.label_next++;
    return label;
}

// define_label appends one Label instruction, which defines the index.
fn define_label(Lowering lowering, int label) {
    push_instruction(lowering.body, Instruction.Label { label = label });
}

// negate_binding materializes the boolean negation of one condition through
// the branch forms the scene carries: the condition's true label stores a
// false constant and its false label stores a true one, so the binding
// holds the flipped value after the pattern merges.
fn negate_binding(Lowering lowering, int condition) -> int {
    int target = new_temporary(lowering.body, NativeType.Bool);
    int when_true = new_label(lowering);
    int when_false = new_label(lowering);
    int merge = new_label(lowering);
    push_instruction(lowering.body, Instruction.Branch { condition = condition, label_true = when_true, label_false = when_false });
    define_label(lowering, when_false);
    push_instruction(lowering.body, Instruction.ConstBool { target = target, value = true });
    push_instruction(lowering.body, Instruction.Jump { label = merge });
    define_label(lowering, when_true);
    push_instruction(lowering.body, Instruction.ConstBool { target = target, value = false });
    define_label(lowering, merge);
    return target;
}

// shortcircuit_materialize lowers one side-effecting boolean operator: the
// first operand is evaluated once and decides whether the second operand is
// evaluated at all; the result is the second operand's value when the first
// did not decide, and the constant the first decided otherwise.
// evaluate_left_true reports whether a true first operand leaves the
// decision to the second operand, which is `&&`; for `||` a false first
// operand does.
fn shortcircuit_materialize(Lowering lowering, Expr left, Expr right, bool evaluate_left_true) -> int {
    int first = lower_expression(lowering, left);
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Bool);
    int evaluate = new_label(lowering);
    int decided = new_label(lowering);
    int merge = new_label(lowering);
    if (evaluate_left_true) {
        push_instruction(lowering.body, Instruction.Branch { condition = first, label_true = evaluate, label_false = decided });
    } else {
        push_instruction(lowering.body, Instruction.Branch { condition = first, label_true = decided, label_false = evaluate });
    }
    define_label(lowering, decided);
    push_instruction(lowering.body, Instruction.ConstBool { target = target, value = !evaluate_left_true });
    push_instruction(lowering.body, Instruction.Jump { label = merge });
    define_label(lowering, evaluate);
    int second = lower_expression(lowering, right);
    if (failed(lowering)) {
        return -1;
    }
    push_instruction(lowering.body, Instruction.Copy { target = target, source = second });
    define_label(lowering, merge);
    return target;
}

// --- Expressions ----------------------------------------------------------------

// lower_expression lowers one expression into a binding that holds its
// value, creating temporaries in walk order, and returns the binding's
// index, or -1 once the run has failed.
fn lower_expression(Lowering lowering, Expr expression) -> int {
    match (expression) {
        Integer(node_id, token) {
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = target, value = parse_int_literal(token.text) });
            return target;
        }
        Boolean(node_id, token, value) {
            int target = new_temporary(lowering.body, NativeType.Bool);
            push_instruction(lowering.body, Instruction.ConstBool { target = target, value = value });
            return target;
        }
        String(node_id, token) {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.ConstRefData { target = target, blob = literal_blob(lowering, decode_string(token.text)) });
            return target;
        }
        Identifier(node_id, token) {
            return lookup(lowering, token.text, position_of_token(token));
        }
        Float(node_id, token) {
            match (encode_float(token.text)) {
                Ok(bits) {
                    int target = new_temporary(lowering.body, NativeType.Float);
                    push_instruction(lowering.body, Instruction.ConstFloat { target = target, bits = bits });
                    return target;
                }
                Failed(message) {
                    fail_at(lowering, position_of_token(token), message);
                    return -1;
                }
            }
        }
        Unary(node_id, operator, operand, postfix) {
            return lower_unary(lowering, operator, operand, postfix);
        }
        Binary(node_id, operator, left, right) {
            return lower_binary(lowering, operator, left, right);
        }
        Assign(node_id, operator, target, value) {
            return lower_assign(lowering, operator, target, value);
        }
        Call(node_id, open_paren, callee, arguments, argument_count) {
            return lower_call(lowering, callee, arguments, argument_count, position_of_token(open_paren));
        }
        Member(node_id, dot, receiver, member) {
            return lower_member_read(lowering, expression, receiver, member, position_of_token(dot));
        }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) {
            return lower_struct_literal(lowering, type_ref, fields, field_count, type_position(type_ref));
        }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) {
            return lower_variant_literal(lowering, type_ref, variant, fields, field_count, position_of_token(variant));
        }
        NewArray(node_id, at, element, length) {
            return lower_array_creation(lowering, element, length, position_of_token(at));
        }
        NewMap(node_id, at, map_type) {
            return lower_map_creation(lowering, map_type, position_of_token(at));
        }
        Index(node_id, bracket, target, index) {
            return lower_index_read(lowering, expression, target, index, position_of_token(bracket));
        }
    }
}

// lower_unary lowers one unary expression. `!` materializes through the
// flipped-branch pattern; `-` negates; `++` and `--` read and update their
// target variable, with a postfix position yielding the previous value and
// a prefix one the new value; every bitwise form fails.
fn lower_unary(Lowering lowering, Token operator, Expr operand, bool postfix) -> int {
    if (operator.text == "++" || operator.text == "--") {
        return lower_increment(lowering, operator, operand, postfix);
    }
    if (operator.text == "-") {
        int value = lower_expression(lowering, operand);
        if (failed(lowering)) {
            return -1;
        }
        if (type_name(lowering.body.binding_types[value]) == type_name(NativeType.Float)) {
            int float_target = new_temporary(lowering.body, NativeType.Float);
            push_instruction(lowering.body, Instruction.NegateFloat { target = float_target, value = value });
            return float_target;
        }
        int target = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.Negate { target = target, value = value });
        return target;
    }
    if (operator.text == "!") {
        int condition = lower_expression(lowering, operand);
        if (failed(lowering)) {
            return -1;
        }
        return negate_binding(lowering, condition);
    }
    if (operator.text == "~") {
        int value = lower_expression(lowering, operand);
        if (failed(lowering)) {
            return -1;
        }
        if (!int_operand(lowering, value, position_of_token(operator))) {
            return -1;
        }
        int target = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.BitNot { target = target, value = value });
        return target;
    }
    fail_at(lowering, position_of_token(operator), "unknown unary operator");
    return -1;
}

// increment_target steps one int or float value, stores it either into a
// variable binding (address < 0) or back through the value address, and
// returns the updated value or, for a postfix form, the previous value.
fn increment_target(Lowering lowering, int target, int address, Type value_type, string op, bool postfix, Position at) -> int {
    NativeType shape = lowering.body.binding_types[target];
    bool integer = type_name(shape) == type_name(NativeType.Int);
    bool floating = type_name(shape) == type_name(NativeType.Float);
    if (!integer && !floating) {
        fail_at(lowering, at, "++ and -- are supported on int and float values only");
        return -1;
    }
    NativeType step_shape = NativeType.Int;
    if (floating) {
        step_shape = NativeType.Float;
    }
    int value = new_temporary(lowering.body, step_shape);
    if (floating) {
        push_instruction(lowering.body, Instruction.ConstFloat { target = value, bits = 4607182418800017408 });
    } else {
        push_instruction(lowering.body, Instruction.ConstInt { target = value, value = 1 });
    }
    int updated = new_temporary(lowering.body, step_shape);
    if (op == "++") {
        if (floating) {
            push_instruction(lowering.body, Instruction.AddFloat { target = updated, left = target, right = value });
        } else {
            push_instruction(lowering.body, Instruction.Add { target = updated, left = target, right = value });
        }
    } else {
        if (floating) {
            push_instruction(lowering.body, Instruction.SubtractFloat { target = updated, left = target, right = value });
        } else {
            push_instruction(lowering.body, Instruction.Subtract { target = updated, left = target, right = value });
        }
    }
    int previous = -1;
    if (postfix) {
        previous = new_temporary(lowering.body, step_shape);
        push_instruction(lowering.body, Instruction.Copy { target = previous, source = target });
    }
    if (address >= 0) {
        store_value_at(lowering, value_type, address, updated, at);
    } else {
        push_instruction(lowering.body, Instruction.Copy { target = target, source = updated });
    }
    if (postfix) {
        return previous;
    }
    return updated;
}

// lower_increment lowers prefix or postfix ++ and -- on a local, a struct
// field, or an array element. The l-value address is evaluated once.
fn lower_increment(Lowering lowering, Token operator, Expr operand, bool postfix) -> int {
    Position at = position_of_token(operator);
    match (operand) {
        Identifier(node_id, token) {
            int target = lookup(lowering, token.text, position_of_token(token));
            if (failed(lowering)) {
                return -1;
            }
            return increment_target(lowering, target, -1, none_type(), operator.text, postfix, at);
        }
        Member(node_id, dot, receiver, member) {
            int address = lower_member_address(lowering, receiver, member, position_of_token(dot));
            if (failed(lowering)) {
                return -1;
            }
            Type field_type = expr_type(lowering, operand);
            int current = load_value_at(lowering, field_type, address, at);
            if (failed(lowering)) {
                return -1;
            }
            return increment_target(lowering, current, address, field_type, operator.text, postfix, at);
        }
        Index(node_id, bracket, collection, index) {
            Type container = expr_type(lowering, collection);
            match (container.kind) {
                Array {
                    int address = lower_array_address(lowering, collection, index, position_of_token(bracket));
                    if (failed(lowering)) {
                        return -1;
                    }
                    Type element = expr_type(lowering, operand);
                    int current = load_value_at(lowering, element, address, at);
                    if (failed(lowering)) {
                        return -1;
                    }
                    return increment_target(lowering, current, address, element, operator.text, postfix, at);
                }
                Map {
                    int table = lower_expression(lowering, collection);
                    if (failed(lowering)) {
                        return -1;
                    }
                    int key = lower_expression(lowering, index);
                    if (failed(lowering)) {
                        return -1;
                    }
                    int address = new_temporary(lowering.body, NativeType.Int);
                    int[] lookup_arguments = new int[2];
                    lookup_arguments[0] = table;
                    lookup_arguments[1] = key;
                    push_instruction(lowering.body, Instruction.Call { target = address, function = lowering.maps.at, arguments = lookup_arguments, argument_count = 2 });
                    Type value_type = expr_type(lowering, operand);
                    int current = load_value_at(lowering, value_type, address, at);
                    if (failed(lowering)) {
                        return -1;
                    }
                    return increment_target(lowering, current, address, value_type, operator.text, postfix, at);
                }
                Int { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Bool { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Float { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Byte { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                String { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Struct { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Enum { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                Union { fail_at(lowering, at, "++ and -- are supported on array elements only"); return -1; }
                None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
                Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
            }
        }
        Integer(node_id, token) { }
        Float(node_id, token) { }
        String(node_id, token) { }
        Boolean(node_id, token, value) { }
        Unary(node_id, inner_operator, inner_operand, inner_postfix) { }
        Binary(node_id, inner_operator, left, right) { }
        Assign(node_id, inner_operator, target, value) { }
        Call(node_id, open_paren, callee, arguments, argument_count) { }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { }
        NewArray(node_id, at, element, length) { }
        NewMap(node_id, at, map_type) { }
    }
    fail_at(lowering, at, "++ and -- are supported on local variables, struct fields, and array elements");
    return -1;
}

// lower_binary lowers one binary expression. Short-circuit boolean forms
// lower before any operand evaluation so their decision controls the right
// operand; every other form evaluates left, then right, then folds. The
// derived comparisons and boolean operators materialize through the branch
// patterns the scene already carries.
fn lower_binary(Lowering lowering, Token operator, Expr left, Expr right) -> int {
    string op = operator.text;
    Position at = position_of_token(operator);

    if (op == "&&") {
        return shortcircuit_materialize(lowering, left, right, true);
    }
    if (op == "||") {
        return shortcircuit_materialize(lowering, left, right, false);
    }

    int left_value = lower_expression(lowering, left);
    if (failed(lowering)) {
        return -1;
    }
    int right_value = lower_expression(lowering, right);
    if (failed(lowering)) {
        return -1;
    }

    if (op == "==" || op == "!=") {
        if (expr_type(lowering, left).kind == TypeKind.Bool) {
            int equal = new_temporary(lowering.body, NativeType.Bool);
            int left_true = new_label(lowering);
            int left_false = new_label(lowering);
            int true_label = new_label(lowering);
            int false_label = new_label(lowering);
            int done = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = left_value, label_true = left_true, label_false = left_false });
            define_label(lowering, left_true);
            push_instruction(lowering.body, Instruction.Branch { condition = right_value, label_true = true_label, label_false = false_label });
            define_label(lowering, left_false);
            push_instruction(lowering.body, Instruction.Branch { condition = right_value, label_true = false_label, label_false = true_label });
            define_label(lowering, true_label);
            push_instruction(lowering.body, Instruction.ConstBool { target = equal, value = true });
            push_instruction(lowering.body, Instruction.Jump { label = done });
            define_label(lowering, false_label);
            push_instruction(lowering.body, Instruction.ConstBool { target = equal, value = false });
            define_label(lowering, done);
            if (op == "!=") {
                return negate_binding(lowering, equal);
            }
            return equal;
        }
    }
    bool floating = type_name(lowering.body.binding_types[left_value]) == type_name(NativeType.Float);
    // String values concatenate and compare by content through the string
    // runtime: "$string_concat" is the one user-reachable allocation, and
    // "$string_equal" walks both payloads byte for byte. `!=` negates the
    // comparison like the derived comparisons do.
    if (op == "+" && type_name(lowering.body.binding_types[left_value]) == type_name(NativeType.Ref)) {
        int target = new_temporary(lowering.body, NativeType.Ref);
        int[] arguments = new int[2];
        arguments[0] = left_value;
        arguments[1] = right_value;
        push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.strings.concat, arguments = arguments, argument_count = 2 });
        return target;
    }
    if (op == "==" || op == "!=") {
        if (type_name(lowering.body.binding_types[left_value]) == type_name(NativeType.Ref)) {
            int equal_value = new_temporary(lowering.body, NativeType.Bool);
            int[] equal_arguments = new int[2];
            equal_arguments[0] = left_value;
            equal_arguments[1] = right_value;
            push_instruction(lowering.body, Instruction.Call { target = equal_value, function = lowering.strings.equal, arguments = equal_arguments, argument_count = 2 });
            if (op == "!=") {
                return negate_binding(lowering, equal_value);
            }
            return equal_value;
        }
    }

    if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%" ||
        op == "<" || op == ">" || op == "<=" || op == ">=") {
        if (floating) {
            if (!float_operand(lowering, left_value, at) || !float_operand(lowering, right_value, at)) {
                return -1;
            }
        } else {
            if (!int_operand(lowering, left_value, at) || !int_operand(lowering, right_value, at)) {
                return -1;
            }
        }
    }

    if (op == "+") {
        int target = new_temporary(lowering.body, shape_of_float(floating));
        if (floating) {
            push_instruction(lowering.body, Instruction.AddFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.Add { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == "-") {
        int target = new_temporary(lowering.body, shape_of_float(floating));
        if (floating) {
            push_instruction(lowering.body, Instruction.SubtractFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.Subtract { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == "*") {
        int target = new_temporary(lowering.body, shape_of_float(floating));
        if (floating) {
            push_instruction(lowering.body, Instruction.MultiplyFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.Multiply { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == "/") {
        int target = new_temporary(lowering.body, shape_of_float(floating));
        if (floating) {
            // IEEE division: a zero divisor yields infinity, and zero over
            // zero NaN, exactly as the C compiler's text passes it through.
            push_instruction(lowering.body, Instruction.DivideFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.WholeDivide { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == "%") {
        int target = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.WholeRemainder { target = target, left = left_value, right = right_value });
        return target;
    }
    if (op == "==" || op == "!=") {
        int target = new_temporary(lowering.body, NativeType.Bool);
        if (floating) {
            push_instruction(lowering.body, Instruction.EqualFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.Equal { target = target, left = left_value, right = right_value });
        }
        if (op == "!=") {
            return negate_binding(lowering, target);
        }
        return target;
    }
    if (op == "<") {
        // a < b through the ordered greater form on the swapped operands.
        int target = new_temporary(lowering.body, NativeType.Bool);
        if (floating) {
            push_instruction(lowering.body, Instruction.GreaterFloat { target = target, left = right_value, right = left_value });
        } else {
            push_instruction(lowering.body, Instruction.LessThan { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == ">") {
        int target = new_temporary(lowering.body, NativeType.Bool);
        if (floating) {
            push_instruction(lowering.body, Instruction.GreaterFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.LessThan { target = target, left = right_value, right = left_value });
        }
        return target;
    }
    if (op == "<=") {
        int target = new_temporary(lowering.body, NativeType.Bool);
        if (floating) {
            push_instruction(lowering.body, Instruction.LessOrEqualFloat { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.LessThan { target = target, left = right_value, right = left_value });
            return negate_binding(lowering, target);
        }
        return target;
    }
    if (op == ">=") {
        int target = new_temporary(lowering.body, NativeType.Bool);
        if (floating) {
            push_instruction(lowering.body, Instruction.LessOrEqualFloat { target = target, left = right_value, right = left_value });
        } else {
            push_instruction(lowering.body, Instruction.LessThan { target = target, left = left_value, right = right_value });
            return negate_binding(lowering, target);
        }
        return target;
    }
    if (op == "&" || op == "|" || op == "^") {
        if (!int_operand(lowering, left_value, at) || !int_operand(lowering, right_value, at)) {
            return -1;
        }
        int target = new_temporary(lowering.body, NativeType.Int);
        if (op == "&") {
            push_instruction(lowering.body, Instruction.BitAnd { target = target, left = left_value, right = right_value });
        } else if (op == "|") {
            push_instruction(lowering.body, Instruction.BitOr { target = target, left = left_value, right = right_value });
        } else {
            push_instruction(lowering.body, Instruction.BitXor { target = target, left = left_value, right = right_value });
        }
        return target;
    }
    if (op == "<<" || op == ">>") {
        if (!int_operand(lowering, left_value, at) || !int_operand(lowering, right_value, at)) {
            return -1;
        }
        int zero = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
        int sixty_three = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.ConstInt { target = sixty_three, value = 63 });
        int negative = new_temporary(lowering.body, NativeType.Bool);
        push_instruction(lowering.body, Instruction.LessThan { target = negative, left = right_value, right = zero });
        int too_high = new_temporary(lowering.body, NativeType.Bool);
        push_instruction(lowering.body, Instruction.LessThan { target = too_high, left = sixty_three, right = right_value });
        int fail_label = new_label(lowering);
        int high_label = new_label(lowering);
        int shift_label = new_label(lowering);
        int merge_label = new_label(lowering);
        int target = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.Branch { condition = negative, label_true = fail_label, label_false = high_label });
        define_label(lowering, high_label);
        push_instruction(lowering.body, Instruction.Branch { condition = too_high, label_true = fail_label, label_false = shift_label });
        define_label(lowering, fail_label);
        int[] fail_arguments = new int[1];
        fail_arguments[0] = right_value;
        push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.fail_shift, arguments = fail_arguments, argument_count = 1 });
        push_instruction(lowering.body, Instruction.Jump { label = merge_label });
        define_label(lowering, shift_label);
        if (op == "<<") {
            push_instruction(lowering.body, Instruction.ShiftLeft { target = target, left = left_value, count = right_value });
        } else {
            push_instruction(lowering.body, Instruction.ShiftRight { target = target, left = left_value, count = right_value });
        }
        push_instruction(lowering.body, Instruction.Jump { label = merge_label });
        define_label(lowering, merge_label);
        return target;
    }
    fail_at(lowering, at, "unknown binary operator");
    return -1;
}
fn int_operand(Lowering lowering, int binding, Position at) -> bool {
    if (type_name(lowering.body.binding_types[binding]) != type_name(NativeType.Int)) {
        fail_at(lowering, at, "arithmetic and comparisons are supported on int values only");
        return false;
    }
    return true;
}

// float_operand is the float sibling of int_operand: a guard against a
// checker guarantee the lowering relies on, since arithmetic and
// comparisons share one operand type.
fn float_operand(Lowering lowering, int binding, Position at) -> bool {
    if (type_name(lowering.body.binding_types[binding]) != type_name(NativeType.Float)) {
        fail_at(lowering, at, "arithmetic and comparisons are supported on float values only");
        return false;
    }
    return true;
}

// shape_of_float picks the float shape when the operator folds floats.
fn shape_of_float(bool floating) -> NativeType {
    if (floating) {
        return NativeType.Float;
    }
    return NativeType.Int;
}

// --- Arrays -------------------------------------------------------------------

// array_element_size returns one element's byte size for the array runtime.
// Int, float, string, array, enum, struct, union, and map elements are eight
// bytes; bool and byte are one. Composites are references; an enum is its
// eight-byte tag.
fn array_element_size(Lowering lowering, Type element, Position at) -> int {
    match (element.kind) {
        Int { return 8; }
        Float { return 8; }
        Bool { return 1; }
        Byte { return 1; }
        String { return 8; }
        Array { return 8; }
        Struct { return 8; }
        Enum { return 8; }
        Union { return 8; }
        Map { return 8; }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return 0; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return 0; }
    }
}

// --- Structs ------------------------------------------------------------------

// FieldPlacement is one resolved struct field's byte offset and type.
struct FieldPlacement {
    bool found;
    int offset;
    Type type;
}

// align_up rounds a byte offset up to the next multiple of alignment.
fn align_up(int value, int alignment) -> int {
    if (alignment <= 1) {
        return value;
    }
    int remainder = value % alignment;
    if (remainder == 0) {
        return value;
    }
    return value + (alignment - remainder);
}

// value_size returns a field's byte size: one for bool and byte, eight for
// every other scalar and for every reference or tag.
fn value_size(Type type) -> int {
    match (type.kind) {
        Bool { return 1; }
        Byte { return 1; }
        Int { return 8; }
        Float { return 8; }
        String { return 8; }
        Array { return 8; }
        Struct { return 8; }
        Enum { return 8; }
        Union { return 8; }
        Map { return 8; }
        None { return 0; }
        Void { return 0; }
    }
}

// value_alignment returns a field's alignment: one for bool and byte, eight
// for every other scalar and for every reference or tag.
fn value_alignment(Type type) -> int {
    match (type.kind) {
        Bool { return 1; }
        Byte { return 1; }
        Int { return 8; }
        Float { return 8; }
        String { return 8; }
        Array { return 8; }
        Struct { return 8; }
        Enum { return 8; }
        Union { return 8; }
        Map { return 8; }
        None { return 1; }
        Void { return 1; }
    }
}

// struct_size returns the whole object size: the eight-byte header followed by
// fields in declaration order at their aligned offsets, rounded to eight.
fn struct_size(Type type) -> int {
    match (type.struct_info) {
        Present(info) {
            int offset = 8;
            int index = 0;
            while (index < info.field_count) {
                StructField field = info.fields[index];
                offset = align_up(offset, value_alignment(field.type));
                offset = offset + value_size(field.type);
                index++;
            }
            return align_up(offset, 8);
        }
        Absent { return 0; }
    }
}

// field_placement finds one field's aligned offset and type, or leaves the
// found flag false when the field is absent.
fn field_placement(Type type, string name) -> FieldPlacement {
    match (type.struct_info) {
        Present(info) {
            int offset = 8;
            int index = 0;
            while (index < info.field_count) {
                StructField field = info.fields[index];
                offset = align_up(offset, value_alignment(field.type));
                if (field.name == name) {
                    return FieldPlacement { found = true, offset = offset, type = field.type };
                }
                offset = offset + value_size(field.type);
                index++;
            }
        }
        Absent { }
    }
    return FieldPlacement { found = false, offset = 0, type = none_type() };
}

// union_size returns the flat union object size: the header, the eight-byte
// tag, then every variant's fields in declaration order, rounded to eight.
fn union_size(Type type) -> int {
    int offset = 16;
    int variant_index = 0;
    while (variant_index < type.variant_count) {
        Variant variant = type.variants[variant_index];
        int field_index = 0;
        while (field_index < variant.field_count) {
            StructField field = variant.fields[field_index];
            offset = align_up(offset, value_alignment(field.type));
            offset = offset + value_size(field.type);
            field_index++;
        }
        variant_index++;
    }
    return align_up(offset, 8);
}

// union_field_offset returns one variant field's flat offset, or -1 when the
// variant or field is absent.
fn union_field_offset(Type type, string variant_name, string field_name) -> int {
    int offset = 16;
    int variant_index = 0;
    while (variant_index < type.variant_count) {
        Variant variant = type.variants[variant_index];
        int field_index = 0;
        while (field_index < variant.field_count) {
            StructField field = variant.fields[field_index];
            offset = align_up(offset, value_alignment(field.type));
            if (variant.name == variant_name && field.name == field_name) {
                return offset;
            }
            offset = offset + value_size(field.type);
            field_index++;
        }
        variant_index++;
    }
    return -1;
}

// lower_union_literal allocates one union object, writes its tag, and stores
// the variant's fields at their flat offsets. The tag is written first, as the
// C generator's constructor does.
fn lower_union_literal(Lowering lowering, Type union_type, Token variant_token, FieldInit[] fields, int field_count, Position at) -> int {
    if (!has(union_type.variant_index, variant_token.text)) {
        fail_at(lowering, at, "union " + quoted(union_type.name) + " has no variant " + quoted(variant_token.text));
        return -1;
    }
    Variant variant = union_type.variant_index[variant_token.text];
    int total = union_size(union_type);
    int request = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = request, value = total - 8 });
    int[] alloc_arguments = new int[1];
    alloc_arguments[0] = request;
    int raw = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.Call { target = raw, function = lowering.allocator.alloc, arguments = alloc_arguments, argument_count = 1 });
    int object = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.Copy { target = object, source = raw });
    int tag = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = tag, value = variant.index });
    push_instruction(lowering.body, Instruction.RawStore64 { address = object, offset = 8, value = tag });

    int index = 0;
    while (index < field_count) {
        FieldInit init = fields[index];
        int offset_value = union_field_offset(union_type, variant.name, init.name.text);
        if (offset_value < 0 || !has(variant.field_index, init.name.text)) {
            fail_at(lowering, position_of_token(init.name), "union " + quoted(union_type.name) + " variant " + quoted(variant.name) + " has no field " + quoted(init.name.text));
            return -1;
        }
        StructField field = variant.field_index[init.name.text];
        int value = lower_expression(lowering, init.value);
        if (failed(lowering)) {
            return -1;
        }
        int offset = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.ConstInt { target = offset, value = offset_value });
        int address = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.Add { target = address, left = object, right = offset });
        store_value_at(lowering, field.type, address, value, position_of_token(init.name));
        index++;
    }
    return object;
}

// lower_union_reference constructs a payload-less union variant.
fn lower_union_reference(Lowering lowering, Type union_type, Variant variant, Position at) -> int {
    if (variant.field_count != 0) {
        fail_at(lowering, at, "union variant " + quoted(variant.name) + " requires its payload fields");
        return -1;
    }
    int total = union_size(union_type);
    int request = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = request, value = total - 8 });
    int[] alloc_arguments = new int[1];
    alloc_arguments[0] = request;
    int raw = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.Call { target = raw, function = lowering.allocator.alloc, arguments = alloc_arguments, argument_count = 1 });
    int object = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.Copy { target = object, source = raw });
    int tag = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = tag, value = variant.index });
    push_instruction(lowering.body, Instruction.RawStore64 { address = object, offset = 8, value = tag });
    return object;
}

// lower_member_address evaluates a struct receiver once and returns the
// absolute address of one field.
fn lower_member_address(Lowering lowering, Expr receiver, Token member, Position at) -> int {
    Type receiver_type = expr_type(lowering, receiver);
    match (receiver_type.kind) {
        Struct {
            FieldPlacement place = field_placement(receiver_type, member.text);
            if (!place.found) {
                fail_at(lowering, at, "struct " + quoted(receiver_type.name) + " has no field " + quoted(member.text));
                return -1;
            }
            int object = lower_expression(lowering, receiver);
            if (failed(lowering)) {
                return -1;
            }
            int offset = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = offset, value = place.offset });
            int address = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Add { target = address, left = object, right = offset });
            return address;
        }
        Int { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Bool { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Float { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Byte { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        String { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Array { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Enum { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        Union { fail_at(lowering, at, "union field access is not supported yet"); return -1; }
        Map { fail_at(lowering, at, "field access is supported on struct values only"); return -1; }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
    }
}

// lower_member_read reads one struct field at its constant offset, or
// resolves an enum case reference to its tag. The checker annotates a
// qualified enum/union name with ExprInfo.variant, which is the distinction
// a bare struct field access does not have.
fn lower_member_read(Lowering lowering, Expr whole, Expr receiver, Token member, Position at) -> int {
    ExprInfo info = expression_info(lowering.module, expr_node_id(whole));
    match (info.variant) {
        Present(variant) {
            Type whole_type = expr_type(lowering, whole);
            match (whole_type.kind) {
                Enum {
                    int target = new_temporary(lowering.body, NativeType.Int);
                    push_instruction(lowering.body, Instruction.ConstInt { target = target, value = variant.index });
                    return target;
                }
                Union { return lower_union_reference(lowering, whole_type, variant, at); }
                Int { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Bool { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Float { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Byte { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                String { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Array { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Struct { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                Map { fail_at(lowering, at, "variant references are supported on enums only"); return -1; }
                None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
                Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
            }
        }
        Absent {
        }
    }
    int address = lower_member_address(lowering, receiver, member, at);
    if (failed(lowering)) {
        return -1;
    }
    Type field_type = expr_type(lowering, whole);
    return load_value_at(lowering, field_type, address, at);
}

// lower_member_assign assigns one struct field, evaluating the receiver once.
fn lower_member_assign(Lowering lowering, string op, Position at, Expr whole, Expr receiver, Token member, Expr value) -> int {
    int address = lower_member_address(lowering, receiver, member, at);
    if (failed(lowering)) {
        return -1;
    }
    Type field_type = expr_type(lowering, whole);
    if (op == "=") {
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        store_value_at(lowering, field_type, address, assigned, at);
        return assigned;
    }
    if (op == "+=" || op == "-=") {
        int current = load_value_at(lowering, field_type, address, at);
        if (failed(lowering)) {
            return -1;
        }
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        NativeType folded_shape = NativeType.Int;
        bool floating = false;
        match (field_type.kind) {
            Int { folded_shape = NativeType.Int; }
            Float { folded_shape = NativeType.Float; floating = true; }
            Bool { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Byte { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            String { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Array { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Struct { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Enum { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Union { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            Map { fail_at(lowering, at, "compound assignment is supported on int and float struct fields only"); return -1; }
            None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
            Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
        }
        int folded = new_temporary(lowering.body, folded_shape);
        if (floating) {
            if (op == "+=") {
                push_instruction(lowering.body, Instruction.AddFloat { target = folded, left = current, right = assigned });
            } else {
                push_instruction(lowering.body, Instruction.SubtractFloat { target = folded, left = current, right = assigned });
            }
        } else {
            if (op == "+=") {
                push_instruction(lowering.body, Instruction.Add { target = folded, left = current, right = assigned });
            } else {
                push_instruction(lowering.body, Instruction.Subtract { target = folded, left = current, right = assigned });
            }
        }
        store_value_at(lowering, field_type, address, folded, at);
        return folded;
    }
    fail_at(lowering, at, "the assignment operator " + quoted(op) + " is not supported on struct fields");
    return -1;
}

// lower_variant_literal lowers one qualified variant reference. Enum cases
// become their eight-byte tag; union construction is still unsupported.
fn lower_variant_literal(Lowering lowering, TypeRef type_ref, Token variant, FieldInit[] fields, int field_count, Position at) -> int {
    OptionalResolvedType resolved = type_ref_type(lowering.module, type_ref_node_id(type_ref));
    Type type = none_type();
    match (resolved) {
        Present(found) { type = found; }
        Absent {
            fail_at(lowering, at, "a type reference is not resolved");
            return -1;
        }
    }
    match (type.kind) {
        Enum {
            if (!has(type.variant_index, variant.text)) {
                fail_at(lowering, at, "enum " + quoted(type.name) + " has no case " + quoted(variant.text));
                return -1;
            }
            int tag = type.variant_index[variant.text].index;
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = target, value = tag });
            return target;
        }
        Union { return lower_union_literal(lowering, type, variant, fields, field_count, at); }
        Int { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Bool { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Float { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Byte { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        String { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Array { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Struct { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        Map { fail_at(lowering, at, "variant literals are supported on enum types only"); return -1; }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
    }
}

// lower_struct_literal allocates one struct object and writes every field at
// its layout offset. All fields are required, so every payload byte that can
// be read is initialized.
fn lower_struct_literal(Lowering lowering, TypeRef type_ref, FieldInit[] fields, int field_count, Position at) -> int {
    OptionalResolvedType resolved = type_ref_type(lowering.module, type_ref_node_id(type_ref));
    Type type = none_type();
    match (resolved) {
        Present(found) { type = found; }
        Absent {
            fail_at(lowering, at, "a type reference is not resolved");
            return -1;
        }
    }
    if (type_name_expr_kind(type) != "struct") {
        fail_at(lowering, at, "struct literals are supported on struct types only");
        return -1;
    }
    int total = struct_size(type);
    int request = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = request, value = total - 8 });
    int[] alloc_arguments = new int[1];
    alloc_arguments[0] = request;
    int raw = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.Call { target = raw, function = lowering.allocator.alloc, arguments = alloc_arguments, argument_count = 1 });
    int object = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.Copy { target = object, source = raw });

    int index = 0;
    while (index < field_count) {
        FieldInit init = fields[index];
        FieldPlacement place = field_placement(type, init.name.text);
        if (!place.found) {
            fail_at(lowering, position_of_token(init.name), "struct " + quoted(type.name) + " has no field " + quoted(init.name.text));
            return -1;
        }
        int value = lower_expression(lowering, init.value);
        if (failed(lowering)) {
            return -1;
        }
        int offset = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.ConstInt { target = offset, value = place.offset });
        int address = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.Add { target = address, left = object, right = offset });
        store_value_at(lowering, place.type, address, value, position_of_token(init.name));
        index++;
    }
    return object;
}

// lower_array_address lowers an array expression and an index expression and
// calls "$array_at" for the checked element address.
fn lower_array_address(Lowering lowering, Expr collection, Expr index, Position at) -> int {
    int array = lower_expression(lowering, collection);
    if (failed(lowering)) {
        return -1;
    }
    int offset = lower_expression(lowering, index);
    if (failed(lowering)) {
        return -1;
    }
    if (!int_operand(lowering, offset, at)) {
        return -1;
    }
    int address = new_temporary(lowering.body, NativeType.Int);
    int[] arguments = new int[2];
    arguments[0] = array;
    arguments[1] = offset;
    push_instruction(lowering.body, Instruction.Call { target = address, function = lowering.arrays.at, arguments = arguments, argument_count = 2 });
    return address;
}

// load_value_at loads one value from an address through the shape its checked
// type names: 8-byte int/enum, 1-byte byte, normalized bool, raw bits plus
// BitsFloat for float, and an 8-byte reference for string/array/composite.
fn load_value_at(Lowering lowering, Type type, int address, Position at) -> int {
    match (type.kind) {
        Int {
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Enum {
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Byte {
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad8 { target = target, address = address, offset = 0 });
            return target;
        }
        Bool {
            int raw = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad8 { target = raw, address = address, offset = 0 });
            int one = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = one, value = 1 });
            int target = new_temporary(lowering.body, NativeType.Bool);
            push_instruction(lowering.body, Instruction.Equal { target = target, left = raw, right = one });
            return target;
        }
        Float {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = bits, address = address, offset = 0 });
            int target = new_temporary(lowering.body, NativeType.Float);
            push_instruction(lowering.body, Instruction.BitsFloat { target = target, value = bits });
            return target;
        }
        String {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Array {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Struct {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Union {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        Map {
            int target = new_temporary(lowering.body, NativeType.Ref);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = address, offset = 0 });
            return target;
        }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
    }
}

// store_value_at stores one value at an address through the same shape split
// as the load. A bool materializes one 0/1 byte through a branch; a reference
// copies its 64-bit address into an int binding first.
fn store_value_at(Lowering lowering, Type type, int address, int value, Position at) {
    match (type.kind) {
        Int {
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = value });
        }
        Enum {
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = value });
        }
        Byte {
            push_instruction(lowering.body, Instruction.RawStore8 { address = address, offset = 0, value = value });
        }
        Bool {
            int one = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = one, value = 1 });
            int zero = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
            int raw = new_temporary(lowering.body, NativeType.Int);
            int truthy = new_label(lowering);
            int falsy = new_label(lowering);
            int done = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = value, label_true = truthy, label_false = falsy });
            define_label(lowering, truthy);
            push_instruction(lowering.body, Instruction.Copy { target = raw, source = one });
            push_instruction(lowering.body, Instruction.Jump { label = done });
            define_label(lowering, falsy);
            push_instruction(lowering.body, Instruction.Copy { target = raw, source = zero });
            define_label(lowering, done);
            push_instruction(lowering.body, Instruction.RawStore8 { address = address, offset = 0, value = raw });
        }
        Float {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.FloatBits { target = bits, value = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        String {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        Array {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        Struct {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        Union {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        Map {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            push_instruction(lowering.body, Instruction.RawStore64 { address = address, offset = 0, value = bits });
        }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); }
        Void { fail_at(lowering, at, "void values cannot be lowered"); }
    }
}

// lower_array_load and lower_array_store keep the array call sites on the
// shared value load/store split.
fn lower_array_load(Lowering lowering, Type element, int address, Position at) -> int {
    return load_value_at(lowering, element, address, at);
}

fn lower_array_store(Lowering lowering, Type element, int address, int value, Position at) {
    store_value_at(lowering, element, address, value, at);
}

// map_value_size returns the stored byte width for a map value: one for bool
// and byte, eight for every scalar, reference, tag, and composite value.
fn map_value_size(Lowering lowering, Type value, Position at) -> int {
    match (value.kind) {
        Bool { return 1; }
        Byte { return 1; }
        Int { return 8; }
        Float { return 8; }
        String { return 8; }
        Array { return 8; }
        Struct { return 8; }
        Enum { return 8; }
        Union { return 8; }
        Map { return 8; }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return 0; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return 0; }
    }
}

// map_store_value turns a value binding into the int bits the map runtime
// writes: bool becomes 0/1, float its raw bits, and a reference its address.
fn map_store_value(Lowering lowering, Type value_type, int value, Position at) -> int {
    match (value_type.kind) {
        Int { return value; }
        Enum { return value; }
        Byte { return value; }
        Bool {
            int one = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = one, value = 1 });
            int zero = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
            int raw = new_temporary(lowering.body, NativeType.Int);
            int truthy = new_label(lowering);
            int falsy = new_label(lowering);
            int done = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = value, label_true = truthy, label_false = falsy });
            define_label(lowering, truthy);
            push_instruction(lowering.body, Instruction.Copy { target = raw, source = one });
            push_instruction(lowering.body, Instruction.Jump { label = done });
            define_label(lowering, falsy);
            push_instruction(lowering.body, Instruction.Copy { target = raw, source = zero });
            define_label(lowering, done);
            return raw;
        }
        Float {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.FloatBits { target = bits, value = value });
            return bits;
        }
        String {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Array {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Struct {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Union {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Map {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
    }
}

// lower_map_creation lowers `new map[string]V` through "$map_new" with the
// value width from the declared map type.
fn lower_map_creation(Lowering lowering, TypeRef map_type, Position at) -> int {
    OptionalResolvedType resolved = type_ref_type(lowering.module, type_ref_node_id(map_type));
    Type type = none_type();
    match (resolved) {
        Present(found) { type = found; }
        Absent {
            fail_at(lowering, at, "a type reference is not resolved");
            return -1;
        }
    }
    if (type_name_expr_kind(type) != "map") {
        fail_at(lowering, at, "map creation is supported on map types only");
        return -1;
    }
    Type value = none_type();
    match (type.value) {
        Present(found) { value = found; }
        Absent {
            fail_at(lowering, at, "map value type is not resolved");
            return -1;
        }
    }
    int size = map_value_size(lowering, value, at);
    if (failed(lowering)) {
        return -1;
    }
    int size_binding = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = size_binding, value = size });
    int target = new_temporary(lowering.body, NativeType.Ref);
    int[] arguments = new int[1];
    arguments[0] = size_binding;
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.maps.new_map, arguments = arguments, argument_count = 1 });
    return target;
}

// lower_map_read reads one map value at the entry address.
fn lower_map_read(Lowering lowering, Expr whole, Expr collection, Expr index, Position at) -> int {
    int table = lower_expression(lowering, collection);
    if (failed(lowering)) {
        return -1;
    }
    int key = lower_expression(lowering, index);
    if (failed(lowering)) {
        return -1;
    }
    int address = new_temporary(lowering.body, NativeType.Int);
    int[] arguments = new int[2];
    arguments[0] = table;
    arguments[1] = key;
    push_instruction(lowering.body, Instruction.Call { target = address, function = lowering.maps.at, arguments = arguments, argument_count = 2 });
    Type value_type = expr_type(lowering, whole);
    return load_value_at(lowering, value_type, address, at);
}

// lower_map_assign inserts or updates one map entry. The key and map evaluate
// once; a plain assignment uses "$map_set", while the compound forms read,
// fold, and set back.
fn lower_map_assign(Lowering lowering, string op, Position at, Expr whole, Expr collection, Expr index, Expr value) -> int {
    int table = lower_expression(lowering, collection);
    if (failed(lowering)) {
        return -1;
    }
    int key = lower_expression(lowering, index);
    if (failed(lowering)) {
        return -1;
    }
    Type value_type = expr_type(lowering, whole);
    if (op == "=") {
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        int stored = map_store_value(lowering, value_type, assigned, at);
        if (failed(lowering)) {
            return -1;
        }
        int[] arguments = new int[3];
        arguments[0] = table;
        arguments[1] = key;
        arguments[2] = stored;
        push_instruction(lowering.body, Instruction.CallVoid { function = lowering.maps.set, arguments = arguments, argument_count = 3 });
        return assigned;
    }
    if (op == "+=" || op == "-=") {
        int address = new_temporary(lowering.body, NativeType.Int);
        int[] lookup_args = new int[2];
        lookup_args[0] = table;
        lookup_args[1] = key;
        push_instruction(lowering.body, Instruction.Call { target = address, function = lowering.maps.at, arguments = lookup_args, argument_count = 2 });
        int current = load_value_at(lowering, value_type, address, at);
        if (failed(lowering)) {
            return -1;
        }
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        NativeType folded_shape = NativeType.Int;
        bool floating = false;
        match (value_type.kind) {
            Int { folded_shape = NativeType.Int; }
            Float { folded_shape = NativeType.Float; floating = true; }
            Bool { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Byte { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            String { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Array { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Struct { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Enum { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Union { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            Map { fail_at(lowering, at, "compound assignment is supported on int and float map values only"); return -1; }
            None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
            Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
        }
        int folded = new_temporary(lowering.body, folded_shape);
        if (floating) {
            if (op == "+=") {
                push_instruction(lowering.body, Instruction.AddFloat { target = folded, left = current, right = assigned });
            } else {
                push_instruction(lowering.body, Instruction.SubtractFloat { target = folded, left = current, right = assigned });
            }
        } else {
            if (op == "+=") {
                push_instruction(lowering.body, Instruction.Add { target = folded, left = current, right = assigned });
            } else {
                push_instruction(lowering.body, Instruction.Subtract { target = folded, left = current, right = assigned });
            }
        }
        int stored = map_store_value(lowering, value_type, folded, at);
        if (failed(lowering)) {
            return -1;
        }
        int[] set_args = new int[3];
        set_args[0] = table;
        set_args[1] = key;
        set_args[2] = stored;
        push_instruction(lowering.body, Instruction.CallVoid { function = lowering.maps.set, arguments = set_args, argument_count = 3 });
        return folded;
    }
    fail_at(lowering, at, "the assignment operator " + quoted(op) + " is not supported on map entries");
    return -1;
}

// lower_map_has_call lowers has(map, key) through the runtime shell.
fn lower_map_has_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 2) {
        fail_at(lowering, open_paren, "has is supported with exactly two arguments");
        return -1;
    }
    int table = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int key = lower_expression(lowering, arguments[1]);
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Bool);
    int[] call_arguments = new int[2];
    call_arguments[0] = table;
    call_arguments[1] = key;
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.maps.has, arguments = call_arguments, argument_count = 2 });
    return target;
}

// lower_index_read reads one array element, or reports the unsupported string
// indexing case rather than handing a string object to the array runtime.
fn lower_index_read(Lowering lowering, Expr whole, Expr collection, Expr index, Position at) -> int {
    Type container = expr_type(lowering, collection);
    match (container.kind) {
        Array {
            int address = lower_array_address(lowering, collection, index, at);
            if (failed(lowering)) {
                return -1;
            }
            Type element = expr_type(lowering, whole);
            return lower_array_load(lowering, element, address, at);
        }
        String {
            int text = lower_expression(lowering, collection);
            if (failed(lowering)) {
                return -1;
            }
            int offset = lower_expression(lowering, index);
            if (failed(lowering)) {
                return -1;
            }
            if (!int_operand(lowering, offset, at)) {
                return -1;
            }
            int target = new_temporary(lowering.body, NativeType.Int);
            int[] arguments = new int[2];
            arguments[0] = text;
            arguments[1] = offset;
            push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.string_at, arguments = arguments, argument_count = 2 });
            return target;
        }
        Map { return lower_map_read(lowering, whole, collection, index, at); }
        Int { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Bool { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Float { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Byte { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Struct { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Enum { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Union { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        None { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Void { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
    }
}

// lower_index_assign assigns one array element. Plain assignment evaluates the
// element address once; the compound forms load through that address, fold,
// and store back, so the index expression never runs twice.
fn lower_index_assign(Lowering lowering, string op, Position at, Expr whole, Expr collection, Expr index, Expr value) -> int {
    Type container = expr_type(lowering, collection);
    match (container.kind) {
        Array {
            int address = lower_array_address(lowering, collection, index, at);
            if (failed(lowering)) {
                return -1;
            }
            Type element = expr_type(lowering, whole);
            if (op == "=") {
                int assigned = lower_expression(lowering, value);
                if (failed(lowering)) {
                    return -1;
                }
                lower_array_store(lowering, element, address, assigned, at);
                return assigned;
            }
            if (op == "+=" || op == "-=") {
                int current = lower_array_load(lowering, element, address, at);
                if (failed(lowering)) {
                    return -1;
                }
                int assigned = lower_expression(lowering, value);
                if (failed(lowering)) {
                    return -1;
                }
                NativeType folded_shape = NativeType.Int;
                bool floating = false;
                bool concatenating = false;
                match (element.kind) {
                    Int { folded_shape = NativeType.Int; }
                    Float { folded_shape = NativeType.Float; floating = true; }
                    String {
                        if (op != "+=") {
                            fail_at(lowering, at, "compound assignment is supported on int and float array elements only");
                            return -1;
                        }
                        folded_shape = NativeType.Ref;
                        concatenating = true;
                    }
                    Bool { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Byte { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Struct { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Array { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Enum { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Union { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Map { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    None { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                    Void { fail_at(lowering, at, "compound assignment is supported on int and float array elements only"); return -1; }
                }
                int folded = new_temporary(lowering.body, folded_shape);
                if (concatenating) {
                    int[] concat_arguments = new int[2];
                    concat_arguments[0] = current;
                    concat_arguments[1] = assigned;
                    push_instruction(lowering.body, Instruction.Call { target = folded, function = lowering.strings.concat, arguments = concat_arguments, argument_count = 2 });
                } else if (floating) {
                    if (op == "+=") {
                        push_instruction(lowering.body, Instruction.AddFloat { target = folded, left = current, right = assigned });
                    } else {
                        push_instruction(lowering.body, Instruction.SubtractFloat { target = folded, left = current, right = assigned });
                    }
                } else {
                    if (op == "+=") {
                        push_instruction(lowering.body, Instruction.Add { target = folded, left = current, right = assigned });
                    } else {
                        push_instruction(lowering.body, Instruction.Subtract { target = folded, left = current, right = assigned });
                    }
                }
                lower_array_store(lowering, element, address, folded, at);
                return folded;
            }
            fail_at(lowering, at, "the assignment operator " + quoted(op) + " is not supported on array elements");
            return -1;
        }
        Map { return lower_map_assign(lowering, op, at, whole, collection, index, value); }
        String {
            fail_at(lowering, at, "string indexing is not supported yet");
            return -1;
        }
        Int { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Bool { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Float { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Byte { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Struct { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Enum { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Union { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        None { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
        Void { fail_at(lowering, at, "indexing is supported on arrays only"); return -1; }
    }
}

// lower_array_creation lowers `new T[n]`: the element size from the declared
// type, the length expression, then the "$array_new" shell.
fn lower_array_creation(Lowering lowering, TypeRef element_ref, Expr length, Position at) -> int {
    OptionalResolvedType resolved = type_ref_type(lowering.module, type_ref_node_id(element_ref));
    Type element = none_type();
    match (resolved) {
        Present(type) { element = type; }
        Absent {
            fail_at(lowering, at, "a type reference is not resolved");
            return -1;
        }
    }
    int size = array_element_size(lowering, element, type_position(element_ref));
    if (failed(lowering)) {
        return -1;
    }
    int count = lower_expression(lowering, length);
    if (failed(lowering)) {
        return -1;
    }
    if (!int_operand(lowering, count, at)) {
        return -1;
    }
    int size_value = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = size_value, value = size });
    int[] arguments = new int[2];
    arguments[0] = count;
    arguments[1] = size_value;
    int target = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.new_array, arguments = arguments, argument_count = 2 });
    return target;
}

// lower_assign lowers one assignment expression: the target must be a local
// variable or parameter, the value lowers first, and plain assignment then
// copies it into the target while the compound forms fold through an int
// temporary. Every assignment expression yields the value that was assigned
// or folded, exactly as the C generator's assignment expressions do.
fn lower_assign(Lowering lowering, Token operator, Expr target, Expr value) -> int {
    string op = operator.text;
    Position at = position_of_token(operator);

    int slot = -1;
    match (target) {
        Identifier(node_id, token) {
            slot = lookup(lowering, token.text, position_of_token(token));
        }
        Integer(node_id, token) { }
        Float(node_id, token) { }
        String(node_id, token) { }
        Boolean(node_id, token, boolean) { }
        Unary(node_id, inner_operator, inner_operand, inner_postfix) { }
        Binary(node_id, inner_operator, left, right) { }
        Assign(node_id, inner_operator, inner_target, inner_value) { }
        Call(node_id, open_paren, callee, arguments, argument_count) { }
        Member(node_id, dot, receiver, member) {
            return lower_member_assign(lowering, op, at, target, receiver, member, value);
        }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { }
        NewArray(node_id, at, element, length) { }
        NewMap(node_id, at, map_type) { }
        Index(node_id, bracket, target_expr, index) {
            return lower_index_assign(lowering, op, at, target, target_expr, index, value);
        }
    }
    if (slot < 0) {
        if (!failed(lowering)) {
            fail_at(lowering, at, "assignment is supported on local variables only");
        }
        return -1;
    }
    if (failed(lowering)) {
        return -1;
    }

    if (op == "=") {
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        push_instruction(lowering.body, Instruction.Copy { target = slot, source = assigned });
        return assigned;
    }
    if (op == "+=") {
        NativeType fold_shape = NativeType.Int;
        bool appending = type_name(lowering.body.binding_types[slot]) == type_name(NativeType.Ref);
        bool floating = type_name(lowering.body.binding_types[slot]) == type_name(NativeType.Float);
        if (appending) {
            fold_shape = NativeType.Ref;
        } else if (floating) {
            if (!float_operand(lowering, slot, at)) {
                return -1;
            }
            fold_shape = NativeType.Float;
        } else {
            if (!int_operand(lowering, slot, at)) {
                return -1;
            }
        }
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        if (appending) {
            if (type_name(lowering.body.binding_types[assigned]) != type_name(NativeType.Ref)) {
                fail_at(lowering, at, "string append is supported with a string value");
                return -1;
            }
            // s' = append(s, t): the one user-reachable allocation, then
            // the target takes the fresh object, exactly like the C
            // pipeline's assignment expression.
            int appended = new_temporary(lowering.body, NativeType.Ref);
            int[] append_arguments = new int[2];
            append_arguments[0] = slot;
            append_arguments[1] = assigned;
            push_instruction(lowering.body, Instruction.Call { target = appended, function = lowering.strings.concat, arguments = append_arguments, argument_count = 2 });
            push_instruction(lowering.body, Instruction.Copy { target = slot, source = appended });
            return appended;
        }
        if (floating) {
            if (!float_operand(lowering, assigned, at)) {
                return -1;
            }
        } else {
            if (!int_operand(lowering, assigned, at)) {
                return -1;
            }
        }
        int folded = new_temporary(lowering.body, fold_shape);
        if (floating) {
            push_instruction(lowering.body, Instruction.AddFloat { target = folded, left = slot, right = assigned });
        } else {
            push_instruction(lowering.body, Instruction.Add { target = folded, left = slot, right = assigned });
        }
        push_instruction(lowering.body, Instruction.Copy { target = slot, source = folded });
        return folded;
    }
    if (op == "-=") {
        NativeType fold_shape = NativeType.Int;
        bool floating = type_name(lowering.body.binding_types[slot]) == type_name(NativeType.Float);
        if (floating) {
            if (!float_operand(lowering, slot, at)) {
                return -1;
            }
            fold_shape = NativeType.Float;
        } else {
            if (!int_operand(lowering, slot, at)) {
                return -1;
            }
        }
        int assigned = lower_expression(lowering, value);
        if (failed(lowering)) {
            return -1;
        }
        if (floating) {
            if (!float_operand(lowering, assigned, at)) {
                return -1;
            }
        } else {
            if (!int_operand(lowering, assigned, at)) {
                return -1;
            }
        }
        int folded = new_temporary(lowering.body, fold_shape);
        if (floating) {
            push_instruction(lowering.body, Instruction.SubtractFloat { target = folded, left = slot, right = assigned });
        } else {
            push_instruction(lowering.body, Instruction.Subtract { target = folded, left = slot, right = assigned });
        }
        push_instruction(lowering.body, Instruction.Copy { target = slot, source = folded });
        return folded;
    }
    fail_at(lowering, at, "the assignment operator " + quoted(op) + " is not supported yet");
    return -1;
}

// lower_call lowers one call expression. The callee is a plain name: a
// user function of the module, the print built-in lowered into the scene's
// print helper, or the exit built-in lowered into a raw exit_group syscall.
// Every argument lowers in order before the call. A void callee contributes
// no value, which the caller sees as a -1 binding with no failure recorded.
fn lower_call(Lowering lowering, Expr callee, Expr[] arguments, int argument_count, Position open_paren) -> int {
    match (callee) {
        Identifier(node_id, token) {
            ExprInfo info = expression_info(lowering.module, node_id);
            match (info.symbol) {
                Present(symbol) {
                    match (symbol.function) {
                        Present(function) {
                            if (function.builtin == BuiltinKind.Print) {
                                return lower_print_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Eprint) {
                                return lower_eprint_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Argv) {
                                return lower_argv_call(lowering, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryCurrentDirectory) {
                                return lower_current_directory_call(lowering, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryReadFile) {
                                return lower_try_read_file_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.ReadFile) {
                                return lower_read_file_fatal_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryWriteFile) {
                                return lower_try_write_file_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryWriteBytes) {
                                return lower_try_write_bytes_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryGetenv) {
                                return lower_try_getenv_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryCreateDirectory) {
                                return lower_try_create_directory_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryRemove) {
                                return lower_try_remove_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryFileInfo) {
                                return lower_try_file_info_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryListDirectory) {
                                return lower_try_list_directory_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryCreateTempDirectory) {
                                return lower_try_create_temp_directory_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryRun) {
                                return lower_try_run_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.TryRunCapture) {
                                return lower_try_run_capture_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.MapHas) {
                                return lower_map_has_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Exit) {
                                return lower_exit_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Length) {
                                return lower_length_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Substring) {
                                return lower_substring_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.IntFromByte) {
                                return lower_int_from_byte_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.ByteFromInt) {
                                return lower_byte_from_int_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.StringToBytes) {
                                return lower_string_to_bytes_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.BytesToString) {
                                return lower_bytes_to_string_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Push) {
                                return lower_push_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.RawLoad8) {
                                return lower_raw_load_call(lowering, arguments, argument_count, open_paren, 8);
                            }
                            if (function.builtin == BuiltinKind.RawLoad64) {
                                return lower_raw_load_call(lowering, arguments, argument_count, open_paren, 64);
                            }
                            if (function.builtin == BuiltinKind.RawStore8) {
                                return lower_raw_store_call(lowering, arguments, argument_count, open_paren, 8);
                            }
                            if (function.builtin == BuiltinKind.RawStore64) {
                                return lower_raw_store_call(lowering, arguments, argument_count, open_paren, 64);
                            }
                            if (function.builtin == BuiltinKind.RawCopy) {
                                return lower_raw_copy_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.RawZero) {
                                return lower_raw_zero_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.AddressOf) {
                                return lower_address_of_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin == BuiltinKind.Syscall) {
                                return lower_syscall_call(lowering, arguments, argument_count, open_paren);
                            }
                            if (function.builtin != BuiltinKind.NotBuiltin) {
                                fail_at(lowering, position_of_token(token), "built-in " + quoted(token.text) + " is not supported yet");
                                return -1;
                            }
                            return lower_user_call(lowering, token, arguments, argument_count, function);
                        }
                        Absent { }
                    }
                }
                Absent { }
            }
        }
        Integer(node_id, token) { }
        Float(node_id, token) { }
        String(node_id, token) { }
        Boolean(node_id, token, value) { }
        Unary(node_id, inner_operator, inner_operand, inner_postfix) { }
        Binary(node_id, inner_operator, left, right) { }
        Assign(node_id, inner_operator, inner_target, inner_value) { }
        Call(node_id, open_paren, inner_callee, arguments, argument_count) { }
        Member(node_id, dot, receiver, member) { }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) { }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) { }
        NewArray(node_id, at, element, length) { }
        NewMap(node_id, at, map_type) { }
        Index(node_id, bracket, target_expr, index) { }
    }
    if (!failed(lowering)) {
        fail_at(lowering, open_paren, "calls are supported on named functions only");
    }
    return -1;
}

// lower_user_call lowers one call to a module function. The checker already
// checked the argument count and the argument types, so the lowering only
// resolves the callee and lowers every argument in order.
fn lower_user_call(Lowering lowering, Token name, Expr[] arguments, int argument_count, Function function) -> int {
    string key = module_function_name(function.module, function.name);
    if (!has(lowering.functions, key)) {
        fail_at(lowering, position_of_token(name), "function " + quoted(name.text) + " is not a lowered function");
        return -1;
    }
    int callee = lowering.functions[key];

    int[] arguments_lowered = new int[argument_count];
    int index = 0;
    while (index < argument_count) {
        int binding = lower_expression(lowering, arguments[index]);
        if (failed(lowering)) {
            return -1;
        }
        arguments_lowered[index] = binding;
        index++;
    }

    if (is_void(function.return_type)) {
        push_instruction(lowering.body, Instruction.CallVoid { function = callee, arguments = arguments_lowered, argument_count = argument_count });
        return -1;
    }
    NativeType result = value_shape(lowering, function.return_type, position_of_token(name));
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, result);
    push_instruction(lowering.body, Instruction.Call { target = target, function = callee, arguments = arguments_lowered, argument_count = argument_count });
    return target;
}

// lower_print_call lowers the print built-in: exactly one argument whose
// type is string, int, or bool — the checker rejects everything else
// already. The call becomes a void call to the kind's print helper: the
// string helper writes one object's payload plus the newline blob, the
// integer helper renders the decimal digits with one byte per write and
// shares the newline tail, and the bool helper writes "true" or "false".
fn lower_print_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count < 1) {
        fail_at(lowering, open_paren, "print needs at least one argument");
        return -1;
    }
    bool multiple = argument_count > 1;
    int space = -1;
    if (multiple) {
        space = new_temporary(lowering.body, NativeType.Ref);
        push_instruction(lowering.body, Instruction.ConstRefData { target = space, blob = lowering.print_space });
    }
    int index = 0;
    while (index < argument_count) {
        string kind = type_name_expr_kind(expr_type(lowering, arguments[index]));
        int helper = -1;
        if (kind == "string") {
            if (multiple) {
                helper = lowering.string_print_raw;
            } else {
                helper = lowering.string_print;
            }
        } else if (kind == "int" || kind == "byte") {
            if (multiple) {
                helper = lowering.int_print_raw;
            } else {
                helper = lowering.int_print;
            }
        } else if (kind == "bool") {
            if (multiple) {
                helper = lowering.bool_print_raw;
            } else {
                helper = lowering.bool_print;
            }
        } else if (kind == "float64") {
            if (multiple) {
                helper = lowering.float_print_raw;
            } else {
                helper = lowering.float_print;
            }
        } else {
            fail_at(lowering, open_paren, "print is supported with string, int, float, bool, or byte arguments");
            return -1;
        }
        if (index > 0) {
            int[] space_arguments = new int[1];
            space_arguments[0] = space;
            push_instruction(lowering.body, Instruction.CallVoid { function = lowering.string_print_raw, arguments = space_arguments, argument_count = 1 });
        }
        int value = lower_expression(lowering, arguments[index]);
        if (failed(lowering)) {
            return -1;
        }
        int[] print_arguments = new int[1];
        print_arguments[0] = value;
        push_instruction(lowering.body, Instruction.CallVoid { function = helper, arguments = print_arguments, argument_count = 1 });
        index++;
    }
    if (multiple) {
        int[] no_arguments = new int[0];
        push_instruction(lowering.body, Instruction.CallVoid { function = lowering.print_tail, arguments = no_arguments, argument_count = 0 });
    }
    return -1;
}

