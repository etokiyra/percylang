// lower_address_of_call lowers address_of(value): the payload pointer of a
// string, or the byte-payload pointer of a byte array, matching the C
// generator's shape split.
fn lower_address_of_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "address_of is supported with exactly one argument");
        return -1;
    }
    Type argument_type = expr_type(lowering, arguments[0]);
    int reference = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    match (argument_type.kind) {
        String {
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = target, address = reference, offset = 16 });
            return target;
        }
        Array {
            if (element_of(argument_type).kind != TypeKind.Byte) {
                fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type));
                return -1;
            }
            int buffer = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.RawLoad64 { target = buffer, address = reference, offset = 24 });
            int eight = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = eight, value = 8 });
            int target = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Add { target = target, left = buffer, right = eight });
            return target;
        }
        Int { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Byte { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Bool { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Float { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Struct { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Enum { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Union { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Map { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        None { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
        Void { fail_at(lowering, open_paren, "address_of does not accept " + type_string(argument_type)); return -1; }
    }
}

// lower_syscall_call lowers syscall(number, a1..a6) into one raw syscall.
fn lower_syscall_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 7) {
        fail_at(lowering, open_paren, "syscall is supported with exactly seven arguments");
        return -1;
    }
    int number = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int[] syscall_arguments = new int[6];
    int index = 1;
    while (index < 7) {
        syscall_arguments[index - 1] = lower_expression(lowering, arguments[index]);
        if (failed(lowering)) {
            return -1;
        }
        index++;
    }
    int target = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.RawSyscall { target = target, number = number, arguments = syscall_arguments, argument_count = 6 });
    return target;
}

