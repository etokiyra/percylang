// lower_eprint_call lowers eprint through the runtime's descriptor writers:
// each string, int, byte, or bool goes to descriptor 2 with a space between
// values and one newline at the end. Float eprint has no descriptor-based
// formatter yet and fails explicitly.
fn lower_eprint_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count < 1) {
        fail_at(lowering, open_paren, "eprint needs at least one argument");
        return -1;
    }
    int two = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = two, value = 2 });
    int space = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.ConstRefData { target = space, blob = lowering.arrays.eprint_space });
    int newline = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.ConstRefData { target = newline, blob = lowering.arrays.eprint_newline });

    int index = 0;
    while (index < argument_count) {
        string kind = type_name_expr_kind(expr_type(lowering, arguments[index]));
        if (index > 0) {
            int[] space_args = new int[2];
            space_args[0] = two;
            space_args[1] = space;
            push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.write_blob_fd, arguments = space_args, argument_count = 2 });
        }
        int value = lower_expression(lowering, arguments[index]);
        if (failed(lowering)) {
            return -1;
        }
        if (kind == "string") {
            int[] text_args = new int[2];
            text_args[0] = two;
            text_args[1] = value;
            push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.write_blob_fd, arguments = text_args, argument_count = 2 });
        } else if (kind == "int" || kind == "byte") {
            int[] int_args = new int[2];
            int_args[0] = two;
            int_args[1] = value;
            push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.write_int_fd, arguments = int_args, argument_count = 2 });
        } else if (kind == "bool") {
            int chosen = new_temporary(lowering.body, NativeType.Ref);
            int true_label = new_label(lowering);
            int false_label = new_label(lowering);
            int merge_label = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = value, label_true = true_label, label_false = false_label });
            define_label(lowering, true_label);
            push_instruction(lowering.body, Instruction.ConstRefData { target = chosen, blob = lowering.arrays.eprint_true });
            push_instruction(lowering.body, Instruction.Jump { label = merge_label });
            define_label(lowering, false_label);
            push_instruction(lowering.body, Instruction.ConstRefData { target = chosen, blob = lowering.arrays.eprint_false });
            define_label(lowering, merge_label);
            int[] bool_args = new int[2];
            bool_args[0] = two;
            bool_args[1] = chosen;
            push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.write_blob_fd, arguments = bool_args, argument_count = 2 });
        } else if (kind == "float64") {
            fail_at(lowering, open_paren, "eprint(float) is not supported yet");
            return -1;
        } else {
            fail_at(lowering, open_paren, "eprint is supported with string, int, float, bool, or byte arguments");
            return -1;
        }
        index++;
    }
    int[] newline_args = new int[2];
    newline_args[0] = two;
    newline_args[1] = newline;
    push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.write_blob_fd, arguments = newline_args, argument_count = 2 });
    return -1;
}

// type_name_expr_kind is the renderer's shape spelling for a checked type's
// kind, the string the prescan keys its helper registration on. The kinds
// the checker can attach to a printable argument are exactly the three the
// lowering implements; anything else arrives here before its unsupport
// message.
fn type_name_expr_kind(Type type) -> string {
    match (type.kind) {
        Int { return "int"; }
        Float { return "float64"; }
        Bool { return "bool"; }
        String { return "string"; }
        Byte { return "byte"; }
        Void { return "void"; }
        Struct { return "struct"; }
        Array { return "array"; }
        Enum { return "enum"; }
        Union { return "union"; }
        Map { return "map"; }
        None { return "invalid"; }
    }
}

// lower_length_call lowers the length built-in: exactly one argument whose
// type is string — every other argument shape failed earlier in the
// checker or the value walk — through the "$string_length" shell, whose
// load reads the object's length word.
fn lower_length_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "length is supported with exactly one argument, but the call passes " + lower_decimal(argument_count));
        return -1;
    }
    Type argument_type = expr_type(lowering, arguments[0]);
    int value = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int[] arguments_lowered = new int[1];
    arguments_lowered[0] = value;
    int target = new_temporary(lowering.body, NativeType.Int);
    match (argument_type.kind) {
        Array {
            push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.length, arguments = arguments_lowered, argument_count = 1 });
            return target;
        }
        String {
            push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.strings.length, arguments = arguments_lowered, argument_count = 1 });
            return target;
        }
        Map {
            push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.maps.length, arguments = arguments_lowered, argument_count = 1 });
            return target;
        }
        Int { fail_at(lowering, open_paren, "length is supported on string, array, and map values only"); return -1; }
        Bool { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Float { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Byte { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Struct { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Enum { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Union { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        None { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
        Void { fail_at(lowering, open_paren, "length is supported on string and array values only"); return -1; }
    }
}

// lower_substring_call lowers the substring built-in through the range-checked
// runtime shell.
fn lower_substring_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 3) {
        fail_at(lowering, open_paren, "substring is supported with exactly three arguments");
        return -1;
    }
    int text = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int start = lower_expression(lowering, arguments[1]);
    if (failed(lowering)) {
        return -1;
    }
    int finish = lower_expression(lowering, arguments[2]);
    if (failed(lowering)) {
        return -1;
    }
    if (!int_operand(lowering, start, open_paren) || !int_operand(lowering, finish, open_paren)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Ref);
    int[] call_arguments = new int[3];
    call_arguments[0] = text;
    call_arguments[1] = start;
    call_arguments[2] = finish;
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.substring, arguments = call_arguments, argument_count = 3 });
    return target;
}

// lower_int_from_byte_call lowers int_from_byte: the byte binding already
// holds its 0..255 value in an int slot, so the conversion is the identity.
fn lower_int_from_byte_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "int_from_byte is supported with exactly one argument");
        return -1;
    }
    return lower_expression(lowering, arguments[0]);
}

// lower_byte_from_int_call lowers byte_from_int: the low eight bits of the
// int, with the truncating remainder mapped from its signed spelling to
// 0..255 by adding 256 when negative.
fn lower_byte_from_int_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "byte_from_int is supported with exactly one argument");
        return -1;
    }
    int value = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    if (!int_operand(lowering, value, open_paren)) {
        return -1;
    }
    int base = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = base, value = 256 });
    int remainder = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.WholeRemainder { target = remainder, left = value, right = base });
    int zero = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
    int negative = new_temporary(lowering.body, NativeType.Bool);
    push_instruction(lowering.body, Instruction.LessThan { target = negative, left = remainder, right = zero });
    int adjusted = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.Copy { target = adjusted, source = remainder });
    int adjust = new_label(lowering);
    int done = new_label(lowering);
    push_instruction(lowering.body, Instruction.Branch { condition = negative, label_true = adjust, label_false = done });
    define_label(lowering, adjust);
    push_instruction(lowering.body, Instruction.Add { target = adjusted, left = remainder, right = base });
    define_label(lowering, done);
    return adjusted;
}

// lower_string_to_bytes_call lowers string_to_bytes through the array
// runtime's copying shell.
fn lower_string_to_bytes_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "string_to_bytes is supported with exactly one argument");
        return -1;
    }
    int value = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Ref);
    int[] call_arguments = new int[1];
    call_arguments[0] = value;
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.string_to_bytes, arguments = call_arguments, argument_count = 1 });
    return target;
}

// lower_bytes_to_string_call lowers bytes_to_string through the array
// runtime's NUL-checking shell.
fn lower_bytes_to_string_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "bytes_to_string is supported with exactly one argument");
        return -1;
    }
    int value = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int target = new_temporary(lowering.body, NativeType.Ref);
    int[] call_arguments = new int[1];
    call_arguments[0] = value;
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.bytes_to_string, arguments = call_arguments, argument_count = 1 });
    return target;
}

// value_bits lowers a value as the int word an array element store copies: the
// value itself for int, bool, byte, enum, and reference shapes, and the raw
// binary64 bits for a float.
fn value_bits(Lowering lowering, Type type, int value, Position at) -> int {
    match (type.kind) {
        Float {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.FloatBits { target = bits, value = value });
            return bits;
        }
        None { fail_at(lowering, at, "invalid values cannot be lowered"); return -1; }
        Void { fail_at(lowering, at, "void values cannot be lowered"); return -1; }
        Int {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Bool {
            // A bool binding is its own shape; normalize it to an int word so
            // the runtime's element store can copy one or eight bytes.
            int bits = new_temporary(lowering.body, NativeType.Int);
            int one = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = one, value = 1 });
            int zero = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
            int truthy = new_label(lowering);
            int falsy = new_label(lowering);
            int done = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = value, label_true = truthy, label_false = falsy });
            define_label(lowering, truthy);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = one });
            push_instruction(lowering.body, Instruction.Jump { label = done });
            define_label(lowering, falsy);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = zero });
            define_label(lowering, done);
            return bits;
        }
        Byte {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        String {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Array {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Struct {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Enum {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Union {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
        Map {
            int bits = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Copy { target = bits, source = value });
            return bits;
        }
    }
}

// lower_push_call lowers push(array, value): the array and the value lower in
// argument order, and the runtime's append copies the value word into the
// element slot, growing the buffer when needed.
fn lower_push_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 2) {
        fail_at(lowering, open_paren, "push is supported with exactly two arguments");
        return -1;
    }
    Type array_type = expr_type(lowering, arguments[0]);
    Type element_type = element_of(array_type);
    int array = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    int value = lower_expression(lowering, arguments[1]);
    if (failed(lowering)) {
        return -1;
    }
    int bits = value_bits(lowering, element_type, value, open_paren);
    if (failed(lowering)) {
        return -1;
    }
    int[] call_arguments = new int[2];
    call_arguments[0] = array;
    call_arguments[1] = bits;
    int target = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.Call { target = target, function = lowering.arrays.push, arguments = call_arguments, argument_count = 2 });
    return target;
}

// lower_exit_call lowers the exit built-in: the status lowers first, and
// the call becomes the backend's own raw exit_group syscall with the status
// as its one register argument, which never returns.
fn lower_exit_call(Lowering lowering, Expr[] arguments, int argument_count, Position open_paren) -> int {
    if (argument_count != 1) {
        fail_at(lowering, open_paren, "exit is supported with exactly one argument");
        return -1;
    }
    int status = lower_expression(lowering, arguments[0]);
    if (failed(lowering)) {
        return -1;
    }
    if (!int_operand(lowering, status, open_paren)) {
        return -1;
    }
    int number = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.ConstInt { target = number, value = 60 });
    int[] syscall_arguments = new int[1];
    syscall_arguments[0] = status;
    int target = new_temporary(lowering.body, NativeType.Int);
    push_instruction(lowering.body, Instruction.RawSyscall { target = target, number = number, arguments = syscall_arguments, argument_count = 1 });
    return -1;
}

// --- Statements ------------------------------------------------------------------

// lower_stmt lowers one statement. Blocks open and close a scope; variable
// declarations allocate their binding in the current scope, initialize it
// when an initializer is present, and leave an uninitialized binding to
// hold whatever the slot already holds, exactly as the C generator's plain
// declarations do; the control-flow statements lay out labels in a fixed
// shape; and everything outside the subset fails.
fn lower_stmt(Lowering lowering, Stmt statement) {
    if (failed(lowering)) {
        return;
    }
    match (statement) {
        Block(open_brace, statements, statement_count) {
            push_scope(lowering);
            int index = 0;
            while (index < statement_count) {
                lower_stmt(lowering, statements[index]);
                if (failed(lowering)) {
                    return;
                }
                index++;
            }
            pop_scope(lowering);
        }
        VarDecl(type_ref, name, initializer) {
            NativeType shape = type_ref_shape(lowering, type_ref);
            if (failed(lowering)) {
                return;
            }
            int binding = new_temporary(lowering.body, shape);
            declare(lowering, name.text, binding);
            match (initializer) {
                Present(expression) {
                    int value = lower_expression(lowering, expression);
                    if (failed(lowering)) {
                        return;
                    }
                    push_instruction(lowering.body, Instruction.Copy { target = binding, source = value });
                }
                Absent {
                }
            }
        }
        Expression(expression) {
            lower_expression(lowering, expression);
        }
        If(at, condition, then_branch, else_branch) {
            lower_if(lowering, condition, then_branch, else_branch);
        }
        While(at, condition, body) {
            int top = new_label(lowering);
            int body_label = new_label(lowering);
            int end = new_label(lowering);
            define_label(lowering, top);
            int condition_value = lower_expression(lowering, condition);
            if (failed(lowering)) {
                return;
            }
            push_instruction(lowering.body, Instruction.Branch { condition = condition_value, label_true = body_label, label_false = end });
            define_label(lowering, body_label);
            int previous_break = lowering.break_label;
            int previous_continue = lowering.continue_label;
            lowering.break_label = end;
            lowering.continue_label = top;
            lower_stmt(lowering, body);
            lowering.break_label = previous_break;
            lowering.continue_label = previous_continue;
            if (failed(lowering)) {
                return;
            }
            push_instruction(lowering.body, Instruction.Jump { label = top });
            define_label(lowering, end);
        }
        For(at, initializer, condition, increment, body) {
            push_scope(lowering);
            match (initializer) {
                Present(initial_statement) {
                    lower_stmt(lowering, initial_statement);
                }
                Absent {
                }
            }
            if (failed(lowering)) {
                return;
            }
            int top = new_label(lowering);
            int body_label = new_label(lowering);
            int continue_label = new_label(lowering);
            int end = new_label(lowering);
            define_label(lowering, top);
            match (condition) {
                Present(condition_expression) {
                    int condition_value = lower_expression(lowering, condition_expression);
                    if (failed(lowering)) {
                        return;
                    }
                    push_instruction(lowering.body, Instruction.Branch { condition = condition_value, label_true = body_label, label_false = end });
                }
                Absent {
                    push_instruction(lowering.body, Instruction.Jump { label = body_label });
                }
            }
            define_label(lowering, body_label);
            int previous_break = lowering.break_label;
            int previous_continue = lowering.continue_label;
            lowering.break_label = end;
            lowering.continue_label = continue_label;
            lower_stmt(lowering, body);
            lowering.break_label = previous_break;
            lowering.continue_label = previous_continue;
            if (failed(lowering)) {
                return;
            }
            define_label(lowering, continue_label);
            match (increment) {
                Present(increment_expression) {
                    lower_expression(lowering, increment_expression);
                    if (failed(lowering)) {
                        return;
                    }
                }
                Absent {
                }
            }
            push_instruction(lowering.body, Instruction.Jump { label = top });
            define_label(lowering, end);
            pop_scope(lowering);
        }
        Break(at) {
            if (lowering.break_label < 0) {
                fail_at(lowering, position_of_token(at), "break is only valid inside a loop");
                return;
            }
            push_instruction(lowering.body, Instruction.Jump { label = lowering.break_label });
        }
        Continue(at) {
            if (lowering.continue_label < 0) {
                fail_at(lowering, position_of_token(at), "continue is only valid inside a loop");
                return;
            }
            push_instruction(lowering.body, Instruction.Jump { label = lowering.continue_label });
        }
        Return(at, value) {
            match (value) {
                Present(expression) {
                    int result = lower_expression(lowering, expression);
                    if (failed(lowering)) {
                        return;
                    }
                    push_instruction(lowering.body, Instruction.Return { value = result });
                }
                Absent {
                    push_instruction(lowering.body, Instruction.ReturnVoid);
                }
            }
        }
        Match(at, scrutinee, arms, arm_count) {
            lower_match(lowering, at, scrutinee, arms, arm_count);
        }
    }
}

// lower_match lowers an exhaustive enum or union match. The scrutinee is
// evaluated once; a union is null-checked before its tag load. Each arm
// compares the tag, opens a scope for its bound fields, loads those fields at
// their flat offsets, lowers the body, and jumps to the shared end. The
// fall-through after the last arm is the defensive invalid-tag failure.
fn lower_match(Lowering lowering, Token at, Expr scrutinee, MatchArm[] arms, int arm_count) {
    Type subject = expr_type(lowering, scrutinee);
    bool is_union = false;
    match (subject.kind) {
        Enum { is_union = false; }
        Union { is_union = true; }
        Int { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Bool { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Float { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Byte { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        String { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Array { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Struct { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        Map { fail_at(lowering, position_of_token(at), "match requires an enum or union value"); return; }
        None { fail_at(lowering, position_of_token(at), "invalid values cannot be lowered"); return; }
        Void { fail_at(lowering, position_of_token(at), "void values cannot be lowered"); return; }
    }

    int value = lower_expression(lowering, scrutinee);
    if (failed(lowering)) {
        return;
    }
    int tag = value;
    int object = -1;
    if (is_union) {
        object = value;
        int address = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.Copy { target = address, source = object });
        int zero = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.ConstInt { target = zero, value = 0 });
        int is_null = new_temporary(lowering.body, NativeType.Bool);
        push_instruction(lowering.body, Instruction.Equal { target = is_null, left = address, right = zero });
        int null_label = new_label(lowering);
        int checked_label = new_label(lowering);
        push_instruction(lowering.body, Instruction.Branch { condition = is_null, label_true = null_label, label_false = checked_label });
        define_label(lowering, null_label);
        int null_blob = add_blob(lowering.scene, "match on a null union reference");
        int null_text = new_temporary(lowering.body, NativeType.Ref);
        push_instruction(lowering.body, Instruction.ConstRefData { target = null_text, blob = null_blob });
        int[] null_arguments = new int[1];
        null_arguments[0] = null_text;
        push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.fail_blob, arguments = null_arguments, argument_count = 1 });
        define_label(lowering, checked_label);
        int loaded_tag = new_temporary(lowering.body, NativeType.Int);
        push_instruction(lowering.body, Instruction.RawLoad64 { target = loaded_tag, address = object, offset = 8 });
        tag = loaded_tag;
    }

    int end_label = new_label(lowering);
    int case_tag = new_temporary(lowering.body, NativeType.Int);
    int matches = new_temporary(lowering.body, NativeType.Bool);
    int arm_index = 0;
    while (arm_index < arm_count) {
        MatchArm arm = arms[arm_index];
        if (!has(subject.variant_index, arm.variant.text)) {
            fail_at(lowering, position_of_token(arm.variant), "variant " + quoted(arm.variant.text) + " was not resolved");
            return;
        }
        Variant variant = subject.variant_index[arm.variant.text];
        int arm_label = new_label(lowering);
        int next_label = new_label(lowering);
        push_instruction(lowering.body, Instruction.ConstInt { target = case_tag, value = variant.index });
        push_instruction(lowering.body, Instruction.Equal { target = matches, left = tag, right = case_tag });
        push_instruction(lowering.body, Instruction.Branch { condition = matches, label_true = arm_label, label_false = next_label });
        define_label(lowering, arm_label);
        push_scope(lowering);

        int binding_index = 0;
        while (binding_index < arm.binding_count) {
            if (!is_union || binding_index >= variant.field_count) {
                fail_at(lowering, position_of_token(arm.variant), "match binding does not match the variant's fields");
                pop_scope(lowering);
                return;
            }
            StructField field = variant.fields[binding_index];
            int offset_value = union_field_offset(subject, variant.name, field.name);
            int offset = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.ConstInt { target = offset, value = offset_value });
            int address = new_temporary(lowering.body, NativeType.Int);
            push_instruction(lowering.body, Instruction.Add { target = address, left = object, right = offset });
            int loaded = load_value_at(lowering, field.type, address, position_of_token(arm.bindings[binding_index]));
            declare(lowering, arm.bindings[binding_index].text, loaded);
            binding_index++;
        }

        lower_stmt(lowering, arm.body);
        if (failed(lowering)) {
            pop_scope(lowering);
            return;
        }
        pop_scope(lowering);
        push_instruction(lowering.body, Instruction.Jump { label = end_label });
        define_label(lowering, next_label);
        arm_index++;
    }

    int invalid_blob = add_blob(lowering.scene, "match on an invalid variant tag");
    int invalid_text = new_temporary(lowering.body, NativeType.Ref);
    push_instruction(lowering.body, Instruction.ConstRefData { target = invalid_text, blob = invalid_blob });
    int[] invalid_arguments = new int[1];
    invalid_arguments[0] = invalid_text;
    push_instruction(lowering.body, Instruction.CallVoid { function = lowering.arrays.fail_blob, arguments = invalid_arguments, argument_count = 1 });
    define_label(lowering, end_label);
}

// lower_if lowers one if statement, with the else branch laid out between
// the then branch and the merge label. An else-if chain is one else branch
// holding an if statement, so the recursion handles it.
fn lower_if(Lowering lowering, Expr condition, Stmt then_branch, OptionalStmt else_branch) {
    int condition_value = lower_expression(lowering, condition);
    if (failed(lowering)) {
        return;
    }
    int then_label = new_label(lowering);
    int end_label = new_label(lowering);
    match (else_branch) {
        Present(else_statement) {
            int else_label = new_label(lowering);
            push_instruction(lowering.body, Instruction.Branch { condition = condition_value, label_true = then_label, label_false = else_label });
            define_label(lowering, then_label);
            lower_stmt(lowering, then_branch);
            if (failed(lowering)) {
                return;
            }
            push_instruction(lowering.body, Instruction.Jump { label = end_label });
            define_label(lowering, else_label);
            lower_stmt(lowering, else_statement);
            if (failed(lowering)) {
                return;
            }
        }
        Absent {
            push_instruction(lowering.body, Instruction.Branch { condition = condition_value, label_true = then_label, label_false = end_label });
            define_label(lowering, then_label);
            lower_stmt(lowering, then_branch);
            if (failed(lowering)) {
                return;
            }
        }
    }
    define_label(lowering, end_label);
}

// --- Program ---------------------------------------------------------------------

// body_print_needs reports which print argument kinds one statement subtree
// contains a call for that resolves to the print built-in. The walk reads
// the same annotations the lowering reads, so each helper is registered when
// and only when resolution will ask for it: a user function named print
// shadows the built-in, so such a program never registers a helper.
fn body_print_needs(Lowering lowering, Stmt statement) -> PrintNeeds {
    match (statement) {
        Block(open_brace, statements, statement_count) {
            PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
            int index = 0;
            while (index < statement_count) {
                needs = merge_print_needs(needs, body_print_needs(lowering, statements[index]));
                index++;
            }
            return needs;
        }
        VarDecl(type_ref, name, initializer) {
            match (initializer) {
                Present(expression) {
                    return expression_print_needs(lowering, expression);
                }
                Absent {
                    return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
                }
            }
        }
        Expression(expression) {
            return expression_print_needs(lowering, expression);
        }
        If(at, condition, then_branch, else_branch) {
            PrintNeeds needs = merge_print_needs(expression_print_needs(lowering, condition), body_print_needs(lowering, then_branch));
            match (else_branch) {
                Present(statement) {
                    return merge_print_needs(needs, body_print_needs(lowering, statement));
                }
                Absent {
                    return needs;
                }
            }
        }
        While(at, condition, body) {
            return merge_print_needs(expression_print_needs(lowering, condition), body_print_needs(lowering, body));
        }
        For(at, initializer, condition, increment, body) {
            PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
            match (initializer) {
                Present(initial_statement) {
                    needs = merge_print_needs(needs, body_print_needs(lowering, initial_statement));
                }
                Absent {
                }
            }
            match (condition) {
                Present(condition_expression) {
                    needs = merge_print_needs(needs, expression_print_needs(lowering, condition_expression));
                }
                Absent {
                }
            }
            match (increment) {
                Present(increment_expression) {
                    needs = merge_print_needs(needs, expression_print_needs(lowering, increment_expression));
                }
                Absent {
                }
            }
            return merge_print_needs(needs, body_print_needs(lowering, body));
        }
        Break(at) {
            return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
        }
        Continue(at) {
            return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
        }
        Return(at, value) {
            match (value) {
                Present(expression) {
                    return expression_print_needs(lowering, expression);
                }
                Absent {
                    return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
                }
            }
        }
        Match(at, scrutinee, arms, arm_count) {
            PrintNeeds needs = expression_print_needs(lowering, scrutinee);
            int arm = 0;
            while (arm < arm_count) {
                needs = merge_print_needs(needs, body_print_needs(lowering, arms[arm].body));
                arm++;
            }
            return needs;
        }
    }
}

// expression_print_needs is the expression half of the prescan. Only a call
// whose callee resolved to the print built-in adds its argument's kind;
// everything else walks its own arguments.
fn expression_print_needs(Lowering lowering, Expr expression) -> PrintNeeds {
    match (expression) {
        Integer(node_id, token) { return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false }; }
        Float(node_id, token) { return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false }; }
        String(node_id, token) { return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false }; }
        Boolean(node_id, token, value) { return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false }; }
        Identifier(node_id, token) { return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false }; }
        Unary(node_id, operator, operand, postfix) {
            return expression_print_needs(lowering, operand);
        }
        Binary(node_id, operator, left, right) {
            return merge_print_needs(expression_print_needs(lowering, left), expression_print_needs(lowering, right));
        }
        Assign(node_id, operator, target, value) {
            return merge_print_needs(expression_print_needs(lowering, target), expression_print_needs(lowering, value));
        }
        Call(node_id, open_paren, callee, arguments, argument_count) {
            PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
            match (callee) {
                Identifier(callee_id, name) {
                    ExprInfo info = expression_info(lowering.module, callee_id);
                    match (info.symbol) {
                        Present(symbol) {
                            match (symbol.function) {
                                Present(function) {
                                    if (function.builtin == BuiltinKind.Print) {
                                        int printed = 0;
                                        while (printed < argument_count) {
                                            needs = merge_print_needs(needs, print_needs_of_kind(type_name_expr_kind(expr_type(lowering, arguments[printed]))));
                                            printed++;
                                        }
                                    }
                                    if (function.builtin == BuiltinKind.Argv) {
                                        lowering.argv_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryCurrentDirectory) {
                                        lowering.current_directory_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryReadFile) {
                                        lowering.read_file_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.ReadFile) {
                                        lowering.read_file_fatal_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryWriteFile || function.builtin == BuiltinKind.TryWriteBytes) {
                                        lowering.write_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryGetenv) {
                                        lowering.getenv_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryCreateDirectory) {
                                        lowering.create_directory_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryRemove) {
                                        lowering.remove_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryFileInfo) {
                                        lowering.file_info_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryListDirectory) {
                                        lowering.list_directory_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryCreateTempDirectory) {
                                        lowering.temp_directory_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryRun) {
                                        lowering.run_needed = true;
                                    }
                                    if (function.builtin == BuiltinKind.TryRunCapture) {
                                        lowering.capture_needed = true;
                                    }
                                }
                                Absent {
                                }
                            }
                        }
                        Absent {
                        }
                    }
                }
                Integer(callee_id, callee_token) { }
                Float(callee_id, callee_token) { }
                String(callee_id, callee_token) { }
                Boolean(callee_id, callee_token, callee_value) { }
                Unary(callee_id, callee_operator, callee_operand, callee_postfix) { }
                Binary(callee_id, callee_operator, callee_left, callee_right) { }
                Assign(callee_id, callee_operator, callee_target, callee_value) { }
                Call(callee_id, inner_open_paren, inner_callee, inner_arguments, inner_argument_count) { }
                Member(callee_id, callee_dot, callee_receiver, callee_member) { }
                StructLiteral(callee_id, callee_type, callee_brace, callee_fields, callee_field_count) { }
                VariantLiteral(callee_id, callee_type, callee_variant, callee_brace, callee_fields, callee_field_count) { }
                NewArray(callee_id, callee_at, callee_element, callee_length) { }
                NewMap(callee_id, callee_at, callee_type) { }
                Index(callee_id, callee_bracket, callee_target, callee_index) { }
            }
            int index = 0;
            while (index < argument_count) {
                needs = merge_print_needs(needs, expression_print_needs(lowering, arguments[index]));
                index++;
            }
            return needs;
        }
        Member(node_id, dot, receiver, member) {
            return expression_print_needs(lowering, receiver);
        }
        StructLiteral(node_id, type_ref, open_brace, fields, field_count) {
            PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
            int index = 0;
            while (index < field_count) {
                needs = merge_print_needs(needs, expression_print_needs(lowering, fields[index].value));
                index++;
            }
            return needs;
        }
        VariantLiteral(node_id, type_ref, variant, open_brace, fields, field_count) {
            PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
            int index = 0;
            while (index < field_count) {
                needs = merge_print_needs(needs, expression_print_needs(lowering, fields[index].value));
                index++;
            }
            return needs;
        }
        NewArray(node_id, at, element, length) {
            return expression_print_needs(lowering, length);
        }
        NewMap(node_id, at, map_type) {
            lowering.maps_needed = true;
            return PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
        }
        Index(node_id, bracket, target, index) {
            return merge_print_needs(expression_print_needs(lowering, target), expression_print_needs(lowering, index));
        }
    }
}

// register_shells walks every module's declarations in order, maps each
// function's parameter and return types onto the scene's shapes, appends one
// empty function per declaration under its module-qualified scene name,
// records the table, and applies the entry-rule checks to the root module's
// main. Imports and struct declarations need no code.
fn register_shells(Lowering lowering) {
    int module_index = 0;
    while (module_index < lowering.model.module_count) {
    lowering.module = module_model(lowering.model, module_index);
    lowering.path = lowering.module.path;
    Program program = lowering.module.program;
    int index = 0;
    while (index < program.declaration_count) {
        Decl declaration = program.declarations[index];
        match (declaration) {
            Import(keyword, path) {
                // The loader already resolved the module; an import needs no
                // scene code of its own.
            }
            Function(at, visibility, name, parameters, parameter_count, return_type, body) {
                OptionalFunction resolved = declaration_function(lowering.module, name.text);
                match (resolved) {
                    Present(function) {
                        NativeType[] shapes = new NativeType[parameter_count];
                        int parameter = 0;
                        while (parameter < parameter_count) {
                            shapes[parameter] = type_ref_shape(lowering, parameters[parameter].type);
                            if (failed(lowering)) {
                                return;
                            }
                            parameter++;
                        }
                        NativeType result = NativeType.Void;
                        match (return_type) {
                            Present(reference) {
                                result = type_ref_shape(lowering, reference);
                                if (failed(lowering)) {
                                    return;
                                }
                            }
                            Absent {
                            }
                        }
                        int scene_index = add_function(lowering.scene, module_function_name(lowering.module.id, name.text), result, shapes, parameter_count);
                        declare_function(lowering, module_function_name(lowering.module.id, name.text), scene_index);
                        if (lowering.module.id == 0 && name.text == "main") {
                            lowering.main_index = scene_index;
                            if (parameter_count != 0) {
                                fail_at(lowering, position_of_token(at), "main must take no parameters");
                                return;
                            }
                            if (!is_void(function.return_type)) {
                                fail_at(lowering, position_of_token(at), "main must not return a value");
                                return;
                            }
                        }
                    }
                    Absent {
                        fail_at(lowering, position_of_token(at), "function " + quoted(name.text) + " is not resolved");
                        return;
                    }
                }
            }
            Struct(at, visibility, name, fields, field_count) {
                // A struct declaration needs no scene code: its layout is
                // derived from the resolved field types at each literal and
                // member access.
            }
            Enum(at, visibility, name, cases, case_count) {
                // An enum declaration needs no scene code: its cases are
                // eight-byte tags in int slots, resolved at each case
                // reference.
            }
            Union(at, visibility, name, variants, variant_count) {
                // A union declaration needs no scene code: its flat layout
                // is derived from the resolved variants at each construction
                // and match.
            }
        }
        index++;
    }
    module_index++;
    }
}

// module_function_name mangles a module's function name for the scene. The
// root module keeps its bare name, so single-module scenes and pins are
// unchanged; imported modules take an "m<id>_" prefix.
fn module_function_name(int module, string name) -> string {
    if (module == 0) {
        return name;
    }
    return "m" + lower_decimal(module) + "_" + name;
}

// declare_function records one scene function index under its source name.
// Duplicate names are impossible: the checker rejected them.
fn declare_function(Lowering lowering, string name, int scene_index) {
    lowering.functions[name] = scene_index;
}

// lower_bodies lowers every function body in declaration order into its
// registered shell: the parameters land in the body's outermost scope
// first, the walk creates bindings in order, and the selector's defensive
// epilogue covers any function whose statements do not end in a return.
fn lower_bodies(Lowering lowering) {
    int module_index = 0;
    while (module_index < lowering.model.module_count) {
    lowering.module = module_model(lowering.model, module_index);
    lowering.path = lowering.module.path;
    Program program = lowering.module.program;
    int index = 0;
    while (index < program.declaration_count) {
        Decl declaration = program.declarations[index];
        match (declaration) {
            Function(at, visibility, name, parameters, parameter_count, return_type, body) {
                NativeFunction handle = function_at(lowering.scene, lowering.functions[module_function_name(lowering.module.id, name.text)]);
                lowering.body = handle;
                lowering.label_next = 0;
                lowering.scope_count = 0;
                push_scope(lowering);
                int parameter = 0;
                while (parameter < parameter_count) {
                    declare(lowering, parameters[parameter].name.text, parameter);
                    parameter++;
                }
                lower_stmt(lowering, body);
                if (failed(lowering)) {
                    return;
                }
            }
            Import(keyword, path) { }
            Struct(at, visibility, name, fields, field_count) { }
            Enum(at, visibility, name, cases, case_count) { }
            Union(at, visibility, name, variants, variant_count) { }
        }
        index++;
    }
    module_index++;
    }
}

// lower_program lowers a successfully checked whole model into one scene:
// it registers every module's function shells, registers the runtime shells
// — the allocator, arrays, and one print helper per argument kind the
// prescan found — lowers every module's bodies against that module's
// annotations, and sets the entry to the root main. Any unsupported
// construct fails the whole run with one deterministic message; nothing is
// returned partially.
public fn lower_program(SemanticModel model) -> LowerResult {
    Lowering lowering = new_lowering(model);
    register_shells(lowering);
    if (failed(lowering)) {
        return LowerResult.Failed { message = lowering.failure };
    }
    if (lowering.main_index < 0) {
        ModuleModel root = module_model(model, 0);
        return LowerResult.Failed { message = root.path + ":1:1: program has no entry point: define fn main() in the root module" };
    }

    PrintNeeds needs = PrintNeeds { string_kind = false, int_kind = false, bool_kind = false, float_kind = false };
    int module_index = 0;
    while (module_index < model.module_count) {
        lowering.module = module_model(model, module_index);
        lowering.path = lowering.module.path;
        Program program = lowering.module.program;
        int index = 0;
        while (index < program.declaration_count) {
            Decl declaration = program.declarations[index];
            match (declaration) {
                Function(at, visibility, name, parameters, parameter_count, return_type, body) {
                    needs = merge_print_needs(needs, body_print_needs(lowering, body));
                }
                Import(keyword, path) { }
                Struct(at, visibility, name, fields, field_count) { }
                Enum(at, visibility, name, cases, case_count) { }
                Union(at, visibility, name, variants, variant_count) { }
            }
            index++;
        }
        module_index++;
    }
    if (lowering.temp_directory_needed) {
        // The temp-directory shell reads $TMPDIR through the getenv shell and
        // resolves a relative base through the current-directory shell.
        lowering.getenv_needed = true;
        lowering.current_directory_needed = true;
    }
    if ((lowering.run_needed || lowering.capture_needed) && lowering.env_blob < 0) {
        // try_run and try_run_capture pass the inherited environment to
        // execve.
        lowering.env_blob = add_blob(lowering.scene, "        ");
        lowering.scene.env_blob = lowering.env_blob;
    }
    int stack_top_blob = add_blob(lowering.scene, "        ");
    lowering.scene.stack_top_blob = stack_top_blob;
    lowering.allocator = add_allocator(lowering.scene, stack_top_blob);
    lowering.strings = add_strings(lowering.scene, lowering.allocator.alloc);
    lowering.arrays = add_arrays(lowering.scene, lowering.allocator.alloc, lowering.strings.copy);
    int c_strlen = -1;
    if (lowering.argv_needed || lowering.current_directory_needed || lowering.getenv_needed || lowering.list_directory_needed) {
        c_strlen = add_c_strlen_shell(lowering.scene);
    }
    if (lowering.argv_needed) {
        lowering.args_blob = add_blob(lowering.scene, "                ");
        lowering.argv = add_argv_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, lowering.arrays.new_array, c_strlen, lowering.args_blob);
        lowering.scene.args_blob = lowering.args_blob;
    }
    if (lowering.current_directory_needed) {
        lowering.current_directory = add_current_directory_shell(lowering.scene, lowering.allocator.alloc, c_strlen, lowering.strings.copy, lowering.strings.concat);
    }
    if (lowering.getenv_needed) {
        lowering.env_blob = add_blob(lowering.scene, "        ");
        lowering.scene.env_blob = lowering.env_blob;
        lowering.getenv = add_try_getenv_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, c_strlen, lowering.env_blob);
    }
    if (lowering.create_directory_needed || lowering.remove_needed || lowering.file_info_needed || lowering.list_directory_needed || lowering.temp_directory_needed || lowering.run_needed || lowering.capture_needed || lowering.read_file_fatal_needed) {
        lowering.errno_reason = add_errno_reason_shell(lowering.scene);
        lowering.c_path = add_c_path_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy);
        lowering.file_failed = add_file_failed_shell(lowering.scene, lowering.allocator.alloc);
        lowering.file_ok = add_file_ok_shell(lowering.scene, lowering.allocator.alloc);
        if (lowering.create_directory_needed) {
            lowering.create_directory = add_try_create_directory_shell(lowering.scene, lowering.c_path, lowering.errno_reason, lowering.strings.concat, lowering.file_failed, lowering.file_ok);
        }
        if (lowering.remove_needed) {
            lowering.remove = add_try_remove_shell(lowering.scene, lowering.allocator.alloc, lowering.c_path, lowering.errno_reason, lowering.strings.concat, lowering.file_failed, lowering.file_ok);
        }
        if (lowering.file_info_needed) {
            int bool_int = add_bool_int_shell(lowering.scene);
            lowering.file_info = add_try_file_info_shell(lowering.scene, lowering.allocator.alloc, lowering.c_path, lowering.errno_reason, lowering.strings.concat, bool_int);
        }
        if (lowering.list_directory_needed) {
            lowering.is_dot_entry = add_is_dot_entry_shell(lowering.scene);
            lowering.string_greater = add_string_greater_shell(lowering.scene);
            lowering.list_directory = add_try_list_directory_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, c_strlen, lowering.c_path, lowering.errno_reason, lowering.strings.concat, lowering.arrays.new_array, lowering.is_dot_entry, lowering.string_greater);
        }
        if (lowering.run_needed) {
            lowering.run = add_try_run_shell(lowering.scene, lowering.allocator.alloc, lowering.c_path, lowering.errno_reason, lowering.strings.concat, lowering.env_blob);
        }
        if (lowering.capture_needed) {
            int build_argv = add_build_argv_shell(lowering.scene, lowering.allocator.alloc, lowering.c_path);
            int read_stream = add_read_stream_shell(lowering.scene, lowering.strings.copy);
            int run_failure = add_run_failure_shell(lowering.scene, lowering.errno_reason, lowering.strings.concat);
            int decimal_string = add_decimal_string_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy);
            int first_nul = add_first_nul_shell(lowering.scene);
            lowering.capture = add_try_run_capture_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, lowering.c_path, lowering.strings.concat, lowering.env_blob, build_argv, read_stream, run_failure, decimal_string, first_nul);
        }
        if (lowering.temp_directory_needed) {
            lowering.valid_temp_prefix = add_valid_temp_prefix_shell(lowering.scene);
            lowering.temp_failed = add_temp_failed_shell(lowering.scene, lowering.allocator.alloc);
            lowering.string_join_path = add_string_join_path_shell(lowering.scene, lowering.strings.concat);
            lowering.temp_directory = add_try_create_temp_directory_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, lowering.c_path, lowering.errno_reason, lowering.strings.concat, lowering.getenv, lowering.current_directory, lowering.string_join_path, lowering.valid_temp_prefix, lowering.temp_failed);
        }
    }
    if (lowering.read_file_needed || lowering.write_needed || lowering.read_file_fatal_needed) {
        int errno_reason = add_errno_reason_shell(lowering.scene);
        if (lowering.read_file_needed) {
            lowering.read_file = add_try_read_file_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, lowering.strings.concat, errno_reason);
        }
        if (lowering.read_file_fatal_needed) {
            int fatal_reason = add_errno_reason_libc_shell(lowering.scene);
            lowering.read_file_fatal = add_read_file_shell(lowering.scene, lowering.allocator.alloc, lowering.c_path, fatal_reason, lowering.strings.concat, lowering.arrays.fail_blob);
        }
        if (lowering.write_needed) {
            lowering.write_common = add_try_write_common_shell(lowering.scene, lowering.allocator.alloc, lowering.strings.copy, lowering.strings.concat, errno_reason);
            lowering.write_file = add_try_write_file_shell(lowering.scene, lowering.write_common);
            lowering.write_bytes = add_try_write_bytes_shell(lowering.scene, lowering.write_common, lowering.arrays.fail_blob);
        }
    }
    if (lowering.maps_needed) {
        lowering.maps = add_maps(lowering.scene, lowering.allocator.alloc, lowering.strings.equal, lowering.strings.copy, lowering.arrays.zero_bytes, lowering.arrays.fail_blob, lowering.arrays.write_blob_fd);
    }
    bool needs_print = needs.string_kind || needs.int_kind || needs.bool_kind || needs.float_kind;
    if (needs_print) {
        lowering.print_newline = add_blob(lowering.scene, "\n");
        lowering.print_space = add_blob(lowering.scene, " ");
        lowering.string_print_raw = add_string_print_raw(lowering.scene);
    }
    if (needs.string_kind || needs.bool_kind) {
        lowering.string_print = add_string_print(lowering.scene, lowering.print_newline);
    }
    if (needs.bool_kind) {
        lowering.bool_print_raw = add_bool_print_raw(lowering.scene, lowering.string_print_raw);
        lowering.bool_print = add_bool_print(lowering.scene, lowering.string_print);
    }
    if (needs_print) {
        lowering.print_tail = add_print_newline(lowering.scene, lowering.print_newline);
    }
    if (needs.int_kind) {
        IntPrintShell int_shell = add_int_print(lowering.scene, lowering.print_tail);
        lowering.int_print = int_shell.print_int;
        lowering.int_print_raw = int_shell.print_int_raw;
    }
    if (needs.float_kind) {
        FloatPrintShell float_shell = add_float_print(lowering.scene, lowering.allocator.alloc, lowering.print_tail);
        lowering.float_print = float_shell.print_float;
        lowering.float_print_raw = float_shell.print_float_raw;
    }

    lower_bodies(lowering);
    if (failed(lowering)) {
        return LowerResult.Failed { message = lowering.failure };
    }

    lowering.scene.entry = lowering.main_index;
    return LowerResult.Ok { scene = lowering.scene };
}
