    push_instruction(h, Instruction.ConstInt { target = fifty_two, value = 4503599627370496 });
    int mant = new_temporary(h, NativeType.Int);
    int[] mant_args = new int[1];
    mant_args[0] = 0;
    push_instruction(h, Instruction.Call { target = mant, function = float_mantissa, arguments = mant_args, argument_count = 1 });
    int sub = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = sub, left = mant, right = fifty_two });
    int est = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Branch { condition = sub, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.ConstInt { target = est, value = -315 });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    int e = new_temporary(h, NativeType.Int);
    int[] e_args = new int[1];
    e_args[0] = 0;
    push_instruction(h, Instruction.Call { target = e, function = float_e, arguments = e_args, argument_count = 1 });
    int log_mul = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 30103 });
    int log_share = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = log_share, left = e, right = log_mul });
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 1580000 });
    push_instruction(h, Instruction.Add { target = log_share, left = log_share, right = log_mul });
    push_instruction(h, Instruction.ConstInt { target = log_mul, value = 100000 });
    push_instruction(h, Instruction.WholeDivide { target = est, left = log_share, right = log_mul });
    push_instruction(h, Instruction.Add { target = est, left = est, right = one_c });
    push_instruction(h, Instruction.Add { target = est, left = est, right = one_c });
    push_instruction(h, Instruction.Label { label = 2 });
    int k = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = k, source = est });
    int[] probe_args = new int[3];
    probe_args[0] = 1;
    probe_args[1] = 2;
    probe_args[2] = k;
    int hit = new_temporary(h, NativeType.Int);
    // Bidirectional walk: probe is monotonic (1 for k <= X). If probe(k)
    // hits, walk up while probe(k+1) hits; if it misses, walk down until
    // probe(k) hits. Returns X.
    push_instruction(h, Instruction.Label { label = 3 });
