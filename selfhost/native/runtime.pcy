public fn heap_base_offset() -> int {
    return 24;
}

public fn heap_cursor_offset() -> int {
    return 32;
}

public fn heap_limit_offset() -> int {
    return 40;
}

public fn heap_free_offset() -> int {
    return 48;
}

public fn heap_last_offset() -> int {
    return 56;
}

public fn heap_last_end_offset() -> int {
    return 64;
}

public fn ledger_array_offset() -> int {
    return 24;
}

public fn ledger_stack_offset() -> int {
    return 32;
}

// heap_size is the one heap mmap: 256 MiB, the proposal Section 7.1's
// first-shippable heap target. The kernel maps pages lazily, so an unused
// program pays only the virtual reservation.
public fn heap_size() -> int {
    return 536870912;
}

// ledger_size is the ledger's byte count: one byte per 8-byte heap word,
// plus an eight-byte overhang, so a stale value equal to the limit still
// indexes a real byte when the scan offers it.
public fn ledger_size() -> int {
    return 67108872;
}

// ones_bytes builds the all-ones payload the scene blobs start with: the
// language cannot write a NUL byte (bytes_to_string rejects it), and every
// word of these tables reads as the negative -1 before its first write,
// the one value that means "absent" for cursors, links, and the captured
// stack.
fn ones_bytes(int count) -> string {
    byte[] data = new byte[count];
    int index = 0;
    while (index < count) {
        data[index] = byte_from_int(255);
        index++;
    }
    return bytes_to_string(data);
}

// AllocShell carries the collector's scene indices: the `$heap` blob index
// and the `$map`, `$alloc`, and `$collect` function indexes, plus the
// mark-pass pieces the probe's white-box graph scene uses.
public struct AllocShell {
    int alloc;
    int map_shell;
    int collect;
    int mark_at;
    int scan_heap;
    int ledger_at;
    int heap_blob;
}

// StringShell carries the string runtime's function indexes.
public struct StringShell {
    int length;
    int equal;
    int concat;
    int copy;
}

// one_ref_parameter returns a shape list holding exactly one reference.
fn one_ref_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Ref;
    return shapes;
}

// one_int_parameter returns a shape list holding exactly one int.
fn one_int_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Int;
    return shapes;
}

// one_bool_parameter returns a shape list holding exactly one bool.
fn one_bool_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Bool;
    return shapes;
}

// two_ref_parameters returns a shape list holding exactly two references.
fn two_ref_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[2];
    shapes[0] = NativeType.Ref;
    shapes[1] = NativeType.Ref;
    return shapes;
}

// two_int_parameters returns a shape list holding exactly two ints.
fn two_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[2];
    shapes[0] = NativeType.Int;
    shapes[1] = NativeType.Int;
    return shapes;
}

// int_ref_parameters returns a shape list holding an int then a reference.
fn int_ref_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[2];
    shapes[0] = NativeType.Int;
    shapes[1] = NativeType.Ref;
    return shapes;
}

// ref_int_parameters returns a shape list holding a reference then an int.
fn ref_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[2];
    shapes[0] = NativeType.Ref;
    shapes[1] = NativeType.Int;
    return shapes;
}

// ref_int_int_parameters returns a reference followed by two ints.
fn ref_int_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[3];
    shapes[0] = NativeType.Ref;
    shapes[1] = NativeType.Int;
    shapes[2] = NativeType.Int;
    return shapes;
}

// ref_ref_int_parameters returns two references followed by an int.
fn ref_ref_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[3];
    shapes[0] = NativeType.Ref;
    shapes[1] = NativeType.Ref;
    shapes[2] = NativeType.Int;
    return shapes;
}

// three_int_parameters returns a shape list holding exactly three ints.
fn three_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[3];
    shapes[0] = NativeType.Int;
    shapes[1] = NativeType.Int;
    shapes[2] = NativeType.Int;
    return shapes;
}

// one_float_parameter returns a shape list holding exactly one float.
fn one_float_parameter() -> NativeType[] {
    NativeType[] shapes = new NativeType[1];
    shapes[0] = NativeType.Float;
    return shapes;
}

// float_int_int_parameters returns a shape list holding a float then two
// ints, the "$float_px" signature.
fn float_int_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[3];
    shapes[0] = NativeType.Float;
    shapes[1] = NativeType.Int;
    shapes[2] = NativeType.Int;
    return shapes;
}

// --- The collector ----------------------------------------------------------

// add_allocator registers the collector into a scene: the `$heap` blob, the
// `$gc` ledger blob, then the shells in dependency order with their bodies.
// It returns every index the lowering and the probe need.
public fn add_allocator(NativeScene scene, int stack_top_blob) -> AllocShell {
    AllocShell shell = AllocShell { alloc = 0, map_shell = 0, collect = 0, mark_at = 0, scan_heap = 0, ledger_at = 0, heap_blob = 0 };

    int heap_blob = add_blob(scene, ones_bytes(48));
    int gc_blob = add_blob(scene, ones_bytes(16));
    int mmap = add_mmap_shell(scene);
    int map_shell = add_map_shell(scene, heap_blob, gc_blob, mmap, stack_top_blob);
    int pad8 = add_pad8_shell(scene);
    int set_one = add_byte_set_shell(scene, heap_blob, gc_blob, 1);
    int set_zero = add_byte_set_shell(scene, heap_blob, gc_blob, 0);
    int search = add_search_shell(scene, heap_blob, set_one);
    int bump = add_bump_shell(scene, heap_blob, set_one);
    int marker = add_mark_at_shell(scene, heap_blob, gc_blob);
    int ledger_at = add_ledger_at_shell(scene, heap_blob, gc_blob);
    int scan_roots = add_scan_roots_shell(scene, gc_blob, marker);
    int scan_heap = add_scan_heap_shell(scene, heap_blob, gc_blob, marker);
    int free_block = add_free_block_shell(scene, heap_blob, set_zero);
    int sweep_block = add_sweep_block_shell(scene, heap_blob, gc_blob, free_block);
    int sweep = add_sweep_shell(scene, heap_blob, sweep_block);
    int collect = add_collect_shell(scene, scan_roots, scan_heap, sweep);
    int alloc = add_alloc_shell(scene, heap_blob, map_shell, pad8, search, bump, collect);

    shell.alloc = alloc;
    shell.map_shell = map_shell;
    shell.collect = collect;
    shell.mark_at = marker;
    shell.scan_heap = scan_heap;
    shell.ledger_at = ledger_at;
    shell.heap_blob = heap_blob;
    return shell;
}

// add_mmap_shell registers "$mmap": one anonymous mmap of the request, with
// a failed mapping reaching FailOOM. Locals: 6.
fn add_mmap_shell(NativeScene scene) -> int {
    int mmap = add_function(scene, "$mmap", NativeType.Int, one_int_parameter(), 1);
    NativeFunction mmap_function = function_at(scene, mmap);

    int zero = new_temporary(mmap_function, NativeType.Int);
    push_instruction(mmap_function, Instruction.ConstInt { target = zero, value = 0 });
    int prot = new_temporary(mmap_function, NativeType.Int);
    push_instruction(mmap_function, Instruction.ConstInt { target = prot, value = 3 });
    int flags = new_temporary(mmap_function, NativeType.Int);
    push_instruction(mmap_function, Instruction.ConstInt { target = flags, value = 34 });
    int number = new_temporary(mmap_function, NativeType.Int);
    push_instruction(mmap_function, Instruction.ConstInt { target = number, value = 9 });
    int mapping = new_temporary(mmap_function, NativeType.Int);
    int[] arguments = new int[4];
    arguments[0] = zero;
    arguments[1] = 0;
    arguments[2] = prot;
    arguments[3] = flags;
    push_instruction(mmap_function, Instruction.RawSyscall { target = mapping, number = number, arguments = arguments, argument_count = 4 });
    int failed = new_temporary(mmap_function, NativeType.Bool);
    push_instruction(mmap_function, Instruction.LessThan { target = failed, left = mapping, right = zero });
    push_instruction(mmap_function, Instruction.Branch { condition = failed, label_true = 0, label_false = 1 });
    push_instruction(mmap_function, Instruction.Label { label = 0 });
    push_instruction(mmap_function, Instruction.FailOOM);
    push_instruction(mmap_function, Instruction.Label { label = 1 });
    push_instruction(mmap_function, Instruction.Return { value = mapping });
    return mmap;
}

// add_map_shell registers "$map": two mmaps (the heap and its ledger) and
// the one stack-pointer capture the conservative scan uses. The six `$heap`
// words take their working values; the three free-list/last words take -1.
// Locals: 7.
fn add_map_shell(NativeScene scene, int heap_blob, int gc_blob, int mmap, int stack_top_blob) -> int {
    int map_shell = add_function(scene, "$map", NativeType.Void, new NativeType[0], 0);
    NativeFunction map_function = function_at(scene, map_shell);

    int size = new_temporary(map_function, NativeType.Int);
    push_instruction(map_function, Instruction.ConstInt { target = size, value = heap_size() });
    int ledger = new_temporary(map_function, NativeType.Int);
    push_instruction(map_function, Instruction.ConstInt { target = ledger, value = ledger_size() });
    int heap = new_temporary(map_function, NativeType.Int);
    int[] heap_arguments = new int[1];
    heap_arguments[0] = size;
    push_instruction(map_function, Instruction.Call { target = heap, function = mmap, arguments = heap_arguments, argument_count = 1 });
    int array = new_temporary(map_function, NativeType.Int);
    int[] array_arguments = new int[1];
    array_arguments[0] = ledger;
    push_instruction(map_function, Instruction.Call { target = array, function = mmap, arguments = array_arguments, argument_count = 1 });
    int rsp = new_temporary(map_function, NativeType.Int);
    if (stack_top_blob >= 0) {
        push_instruction(map_function, Instruction.GetStatic { target = rsp, blob = stack_top_blob, offset = 24 });
    } else {
        push_instruction(map_function, Instruction.StackPointer { target = rsp });
    }
    int minus_one = new_temporary(map_function, NativeType.Int);
    push_instruction(map_function, Instruction.ConstInt { target = minus_one, value = -1 });
    int limit = new_temporary(map_function, NativeType.Int);
    push_instruction(map_function, Instruction.Add { target = limit, left = heap, right = size });

    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_base_offset(), value = heap });
    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_cursor_offset(), value = heap });
    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_limit_offset(), value = limit });
    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_free_offset(), value = minus_one });
    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_offset(), value = minus_one });
    push_instruction(map_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_end_offset(), value = minus_one });
    push_instruction(map_function, Instruction.SetStatic { blob = gc_blob, offset = ledger_array_offset(), value = array });
    push_instruction(map_function, Instruction.SetStatic { blob = gc_blob, offset = ledger_stack_offset(), value = rsp });
    push_instruction(map_function, Instruction.ReturnVoid);
    return map_shell;
}

// add_pad8_shell registers "$pad8": the whole block size is the request plus
// the 8-byte header, rounded up to eight, with a 16-byte minimum, so a block
// always fits its header and a free-list link. Locals: 7.
fn add_pad8_shell(NativeScene scene) -> int {
    int pad8 = add_function(scene, "$pad8", NativeType.Int, one_int_parameter(), 1);
    NativeFunction pad_function = function_at(scene, pad8);

    int fifteen = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.ConstInt { target = fifteen, value = 15 });
    int eight = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.ConstInt { target = sixteen, value = 16 });
    int padded = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.Add { target = padded, left = 0, right = fifteen });
    int divided = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.WholeDivide { target = divided, left = padded, right = eight });
    int rounded = new_temporary(pad_function, NativeType.Int);
    push_instruction(pad_function, Instruction.Multiply { target = rounded, left = divided, right = eight });
    int small = new_temporary(pad_function, NativeType.Bool);
    push_instruction(pad_function, Instruction.LessThan { target = small, left = rounded, right = sixteen });
    push_instruction(pad_function, Instruction.Branch { condition = small, label_true = 0, label_false = 1 });
    push_instruction(pad_function, Instruction.Label { label = 0 });
    push_instruction(pad_function, Instruction.Copy { target = rounded, source = sixteen });
    push_instruction(pad_function, Instruction.Label { label = 1 });
    push_instruction(pad_function, Instruction.Return { value = rounded });
    return pad8;
}

// add_byte_set_shell registers "$byte_set1"/"$byte_set0": the ledger byte
// at the given block's word takes the fixed digit (1 certifies a block
// header, 0 releases it). Every ledger write outside the sweep goes through
// one of these shells, so a stale value can never steer a write into
// payload data. Locals: 7.
fn add_byte_set_shell(NativeScene scene, int heap_blob, int gc_blob, int digit) -> int {
    string name = "$byte_set1";
    if (digit == 0) {
        name = "$byte_set0";
    }
    int setter = add_function(scene, name, NativeType.Void, one_int_parameter(), 1);
    NativeFunction setter_function = function_at(scene, setter);

    int base = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int rel = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.Subtract { target = rel, left = 0, right = base });
    int eight = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.ConstInt { target = eight, value = 8 });
    int idx = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.WholeDivide { target = idx, left = rel, right = eight });
    int array = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.GetStatic { target = array, blob = gc_blob, offset = ledger_array_offset() });
    int addr = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.Add { target = addr, left = array, right = idx });
    int value = new_temporary(setter_function, NativeType.Int);
    push_instruction(setter_function, Instruction.ConstInt { target = value, value = digit });
    push_instruction(setter_function, Instruction.RawStore8 { address = addr, offset = 0, value = value });
    push_instruction(setter_function, Instruction.ReturnVoid);
    return setter;
}

// add_search_shell registers "$search": first fit through the free list.
// The found block is unlinked (the head word or the predecessor's link),
// its tail splits off and relinks at the list head when the remainder
// still fits a block, its header re-stamps to the taken size, and its
// ledger byte gets certified 1. Locals: 14 (at the frame cap).
fn add_search_shell(NativeScene scene, int heap_blob, int set_one) -> int {
    int search = add_function(scene, "$search", NativeType.Int, one_int_parameter(), 1);
    NativeFunction search_function = function_at(scene, search);

    int zero = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.ConstInt { target = zero, value = 0 });
    int free = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.GetStatic { target = free, blob = heap_blob, offset = heap_free_offset() });
    int prev = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.Copy { target = prev, source = zero });
    int cur = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.Copy { target = cur, source = free });
    int sixteen = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.ConstInt { target = sixteen, value = 16 });

    // Walk: while cur >= 0 — the list's -1 sentinel ends it.
    push_instruction(search_function, Instruction.Label { label = 0 });
    int end = new_temporary(search_function, NativeType.Bool);
    push_instruction(search_function, Instruction.LessThan { target = end, left = cur, right = zero });
    push_instruction(search_function, Instruction.Branch { condition = end, label_true = 9, label_false = 1 });
    push_instruction(search_function, Instruction.Label { label = 1 });
    int hdr = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.RawLoad64 { target = hdr, address = cur, offset = 0 });
    int too_small = new_temporary(search_function, NativeType.Bool);
    push_instruction(search_function, Instruction.LessThan { target = too_small, left = hdr, right = 0 });
    push_instruction(search_function, Instruction.Branch { condition = too_small, label_true = 2, label_false = 3 });

    // Too small: prev = cur; cur = [cur+8], the address feeding its own load.
    push_instruction(search_function, Instruction.Label { label = 2 });
    push_instruction(search_function, Instruction.Copy { target = prev, source = cur });
    push_instruction(search_function, Instruction.RawLoad64 { target = cur, address = cur, offset = 8 });
    push_instruction(search_function, Instruction.Jump { label = 0 });

    // Found. Unlink, then decide split.
    push_instruction(search_function, Instruction.Label { label = 3 });
    int next = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.RawLoad64 { target = next, address = cur, offset = 8 });
    int is_first = new_temporary(search_function, NativeType.Bool);
    push_instruction(search_function, Instruction.Equal { target = is_first, left = prev, right = zero });
    push_instruction(search_function, Instruction.Branch { condition = is_first, label_true = 4, label_false = 5 });
    push_instruction(search_function, Instruction.Label { label = 4 });
    push_instruction(search_function, Instruction.SetStatic { blob = heap_blob, offset = heap_free_offset(), value = next });
    push_instruction(search_function, Instruction.Jump { label = 6 });
    push_instruction(search_function, Instruction.Label { label = 5 });
    push_instruction(search_function, Instruction.RawStore64 { address = prev, offset = 8, value = next });
    push_instruction(search_function, Instruction.Label { label = 6 });
    int rest = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.Subtract { target = rest, left = hdr, right = 0 });
    int small = new_temporary(search_function, NativeType.Bool);
    push_instruction(search_function, Instruction.LessThan { target = small, left = rest, right = sixteen });
    push_instruction(search_function, Instruction.Branch { condition = small, label_true = 8, label_false = 7 });
    // Split: a fresh free node at cur + T, relinked at the list head.
    push_instruction(search_function, Instruction.Label { label = 7 });
    int tail = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.Add { target = tail, left = cur, right = 0 });
    int head_now = new_temporary(search_function, NativeType.Int);
    push_instruction(search_function, Instruction.RawStore64 { address = tail, offset = 0, value = rest });
    push_instruction(search_function, Instruction.GetStatic { target = head_now, blob = heap_blob, offset = heap_free_offset() });
    push_instruction(search_function, Instruction.RawStore64 { address = tail, offset = 8, value = head_now });
    push_instruction(search_function, Instruction.SetStatic { blob = heap_blob, offset = heap_free_offset(), value = tail });
    push_instruction(search_function, Instruction.Jump { label = 8 });
    // Whole block: the remainder would not hold a node.
    push_instruction(search_function, Instruction.Label { label = 8 });
    push_instruction(search_function, Instruction.RawStore64 { address = cur, offset = 0, value = 0 });
    int[] set_arguments = new int[1];
    set_arguments[0] = cur;
    push_instruction(search_function, Instruction.CallVoid { function = set_one, arguments = set_arguments, argument_count = 1 });
    push_instruction(search_function, Instruction.Return { value = cur });
    // walked off the end: no fit.
    push_instruction(search_function, Instruction.Label { label = 9 });
    push_instruction(search_function, Instruction.Return { value = zero });
    return search;
}

// add_bump_shell registers "$bump": the fast path. The cursor advances past
// the block when the limit allows, the header and ledger byte go down at
// the object start, and the block's address returns. No room answers zero.
// Locals: 5.
fn add_bump_shell(NativeScene scene, int heap_blob, int set_one) -> int {
    int bump = add_function(scene, "$bump", NativeType.Int, one_int_parameter(), 1);
    NativeFunction bump_function = function_at(scene, bump);

    int zero = new_temporary(bump_function, NativeType.Int);
    push_instruction(bump_function, Instruction.ConstInt { target = zero, value = 0 });
    int cursor = new_temporary(bump_function, NativeType.Int);
    push_instruction(bump_function, Instruction.GetStatic { target = cursor, blob = heap_blob, offset = heap_cursor_offset() });
    int limit = new_temporary(bump_function, NativeType.Int);
    push_instruction(bump_function, Instruction.GetStatic { target = limit, blob = heap_blob, offset = heap_limit_offset() });
    int advanced = new_temporary(bump_function, NativeType.Int);
    push_instruction(bump_function, Instruction.Add { target = advanced, left = cursor, right = 0 });
    int over = new_temporary(bump_function, NativeType.Bool);
    push_instruction(bump_function, Instruction.LessThan { target = over, left = limit, right = advanced });
    push_instruction(bump_function, Instruction.Branch { condition = over, label_true = 0, label_false = 1 });
    push_instruction(bump_function, Instruction.Label { label = 1 });
    push_instruction(bump_function, Instruction.SetStatic { blob = heap_blob, offset = heap_cursor_offset(), value = advanced });
    push_instruction(bump_function, Instruction.RawStore64 { address = cursor, offset = 0, value = 0 });
    int[] set_arguments = new int[1];
    set_arguments[0] = cursor;
    push_instruction(bump_function, Instruction.CallVoid { function = set_one, arguments = set_arguments, argument_count = 1 });
    push_instruction(bump_function, Instruction.Return { value = cursor });
    push_instruction(bump_function, Instruction.Label { label = 0 });
    push_instruction(bump_function, Instruction.Return { value = zero });
    return bump;
}

// add_mark_at_shell registers "$mark_at": one conservative stack value. A
// value below the heap or at/above the limit is refused. A value inside the
// heap maps to its ledger word, and only when the ledger certifies a block
// header does the scanner set the byte to 2 (marked and live) unless it
// already reads 2. It answers 1 when it marks a header that was not already
// marked, and 0 otherwise, so "$scan_heap" can run to a fixpoint. Locals: 14.
fn add_mark_at_shell(NativeScene scene, int heap_blob, int gc_blob) -> int {
    int marker = add_function(scene, "$mark_at", NativeType.Int, one_int_parameter(), 1);
    NativeFunction marker_function = function_at(scene, marker);

    int result = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.ConstInt { target = result, value = 0 });
    int base = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int below = new_temporary(marker_function, NativeType.Bool);
    push_instruction(marker_function, Instruction.LessThan { target = below, left = 0, right = base });
    push_instruction(marker_function, Instruction.Branch { condition = below, label_true = 0, label_false = 1 });
    push_instruction(marker_function, Instruction.Label { label = 1 });
    int limit = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.GetStatic { target = limit, blob = heap_blob, offset = heap_limit_offset() });
    int above = new_temporary(marker_function, NativeType.Bool);
    push_instruction(marker_function, Instruction.LessThan { target = above, left = limit, right = 0 });
    push_instruction(marker_function, Instruction.Branch { condition = above, label_true = 0, label_false = 2 });
    push_instruction(marker_function, Instruction.Label { label = 2 });
    int eight = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.ConstInt { target = eight, value = 8 });
    int rel = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.Subtract { target = rel, left = 0, right = base });
    int idx = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.WholeDivide { target = idx, left = rel, right = eight });
    int array = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.GetStatic { target = array, blob = gc_blob, offset = ledger_array_offset() });
    int addr = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.Add { target = addr, left = array, right = idx });
    int state = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.RawLoad8 { target = state, address = addr, offset = 0 });
    int one = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.ConstInt { target = one, value = 1 });
    int certified = new_temporary(marker_function, NativeType.Bool);
    push_instruction(marker_function, Instruction.Equal { target = certified, left = state, right = one });
    push_instruction(marker_function, Instruction.Branch { condition = certified, label_true = 3, label_false = 0 });
    push_instruction(marker_function, Instruction.Label { label = 3 });
    int two = new_temporary(marker_function, NativeType.Int);
    push_instruction(marker_function, Instruction.ConstInt { target = two, value = 2 });
    push_instruction(marker_function, Instruction.RawStore8 { address = addr, offset = 0, value = two });
    push_instruction(marker_function, Instruction.ConstInt { target = result, value = 1 });
    push_instruction(marker_function, Instruction.Label { label = 0 });
    push_instruction(marker_function, Instruction.Return { value = result });
    return marker;
}

// add_ledger_at_shell registers "$ledger_at": the ledger byte for one value,
// or 0 when the value lies outside the heap. It never changes state, so the
// probe's graph scene can inspect the mark pass without sweeping.
fn add_ledger_at_shell(NativeScene scene, int heap_blob, int gc_blob) -> int {
    int lookup = add_function(scene, "$ledger_at", NativeType.Int, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, lookup);

    int state = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = state, value = 0 });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int below = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = below, left = 0, right = base });
    push_instruction(h, Instruction.Branch { condition = below, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    int limit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = limit, blob = heap_blob, offset = heap_limit_offset() });
    int above = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = above, left = limit, right = 0 });
    push_instruction(h, Instruction.Branch { condition = above, label_true = 0, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int rel = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = rel, left = 0, right = base });
    int idx = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = idx, left = rel, right = eight });
    int array = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = array, blob = gc_blob, offset = ledger_array_offset() });
    int addr = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = addr, left = array, right = idx });
    push_instruction(h, Instruction.RawLoad8 { target = state, address = addr, offset = 0 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Return { value = state });
    return lookup;
}

// add_scan_roots_shell registers "$scan_roots": the conservative root walk.
// Every 8-byte slot from the current stack pointer (rounded down to a word)
// to the stack captured at mapping time is offered to "$mark_at". Locals: 7.
fn add_scan_roots_shell(NativeScene scene, int gc_blob, int marker) -> int {
    int scanner = add_function(scene, "$scan_roots", NativeType.Void, new NativeType[0], 0);
    NativeFunction scanner_function = function_at(scene, scanner);

    int top = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.GetStatic { target = top, blob = gc_blob, offset = ledger_stack_offset() });
    int rsp = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.StackPointer { target = rsp });
    int seven = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.ConstInt { target = seven, value = 7 });
    int eight = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.ConstInt { target = eight, value = 8 });
    int low = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.Subtract { target = low, left = rsp, right = seven });
    push_instruction(scanner_function, Instruction.WholeDivide { target = low, left = low, right = eight });
    push_instruction(scanner_function, Instruction.Multiply { target = low, left = low, right = eight });

    push_instruction(scanner_function, Instruction.Label { label = 0 });
    int more = new_temporary(scanner_function, NativeType.Bool);
    push_instruction(scanner_function, Instruction.LessThan { target = more, left = low, right = top });
    push_instruction(scanner_function, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(scanner_function, Instruction.Label { label = 1 });
    int value = new_temporary(scanner_function, NativeType.Int);
    push_instruction(scanner_function, Instruction.RawLoad64 { target = value, address = low, offset = 0 });
    int marked = new_temporary(scanner_function, NativeType.Int);
    int[] mark_arguments = new int[1];
    mark_arguments[0] = value;
    push_instruction(scanner_function, Instruction.Call { target = marked, function = marker, arguments = mark_arguments, argument_count = 1 });
    push_instruction(scanner_function, Instruction.Add { target = low, left = low, right = eight });
    push_instruction(scanner_function, Instruction.Jump { label = 0 });
    push_instruction(scanner_function, Instruction.Label { label = 2 });
    push_instruction(scanner_function, Instruction.ReturnVoid);
    return scanner;
}

// add_scan_heap_shell registers "$scan_heap": the transitive mark pass. It
// walks every block from the heap base to the allocation cursor; for each
// ledger-certified marked block it offers every 8-byte word of the block's
// payload (the size header is skipped) to "$mark_at". It answers the number
// of newly marked headers, and "$collect" repeats the pass while that number
// is nonzero, so a graph reachable only through heap pointers survives.
// Scanning conservatively may retain a block whose payload merely looks like
// a pointer; false retention is acceptable, missed retention is not.
// Locals: 18.
fn add_scan_heap_shell(NativeScene scene, int heap_blob, int gc_blob, int marker) -> int {
    int scanner = add_function(scene, "$scan_heap", NativeType.Int, new NativeType[0], 0);
    NativeFunction h = function_at(scene, scanner);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int cursor = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = cursor, blob = heap_blob, offset = heap_cursor_offset() });
    int block = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = block, source = base });
    int changed = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = changed, source = zero });
    int size = new_temporary(h, NativeType.Int);
    int rel = new_temporary(h, NativeType.Int);
    int idx = new_temporary(h, NativeType.Int);
    int array = new_temporary(h, NativeType.Int);
    int addr = new_temporary(h, NativeType.Int);
    int state = new_temporary(h, NativeType.Int);
    int marked = new_temporary(h, NativeType.Bool);
    int word = new_temporary(h, NativeType.Int);
    int end = new_temporary(h, NativeType.Int);
    int scan_more = new_temporary(h, NativeType.Bool);
    int value = new_temporary(h, NativeType.Int);
    int mark_result = new_temporary(h, NativeType.Int);
    int more = new_temporary(h, NativeType.Bool);
    int[] mark_arguments = new int[1];

    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = block, right = cursor });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.RawLoad64 { target = size, address = block, offset = 0 });
    push_instruction(h, Instruction.Subtract { target = rel, left = block, right = base });
    push_instruction(h, Instruction.WholeDivide { target = idx, left = rel, right = eight });
    push_instruction(h, Instruction.GetStatic { target = array, blob = gc_blob, offset = ledger_array_offset() });
    push_instruction(h, Instruction.Add { target = addr, left = array, right = idx });
    push_instruction(h, Instruction.RawLoad8 { target = state, address = addr, offset = 0 });
    push_instruction(h, Instruction.Equal { target = marked, left = state, right = two });
    push_instruction(h, Instruction.Branch { condition = marked, label_true = 3, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Add { target = word, left = block, right = eight });
    push_instruction(h, Instruction.Add { target = end, left = block, right = size });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.LessThan { target = scan_more, left = word, right = end });
    push_instruction(h, Instruction.Branch { condition = scan_more, label_true = 6, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.RawLoad64 { target = value, address = word, offset = 0 });
    mark_arguments[0] = value;
    push_instruction(h, Instruction.Call { target = mark_result, function = marker, arguments = mark_arguments, argument_count = 1 });
    push_instruction(h, Instruction.Add { target = changed, left = changed, right = mark_result });
    push_instruction(h, Instruction.Add { target = word, left = word, right = eight });
    push_instruction(h, Instruction.Jump { label = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Add { target = block, left = block, right = size });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Return { value = changed });
    return scanner;
}

// add_free_block_shell registers "$free_block": one dead block's disposal.
// A walk whose end is exactly this block's address extends the preceding
// free run (its header absorbs the size, its list node stays); otherwise
// the block heads the free list. Both shapes record the walk's last words
// and clear the ledger byte. Locals: 8.
fn add_free_block_shell(NativeScene scene, int heap_blob, int set_zero) -> int {
    int free_block = add_function(scene, "$free_block", NativeType.Void, two_int_parameters(), 2);
    NativeFunction free_function = function_at(scene, free_block);

    int zero = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.ConstInt { target = zero, value = 0 });
    int head = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.GetStatic { target = head, blob = heap_blob, offset = heap_free_offset() });
    int last = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.GetStatic { target = last, blob = heap_blob, offset = heap_last_offset() });
    int last_end = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.GetStatic { target = last_end, blob = heap_blob, offset = heap_last_end_offset() });
    int grows = new_temporary(free_function, NativeType.Bool);
    push_instruction(free_function, Instruction.Equal { target = grows, left = last_end, right = 0 });
    push_instruction(free_function, Instruction.Branch { condition = grows, label_true = 0, label_false = 1 });
    // Extend the preceding free run: the header absorbs the size and the
    // walk's end moves past this block.
    push_instruction(free_function, Instruction.Label { label = 0 });
    int hdr = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.RawLoad64 { target = hdr, address = last, offset = 0 });
    int grown = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.Add { target = grown, left = hdr, right = 1 });
    push_instruction(free_function, Instruction.RawStore64 { address = last, offset = 0, value = grown });
    int end = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.Add { target = end, left = 0, right = 1 });
    push_instruction(free_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_end_offset(), value = end });
    int[] zero_arguments = new int[1];
    zero_arguments[0] = 0;
    push_instruction(free_function, Instruction.CallVoid { function = set_zero, arguments = zero_arguments, argument_count = 1 });
    push_instruction(free_function, Instruction.ReturnVoid);
    // Fresh: the block heads the list and the walk's last words.
    push_instruction(free_function, Instruction.Label { label = 1 });
    int fresh_end = new_temporary(free_function, NativeType.Int);
    push_instruction(free_function, Instruction.Add { target = fresh_end, left = 0, right = 1 });
    push_instruction(free_function, Instruction.RawStore64 { address = 0, offset = 8, value = head });
    push_instruction(free_function, Instruction.SetStatic { blob = heap_blob, offset = heap_free_offset(), value = 0 });
    push_instruction(free_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_offset(), value = 0 });
    push_instruction(free_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_end_offset(), value = fresh_end });
    push_instruction(free_function, Instruction.CallVoid { function = set_zero, arguments = zero_arguments, argument_count = 1 });
    push_instruction(free_function, Instruction.ReturnVoid);
    return free_block;
}
// add_string_print registers the "$print" routine: one reference parameter,
// the object's length at raw offset 8 and payload pointer at raw offset 16,
// one write syscall, then the newline blob's own byte through a second one.
public fn add_string_print(NativeScene scene, int newline_blob) -> int {
    int print = add_function(scene, "$print", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction print_function = function_at(scene, print);

    int length = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int number = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = number, value = 1 });
    int[] arguments = new int[3];
    arguments[0] = number;
    arguments[1] = data;
    arguments[2] = length;
    int written = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawSyscall { target = written, number = number, arguments = arguments, argument_count = 3 });

    int tail = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.ConstRefData { target = tail, blob = newline_blob });
    int tail_data = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.RawLoad64 { target = tail_data, address = tail, offset = 16 });
    int tail_number = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = tail_number, value = 1 });
    int[] tail_arguments = new int[3];
    tail_arguments[0] = tail_number;
    tail_arguments[1] = tail_data;
    tail_arguments[2] = tail_number;
    int tail_written = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawSyscall { target = tail_written, number = tail_number, arguments = tail_arguments, argument_count = 3 });
    push_instruction(print_function, Instruction.ReturnVoid);
    return print;
}

// add_string_print_raw registers "$print_string_raw": the payload write
// without the newline, the piece a multi-argument print uses between spaces.
public fn add_string_print_raw(NativeScene scene) -> int {
    int print = add_function(scene, "$print_string_raw", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction print_function = function_at(scene, print);

    int length = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(print_function, NativeType.Ref);
    push_instruction(print_function, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int number = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.ConstInt { target = number, value = 1 });
    int[] arguments = new int[3];
    arguments[0] = number;
    arguments[1] = data;
    arguments[2] = length;
    int written = new_temporary(print_function, NativeType.Int);
    push_instruction(print_function, Instruction.RawSyscall { target = written, number = number, arguments = arguments, argument_count = 3 });
    push_instruction(print_function, Instruction.ReturnVoid);
    return print;
}

// add_write_one registers "$write1": one reference parameter whose object's
// payload holds exactly one byte, written to standard output with one
// syscall. The digit scratch, the minus sign, and the zero digit all share
// the routine.
public fn add_write_one(NativeScene scene) -> int {
    int writer = add_function(scene, "$write1", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction writer_function = function_at(scene, writer);

    int one = new_temporary(writer_function, NativeType.Int);
    push_instruction(writer_function, Instruction.ConstInt { target = one, value = 1 });
    int data = new_temporary(writer_function, NativeType.Ref);
    push_instruction(writer_function, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int[] arguments = new int[3];
    arguments[0] = one;
    arguments[1] = data;
    arguments[2] = one;
    int written = new_temporary(writer_function, NativeType.Int);
    push_instruction(writer_function, Instruction.RawSyscall { target = written, number = one, arguments = arguments, argument_count = 3 });
    push_instruction(writer_function, Instruction.ReturnVoid);
    return writer;
}

// add_print_newline registers "$print_newline": the newline blob's byte and
// nothing else, the tail every "$print_int" run shares.
public fn add_print_newline(NativeScene scene, int newline_blob) -> int {
    int tail = add_function(scene, "$print_newline", NativeType.Void, new NativeType[0], 0);
    NativeFunction tail_function = function_at(scene, tail);

    int reference = new_temporary(tail_function, NativeType.Ref);
    push_instruction(tail_function, Instruction.ConstRefData { target = reference, blob = newline_blob });
    int data = new_temporary(tail_function, NativeType.Ref);
    push_instruction(tail_function, Instruction.RawLoad64 { target = data, address = reference, offset = 16 });
    int one = new_temporary(tail_function, NativeType.Int);
    push_instruction(tail_function, Instruction.ConstInt { target = one, value = 1 });
    int[] arguments = new int[3];
    arguments[0] = one;
    arguments[1] = data;
    arguments[2] = one;
    int written = new_temporary(tail_function, NativeType.Int);
    push_instruction(tail_function, Instruction.RawSyscall { target = written, number = one, arguments = arguments, argument_count = 3 });
    push_instruction(tail_function, Instruction.ReturnVoid);
    return tail;
}

// IntPrintShell carries the integer print helpers' index set: the
// `$print_int` and `$digits` function indexes, and the blobs the helpers
// share. The writer and tail inside the scene take no external wiring.
public struct IntPrintShell {
    int print_int;
    int print_int_raw;
    int digits;
    int dash_blob;
    int zero_blob;
    int scratch_blob;
}

// add_int_print registers the integer print helpers into a scene: the
// minus-digit, zero-digit, and scratch blobs first, then "$write1", the
// recursive "$digits", and "$print_int". The caller supplies the shared
// "$print_newline" tail so every print kind uses one newline shell. `$digits`
// works on a negative magnitude — the zero case never reaches it — so the
// truncated quotient and the negated remainder always produce the digit and
// INT64_MIN digitizes without a case of its own.
public fn add_int_print(NativeScene scene, int tail) -> IntPrintShell {
    IntPrintShell shell = IntPrintShell { print_int = 0, print_int_raw = 0, digits = 0, dash_blob = 0, zero_blob = 0, scratch_blob = 0 };

    int dash_blob = add_blob(scene, "-");
    int zero_blob = add_blob(scene, "0");
    int scratch_blob = add_blob(scene, "0");
    int writer = add_write_one(scene);

    int digits = add_function(scene, "$digits", NativeType.Void, one_int_parameter(), 1);
    NativeFunction digits_function = function_at(scene, digits);
    int ten = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.ConstInt { target = ten, value = 10 });
    int remainder = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.WholeRemainder { target = remainder, left = 0, right = ten });
    int stepped = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.WholeDivide { target = stepped, left = 0, right = ten });
    int zero = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.ConstInt { target = zero, value = 0 });
    int more = new_temporary(digits_function, NativeType.Bool);
    push_instruction(digits_function, Instruction.Equal { target = more, left = stepped, right = zero });
    push_instruction(digits_function, Instruction.Branch { condition = more, label_true = 1, label_false = 0 });
    push_instruction(digits_function, Instruction.Label { label = 0 });
    int[] again = new int[1];
    again[0] = stepped;
    push_instruction(digits_function, Instruction.CallVoid { function = digits, arguments = again, argument_count = 1 });
    push_instruction(digits_function, Instruction.Label { label = 1 });
    int digit = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.Negate { target = digit, value = remainder });
    int base = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.ConstInt { target = base, value = 48 });
    int code = new_temporary(digits_function, NativeType.Int);
    push_instruction(digits_function, Instruction.Add { target = code, left = digit, right = base });
    push_instruction(digits_function, Instruction.SetStatic { blob = scratch_blob, offset = 24, value = code });
    int reference = new_temporary(digits_function, NativeType.Ref);
    push_instruction(digits_function, Instruction.ConstRefData { target = reference, blob = scratch_blob });
    int[] single = new int[1];
    single[0] = reference;
    push_instruction(digits_function, Instruction.CallVoid { function = writer, arguments = single, argument_count = 1 });
    push_instruction(digits_function, Instruction.ReturnVoid);

    int print_int_raw = add_function(scene, "$print_int_raw", NativeType.Void, one_int_parameter(), 1);
    NativeFunction print_int_function = function_at(scene, print_int_raw);
    int zero0 = new_temporary(print_int_function, NativeType.Int);
    push_instruction(print_int_function, Instruction.ConstInt { target = zero0, value = 0 });
    int is_zero = new_temporary(print_int_function, NativeType.Bool);
    push_instruction(print_int_function, Instruction.Equal { target = is_zero, left = 0, right = zero0 });
    push_instruction(print_int_function, Instruction.Branch { condition = is_zero, label_true = 0, label_false = 1 });
    push_instruction(print_int_function, Instruction.Label { label = 1 });
    int is_negative = new_temporary(print_int_function, NativeType.Bool);
    push_instruction(print_int_function, Instruction.LessThan { target = is_negative, left = 0, right = zero0 });
    push_instruction(print_int_function, Instruction.Branch { condition = is_negative, label_true = 2, label_false = 3 });
    push_instruction(print_int_function, Instruction.Label { label = 2 });
    int dash = new_temporary(print_int_function, NativeType.Ref);
    push_instruction(print_int_function, Instruction.ConstRefData { target = dash, blob = dash_blob });
    int[] minus = new int[1];
    minus[0] = dash;
    push_instruction(print_int_function, Instruction.CallVoid { function = writer, arguments = minus, argument_count = 1 });
    push_instruction(print_int_function, Instruction.Jump { label = 4 });
    push_instruction(print_int_function, Instruction.Label { label = 3 });
    push_instruction(print_int_function, Instruction.Negate { target = 0, value = 0 });
    push_instruction(print_int_function, Instruction.Label { label = 4 });
    int[] magnitude = new int[1];
    magnitude[0] = 0;
    push_instruction(print_int_function, Instruction.CallVoid { function = digits, arguments = magnitude, argument_count = 1 });
    push_instruction(print_int_function, Instruction.Jump { label = 5 });
    push_instruction(print_int_function, Instruction.Label { label = 0 });
    int zero_digit = new_temporary(print_int_function, NativeType.Ref);
    push_instruction(print_int_function, Instruction.ConstRefData { target = zero_digit, blob = zero_blob });
    int[] zero_call = new int[1];
    zero_call[0] = zero_digit;
    push_instruction(print_int_function, Instruction.CallVoid { function = writer, arguments = zero_call, argument_count = 1 });
    push_instruction(print_int_function, Instruction.Label { label = 5 });
    push_instruction(print_int_function, Instruction.ReturnVoid);

    int print_int = add_function(scene, "$print_int", NativeType.Void, one_int_parameter(), 1);
    NativeFunction print_int_wrapper = function_at(scene, print_int);
    int[] raw_arguments = new int[1];
    raw_arguments[0] = 0;
    push_instruction(print_int_wrapper, Instruction.CallVoid { function = print_int_raw, arguments = raw_arguments, argument_count = 1 });
    int[] no_arguments = new int[0];
    push_instruction(print_int_wrapper, Instruction.CallVoid { function = tail, arguments = no_arguments, argument_count = 0 });
    push_instruction(print_int_wrapper, Instruction.ReturnVoid);

    shell.print_int = print_int;
    shell.print_int_raw = print_int_raw;
    shell.digits = digits;
    shell.dash_blob = dash_blob;
    shell.zero_blob = zero_blob;
    shell.scratch_blob = scratch_blob;
    return shell;
}

// add_bool_print registers "$print_bool": one bool parameter written as
// "true" or "false" plus newline, through the shared "$print" routine. The
// bool reads as one byte, so the branch's condition is the parameter itself.
public fn add_bool_print(NativeScene scene, int string_print) -> int {
    int true_blob = add_blob(scene, "true");
    int false_blob = add_blob(scene, "false");
    int shell = add_function(scene, "$print_bool", NativeType.Void, one_bool_parameter(), 1);
    NativeFunction bool_function = function_at(scene, shell);

    push_instruction(bool_function, Instruction.Branch { condition = 0, label_true = 0, label_false = 1 });
    push_instruction(bool_function, Instruction.Label { label = 0 });
    int reference = new_temporary(bool_function, NativeType.Ref);
    push_instruction(bool_function, Instruction.ConstRefData { target = reference, blob = true_blob });
    int[] true_arguments = new int[1];
    true_arguments[0] = reference;
    push_instruction(bool_function, Instruction.CallVoid { function = string_print, arguments = true_arguments, argument_count = 1 });
    push_instruction(bool_function, Instruction.ReturnVoid);
    push_instruction(bool_function, Instruction.Label { label = 1 });
    push_instruction(bool_function, Instruction.ConstRefData { target = reference, blob = false_blob });
    int[] false_arguments = new int[1];
    false_arguments[0] = reference;
    push_instruction(bool_function, Instruction.CallVoid { function = string_print, arguments = false_arguments, argument_count = 1 });
    push_instruction(bool_function, Instruction.ReturnVoid);
    return shell;
}

// add_bool_print_raw registers "$print_bool_raw": the true/false word through
// the raw string writer, without the trailing newline.
public fn add_bool_print_raw(NativeScene scene, int string_print_raw) -> int {
    int true_blob = add_blob(scene, "true");
    int false_blob = add_blob(scene, "false");
    int shell = add_function(scene, "$print_bool_raw", NativeType.Void, one_bool_parameter(), 1);
    NativeFunction bool_function = function_at(scene, shell);

    push_instruction(bool_function, Instruction.Branch { condition = 0, label_true = 0, label_false = 1 });
    push_instruction(bool_function, Instruction.Label { label = 0 });
    int reference = new_temporary(bool_function, NativeType.Ref);
    push_instruction(bool_function, Instruction.ConstRefData { target = reference, blob = true_blob });
    int[] true_arguments = new int[1];
    true_arguments[0] = reference;
    push_instruction(bool_function, Instruction.CallVoid { function = string_print_raw, arguments = true_arguments, argument_count = 1 });
    push_instruction(bool_function, Instruction.ReturnVoid);
    push_instruction(bool_function, Instruction.Label { label = 1 });
    push_instruction(bool_function, Instruction.ConstRefData { target = reference, blob = false_blob });
    int[] false_arguments = new int[1];
    false_arguments[0] = reference;
    push_instruction(bool_function, Instruction.CallVoid { function = string_print_raw, arguments = false_arguments, argument_count = 1 });
    push_instruction(bool_function, Instruction.ReturnVoid);
    return shell;
}

// add_sweep_block_shell registers "$sweep_block": one heap block's fate and
// the size that advances the walk. A ledger byte of 2 (marked live) demotes
// to 1; 1 (allocated, unmarked) hands the block to "$free_block"; 0
// (released already) is skipped. Locals: 11.
fn add_sweep_block_shell(NativeScene scene, int heap_blob, int gc_blob, int free_block) -> int {
    int sweep_block = add_function(scene, "$sweep_block", NativeType.Int, one_int_parameter(), 1);
    NativeFunction sweep_function = function_at(scene, sweep_block);

    int base = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int rel = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.Subtract { target = rel, left = 0, right = base });
    int eight = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.ConstInt { target = eight, value = 8 });
    int idx = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.WholeDivide { target = idx, left = rel, right = eight });
    int array = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.GetStatic { target = array, blob = gc_blob, offset = ledger_array_offset() });
    int addr = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.Add { target = addr, left = array, right = idx });
    int state = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.RawLoad8 { target = state, address = addr, offset = 0 });
    int hdr = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.RawLoad64 { target = hdr, address = 0, offset = 0 });
    int two = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.ConstInt { target = two, value = 2 });
    int one = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.ConstInt { target = one, value = 1 });
    int marked = new_temporary(sweep_function, NativeType.Bool);
    push_instruction(sweep_function, Instruction.Equal { target = marked, left = state, right = two });
    push_instruction(sweep_function, Instruction.Branch { condition = marked, label_true = 0, label_false = 1 });
    push_instruction(sweep_function, Instruction.Label { label = 0 });
    push_instruction(sweep_function, Instruction.RawStore8 { address = addr, offset = 0, value = one });
    push_instruction(sweep_function, Instruction.Return { value = hdr });
    push_instruction(sweep_function, Instruction.Label { label = 1 });
    push_instruction(sweep_function, Instruction.Equal { target = marked, left = state, right = one });
    push_instruction(sweep_function, Instruction.Branch { condition = marked, label_true = 2, label_false = 3 });
    push_instruction(sweep_function, Instruction.Label { label = 2 });
    int[] free_arguments = new int[2];
    free_arguments[0] = 0;
    free_arguments[1] = hdr;
    push_instruction(sweep_function, Instruction.CallVoid { function = free_block, arguments = free_arguments, argument_count = 2 });
    push_instruction(sweep_function, Instruction.Return { value = hdr });
    push_instruction(sweep_function, Instruction.Label { label = 3 });
    push_instruction(sweep_function, Instruction.Return { value = hdr });
    return sweep_block;
}

// add_sweep_shell registers "$sweep": walk the heap block by block from its
// base to the cursor, calling "$sweep_block" on each and advancing by its
// size. The walk leaves the sweep's last words at -1 for the next run.
// Locals: 6.
fn add_sweep_shell(NativeScene scene, int heap_blob, int sweep_block) -> int {
    int sweep = add_function(scene, "$sweep", NativeType.Void, new NativeType[0], 0);
    NativeFunction sweep_function = function_at(scene, sweep);

    int base = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.GetStatic { target = base, blob = heap_blob, offset = heap_base_offset() });
    int cursor = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.GetStatic { target = cursor, blob = heap_blob, offset = heap_cursor_offset() });
    int cur = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.Copy { target = cur, source = base });
    push_instruction(sweep_function, Instruction.Label { label = 0 });
    int more = new_temporary(sweep_function, NativeType.Bool);
    push_instruction(sweep_function, Instruction.LessThan { target = more, left = cur, right = cursor });
    push_instruction(sweep_function, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(sweep_function, Instruction.Label { label = 1 });
    int size = new_temporary(sweep_function, NativeType.Int);
    int[] block_arguments = new int[1];
    block_arguments[0] = cur;
    push_instruction(sweep_function, Instruction.Call { target = size, function = sweep_block, arguments = block_arguments, argument_count = 1 });
    push_instruction(sweep_function, Instruction.Add { target = cur, left = cur, right = size });
    push_instruction(sweep_function, Instruction.Jump { label = 0 });
    push_instruction(sweep_function, Instruction.Label { label = 2 });
    int minus_one = new_temporary(sweep_function, NativeType.Int);
    push_instruction(sweep_function, Instruction.ConstInt { target = minus_one, value = -1 });
    push_instruction(sweep_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_offset(), value = minus_one });
    push_instruction(sweep_function, Instruction.SetStatic { blob = heap_blob, offset = heap_last_end_offset(), value = minus_one });
    push_instruction(sweep_function, Instruction.ReturnVoid);
    return sweep;
}

// add_collect_shell registers "$collect": mark the stack roots, run the
// transitive heap pass to a fixpoint, then sweep.
fn add_collect_shell(NativeScene scene, int scan_roots, int scan_heap, int sweep) -> int {
    int collect = add_function(scene, "$collect", NativeType.Void, new NativeType[0], 0);
    NativeFunction collect_function = function_at(scene, collect);

    int[] no_arguments = new int[0];
    push_instruction(collect_function, Instruction.CallVoid { function = scan_roots, arguments = no_arguments, argument_count = 0 });
    int zero = new_temporary(collect_function, NativeType.Int);
    push_instruction(collect_function, Instruction.ConstInt { target = zero, value = 0 });
    int changed = new_temporary(collect_function, NativeType.Int);
    int settled = new_temporary(collect_function, NativeType.Bool);
    push_instruction(collect_function, Instruction.Label { label = 0 });
    push_instruction(collect_function, Instruction.Call { target = changed, function = scan_heap, arguments = no_arguments, argument_count = 0 });
    push_instruction(collect_function, Instruction.Equal { target = settled, left = changed, right = zero });
    push_instruction(collect_function, Instruction.Branch { condition = settled, label_true = 1, label_false = 0 });
    push_instruction(collect_function, Instruction.Label { label = 1 });
    push_instruction(collect_function, Instruction.CallVoid { function = sweep, arguments = no_arguments, argument_count = 0 });
    push_instruction(collect_function, Instruction.ReturnVoid);
    return collect;
}

// add_alloc_shell registers "$alloc": search the free list, bump the
// cursor, and one full collection in between, all converging on one return
// paragraph. Locals: 8.
fn add_alloc_shell(NativeScene scene, int heap_blob, int map_shell, int pad8, int search, int bump, int collect) -> int {
    int alloc = add_function(scene, "$alloc", NativeType.Int, one_int_parameter(), 1);
    NativeFunction alloc_function = function_at(scene, alloc);

    int zero = new_temporary(alloc_function, NativeType.Int);
    push_instruction(alloc_function, Instruction.ConstInt { target = zero, value = 0 });
    int cursor = new_temporary(alloc_function, NativeType.Int);
    push_instruction(alloc_function, Instruction.GetStatic { target = cursor, blob = heap_blob, offset = heap_cursor_offset() });
    int unmapped = new_temporary(alloc_function, NativeType.Bool);
    push_instruction(alloc_function, Instruction.LessThan { target = unmapped, left = cursor, right = zero });
    push_instruction(alloc_function, Instruction.Branch { condition = unmapped, label_true = 0, label_false = 1 });
    push_instruction(alloc_function, Instruction.Label { label = 0 });
    int[] no_arguments = new int[0];
    push_instruction(alloc_function, Instruction.CallVoid { function = map_shell, arguments = no_arguments, argument_count = 0 });
    push_instruction(alloc_function, Instruction.Label { label = 1 });
    int size = new_temporary(alloc_function, NativeType.Int);
    int[] request_arguments = new int[1];
    request_arguments[0] = 0;
    push_instruction(alloc_function, Instruction.Call { target = size, function = pad8, arguments = request_arguments, argument_count = 1 });
    int[] padded_arguments = new int[1];
    padded_arguments[0] = size;
    int block = new_temporary(alloc_function, NativeType.Int);
    push_instruction(alloc_function, Instruction.Call { target = block, function = search, arguments = padded_arguments, argument_count = 1 });
    int miss = new_temporary(alloc_function, NativeType.Bool);
    push_instruction(alloc_function, Instruction.Equal { target = miss, left = block, right = zero });
    push_instruction(alloc_function, Instruction.Branch { condition = miss, label_true = 2, label_false = 7 });
    // Bump attempt: the untouched cursor still has room.
    push_instruction(alloc_function, Instruction.Label { label = 2 });
    int bumped = new_temporary(alloc_function, NativeType.Int);
    push_instruction(alloc_function, Instruction.Call { target = bumped, function = bump, arguments = padded_arguments, argument_count = 1 });
    int empty = new_temporary(alloc_function, NativeType.Bool);
    push_instruction(alloc_function, Instruction.Equal { target = empty, left = bumped, right = zero });
    push_instruction(alloc_function, Instruction.Branch { condition = empty, label_true = 3, label_false = 6 });
    // Collect, then one last search and one last bump.
    push_instruction(alloc_function, Instruction.Label { label = 3 });
    push_instruction(alloc_function, Instruction.CallVoid { function = collect, arguments = no_arguments, argument_count = 0 });
    push_instruction(alloc_function, Instruction.Call { target = block, function = search, arguments = padded_arguments, argument_count = 1 });
    push_instruction(alloc_function, Instruction.Equal { target = miss, left = block, right = zero });
    push_instruction(alloc_function, Instruction.Branch { condition = miss, label_true = 4, label_false = 7 });
    push_instruction(alloc_function, Instruction.Label { label = 4 });
    push_instruction(alloc_function, Instruction.Call { target = bumped, function = bump, arguments = padded_arguments, argument_count = 1 });
    push_instruction(alloc_function, Instruction.Equal { target = empty, left = bumped, right = zero });
    push_instruction(alloc_function, Instruction.Branch { condition = empty, label_true = 5, label_false = 6 });
    push_instruction(alloc_function, Instruction.Label { label = 5 });
    push_instruction(alloc_function, Instruction.FailOOM);
    push_instruction(alloc_function, Instruction.Label { label = 6 });
    push_instruction(alloc_function, Instruction.Copy { target = block, source = bumped });
    push_instruction(alloc_function, Instruction.Label { label = 7 });
    push_instruction(alloc_function, Instruction.Return { value = block });
    return alloc;
}

// --- The string runtime -----------------------------------------------------

// add_strings registers the string runtime: `$string_length`, `$copy_bytes`,
// `$string_equal`, and `$string_concat`, in dependency order, with the
// allocator's index handed to the concat shell. Nothing here depends on a
// prescan, so every lowered program carries the shells.
public fn add_strings(NativeScene scene, int alloc) -> StringShell {
    StringShell shell = StringShell { length = 0, equal = 0, concat = 0, copy = 0 };
    shell.length = add_string_length_shell(scene);
    shell.copy = add_copy_bytes_shell(scene);
    shell.equal = add_string_equal_shell(scene);
    shell.concat = add_string_concat_shell(scene, shell.copy, alloc);
    return shell;
}

// add_string_length_shell registers "$string_length": the length word at
// offset 8, with a null string normalized to length zero as the C runtime's
// pcy_rt_string_value does.
fn add_string_length_shell(NativeScene scene) -> int {
    int length = add_function(scene, "$string_length", NativeType.Int, one_ref_parameter(), 1);
    NativeFunction length_function = function_at(scene, length);
    int zero = new_temporary(length_function, NativeType.Int);
    push_instruction(length_function, Instruction.ConstInt { target = zero, value = 0 });
    int bits = new_temporary(length_function, NativeType.Int);
    push_instruction(length_function, Instruction.Copy { target = bits, source = 0 });
    int len = new_temporary(length_function, NativeType.Int);
    push_instruction(length_function, Instruction.Copy { target = len, source = zero });
    int is_null = new_temporary(length_function, NativeType.Bool);
    push_instruction(length_function, Instruction.Equal { target = is_null, left = bits, right = zero });
    push_instruction(length_function, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(length_function, Instruction.Label { label = 0 });
    push_instruction(length_function, Instruction.Return { value = len });
    push_instruction(length_function, Instruction.Label { label = 1 });
    push_instruction(length_function, Instruction.RawLoad64 { target = len, address = 0, offset = 8 });
    push_instruction(length_function, Instruction.Return { value = len });
    return length;
}

// add_copy_bytes_shell registers "$copy_bytes": copy `n` bytes from source
// address to destination address, one byte per iteration. Locals: 6.
fn add_copy_bytes_shell(NativeScene scene) -> int {
    int copy = add_function(scene, "$copy_bytes", NativeType.Void, three_int_parameters(), 3);
    NativeFunction copy_function = function_at(scene, copy);

    int i = new_temporary(copy_function, NativeType.Int);
    push_instruction(copy_function, Instruction.ConstInt { target = i, value = 0 });
    int one = new_temporary(copy_function, NativeType.Int);
    push_instruction(copy_function, Instruction.ConstInt { target = one, value = 1 });
    push_instruction(copy_function, Instruction.Label { label = 0 });
    int cont = new_temporary(copy_function, NativeType.Bool);
    push_instruction(copy_function, Instruction.LessThan { target = cont, left = i, right = 2 });
    push_instruction(copy_function, Instruction.Branch { condition = cont, label_true = 2, label_false = 1 });
    // Body: destination[i] = source[i]; i += 1.
    push_instruction(copy_function, Instruction.Label { label = 2 });
    int saddr = new_temporary(copy_function, NativeType.Int);
    push_instruction(copy_function, Instruction.Add { target = saddr, left = 1, right = i });
    int value = new_temporary(copy_function, NativeType.Int);
    push_instruction(copy_function, Instruction.RawLoad8 { target = value, address = saddr, offset = 0 });
    int daddr = new_temporary(copy_function, NativeType.Int);
    push_instruction(copy_function, Instruction.Add { target = daddr, left = 0, right = i });
    push_instruction(copy_function, Instruction.RawStore8 { address = daddr, offset = 0, value = value });
    push_instruction(copy_function, Instruction.Add { target = i, left = i, right = one });
    push_instruction(copy_function, Instruction.Jump { label = 0 });
    push_instruction(copy_function, Instruction.Label { label = 1 });
    push_instruction(copy_function, Instruction.ReturnVoid);
    return copy;
}

// add_string_equal_shell registers "$string_equal": two content-compare
// string objects, byte for byte, across the payload pointers at offset 16.
// Locals: 14 (at the frame cap).
fn add_string_equal_shell(NativeScene scene) -> int {
    int equal = add_function(scene, "$string_equal", NativeType.Bool, two_ref_parameters(), 2);
    NativeFunction equal_function = function_at(scene, equal);
    int zero = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.ConstInt { target = one, value = 1 });
    int a_bits = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = a_bits, source = 0 });
    int b_bits = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = b_bits, source = 1 });
    int len_a = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = len_a, source = zero });
    int pa = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = pa, source = zero });
    int a_null = new_temporary(equal_function, NativeType.Bool);
    push_instruction(equal_function, Instruction.Equal { target = a_null, left = a_bits, right = zero });
    push_instruction(equal_function, Instruction.Branch { condition = a_null, label_true = 0, label_false = 1 });
    push_instruction(equal_function, Instruction.Label { label = 1 });
    push_instruction(equal_function, Instruction.RawLoad64 { target = len_a, address = 0, offset = 8 });
    push_instruction(equal_function, Instruction.RawLoad64 { target = pa, address = 0, offset = 16 });
    push_instruction(equal_function, Instruction.Jump { label = 2 });
    push_instruction(equal_function, Instruction.Label { label = 0 });
    push_instruction(equal_function, Instruction.Label { label = 2 });
    int len_b = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = len_b, source = zero });
    int pb = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Copy { target = pb, source = zero });
    int b_null = new_temporary(equal_function, NativeType.Bool);
    push_instruction(equal_function, Instruction.Equal { target = b_null, left = b_bits, right = zero });
    push_instruction(equal_function, Instruction.Branch { condition = b_null, label_true = 3, label_false = 4 });
    push_instruction(equal_function, Instruction.Label { label = 4 });
    push_instruction(equal_function, Instruction.RawLoad64 { target = len_b, address = 1, offset = 8 });
    push_instruction(equal_function, Instruction.RawLoad64 { target = pb, address = 1, offset = 16 });
    push_instruction(equal_function, Instruction.Jump { label = 5 });
    push_instruction(equal_function, Instruction.Label { label = 3 });
    push_instruction(equal_function, Instruction.Label { label = 5 });
    int same = new_temporary(equal_function, NativeType.Bool);
    push_instruction(equal_function, Instruction.Equal { target = same, left = len_a, right = len_b });
    int answer = new_temporary(equal_function, NativeType.Bool);
    push_instruction(equal_function, Instruction.Branch { condition = same, label_true = 6, label_false = 7 });
    push_instruction(equal_function, Instruction.Label { label = 7 });
    push_instruction(equal_function, Instruction.ConstBool { target = answer, value = false });
    push_instruction(equal_function, Instruction.Return { value = answer });
    push_instruction(equal_function, Instruction.Label { label = 6 });
    int i = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.ConstInt { target = i, value = 0 });
    push_instruction(equal_function, Instruction.Label { label = 8 });
    push_instruction(equal_function, Instruction.LessThan { target = same, left = i, right = len_a });
    push_instruction(equal_function, Instruction.Branch { condition = same, label_true = 9, label_false = 10 });
    push_instruction(equal_function, Instruction.Label { label = 9 });
    int saddr = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Add { target = saddr, left = pa, right = i });
    int ba = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.RawLoad8 { target = ba, address = saddr, offset = 0 });
    int daddr = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.Add { target = daddr, left = pb, right = i });
    int bb = new_temporary(equal_function, NativeType.Int);
    push_instruction(equal_function, Instruction.RawLoad8 { target = bb, address = daddr, offset = 0 });
    int matching = new_temporary(equal_function, NativeType.Bool);
    push_instruction(equal_function, Instruction.Equal { target = matching, left = ba, right = bb });
    push_instruction(equal_function, Instruction.Branch { condition = matching, label_true = 11, label_false = 7 });
    push_instruction(equal_function, Instruction.Label { label = 11 });
    push_instruction(equal_function, Instruction.Add { target = i, left = i, right = one });
    push_instruction(equal_function, Instruction.Jump { label = 8 });
    push_instruction(equal_function, Instruction.Label { label = 10 });
    push_instruction(equal_function, Instruction.ConstBool { target = answer, value = true });
    push_instruction(equal_function, Instruction.Return { value = answer });
    return equal;
}

// add_string_concat_shell registers "$string_concat": allocate one object
// through "$alloc" large enough for both payloads, then copy the bytes.
// The parameters and the fresh object all live in the same frame, so a
// collection inside "$alloc" finds both source strings on the stack.
// Locals: 9.
fn add_string_concat_shell(NativeScene scene, int copy_bytes, int alloc) -> int {
    int concat = add_function(scene, "$string_concat", NativeType.Ref, two_ref_parameters(), 2);
    NativeFunction concat_function = function_at(scene, concat);
    int zero = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.ConstInt { target = zero, value = 0 });
    int a_bits = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = a_bits, source = 0 });
    int len_a = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = len_a, source = zero });
    int pa = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = pa, source = zero });
    int a_null = new_temporary(concat_function, NativeType.Bool);
    push_instruction(concat_function, Instruction.Equal { target = a_null, left = a_bits, right = zero });
    push_instruction(concat_function, Instruction.Branch { condition = a_null, label_true = 0, label_false = 1 });
    push_instruction(concat_function, Instruction.Label { label = 1 });
    push_instruction(concat_function, Instruction.RawLoad64 { target = len_a, address = 0, offset = 8 });
    push_instruction(concat_function, Instruction.RawLoad64 { target = pa, address = 0, offset = 16 });
    push_instruction(concat_function, Instruction.Jump { label = 2 });
    push_instruction(concat_function, Instruction.Label { label = 0 });
    push_instruction(concat_function, Instruction.Label { label = 2 });
    int b_bits = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = b_bits, source = 1 });
    int len_b = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = len_b, source = zero });
    int pb = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Copy { target = pb, source = zero });
    int b_null = new_temporary(concat_function, NativeType.Bool);
    push_instruction(concat_function, Instruction.Equal { target = b_null, left = b_bits, right = zero });
    push_instruction(concat_function, Instruction.Branch { condition = b_null, label_true = 3, label_false = 4 });
    push_instruction(concat_function, Instruction.Label { label = 4 });
    push_instruction(concat_function, Instruction.RawLoad64 { target = len_b, address = 1, offset = 8 });
    push_instruction(concat_function, Instruction.RawLoad64 { target = pb, address = 1, offset = 16 });
    push_instruction(concat_function, Instruction.Jump { label = 5 });
    push_instruction(concat_function, Instruction.Label { label = 3 });
    push_instruction(concat_function, Instruction.Label { label = 5 });
    int total = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Add { target = total, left = len_a, right = len_b });
    int sixteen = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.ConstInt { target = sixteen, value = 16 });
    int request = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Add { target = request, left = total, right = sixteen });
    int obj_raw = new_temporary(concat_function, NativeType.Int);
    int[] alloc_arguments = new int[1];
    alloc_arguments[0] = request;
    push_instruction(concat_function, Instruction.Call { target = obj_raw, function = alloc, arguments = alloc_arguments, argument_count = 1 });
    int obj = new_temporary(concat_function, NativeType.Ref);
    push_instruction(concat_function, Instruction.Copy { target = obj, source = obj_raw });
    int twenty_four = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.ConstInt { target = twenty_four, value = 24 });
    int dst = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Add { target = dst, left = obj, right = twenty_four });
    push_instruction(concat_function, Instruction.RawStore64 { address = obj, offset = 8, value = total });
    push_instruction(concat_function, Instruction.RawStore64 { address = obj, offset = 16, value = dst });
    int[] first = new int[3];
    first[0] = dst;
    first[1] = pa;
    first[2] = len_a;
    push_instruction(concat_function, Instruction.CallVoid { function = copy_bytes, arguments = first, argument_count = 3 });
    int mid = new_temporary(concat_function, NativeType.Int);
    push_instruction(concat_function, Instruction.Add { target = mid, left = dst, right = len_a });
    int[] second = new int[3];
    second[0] = mid;
    second[1] = pb;
    second[2] = len_b;
    push_instruction(concat_function, Instruction.CallVoid { function = copy_bytes, arguments = second, argument_count = 3 });
    push_instruction(concat_function, Instruction.Return { value = obj });
    return concat;
}

// add_c_strlen_shell registers "$c_strlen": the byte length of a
// NUL-terminated C string.
public fn add_c_strlen_shell(NativeScene scene) -> int {
    int measure = add_function(scene, "$c_strlen", NativeType.Int, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, measure);

    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    int octet = new_temporary(h, NativeType.Int);
    int done = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Add { target = address, left = 0, right = i });
    push_instruction(h, Instruction.RawLoad8 { target = octet, address = address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = done, left = octet, right = zero });
    push_instruction(h, Instruction.Branch { condition = done, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Return { value = i });
    return measure;
}

// add_argv_shell registers "$argv": read argc and the argv pointer from the
// saved args blob, allocate a fresh string[] of argc references, and copy each
// C argument into a normal length-carrying string object.
public fn add_argv_shell(NativeScene scene, int alloc, int copy_bytes, int array_new, int c_strlen, int args_blob) -> int {
    int build = add_function(scene, "$argv", NativeType.Ref, new NativeType[0], 0);
    NativeFunction h = function_at(scene, build);

    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int argc = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = argc, blob = args_blob, offset = 24 });
    int argv_pointer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = argv_pointer, blob = args_blob, offset = 32 });
    int[] array_args = new int[2];
    array_args[0] = argc;
    array_args[1] = eight;
    int array = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = array, function = array_new, arguments = array_args, argument_count = 2 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = array, offset = 24 });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = base, left = data, right = eight });
    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int slot_offset = new_temporary(h, NativeType.Int);
    int slot = new_temporary(h, NativeType.Int);
    int pointer = new_temporary(h, NativeType.Int);
    int length = new_temporary(h, NativeType.Int);
    int request = new_temporary(h, NativeType.Int);
    int raw = new_temporary(h, NativeType.Int);
    int payload = new_temporary(h, NativeType.Int);
    int element_offset = new_temporary(h, NativeType.Int);
    int element = new_temporary(h, NativeType.Int);
    int more = new_temporary(h, NativeType.Bool);
    int[] alloc_args = new int[1];
    int[] copy_args = new int[3];

    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = argc });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Multiply { target = slot_offset, left = i, right = eight });
    push_instruction(h, Instruction.Add { target = slot, left = argv_pointer, right = slot_offset });
    push_instruction(h, Instruction.RawLoad64 { target = pointer, address = slot, offset = 0 });
    int[] strlen_args = new int[1];
    strlen_args[0] = pointer;
    push_instruction(h, Instruction.Call { target = length, function = c_strlen, arguments = strlen_args, argument_count = 1 });
    push_instruction(h, Instruction.Add { target = request, left = length, right = sixteen });
    alloc_args[0] = request;
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = length });
    push_instruction(h, Instruction.Add { target = payload, left = raw, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 16, value = payload });
    copy_args[0] = payload;
    copy_args[1] = pointer;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.Multiply { target = element_offset, left = i, right = eight });
    push_instruction(h, Instruction.Add { target = element, left = base, right = element_offset });
    push_instruction(h, Instruction.RawStore64 { address = element, offset = 0, value = raw });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Return { value = array });
    return build;
}

// MapShell carries the map runtime's function indices.
public struct MapShell {
    int new_map;
    int at;
    int set;
    int has;
    int length;
    int fail_blob;
}

// add_map_key_shell registers "$map_key_or_empty": a null key normalizes to
// the empty string, as the C runtime does.
fn add_map_key_shell(NativeScene scene, int empty_blob) -> int {
    int key_shell = add_function(scene, "$map_key_or_empty", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, key_shell);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    int result = new_temporary(h, NativeType.Ref);
    int empty_label = 0;
    int present_label = 1;
    int done_label = 2;
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = empty_label, label_false = present_label });
    push_instruction(h, Instruction.Label { label = empty_label });
    push_instruction(h, Instruction.ConstRefData { target = result, blob = empty_blob });
    push_instruction(h, Instruction.Jump { label = done_label });
    push_instruction(h, Instruction.Label { label = present_label });
    push_instruction(h, Instruction.Copy { target = result, source = 0 });
    push_instruction(h, Instruction.Label { label = done_label });
    push_instruction(h, Instruction.Return { value = result });
    return key_shell;
}

// add_map_find_shell registers "$map_find": linear search over the packed
// entry table, answering the entry index or -1.
fn add_map_find_shell(NativeScene scene, int string_equal) -> int {
    int find = add_function(scene, "$map_find", NativeType.Int, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, find);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int minus_one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = minus_one, value = -1 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int keys = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = keys, address = 0, offset = 32 });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = base, left = keys, right = eight });
    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    int offset = new_temporary(h, NativeType.Int);
    int slot = new_temporary(h, NativeType.Int);
    int existing = new_temporary(h, NativeType.Ref);
    int equal = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = length });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Multiply { target = offset, left = i, right = eight });
    push_instruction(h, Instruction.Add { target = slot, left = base, right = offset });
    push_instruction(h, Instruction.RawLoad64 { target = existing, address = slot, offset = 0 });
    int[] equal_args = new int[2];
    equal_args[0] = existing;
    equal_args[1] = 1;
    push_instruction(h, Instruction.Call { target = equal, function = string_equal, arguments = equal_args, argument_count = 2 });
    push_instruction(h, Instruction.Branch { condition = equal, label_true = 3, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Return { value = i });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Return { value = minus_one });
    return find;
}

// add_map_new_shell registers "$map_new": allocate the map object and its
// zeroed key/value buffers at the initial capacity of eight.
fn add_map_new_shell(NativeScene scene, int alloc, int zero_bytes, int fail_blob, int size_blob) -> int {
    int create = add_function(scene, "$map_new", NativeType.Ref, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, create);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int forty = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = forty, value = 40 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = zero });
    int nonpositive = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = nonpositive, left = 0, right = one });
    int fail_label = 0;
    int ok_label = 1;
    push_instruction(h, Instruction.Branch { condition = nonpositive, label_true = fail_label, label_false = ok_label });
    push_instruction(h, Instruction.Label { label = fail_label });
    int size_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = size_text, blob = size_blob });
    int[] size_args = new int[1];
    size_args[0] = size_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = size_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = ok_label });

    int keys_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = keys_bytes, left = eight, right = eight });
    int[] keys_args = new int[1];
    keys_args[0] = keys_bytes;
    int keys = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = keys, function = alloc, arguments = keys_args, argument_count = 1 });
    int keys_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = keys_payload, left = keys, right = eight });
    int[] keys_zero = new int[2];
    keys_zero[0] = keys_payload;
    keys_zero[1] = keys_bytes;
    push_instruction(h, Instruction.CallVoid { function = zero_bytes, arguments = keys_zero, argument_count = 2 });

    int values_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = values_bytes, left = eight, right = 0 });
    int[] values_args = new int[1];
    values_args[0] = values_bytes;
    int values = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = values, function = alloc, arguments = values_args, argument_count = 1 });
    int values_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = values_payload, left = values, right = eight });
    int[] values_zero = new int[2];
    values_zero[0] = values_payload;
    values_zero[1] = values_bytes;
    push_instruction(h, Instruction.CallVoid { function = zero_bytes, arguments = values_zero, argument_count = 2 });

    int[] map_args = new int[1];
    map_args[0] = forty;
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = map_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = zero });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 16, value = eight });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 24, value = 0 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 32, value = keys });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 40, value = values });
    push_instruction(h, Instruction.Copy { target = result, source = raw });
    push_instruction(h, Instruction.Return { value = result });
    return create;
}

// add_map_length_shell registers "$map_length": the length word with a null
// reference reaching the C runtime's exact error.
fn add_map_length_shell(NativeScene scene, int fail_blob, int null_blob) -> int {
    int length = add_function(scene, "$map_length", NativeType.Int, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, length);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    int fail_label = 0;
    int ok_label = 1;
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = fail_label, label_false = ok_label });
    push_instruction(h, Instruction.Label { label = fail_label });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });
    push_instruction(h, Instruction.Label { label = ok_label });
    int len = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = len, address = 0, offset = 8 });
    push_instruction(h, Instruction.Return { value = len });
    return length;
}

// add_map_has_shell registers "$map_has": a null check, then whether the
// linear find returned a non-negative index.
fn add_map_has_shell(NativeScene scene, int find, int fail_blob, int null_blob, int map_key) -> int {
    int has = add_function(scene, "$map_has", NativeType.Bool, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, has);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    int fail_label = 0;
    int ok_label = 1;
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = fail_label, label_false = ok_label });
    push_instruction(h, Instruction.Label { label = fail_label });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    int false_result = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.ConstBool { target = false_result, value = false });
    push_instruction(h, Instruction.Return { value = false_result });
    push_instruction(h, Instruction.Label { label = ok_label });

    int[] key_args = new int[1];
    key_args[0] = 1;
    int key = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = key, function = map_key, arguments = key_args, argument_count = 1 });
    int[] find_args = new int[2];
    find_args[0] = 0;
    find_args[1] = key;
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = index, function = find, arguments = find_args, argument_count = 2 });
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = index, right = zero });
    int true_label = 2;
    int false_label = 3;
    int done_label = 4;
    int result = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Branch { condition = negative, label_true = false_label, label_false = true_label });
    push_instruction(h, Instruction.Label { label = true_label });
    push_instruction(h, Instruction.ConstBool { target = result, value = true });
    push_instruction(h, Instruction.Jump { label = done_label });
    push_instruction(h, Instruction.Label { label = false_label });
    push_instruction(h, Instruction.ConstBool { target = result, value = false });
    push_instruction(h, Instruction.Label { label = done_label });
    push_instruction(h, Instruction.Return { value = result });
    return has;
}

// add_fail_map_key_shell registers "$fail_map_key": the missing-entry error
// with the key's bytes, then status 1.
fn add_fail_map_key_shell(NativeScene scene, int prefix_blob, int suffix_blob, int write_blob_fd, int map_key) -> int {
    int fail = add_function(scene, "$fail_map_key", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, fail);
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int[] key_args = new int[1];
    key_args[0] = 0;
    int key = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = key, function = map_key, arguments = key_args, argument_count = 1 });
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = prefix_blob });
    int[] prefix_args = new int[2];
    prefix_args[0] = two;
    prefix_args[1] = prefix;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = prefix_args, argument_count = 2 });
    int[] key_write = new int[2];
    key_write[0] = two;
    key_write[1] = key;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = key_write, argument_count = 2 });
    int suffix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = suffix, blob = suffix_blob });
    int[] suffix_args = new int[2];
    suffix_args[0] = two;
    suffix_args[1] = suffix;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = suffix_args, argument_count = 2 });
    int exit_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = exit_number, value = 60 });
    int status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = status, value = 1 });
    int[] exit_args = new int[1];
    exit_args[0] = status;
    int ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = ignored, number = exit_number, arguments = exit_args, argument_count = 1 });
    push_instruction(h, Instruction.ReturnVoid);
    return fail;
}

// add_map_set_shell registers "$map_set": update an existing entry or grow
// and append a new one. Growth copies keys and values as raw bytes so
// reference values stay reachable through both buffers and the new one.
fn add_map_set_shell(NativeScene scene, int alloc, int zero_bytes, int copy_bytes, int map_key, int find, int fail_blob, int null_blob) -> int {
    int set = add_function(scene, "$map_set", NativeType.Void, ref_ref_int_parameters(), 3);
    NativeFunction h = function_at(scene, set);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.ReturnVoid);

    push_instruction(h, Instruction.Label { label = 1 });
    int[] key_args = new int[1];
    key_args[0] = 1;
    int key = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = key, function = map_key, arguments = key_args, argument_count = 1 });
    int[] find_args = new int[2];
    find_args[0] = 0;
    find_args[1] = key;
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = index, function = find, arguments = find_args, argument_count = 2 });
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = index, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 2, label_false = 3 });

    // Existing entry: overwrite its value bytes.
    push_instruction(h, Instruction.Label { label = 3 });
    int value_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = value_size, address = 0, offset = 24 });
    int values = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = values, address = 0, offset = 40 });
    int value_offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = value_offset, left = index, right = value_size });
    int value_base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = value_base, left = values, right = eight });
    int value_slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = value_slot, left = value_base, right = value_offset });
    int one_byte = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = one_byte, left = value_size, right = one });
    push_instruction(h, Instruction.Branch { condition = one_byte, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.RawStore8 { address = value_slot, offset = 0, value = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.RawStore64 { address = value_slot, offset = 0, value = 2 });
    push_instruction(h, Instruction.ReturnVoid);

    // New entry: grow when full, then append at the packed length.
    push_instruction(h, Instruction.Label { label = 2 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = capacity, address = 0, offset = 16 });
    int full = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = full, left = length, right = capacity });
    push_instruction(h, Instruction.Branch { condition = full, label_true = 6, label_false = 7 });

    push_instruction(h, Instruction.Label { label = 6 });
    int old_keys = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = old_keys, address = 0, offset = 32 });
    int old_values = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = old_values, address = 0, offset = 40 });
    int old_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = old_size, address = 0, offset = 24 });
    int new_capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = new_capacity, left = capacity, right = two });
    int keys_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = keys_bytes, left = new_capacity, right = eight });
    int values_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = values_bytes, left = new_capacity, right = old_size });
    int[] keys_args = new int[1];
    keys_args[0] = keys_bytes;
    int new_keys = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = new_keys, function = alloc, arguments = keys_args, argument_count = 1 });
    int new_keys_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = new_keys_payload, left = new_keys, right = eight });
    int[] keys_zero = new int[2];
    keys_zero[0] = new_keys_payload;
    keys_zero[1] = keys_bytes;
    push_instruction(h, Instruction.CallVoid { function = zero_bytes, arguments = keys_zero, argument_count = 2 });
    int[] values_args = new int[1];
    values_args[0] = values_bytes;
    int new_values = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = new_values, function = alloc, arguments = values_args, argument_count = 1 });
    int new_values_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = new_values_payload, left = new_values, right = eight });
    int[] values_zero = new int[2];
    values_zero[0] = new_values_payload;
    values_zero[1] = values_bytes;
    push_instruction(h, Instruction.CallVoid { function = zero_bytes, arguments = values_zero, argument_count = 2 });
    int keys_copy_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = keys_copy_bytes, left = length, right = eight });
    int old_keys_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = old_keys_payload, left = old_keys, right = eight });
    int[] keys_copy = new int[3];
    keys_copy[0] = new_keys_payload;
    keys_copy[1] = old_keys_payload;
    keys_copy[2] = keys_copy_bytes;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = keys_copy, argument_count = 3 });
    int values_copy_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = values_copy_bytes, left = length, right = old_size });
    int old_values_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = old_values_payload, left = old_values, right = eight });
    int[] values_copy = new int[3];
    values_copy[0] = new_values_payload;
    values_copy[1] = old_values_payload;
    values_copy[2] = values_copy_bytes;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = values_copy, argument_count = 3 });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 32, value = new_keys });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 40, value = new_values });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 16, value = new_capacity });

    push_instruction(h, Instruction.Label { label = 7 });
    int length2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length2, address = 0, offset = 8 });
    int keys = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = keys, address = 0, offset = 32 });
    int values2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = values2, address = 0, offset = 40 });
    int size2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = size2, address = 0, offset = 24 });
    int key_offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = key_offset, left = length2, right = eight });
    int key_base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = key_base, left = keys, right = eight });
    int key_slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = key_slot, left = key_base, right = key_offset });
    int key_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = key_bits, source = key });
    push_instruction(h, Instruction.RawStore64 { address = key_slot, offset = 0, value = key_bits });
    int value_offset2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = value_offset2, left = length2, right = size2 });
    int value_base2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = value_base2, left = values2, right = eight });
    int value_slot2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = value_slot2, left = value_base2, right = value_offset2 });
    int one_byte2 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = one_byte2, left = size2, right = one });
    push_instruction(h, Instruction.Branch { condition = one_byte2, label_true = 8, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.RawStore8 { address = value_slot2, offset = 0, value = 2 });
    push_instruction(h, Instruction.Jump { label = 10 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.RawStore64 { address = value_slot2, offset = 0, value = 2 });
    push_instruction(h, Instruction.Label { label = 10 });
    int grown_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = grown_length, left = length2, right = one });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 8, value = grown_length });
    push_instruction(h, Instruction.ReturnVoid);
    return set;
}

// add_map_at_shell registers "$map_at": null and missing-key checks, then the
// address of the entry's value bytes.
fn add_map_at_shell(NativeScene scene, int map_key, int find, int fail_map_key, int fail_blob, int null_blob) -> int {
    int at = add_function(scene, "$map_at", NativeType.Int, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, at);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });

    push_instruction(h, Instruction.Label { label = 1 });
    int[] key_args = new int[1];
    key_args[0] = 1;
    int key = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = key, function = map_key, arguments = key_args, argument_count = 1 });
    int[] find_args = new int[2];
    find_args[0] = 0;
    find_args[1] = key;
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = index, function = find, arguments = find_args, argument_count = 2 });
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = index, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    int[] missing_args = new int[1];
    missing_args[0] = key;
    push_instruction(h, Instruction.CallVoid { function = fail_map_key, arguments = missing_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });
    push_instruction(h, Instruction.Label { label = 3 });
    int value_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = value_size, address = 0, offset = 24 });
    int values = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = values, address = 0, offset = 40 });
    int offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = offset, left = index, right = value_size });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = base, left = values, right = eight });
    int slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = slot, left = base, right = offset });
    push_instruction(h, Instruction.Return { value = slot });
    return at;
}

// add_maps registers the map runtime: one shared key normalizer, the linear
// find, the object shell, and the set/at/has/length operations.
public fn add_maps(NativeScene scene, int alloc, int string_equal, int copy_bytes, int zero_bytes, int fail_blob, int write_blob_fd) -> MapShell {
    MapShell shell = MapShell { new_map = 0, at = 0, set = 0, has = 0, length = 0, fail_blob = 0 };
    int empty_blob = add_blob(scene, "");
    int prefix_blob = add_blob(scene, "purr: map has no entry for key \"");
    int suffix_blob = add_blob(scene, "\"\n");
    int size_blob = add_blob(scene, "map value size must be positive");
    int set_null_blob = add_blob(scene, "map assignment on a null map reference");
    int at_null_blob = add_blob(scene, "map lookup on a null map reference");
    int has_null_blob = add_blob(scene, "has on a null map reference");
    int length_null_blob = add_blob(scene, "length of a null map reference");

    int map_key = add_map_key_shell(scene, empty_blob);
    int fail_key = add_fail_map_key_shell(scene, prefix_blob, suffix_blob, write_blob_fd, map_key);
    int find = add_map_find_shell(scene, string_equal);
    shell.new_map = add_map_new_shell(scene, alloc, zero_bytes, fail_blob, size_blob);
    shell.set = add_map_set_shell(scene, alloc, zero_bytes, copy_bytes, map_key, find, fail_blob, set_null_blob);
    shell.at = add_map_at_shell(scene, map_key, find, fail_key, fail_blob, at_null_blob);
    shell.has = add_map_has_shell(scene, find, fail_blob, has_null_blob, map_key);
    shell.length = add_map_length_shell(scene, fail_blob, length_null_blob);
    shell.fail_blob = fail_blob;
    return shell;
}

// add_current_directory_shell registers "$try_current_directory": one
// getcwd(2) syscall into a 64 KiB buffer, then the predeclared result union
// [size][tag=Ok 0/Failed 1][path or message] with the C runtime's
// `getwd: <reason>` failure text.
public fn add_current_directory_shell(NativeScene scene, int alloc, int c_strlen, int copy_bytes, int string_concat) -> int {
    int getcwd = add_function(scene, "$try_current_directory", NativeType.Ref, new NativeType[0], 0);
    NativeFunction h = function_at(scene, getcwd);

    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = capacity, value = 65536 });
    int number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = number, value = 79 });

    int[] buffer_args = new int[1];
    buffer_args[0] = capacity;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = alloc, arguments = buffer_args, argument_count = 1 });
    int buffer_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = buffer_data, left = buffer, right = eight });
    int[] syscall_args = new int[2];
    syscall_args[0] = buffer_data;
    syscall_args[1] = capacity;
    int called = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = called, number = number, arguments = syscall_args, argument_count = 2 });
    int failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = failed, left = called, right = zero });
    push_instruction(h, Instruction.Branch { condition = failed, label_true = 0, label_false = 1 });

    // Failure: select the Go-compatible reason and build getwd: <reason>.
    push_instruction(h, Instruction.Label { label = 0 });
    int errno_value = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = errno_value, value = called });
    int reason = new_temporary(h, NativeType.Ref);
    int check = new_temporary(h, NativeType.Bool);
    int enoent_blob = add_blob(scene, "no such file or directory");
    int eacces_blob = add_blob(scene, "permission denied");
    int enomem_blob = add_blob(scene, "cannot allocate memory");
    int erange_blob = add_blob(scene, "numerical result out of range");
    int unknown_blob = add_blob(scene, "unknown error");
    int thirteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirteen, value = 13 });
    int twelve = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twelve, value = 12 });
    int thirty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_four, value = 34 });
    push_instruction(h, Instruction.Equal { target = check, left = errno_value, right = two });
    push_instruction(h, Instruction.Branch { condition = check, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = enoent_blob });
    push_instruction(h, Instruction.Jump { label = 8 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Equal { target = check, left = errno_value, right = thirteen });
    push_instruction(h, Instruction.Branch { condition = check, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = eacces_blob });
    push_instruction(h, Instruction.Jump { label = 8 });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Equal { target = check, left = errno_value, right = twelve });
    push_instruction(h, Instruction.Branch { condition = check, label_true = 6, label_false = 7 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = enomem_blob });
    push_instruction(h, Instruction.Jump { label = 8 });
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Equal { target = check, left = errno_value, right = thirty_four });
    push_instruction(h, Instruction.Branch { condition = check, label_true = 9, label_false = 10 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = erange_blob });
    push_instruction(h, Instruction.Jump { label = 8 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = unknown_blob });
    push_instruction(h, Instruction.Label { label = 8 });
    int prefix_blob = add_blob(scene, "getwd: ");
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = prefix_blob });
    int[] concat_args = new int[2];
    concat_args[0] = prefix;
    concat_args[1] = reason;
    int message = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = message, function = string_concat, arguments = concat_args, argument_count = 2 });
    int[] union_args = new int[1];
    union_args[0] = twenty_four;
    int failed_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_union, function = alloc, arguments = union_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_union, offset = 8, value = one });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = message });
    push_instruction(h, Instruction.RawStore64 { address = failed_union, offset = 24, value = message_bits });
    int failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failed_result, source = failed_union });
    push_instruction(h, Instruction.Return { value = failed_result });

    // Success: copy the NUL-terminated path into a normal string object.
    push_instruction(h, Instruction.Label { label = 1 });
    int[] strlen_args = new int[1];
    strlen_args[0] = buffer_data;
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = length, function = c_strlen, arguments = strlen_args, argument_count = 1 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = length, right = sixteen });
    int[] path_args = new int[1];
    path_args[0] = request;
    int path = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = path, function = alloc, arguments = path_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = path, offset = 8, value = length });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = path, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = path, offset = 16, value = payload });
    int[] copy_args = new int[3];
    copy_args[0] = payload;
    copy_args[1] = buffer_data;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    int[] ok_union_args = new int[1];
    ok_union_args[0] = twenty_four;
    int ok_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_union, function = alloc, arguments = ok_union_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 8, value = zero });
    int path_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = path_bits, source = path });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 16, value = path_bits });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_union });
    push_instruction(h, Instruction.Return { value = ok_result });
    return getcwd;
}

// add_errno_reason_shell registers "$errno_reason": the Go-compatible
// lower-case reason for the common recoverable file errors.
public fn add_errno_reason_shell(NativeScene scene) -> int {
    int reason_fn = add_function(scene, "$errno_reason", NativeType.Ref, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, reason_fn);
    int reason = new_temporary(h, NativeType.Ref);
    int check = new_temporary(h, NativeType.Bool);
    int[] numbers = new int[11];
    numbers[0] = 2;
    numbers[1] = 13;
    numbers[2] = 21;
    numbers[3] = 20;
    numbers[4] = 36;
    numbers[5] = 24;
    numbers[6] = 23;
    numbers[7] = 40;
    numbers[8] = 12;
    numbers[9] = 17;
    numbers[10] = 39;
    string[] texts = new string[11];
    texts[0] = "no such file or directory";
    texts[1] = "permission denied";
    texts[2] = "is a directory";
    texts[3] = "not a directory";
    texts[4] = "file name too long";
    texts[5] = "too many open files";
    texts[6] = "too many open files in system";
    texts[7] = "too many levels of symbolic links";
    texts[8] = "cannot allocate memory";
    texts[9] = "file exists";
    texts[10] = "directory not empty";
    int index = 0;
    while (index < 11) {
        int value = new_temporary(h, NativeType.Int);
        push_instruction(h, Instruction.ConstInt { target = value, value = numbers[index] });
        push_instruction(h, Instruction.Equal { target = check, left = 0, right = value });
        int hit = index * 2;
        int next = hit + 1;
        int after = 22;
        push_instruction(h, Instruction.Branch { condition = check, label_true = hit, label_false = next });
        push_instruction(h, Instruction.Label { label = hit });
        int blob = add_blob(scene, texts[index]);
        push_instruction(h, Instruction.ConstRefData { target = reason, blob = blob });
        push_instruction(h, Instruction.Jump { label = after });
        push_instruction(h, Instruction.Label { label = next });
        index++;
    }
    int unknown = add_blob(scene, "unknown error");
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = unknown });
    push_instruction(h, Instruction.Label { label = 22 });
    push_instruction(h, Instruction.Return { value = reason });
    return reason_fn;
}

// add_errno_reason_libc_shell registers "$errno_reason_libc": the same
// errno lookup with the capitalization glibc's strerror produces, which the
// fatal read_file path uses. The recoverable built-ins keep the lower-case
// Go-compatible text.
public fn add_errno_reason_libc_shell(NativeScene scene) -> int {
    int reason_fn = add_function(scene, "$errno_reason_libc", NativeType.Ref, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, reason_fn);
    int reason = new_temporary(h, NativeType.Ref);
    int check = new_temporary(h, NativeType.Bool);
    int[] numbers = new int[14];
    numbers[0] = 2;
    numbers[1] = 13;
    numbers[2] = 21;
    numbers[3] = 20;
    numbers[4] = 36;
    numbers[5] = 24;
    numbers[6] = 23;
    numbers[7] = 40;
    numbers[8] = 12;
    numbers[9] = 17;
    numbers[10] = 39;
    numbers[11] = 22;
    numbers[12] = 29;
    numbers[13] = 5;
    string[] texts = new string[14];
    texts[0] = "No such file or directory";
    texts[1] = "Permission denied";
    texts[2] = "Is a directory";
    texts[3] = "Not a directory";
    texts[4] = "File name too long";
    texts[5] = "Too many open files";
    texts[6] = "Too many open files in system";
    texts[7] = "Too many levels of symbolic links";
    texts[8] = "Cannot allocate memory";
    texts[9] = "File exists";
    texts[10] = "Directory not empty";
    texts[11] = "Invalid argument";
    texts[12] = "Illegal seek";
    texts[13] = "Input/output error";
    int index = 0;
    while (index < 14) {
        int value = new_temporary(h, NativeType.Int);
        push_instruction(h, Instruction.ConstInt { target = value, value = numbers[index] });
        push_instruction(h, Instruction.Equal { target = check, left = 0, right = value });
        int hit = index * 2;
        int next = hit + 1;
        int after = 28;
        push_instruction(h, Instruction.Branch { condition = check, label_true = hit, label_false = next });
        push_instruction(h, Instruction.Label { label = hit });
        int blob = add_blob(scene, texts[index]);
        push_instruction(h, Instruction.ConstRefData { target = reason, blob = blob });
        push_instruction(h, Instruction.Jump { label = after });
        push_instruction(h, Instruction.Label { label = next });
        index++;
    }
    int unknown = add_blob(scene, "Unknown error");
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = unknown });
    push_instruction(h, Instruction.Label { label = 28 });
    push_instruction(h, Instruction.Return { value = reason });
    return reason_fn;
}

// add_try_read_file_shell registers "$try_read_file": open/read/close a path
// and build ReadFileResult. Open and read failures use the C runtime's
// `open|read <path>: <reason>` text; a successful read becomes Ok{text}.
public fn add_try_read_file_shell(NativeScene scene, int alloc, int copy_bytes, int string_concat, int errno_reason) -> int {
    int reader = add_function(scene, "$try_read_file", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, reader);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int open_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = open_number, value = 2 });
    int close_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = close_number, value = 3 });
    int read_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = read_number, value = 0 });

    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int path_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_request, left = length, right = one });
    int[] path_alloc = new int[1];
    path_alloc[0] = path_request;
    int path_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = path_buffer, function = alloc, arguments = path_alloc, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = path_buffer, right = eight });
    int[] path_copy = new int[3];
    path_copy[0] = path_data;
    path_copy[1] = data;
    path_copy[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = path_copy, argument_count = 3 });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = terminator, left = path_data, right = length });
    push_instruction(h, Instruction.RawStore8 { address = terminator, offset = 0, value = zero });

    int[] open_args = new int[3];
    open_args[0] = path_data;
    open_args[1] = zero;
    open_args[2] = zero;
    int descriptor = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = descriptor, number = open_number, arguments = open_args, argument_count = 3 });
    int open_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = open_failed, left = descriptor, right = zero });
    push_instruction(h, Instruction.Branch { condition = open_failed, label_true = 0, label_false = 1 });

    // Open failure.
    push_instruction(h, Instruction.Label { label = 0 });
    int open_error = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = open_error, value = descriptor });
    int open_reason = new_temporary(h, NativeType.Ref);
    int[] open_reason_args = new int[1];
    open_reason_args[0] = open_error;
    push_instruction(h, Instruction.Call { target = open_reason, function = errno_reason, arguments = open_reason_args, argument_count = 1 });
    int open_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = open_prefix, blob = add_blob(scene, "open ") });
    int open_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = open_colon, blob = add_blob(scene, ": ") });
    int open_message = new_temporary(h, NativeType.Ref);
    open_message = concat_twice(h, string_concat, open_prefix, 0, open_colon, open_reason);
    int failed = new_temporary(h, NativeType.Ref);
    int[] failed_args = new int[1];
    failed_args[0] = twenty_four;
    int failed_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_raw, function = alloc, arguments = failed_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 8, value = one });
    int failed_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = failed_bits, source = open_message });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 24, value = failed_bits });
    push_instruction(h, Instruction.Copy { target = failed, source = failed_raw });
    push_instruction(h, Instruction.Return { value = failed });

    // Open succeeded: fstat for the size, then read to that size.
    push_instruction(h, Instruction.Label { label = 1 });
    int stat_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_size, value = 144 });
    int[] stat_request = new int[1];
    stat_request[0] = stat_size;
    int stat_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = stat_buffer, function = alloc, arguments = stat_request, argument_count = 1 });
    int stat_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = stat_data, left = stat_buffer, right = eight });
    int stat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_number, value = 5 });
    int[] stat_args = new int[2];
    stat_args[0] = descriptor;
    stat_args[1] = stat_data;
    int stat_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = stat_result, number = stat_number, arguments = stat_args, argument_count = 2 });
    int stat_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = stat_failed, left = stat_result, right = zero });
    push_instruction(h, Instruction.Branch { condition = stat_failed, label_true = 9, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    int size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = size, address = stat_data, offset = 48 });
    push_instruction(h, Instruction.Jump { label = 4 });

    // Failure label 2 uses error_code and fail_prefix (stat at 9, read at 8).
    int error_code = new_temporary(h, NativeType.Int);
    int fail_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.Negate { target = error_code, value = stat_result });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "stat ") });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    int close_ignored = new_temporary(h, NativeType.Int);
    int[] close_call = new int[1];
    close_call[0] = descriptor;
    push_instruction(h, Instruction.RawSyscall { target = close_ignored, number = close_number, arguments = close_call, argument_count = 1 });
    int read_reason = new_temporary(h, NativeType.Ref);
    int[] read_reason_args = new int[1];
    read_reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = read_reason, function = errno_reason, arguments = read_reason_args, argument_count = 1 });
    int read_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = read_colon, blob = add_blob(scene, ": ") });
    int read_message = new_temporary(h, NativeType.Ref);
    read_message = concat_twice(h, string_concat, fail_prefix, 0, read_colon, read_reason);
    int read_failed = new_temporary(h, NativeType.Ref);
    int[] read_failed_args = new int[1];
    read_failed_args[0] = twenty_four;
    int read_failed_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = read_failed_raw, function = alloc, arguments = read_failed_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = read_failed_raw, offset = 8, value = one });
    int read_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = read_bits, source = read_message });
    push_instruction(h, Instruction.RawStore64 { address = read_failed_raw, offset = 24, value = read_bits });
    push_instruction(h, Instruction.Copy { target = read_failed, source = read_failed_raw });
    push_instruction(h, Instruction.Return { value = read_failed });

    push_instruction(h, Instruction.Label { label = 4 });
    int actual_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = actual_size, source = size });
    int[] buffer_args = new int[1];
    buffer_args[0] = actual_size;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = alloc, arguments = buffer_args, argument_count = 1 });
    int buffer_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = buffer_data, left = buffer, right = eight });
    int total = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = total, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    int remaining = new_temporary(h, NativeType.Int);
    int read_address = new_temporary(h, NativeType.Int);
    int count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.LessThan { target = more, left = total, right = actual_size });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 6, label_false = 7 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.Subtract { target = remaining, left = actual_size, right = total });
    push_instruction(h, Instruction.Add { target = read_address, left = buffer_data, right = total });
    int[] read_args = new int[3];
    read_args[0] = descriptor;
    read_args[1] = read_address;
    read_args[2] = remaining;
    push_instruction(h, Instruction.RawSyscall { target = count, number = read_number, arguments = read_args, argument_count = 3 });
    int read_bad = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = read_bad, left = count, right = zero });
    int read_empty = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = read_empty, left = count, right = zero });
    push_instruction(h, Instruction.Branch { condition = read_bad, label_true = 8, label_false = 10 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.Branch { condition = read_empty, label_true = 7, label_false = 11 });
    push_instruction(h, Instruction.Label { label = 11 });
    push_instruction(h, Instruction.Add { target = total, left = total, right = count });
    push_instruction(h, Instruction.Jump { label = 5 });

    // Label 8: read error path, set error_code and the read prefix, then
    // reuse the shared failure builder at label 2.
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.Negate { target = error_code, value = count });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "read ") });
    push_instruction(h, Instruction.Jump { label = 2 });

    // Label 7: close, copy the read bytes into a string, and build Ok.
    push_instruction(h, Instruction.Label { label = 7 });
    int[] close_ok = new int[1];
    close_ok[0] = descriptor;
    int close_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = close_result, number = close_number, arguments = close_ok, argument_count = 1 });
    int string_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = string_request, left = total, right = sixteen });
    int[] string_args = new int[1];
    string_args[0] = string_request;
    int text_object = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = text_object, function = alloc, arguments = string_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = text_object, offset = 8, value = total });
    int string_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = string_data, left = text_object, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = text_object, offset = 16, value = string_data });
    int[] string_copy = new int[3];
    string_copy[0] = string_data;
    string_copy[1] = buffer_data;
    string_copy[2] = total;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = string_copy, argument_count = 3 });
    int[] ok_args = new int[1];
    ok_args[0] = twenty_four;
    int ok_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_raw, function = alloc, arguments = ok_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 8, value = zero });
    int ok_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = ok_bits, source = text_object });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 16, value = ok_bits });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_raw });
    push_instruction(h, Instruction.Return { value = ok_result });
    return reader;
}

// add_read_file_shell registers "$read_file": the fatal whole-file read.
// It mirrors the C runtime's pcy_rt_read_file: fopen-style open, a size
// from fstat, a 256 MiB limit, and the exact `read_file: ...` messages on
// failure, each routed through "$fail_blob" (which prefixes `purr: ` and
// exits 1). Labels: 0 open fail, 1 open ok, 2 stat fail, 3 after stat,
// 4 too large, 5 read head, 6 read body, 7 read fail, 8 finish,
// 9 zero check, 10 accumulate.
public fn add_read_file_shell(NativeScene scene, int alloc, int c_path, int errno_reason, int string_concat, int fail_blob) -> int {
    int reader = add_function(scene, "$read_file", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, reader);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int seventeen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = seventeen, value = 17 });
    int max_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = max_size, value = 268435456 });
    int open_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = open_number, value = 2 });
    int close_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = close_number, value = 3 });
    int read_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = read_number, value = 0 });
    int fstat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = fstat_number, value = 5 });
    int stat_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_size, value = 144 });
    int type_mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = type_mask, value = 61440 });
    int regular_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = regular_type, value = 32768 });
    int directory_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = directory_type, value = 16384 });

    int[] path_args = new int[1];
    path_args[0] = 0;
    int path_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = path_buffer, function = c_path, arguments = path_args, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = path_buffer, right = eight });
    int[] open_args = new int[3];
    open_args[0] = path_data;
    open_args[1] = zero;
    open_args[2] = zero;
    int descriptor = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = descriptor, number = open_number, arguments = open_args, argument_count = 3 });
    int open_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = open_failed, left = descriptor, right = zero });
    push_instruction(h, Instruction.Branch { condition = open_failed, label_true = 0, label_false = 1 });

    int error_code = new_temporary(h, NativeType.Int);
    int reason = new_temporary(h, NativeType.Ref);
    int message = new_temporary(h, NativeType.Ref);
    int null_ref = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = null_ref, source = zero });

    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Negate { target = error_code, value = descriptor });
    int[] open_reason_args = new int[1];
    open_reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = open_reason_args, argument_count = 1 });
    int open_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = open_prefix, blob = add_blob(scene, "read_file: cannot open '") });
    int open_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = open_colon, blob = add_blob(scene, "': ") });
    message = concat_twice(h, string_concat, open_prefix, 0, open_colon, reason);
    int[] open_fail_args = new int[1];
    open_fail_args[0] = message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = open_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 1 });
    int[] stat_alloc = new int[1];
    stat_alloc[0] = stat_size;
    int stat_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = stat_buffer, function = alloc, arguments = stat_alloc, argument_count = 1 });
    int stat_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = stat_data, left = stat_buffer, right = eight });
    int[] stat_args = new int[2];
    stat_args[0] = descriptor;
    stat_args[1] = stat_data;
    int stat_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = stat_result, number = fstat_number, arguments = stat_args, argument_count = 2 });
    int stat_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = stat_failed, left = stat_result, right = zero });
    push_instruction(h, Instruction.Branch { condition = stat_failed, label_true = 2, label_false = 3 });

    push_instruction(h, Instruction.Label { label = 2 });
    int[] stat_close = new int[1];
    stat_close[0] = descriptor;
    int stat_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = stat_close_ignored, number = close_number, arguments = stat_close, argument_count = 1 });
    push_instruction(h, Instruction.Negate { target = error_code, value = stat_result });
    int[] stat_reason_args = new int[1];
    stat_reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = stat_reason_args, argument_count = 1 });
    int stat_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = stat_prefix, blob = add_blob(scene, "read_file: cannot determine the size of '") });
    int stat_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = stat_colon, blob = add_blob(scene, "': ") });
    message = concat_twice(h, string_concat, stat_prefix, 0, stat_colon, reason);
    int[] stat_fail_args = new int[1];
    stat_fail_args[0] = message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = stat_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 3 });
    int size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = size, address = stat_data, offset = 48 });
    // The C runtime sizes the file with fseek/ftell, which fails for a
    // directory (EINVAL) and for other non-regular files (ESPIPE); mirror
    // that before trusting the fstat size.
    int mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = mode, address = stat_data, offset = 24 });
    int file_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = file_type, left = mode, right = type_mask });
    int regular = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = regular, left = file_type, right = regular_type });
    push_instruction(h, Instruction.Branch { condition = regular, label_true = 12, label_false = 15 });
    push_instruction(h, Instruction.Label { label = 15 });
    int is_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_directory, left = file_type, right = directory_type });
    push_instruction(h, Instruction.Branch { condition = is_directory, label_true = 13, label_false = 14 });

    push_instruction(h, Instruction.Label { label = 13 });
    int[] directory_close = new int[1];
    directory_close[0] = descriptor;
    int directory_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = directory_close_ignored, number = close_number, arguments = directory_close, argument_count = 1 });
    int directory_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = directory_prefix, blob = add_blob(scene, "read_file: cannot determine the size of '") });
    int directory_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = directory_colon, blob = add_blob(scene, "': ") });
    int directory_reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = directory_reason, blob = add_blob(scene, "Invalid argument") });
    int directory_message = new_temporary(h, NativeType.Ref);
    directory_message = concat_twice(h, string_concat, directory_prefix, 0, directory_colon, directory_reason);
    int[] directory_fail_args = new int[1];
    directory_fail_args[0] = directory_message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = directory_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 14 });
    int[] special_close = new int[1];
    special_close[0] = descriptor;
    int special_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = special_close_ignored, number = close_number, arguments = special_close, argument_count = 1 });
    int special_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = special_prefix, blob = add_blob(scene, "read_file: cannot determine the size of '") });
    int special_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = special_colon, blob = add_blob(scene, "': ") });
    int special_reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = special_reason, blob = add_blob(scene, "Illegal seek") });
    int special_message = new_temporary(h, NativeType.Ref);
    special_message = concat_twice(h, string_concat, special_prefix, 0, special_colon, special_reason);
    int[] special_fail_args = new int[1];
    special_fail_args[0] = special_message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = special_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 12 });
    int too_large = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = too_large, left = max_size, right = size });
    push_instruction(h, Instruction.Branch { condition = too_large, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    int[] large_close = new int[1];
    large_close[0] = descriptor;
    int large_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = large_close_ignored, number = close_number, arguments = large_close, argument_count = 1 });
    int large_message = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = large_message, blob = add_blob(scene, "read_file: file is larger than the maximum supported size") });
    int[] large_fail_args = new int[1];
    large_fail_args[0] = large_message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = large_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 5 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = size, right = seventeen });
    int[] object_alloc = new int[1];
    object_alloc[0] = request;
    int object = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = object, function = alloc, arguments = object_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = object, offset = 8, value = size });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = data, left = object, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = object, offset = 16, value = data });
    int total = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = total, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    int remaining = new_temporary(h, NativeType.Int);
    int address = new_temporary(h, NativeType.Int);
    int count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.LessThan { target = more, left = total, right = size });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 7, label_false = 8 });
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Subtract { target = remaining, left = size, right = total });
    push_instruction(h, Instruction.Add { target = address, left = data, right = total });
    int[] read_args = new int[3];
    read_args[0] = descriptor;
    read_args[1] = address;
    read_args[2] = remaining;
    push_instruction(h, Instruction.RawSyscall { target = count, number = read_number, arguments = read_args, argument_count = 3 });
    int read_bad = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = read_bad, left = count, right = zero });
    int read_empty = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = read_empty, left = count, right = zero });
    push_instruction(h, Instruction.Branch { condition = read_bad, label_true = 9, label_false = 10 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.Branch { condition = read_empty, label_true = 8, label_false = 11 });
    push_instruction(h, Instruction.Label { label = 11 });
    push_instruction(h, Instruction.Add { target = total, left = total, right = count });
    push_instruction(h, Instruction.Jump { label = 6 });

    push_instruction(h, Instruction.Label { label = 9 });
    int[] read_close = new int[1];
    read_close[0] = descriptor;
    int read_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = read_close_ignored, number = close_number, arguments = read_close, argument_count = 1 });
    push_instruction(h, Instruction.Negate { target = error_code, value = count });
    int[] read_reason_args = new int[1];
    read_reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = read_reason_args, argument_count = 1 });
    int read_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = read_prefix, blob = add_blob(scene, "read_file: cannot read '") });
    int read_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = read_colon, blob = add_blob(scene, "': ") });
    message = concat_twice(h, string_concat, read_prefix, 0, read_colon, reason);
    int[] read_fail_args = new int[1];
    read_fail_args[0] = message;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = read_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = null_ref });

    push_instruction(h, Instruction.Label { label = 8 });
    int[] finish_close = new int[1];
    finish_close[0] = descriptor;
    int finish_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = finish_close_ignored, number = close_number, arguments = finish_close, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = object, offset = 8, value = total });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = terminator, left = data, right = total });
    push_instruction(h, Instruction.RawStore8 { address = terminator, offset = 0, value = zero });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = object });
    push_instruction(h, Instruction.Return { value = result });
    return reader;
}

// concat_twice builds prefix + path + colon + reason through three
// string_concat calls.
fn concat_twice(NativeFunction h, int string_concat, int prefix, int path, int colon, int reason) -> int {
    int first = new_temporary(h, NativeType.Ref);
    int[] first_args = new int[2];
    first_args[0] = prefix;
    first_args[1] = path;
    push_instruction(h, Instruction.Call { target = first, function = string_concat, arguments = first_args, argument_count = 2 });
    int second = new_temporary(h, NativeType.Ref);
    int[] second_args = new int[2];
    second_args[0] = first;
    second_args[1] = colon;
    push_instruction(h, Instruction.Call { target = second, function = string_concat, arguments = second_args, argument_count = 2 });
    int third = new_temporary(h, NativeType.Ref);
    int[] third_args = new int[2];
    third_args[0] = second;
    third_args[1] = reason;
    push_instruction(h, Instruction.Call { target = third, function = string_concat, arguments = third_args, argument_count = 2 });
    return third;
}

// add_try_write_common_shell registers "$try_write_common": create or
// truncate the path with mode 0644, write the bytes, close, and build
// FileResult. Labels: 0 open fail, 1 open ok, 2 write error, 3 short write,
// 4 close fail, 5 Ok, 6 errno reason, 7 message builder, 8 write loop,
// 9 write body, 10 accumulate, 11 done.
public fn add_try_write_common_shell(NativeScene scene, int alloc, int copy_bytes, int string_concat, int errno_reason) -> int {
    int writer = add_function(scene, "$try_write_common", NativeType.Ref, ref_int_int_parameters(), 3);
    NativeFunction h = function_at(scene, writer);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int close_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = close_number, value = 3 });
    int write_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = write_number, value = 1 });
    int open_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = open_number, value = 2 });
    int flags = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = flags, value = 577 });
    int mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mode, value = 420 });

    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = length, right = one });
    int[] path_alloc = new int[1];
    path_alloc[0] = request;
    int path_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = path_buffer, function = alloc, arguments = path_alloc, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = path_buffer, right = eight });
    int[] path_copy = new int[3];
    path_copy[0] = path_data;
    path_copy[1] = data;
    path_copy[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = path_copy, argument_count = 3 });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = terminator, left = path_data, right = length });
    push_instruction(h, Instruction.RawStore8 { address = terminator, offset = 0, value = zero });

    int[] open_args = new int[3];
    open_args[0] = path_data;
    open_args[1] = flags;
    open_args[2] = mode;
    int descriptor = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = descriptor, number = open_number, arguments = open_args, argument_count = 3 });
    int open_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = open_failed, left = descriptor, right = zero });
    push_instruction(h, Instruction.Branch { condition = open_failed, label_true = 0, label_false = 1 });

    push_instruction(h, Instruction.Label { label = 0 });
    int error_code = new_temporary(h, NativeType.Int);
    int fail_prefix = new_temporary(h, NativeType.Ref);
    int reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Negate { target = error_code, value = descriptor });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "open ") });
    push_instruction(h, Instruction.Jump { label = 6 });

    push_instruction(h, Instruction.Label { label = 1 });
    int total = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = total, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    int remaining = new_temporary(h, NativeType.Int);
    int address = new_temporary(h, NativeType.Int);
    int count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.LessThan { target = more, left = total, right = 2 });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 9, label_false = 12 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.Subtract { target = remaining, left = 2, right = total });
    push_instruction(h, Instruction.Add { target = address, left = 1, right = total });
    int[] write_args = new int[3];
    write_args[0] = descriptor;
    write_args[1] = address;
    write_args[2] = remaining;
    push_instruction(h, Instruction.RawSyscall { target = count, number = write_number, arguments = write_args, argument_count = 3 });
    int write_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = write_failed, left = count, right = zero });
    int short_write = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = short_write, left = count, right = zero });
    push_instruction(h, Instruction.Branch { condition = write_failed, label_true = 2, label_false = 10 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.Branch { condition = short_write, label_true = 3, label_false = 11 });
    push_instruction(h, Instruction.Label { label = 11 });
    push_instruction(h, Instruction.Add { target = total, left = total, right = count });
    push_instruction(h, Instruction.Jump { label = 8 });

    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Negate { target = error_code, value = count });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "write ") });
    push_instruction(h, Instruction.Jump { label = 6 });

    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "write ") });
    push_instruction(h, Instruction.ConstRefData { target = reason, blob = add_blob(scene, "short write") });
    push_instruction(h, Instruction.Jump { label = 7 });

    push_instruction(h, Instruction.Label { label = 12 });
    int[] close_args = new int[1];
    close_args[0] = descriptor;
    int close_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = close_result, number = close_number, arguments = close_args, argument_count = 1 });
    int close_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = close_failed, left = close_result, right = zero });
    push_instruction(h, Instruction.Branch { condition = close_failed, label_true = 4, label_false = 5 });

    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Negate { target = error_code, value = close_result });
    push_instruction(h, Instruction.ConstRefData { target = fail_prefix, blob = add_blob(scene, "close ") });
    push_instruction(h, Instruction.Jump { label = 6 });

    push_instruction(h, Instruction.Label { label = 5 });
    int[] ok_args = new int[1];
    ok_args[0] = sixteen;
    int ok_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_raw, function = alloc, arguments = ok_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 8, value = zero });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_raw });
    push_instruction(h, Instruction.Return { value = ok_result });

    push_instruction(h, Instruction.Label { label = 6 });
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    push_instruction(h, Instruction.Jump { label = 7 });

    push_instruction(h, Instruction.Label { label = 7 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    int message = new_temporary(h, NativeType.Ref);
    message = concat_twice(h, string_concat, fail_prefix, 0, colon, reason);
    int[] failed_args = new int[1];
    failed_args[0] = sixteen;
    int failed_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_raw, function = alloc, arguments = failed_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 8, value = one });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = message });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 16, value = message_bits });
    int failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failed_result, source = failed_raw });
    push_instruction(h, Instruction.Return { value = failed_result });
    return writer;
}

// add_try_write_file_shell registers "$try_write_file": the string's payload
// through the common writer.
public fn add_try_write_file_shell(NativeScene scene, int common) -> int {
    int writer = add_function(scene, "$try_write_file", NativeType.Ref, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, writer);
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 1, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 1, offset = 16 });
    int[] args = new int[3];
    args[0] = 0;
    args[1] = data;
    args[2] = length;
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = result, function = common, arguments = args, argument_count = 3 });
    push_instruction(h, Instruction.Return { value = result });
    return writer;
}

// add_try_write_bytes_shell registers "$try_write_bytes": validate the byte
// array's identity, then hand its length and payload to the common writer.
public fn add_try_write_bytes_shell(NativeScene scene, int common, int fail_blob) -> int {
    int writer = add_function(scene, "$try_write_bytes", NativeType.Ref, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, writer);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = zero });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 1 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = add_blob(scene, "try_write_bytes received a null byte array") });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 1 });
    int element_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = element_size, address = 1, offset = 16 });
    int unit = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = unit, left = element_size, right = one });
    push_instruction(h, Instruction.Branch { condition = unit, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    int bad_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = bad_text, blob = add_blob(scene, "try_write_bytes received a non-byte array") });
    int[] bad_args = new int[1];
    bad_args[0] = bad_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = bad_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 2 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 1, offset = 8 });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = base, address = 1, offset = 24 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = data, left = base, right = eight });
    int[] args = new int[3];
    args[0] = 0;
    args[1] = data;
    args[2] = length;
    push_instruction(h, Instruction.Call { target = result, function = common, arguments = args, argument_count = 3 });
    push_instruction(h, Instruction.Return { value = result });
    return writer;
}

// add_c_path_shell registers "$c_path": copy a string object's bytes into a
// fresh NUL-terminated buffer and return the buffer object. Callers add the
// object's payload offset (8) before a syscall, so the buffer stays visible
// to the collector while it is live.
public fn add_c_path_shell(NativeScene scene, int alloc, int copy_bytes) -> int {
    int convert = add_function(scene, "$c_path", NativeType.Int, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, convert);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = length, right = one });
    int[] alloc_args = new int[1];
    alloc_args[0] = request;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = alloc, arguments = alloc_args, argument_count = 1 });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = buffer, right = eight });
    int[] copy_args = new int[3];
    copy_args[0] = payload;
    copy_args[1] = data;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = terminator, left = payload, right = length });
    push_instruction(h, Instruction.RawStore8 { address = terminator, offset = 0, value = zero });
    push_instruction(h, Instruction.Return { value = buffer });
    return convert;
}

// add_file_failed_shell registers "$file_failed": build FileResult.Failed
// with one message (tag 1 at offset 8, message at offset 16).
public fn add_file_failed_shell(NativeScene scene, int alloc) -> int {
    int fail = add_function(scene, "$file_failed", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, fail);
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int[] alloc_args = new int[1];
    alloc_args[0] = sixteen;
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = one });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = 0 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 16, value = message_bits });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = raw });
    push_instruction(h, Instruction.Return { value = result });
    return fail;
}

// add_file_ok_shell registers "$file_ok": build FileResult.Ok, tag 0.
public fn add_file_ok_shell(NativeScene scene, int alloc) -> int {
    int ok = add_function(scene, "$file_ok", NativeType.Ref, new NativeType[0], 0);
    NativeFunction h = function_at(scene, ok);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int[] alloc_args = new int[1];
    alloc_args[0] = sixteen;
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = zero });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = raw });
    push_instruction(h, Instruction.Return { value = result });
    return ok;
}

// add_try_create_directory_shell registers "$try_create_directory": mkdir
// with mode 0755 and a FileResult.
public fn add_try_create_directory_shell(NativeScene scene, int c_path, int errno_reason, int string_concat, int file_failed, int file_ok) -> int {
    int shell = add_function(scene, "$try_create_directory", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mode, value = 493 });
    int mkdir_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mkdir_number, value = 83 });

    int[] path_args = new int[1];
    path_args[0] = 0;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = c_path, arguments = path_args, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = buffer, right = eight });
    int[] mkdir_args = new int[2];
    mkdir_args[0] = path_data;
    mkdir_args[1] = mode;
    int made = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = made, number = mkdir_number, arguments = mkdir_args, argument_count = 2 });
    int failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = failed, left = made, right = zero });
    push_instruction(h, Instruction.Branch { condition = failed, label_true = 0, label_false = 1 });

    push_instruction(h, Instruction.Label { label = 0 });
    int error_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = error_code, value = made });
    int reason = new_temporary(h, NativeType.Ref);
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "mkdir ") });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    int message = new_temporary(h, NativeType.Ref);
    message = concat_twice(h, string_concat, prefix, 0, colon, reason);
    int failed_result = new_temporary(h, NativeType.Ref);
    int[] failed_args = new int[1];
    failed_args[0] = message;
    push_instruction(h, Instruction.Call { target = failed_result, function = file_failed, arguments = failed_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = failed_result });

    push_instruction(h, Instruction.Label { label = 1 });
    int ok_result = new_temporary(h, NativeType.Ref);
    int[] no_args = new int[0];
    push_instruction(h, Instruction.Call { target = ok_result, function = file_ok, arguments = no_args, argument_count = 0 });
    push_instruction(h, Instruction.Return { value = ok_result });
    return shell;
}

// add_try_remove_shell registers "$try_remove": lstat to choose rmdir or
// unlink, then a FileResult. Labels: 0 fail, 2 after lstat, 3 rmdir, 4 unlink,
// 5 after removal, 6 ok, 7 message.
public fn add_try_remove_shell(NativeScene scene, int alloc, int c_path, int errno_reason, int string_concat, int file_failed, int file_ok) -> int {
    int shell = add_function(scene, "$try_remove", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int stat_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_size, value = 144 });
    int lstat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = lstat_number, value = 6 });
    int rmdir_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = rmdir_number, value = 84 });
    int unlink_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = unlink_number, value = 87 });
    int mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mask, value = 61440 });
    int directory_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = directory_type, value = 16384 });

    int[] path_args = new int[1];
    path_args[0] = 0;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = c_path, arguments = path_args, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = buffer, right = eight });

    int[] stat_alloc = new int[1];
    stat_alloc[0] = stat_size;
    int stat_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = stat_buffer, function = alloc, arguments = stat_alloc, argument_count = 1 });
    int stat_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = stat_data, left = stat_buffer, right = eight });
    int[] lstat_args = new int[2];
    lstat_args[0] = path_data;
    lstat_args[1] = stat_data;
    int stat_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = stat_result, number = lstat_number, arguments = lstat_args, argument_count = 2 });
    int stat_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = stat_failed, left = stat_result, right = zero });
    int error_code = new_temporary(h, NativeType.Int);
    int removal = new_temporary(h, NativeType.Int);
    int reason = new_temporary(h, NativeType.Ref);
    int prefix = new_temporary(h, NativeType.Ref);
    int message = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Branch { condition = stat_failed, label_true = 0, label_false = 1 });

    // Label 0: lstat failure, with the errno the lstat returned.
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Negate { target = error_code, value = stat_result });
    push_instruction(h, Instruction.Jump { label = 6 });

    push_instruction(h, Instruction.Label { label = 1 });
    int mode_word = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = mode_word, address = stat_data, offset = 24 });
    int type_word = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = type_word, left = mode_word, right = mask });
    int is_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_directory, left = type_word, right = directory_type });
    push_instruction(h, Instruction.Branch { condition = is_directory, label_true = 2, label_false = 3 });

    push_instruction(h, Instruction.Label { label = 2 });
    int[] rmdir_args = new int[1];
    rmdir_args[0] = path_data;
    push_instruction(h, Instruction.RawSyscall { target = removal, number = rmdir_number, arguments = rmdir_args, argument_count = 1 });
    push_instruction(h, Instruction.Jump { label = 4 });

    push_instruction(h, Instruction.Label { label = 3 });
    int[] unlink_args = new int[1];
    unlink_args[0] = path_data;
    push_instruction(h, Instruction.RawSyscall { target = removal, number = unlink_number, arguments = unlink_args, argument_count = 1 });

    push_instruction(h, Instruction.Label { label = 4 });
    int removal_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = removal_failed, left = removal, right = zero });
    push_instruction(h, Instruction.Branch { condition = removal_failed, label_true = 7, label_false = 5 });

    push_instruction(h, Instruction.Label { label = 5 });
    int ok_result = new_temporary(h, NativeType.Ref);
    int[] no_args = new int[0];
    push_instruction(h, Instruction.Call { target = ok_result, function = file_ok, arguments = no_args, argument_count = 0 });
    push_instruction(h, Instruction.Return { value = ok_result });

    // Label 7: removal failure, with the errno the removal returned.
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Negate { target = error_code, value = removal });

    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "remove ") });
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    message = concat_twice(h, string_concat, prefix, 0, colon, reason);
    int failed_result = new_temporary(h, NativeType.Ref);
    int[] failed_args = new int[1];
    failed_args[0] = message;
    push_instruction(h, Instruction.Call { target = failed_result, function = file_failed, arguments = failed_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = failed_result });
    return shell;
}

// add_bool_int_shell registers "$bool_int": one bool in, int 0/1 out. The
// scene's RawStore8 takes an int value, and union bool fields are stored one
// byte at a time.
public fn add_bool_int_shell(NativeScene scene) -> int {
    int convert = add_function(scene, "$bool_int", NativeType.Int, one_bool_parameter(), 1);
    NativeFunction h = function_at(scene, convert);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = result, source = zero });
    push_instruction(h, Instruction.Branch { condition = 0, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Copy { target = result, source = one });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Return { value = result });
    return convert;
}

// add_try_file_info_shell registers "$try_file_info": lstat classification,
// symlink following, access(X_OK), and FileInfoResult. Labels: 0 lstat fail,
// 1 lstat ok, 2 symlink stat, 3 stat ok, 4 Ok, 5 Missing, 6 failure builder,
// 7 stat fail, 8 lstat prefix, 9 stat prefix.
public fn add_try_file_info_shell(NativeScene scene, int alloc, int c_path, int errno_reason, int string_concat, int bool_int) -> int {
    int shell = add_function(scene, "$try_file_info", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int twenty = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty, value = 20 });
    int thirty_two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_two, value = 32 });
    int stat_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_size, value = 144 });
    int lstat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = lstat_number, value = 6 });
    int stat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_number, value = 4 });
    int access_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = access_number, value = 21 });
    int execute = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = execute, value = 1 });
    int mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mask, value = 61440 });
    int regular_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = regular_type, value = 32768 });
    int directory_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = directory_type, value = 16384 });
    int link_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = link_type, value = 40960 });

    int[] path_args = new int[1];
    path_args[0] = 0;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = c_path, arguments = path_args, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = buffer, right = eight });

    int[] first_alloc = new int[1];
    first_alloc[0] = stat_size;
    int first_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = first_buffer, function = alloc, arguments = first_alloc, argument_count = 1 });
    int first_stat = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = first_stat, left = first_buffer, right = eight });
    int[] first_args = new int[2];
    first_args[0] = path_data;
    first_args[1] = first_stat;
    int first_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = first_result, number = lstat_number, arguments = first_args, argument_count = 2 });
    int first_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = first_failed, left = first_result, right = zero });
    int error_code = new_temporary(h, NativeType.Int);
    int prefix = new_temporary(h, NativeType.Ref);
    int message = new_temporary(h, NativeType.Ref);
    int reason = new_temporary(h, NativeType.Ref);
    int is_symlink = new_temporary(h, NativeType.Bool);
    int followed_mode = new_temporary(h, NativeType.Int);
    int followed_stat = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Branch { condition = first_failed, label_true = 0, label_false = 1 });

    // Label 0: lstat failed; ENOENT and ENOTDIR are Missing.
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Negate { target = error_code, value = first_result });
    int no_entry = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = no_entry, left = error_code, right = two });
    push_instruction(h, Instruction.Branch { condition = no_entry, label_true = 5, label_false = 12 });
    push_instruction(h, Instruction.Label { label = 12 });
    int not_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = not_directory, left = error_code, right = twenty });
    push_instruction(h, Instruction.Branch { condition = not_directory, label_true = 5, label_false = 8 });

    // Label 1: lstat succeeded. Classify the link itself first.
    push_instruction(h, Instruction.Label { label = 1 });
    int first_mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = first_mode, address = first_stat, offset = 24 });
    int first_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = first_type, left = first_mode, right = mask });
    push_instruction(h, Instruction.Equal { target = is_symlink, left = first_type, right = link_type });
    push_instruction(h, Instruction.Copy { target = followed_mode, source = first_mode });
    push_instruction(h, Instruction.Copy { target = followed_stat, source = first_stat });
    push_instruction(h, Instruction.Branch { condition = is_symlink, label_true = 2, label_false = 4 });

    // Label 2: follow the link with stat.
    push_instruction(h, Instruction.Label { label = 2 });
    int[] second_alloc = new int[1];
    second_alloc[0] = stat_size;
    int second_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = second_buffer, function = alloc, arguments = second_alloc, argument_count = 1 });
    int second_stat = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = second_stat, left = second_buffer, right = eight });
    int[] second_args = new int[2];
    second_args[0] = path_data;
    second_args[1] = second_stat;
    int second_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = second_result, number = stat_number, arguments = second_args, argument_count = 2 });
    int second_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = second_failed, left = second_result, right = zero });
    push_instruction(h, Instruction.Branch { condition = second_failed, label_true = 7, label_false = 3 });

    // Label 3: use the followed stat for classification.
    push_instruction(h, Instruction.Label { label = 3 });
    int second_mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = second_mode, address = second_stat, offset = 24 });
    push_instruction(h, Instruction.Copy { target = followed_mode, source = second_mode });
    push_instruction(h, Instruction.Copy { target = followed_stat, source = second_stat });
    push_instruction(h, Instruction.Jump { label = 4 });

    // Label 7: stat failed; ENOENT/ENOTDIR keeps the dangling link as Ok.
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Negate { target = error_code, value = second_result });
    int stat_no_entry = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = stat_no_entry, left = error_code, right = two });
    push_instruction(h, Instruction.Branch { condition = stat_no_entry, label_true = 4, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 13 });
    int stat_not_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = stat_not_directory, left = error_code, right = twenty });
    push_instruction(h, Instruction.Branch { condition = stat_not_directory, label_true = 4, label_false = 9 });

    // Label 4: build FileInfoResult.Ok.
    push_instruction(h, Instruction.Label { label = 4 });
    int followed_type = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = followed_type, left = followed_mode, right = mask });
    int is_file = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_file, left = followed_type, right = regular_type });
    int is_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_directory, left = followed_type, right = directory_type });
    int size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = size, value = 0 });
    push_instruction(h, Instruction.Branch { condition = is_file, label_true = 10, label_false = 11 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.RawLoad64 { target = size, address = followed_stat, offset = 48 });
    push_instruction(h, Instruction.Label { label = 11 });
    int[] access_args = new int[2];
    access_args[0] = path_data;
    access_args[1] = execute;
    int access_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = access_result, number = access_number, arguments = access_args, argument_count = 2 });
    int executable = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = executable, left = access_result, right = zero });
    int[] ok_alloc = new int[1];
    ok_alloc[0] = thirty_two;
    int ok_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_raw, function = alloc, arguments = ok_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 8, value = zero });
    int is_file_byte = new_temporary(h, NativeType.Int);
    int[] is_file_args = new int[1];
    is_file_args[0] = is_file;
    push_instruction(h, Instruction.Call { target = is_file_byte, function = bool_int, arguments = is_file_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore8 { address = ok_raw, offset = 16, value = is_file_byte });
    int is_directory_byte = new_temporary(h, NativeType.Int);
    int[] is_directory_args = new int[1];
    is_directory_args[0] = is_directory;
    push_instruction(h, Instruction.Call { target = is_directory_byte, function = bool_int, arguments = is_directory_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore8 { address = ok_raw, offset = 17, value = is_directory_byte });
    int is_symlink_byte = new_temporary(h, NativeType.Int);
    int[] is_symlink_args = new int[1];
    is_symlink_args[0] = is_symlink;
    push_instruction(h, Instruction.Call { target = is_symlink_byte, function = bool_int, arguments = is_symlink_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore8 { address = ok_raw, offset = 18, value = is_symlink_byte });
    int executable_byte = new_temporary(h, NativeType.Int);
    int[] executable_args = new int[1];
    executable_args[0] = executable;
    push_instruction(h, Instruction.Call { target = executable_byte, function = bool_int, arguments = executable_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore8 { address = ok_raw, offset = 19, value = executable_byte });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 24, value = size });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_raw });
    push_instruction(h, Instruction.Return { value = ok_result });

    // Label 5: FileInfoResult.Missing.
    push_instruction(h, Instruction.Label { label = 5 });
    int[] missing_alloc = new int[1];
    missing_alloc[0] = thirty_two;
    int missing_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = missing_raw, function = alloc, arguments = missing_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = missing_raw, offset = 8, value = one });
    int missing_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = missing_result, source = missing_raw });
    push_instruction(h, Instruction.Return { value = missing_result });

    // Label 8/9: set the failing call's prefix, then the shared builder.
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "lstat ") });
    push_instruction(h, Instruction.Jump { label = 6 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "stat ") });

    // Label 6: build FileInfoResult.Failed (tag 2, message at offset 32).
    push_instruction(h, Instruction.Label { label = 6 });
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    message = concat_twice(h, string_concat, prefix, 0, colon, reason);
    int[] failed_alloc = new int[1];
    failed_alloc[0] = thirty_two;
    int failed_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_raw, function = alloc, arguments = failed_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 8, value = two });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = message });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 32, value = message_bits });
    int failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failed_result, source = failed_raw });
    push_instruction(h, Instruction.Return { value = failed_result });
    return shell;
}

// add_is_dot_entry_shell registers "$is_dot_entry": whether a directory
// entry name is exactly "." or "..".
public fn add_is_dot_entry_shell(NativeScene scene) -> int {
    int check = add_function(scene, "$is_dot_entry", NativeType.Bool, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, check);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int dot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = dot, value = 46 });
    int result = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.ConstBool { target = result, value = false });
    int first = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = first, address = 0, offset = 0 });
    int is_dot = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_dot, left = first, right = dot });
    push_instruction(h, Instruction.Branch { condition = is_dot, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 0 });
    int next = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = next, left = 0, right = one });
    int second = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = second, address = next, offset = 0 });
    int single_end = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = single_end, left = second, right = zero });
    push_instruction(h, Instruction.Branch { condition = single_end, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.ConstBool { target = result, value = true });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 3 });
    int second_dot = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = second_dot, left = second, right = dot });
    push_instruction(h, Instruction.Branch { condition = second_dot, label_true = 4, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 4 });
    int next2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = next2, left = 0, right = two });
    int third = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = third, address = next2, offset = 0 });
    int double_end = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = double_end, left = third, right = zero });
    push_instruction(h, Instruction.Branch { condition = double_end, label_true = 2, label_false = 1 });
    return check;
}

// add_string_greater_shell registers "$string_greater": bytewise a > b, with
// a longer string winning when the shorter is a prefix.
public fn add_string_greater_shell(NativeScene scene) -> int {
    int compare = add_function(scene, "$string_greater", NativeType.Bool, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, compare);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int left_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = left_length, address = 0, offset = 8 });
    int left_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = left_data, address = 0, offset = 16 });
    int right_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = right_length, address = 1, offset = 8 });
    int right_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = right_data, address = 1, offset = 16 });
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });
    int result = new_temporary(h, NativeType.Bool);
    int left_more = new_temporary(h, NativeType.Bool);
    int right_more = new_temporary(h, NativeType.Bool);
    int left_address = new_temporary(h, NativeType.Int);
    int right_address = new_temporary(h, NativeType.Int);
    int left_byte = new_temporary(h, NativeType.Int);
    int right_byte = new_temporary(h, NativeType.Int);
    int left_less = new_temporary(h, NativeType.Bool);
    int right_less = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = left_more, left = index, right = left_length });
    push_instruction(h, Instruction.Branch { condition = left_more, label_true = 3, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.LessThan { target = right_more, left = index, right = right_length });
    push_instruction(h, Instruction.Branch { condition = right_more, label_true = 4, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Add { target = left_address, left = left_data, right = index });
    push_instruction(h, Instruction.RawLoad8 { target = left_byte, address = left_address, offset = 0 });
    push_instruction(h, Instruction.Add { target = right_address, left = right_data, right = index });
    push_instruction(h, Instruction.RawLoad8 { target = right_byte, address = right_address, offset = 0 });
    push_instruction(h, Instruction.LessThan { target = left_less, left = left_byte, right = right_byte });
    push_instruction(h, Instruction.Branch { condition = left_less, label_true = 1, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.LessThan { target = right_less, left = right_byte, right = left_byte });
    push_instruction(h, Instruction.Branch { condition = right_less, label_true = 2, label_false = 6 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.ConstBool { target = result, value = false });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.ConstBool { target = result, value = true });
    push_instruction(h, Instruction.Return { value = result });
    return compare;
}

// add_try_list_directory_shell registers "$try_list_directory": two
// getdents64 passes (count, then fill), a close, an insertion sort, and
// ListDirectoryResult. Labels: 0 open fail, 1 open ok, 2 first getdents,
// 3 first read fail, 4 after first getdents, 5 first parse, 6 first record,
// 7 first count, 8 first advance, 9 first done, 10 second getdents,
// 11 second read fail, 12 after second getdents, 13 second parse,
// 14 second record, 15 second create, 16 second advance, 17 second batch,
// 18 listing done, 19 sort outer, 20 sort outer body, 21 sort inner,
// 22 sort compare, 23 sort shift, 24 sort place, 25 Ok, 26 failure.
public fn add_try_list_directory_shell(NativeScene scene, int alloc, int copy_bytes, int c_strlen, int c_path, int errno_reason, int string_concat, int array_new, int is_dot, int string_greater) -> int {
    int shell = add_function(scene, "$try_list_directory", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int open_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = open_number, value = 2 });
    int close_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = close_number, value = 3 });
    int getdents_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = getdents_number, value = 217 });
    int lseek_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = lseek_number, value = 8 });
    int directory_flag = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = directory_flag, value = 65536 });
    int buffer_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = buffer_size, value = 32768 });
    int record_length_mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = record_length_mask, value = 65535 });
    int record_length_offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = record_length_offset, value = 16 });
    int name_offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = name_offset, value = 19 });

    int[] path_args = new int[1];
    path_args[0] = 0;
    int path_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = path_buffer, function = c_path, arguments = path_args, argument_count = 1 });
    int path_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = path_data, left = path_buffer, right = eight });
    int[] open_args = new int[3];
    open_args[0] = path_data;
    open_args[1] = directory_flag;
    open_args[2] = zero;
    int descriptor = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = descriptor, number = open_number, arguments = open_args, argument_count = 3 });
    int open_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = open_failed, left = descriptor, right = zero });
    int error_code = new_temporary(h, NativeType.Int);
    int prefix = new_temporary(h, NativeType.Ref);
    int message = new_temporary(h, NativeType.Ref);
    int reason = new_temporary(h, NativeType.Ref);
    int count = new_temporary(h, NativeType.Int);
    int array = new_temporary(h, NativeType.Ref);
    int entries_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Branch { condition = open_failed, label_true = 0, label_false = 1 });

    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Negate { target = error_code, value = descriptor });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "open ") });
    push_instruction(h, Instruction.Jump { label = 26 });

    push_instruction(h, Instruction.Label { label = 1 });
    int[] dent_alloc = new int[1];
    dent_alloc[0] = buffer_size;
    int dent_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = dent_buffer, function = alloc, arguments = dent_alloc, argument_count = 1 });
    int dent_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = dent_data, left = dent_buffer, right = eight });
    push_instruction(h, Instruction.ConstInt { target = count, value = 0 });

    // First pass: count the entries.
    push_instruction(h, Instruction.Label { label = 2 });
    int[] read_args = new int[3];
    read_args[0] = descriptor;
    read_args[1] = dent_data;
    read_args[2] = buffer_size;
    int batch = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = batch, number = getdents_number, arguments = read_args, argument_count = 3 });
    int read_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = read_failed, left = batch, right = zero });
    push_instruction(h, Instruction.Branch { condition = read_failed, label_true = 3, label_false = 4 });

    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Negate { target = error_code, value = batch });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "readdirent ") });
    int[] first_close = new int[1];
    first_close[0] = descriptor;
    int first_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = first_close_ignored, number = close_number, arguments = first_close, argument_count = 1 });
    push_instruction(h, Instruction.Jump { label = 26 });

    push_instruction(h, Instruction.Label { label = 4 });
    int empty_batch = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = empty_batch, left = batch, right = zero });
    int offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = offset, value = 0 });
    push_instruction(h, Instruction.Branch { condition = empty_batch, label_true = 9, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 5 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = offset, right = batch });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 6, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 6 });
    int record = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = record, left = dent_data, right = offset });
    int record_length_word = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = record_length_word, address = record, offset = 16 });
    int record_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = record_length, left = record_length_word, right = record_length_mask });
    int name = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = name, left = record, right = name_offset });
    int dot = new_temporary(h, NativeType.Bool);
    int[] dot_args = new int[1];
    dot_args[0] = name;
    push_instruction(h, Instruction.Call { target = dot, function = is_dot, arguments = dot_args, argument_count = 1 });
    push_instruction(h, Instruction.Branch { condition = dot, label_true = 8, label_false = 7 });

    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Add { target = count, left = count, right = one });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.Add { target = offset, left = offset, right = record_length });
    push_instruction(h, Instruction.Jump { label = 5 });

    // First pass done: rewind, allocate the exact-length array, fill it.
    push_instruction(h, Instruction.Label { label = 9 });
    int[] rewind_args = new int[3];
    rewind_args[0] = descriptor;
    rewind_args[1] = zero;
    rewind_args[2] = zero;
    int rewind_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = rewind_ignored, number = lseek_number, arguments = rewind_args, argument_count = 3 });
    int[] array_args = new int[2];
    array_args[0] = count;
    array_args[1] = eight;
    push_instruction(h, Instruction.Call { target = array, function = array_new, arguments = array_args, argument_count = 2 });
    int data_base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data_base, address = array, offset = 24 });
    push_instruction(h, Instruction.Add { target = entries_data, left = data_base, right = eight });
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });

    // Second pass: create one string per entry.
    push_instruction(h, Instruction.Label { label = 10 });
    int[] read2_args = new int[3];
    read2_args[0] = descriptor;
    read2_args[1] = dent_data;
    read2_args[2] = buffer_size;
    int batch2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = batch2, number = getdents_number, arguments = read2_args, argument_count = 3 });
    int read2_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = read2_failed, left = batch2, right = zero });
    push_instruction(h, Instruction.Branch { condition = read2_failed, label_true = 11, label_false = 12 });

    push_instruction(h, Instruction.Label { label = 11 });
    push_instruction(h, Instruction.Negate { target = error_code, value = batch2 });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "readdirent ") });
    int[] second_close = new int[1];
    second_close[0] = descriptor;
    int second_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = second_close_ignored, number = close_number, arguments = second_close, argument_count = 1 });
    push_instruction(h, Instruction.Jump { label = 26 });

    push_instruction(h, Instruction.Label { label = 12 });
    int empty2 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = empty2, left = batch2, right = zero });
    int offset2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = offset2, value = 0 });
    push_instruction(h, Instruction.Branch { condition = empty2, label_true = 18, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 13 });
    int more2 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more2, left = offset2, right = batch2 });
    push_instruction(h, Instruction.Branch { condition = more2, label_true = 14, label_false = 17 });
    push_instruction(h, Instruction.Label { label = 14 });
    int record2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = record2, left = dent_data, right = offset2 });
    int record2_length_word = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = record2_length_word, address = record2, offset = 16 });
    int record2_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = record2_length, left = record2_length_word, right = record_length_mask });
    int name2 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = name2, left = record2, right = name_offset });
    int dot2 = new_temporary(h, NativeType.Bool);
    int[] dot2_args = new int[1];
    dot2_args[0] = name2;
    push_instruction(h, Instruction.Call { target = dot2, function = is_dot, arguments = dot2_args, argument_count = 1 });
    push_instruction(h, Instruction.Branch { condition = dot2, label_true = 16, label_false = 15 });

    push_instruction(h, Instruction.Label { label = 15 });
    int[] length_args = new int[1];
    length_args[0] = name2;
    int name_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = name_length, function = c_strlen, arguments = length_args, argument_count = 1 });
    int string_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = string_request, left = name_length, right = sixteen });
    int[] string_alloc = new int[1];
    string_alloc[0] = string_request;
    int text = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = text, function = alloc, arguments = string_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 8, value = name_length });
    int text_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = text_data, left = text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 16, value = text_data });
    int[] copy_args = new int[3];
    copy_args[0] = text_data;
    copy_args[1] = name2;
    copy_args[2] = name_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    int step = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = step, left = index, right = eight });
    int slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = slot, left = entries_data, right = step });
    push_instruction(h, Instruction.RawStore64 { address = slot, offset = 0, value = text });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Label { label = 16 });
    push_instruction(h, Instruction.Add { target = offset2, left = offset2, right = record2_length });
    push_instruction(h, Instruction.Jump { label = 13 });

    push_instruction(h, Instruction.Label { label = 17 });
    push_instruction(h, Instruction.Jump { label = 10 });

    // Listing done: close, then insertion-sort the names bytewise.
    push_instruction(h, Instruction.Label { label = 18 });
    int[] done_close = new int[1];
    done_close[0] = descriptor;
    int done_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = done_close_ignored, number = close_number, arguments = done_close, argument_count = 1 });
    int outer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = outer, value = 1 });
    int key = new_temporary(h, NativeType.Ref);
    int key_bits = new_temporary(h, NativeType.Int);
    int inner = new_temporary(h, NativeType.Int);
    int current = new_temporary(h, NativeType.Ref);
    int current_bits = new_temporary(h, NativeType.Int);
    int greater = new_temporary(h, NativeType.Bool);
    int negative = new_temporary(h, NativeType.Bool);
    int outer_more = new_temporary(h, NativeType.Bool);
    int address_step = new_temporary(h, NativeType.Int);
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 19 });
    push_instruction(h, Instruction.LessThan { target = outer_more, left = outer, right = count });
    push_instruction(h, Instruction.Branch { condition = outer_more, label_true = 20, label_false = 25 });
    push_instruction(h, Instruction.Label { label = 20 });
    push_instruction(h, Instruction.Multiply { target = address_step, left = outer, right = eight });
    push_instruction(h, Instruction.Add { target = address, left = entries_data, right = address_step });
    push_instruction(h, Instruction.RawLoad64 { target = key, address = address, offset = 0 });
    push_instruction(h, Instruction.Subtract { target = inner, left = outer, right = one });
    push_instruction(h, Instruction.Label { label = 21 });
    push_instruction(h, Instruction.LessThan { target = negative, left = inner, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 24, label_false = 22 });
    push_instruction(h, Instruction.Label { label = 22 });
    push_instruction(h, Instruction.Multiply { target = address_step, left = inner, right = eight });
    push_instruction(h, Instruction.Add { target = address, left = entries_data, right = address_step });
    push_instruction(h, Instruction.RawLoad64 { target = current, address = address, offset = 0 });
    int[] greater_args = new int[2];
    greater_args[0] = current;
    greater_args[1] = key;
    push_instruction(h, Instruction.Call { target = greater, function = string_greater, arguments = greater_args, argument_count = 2 });
    push_instruction(h, Instruction.Branch { condition = greater, label_true = 23, label_false = 24 });
    push_instruction(h, Instruction.Label { label = 23 });
    int next_slot = new_temporary(h, NativeType.Int);
    int next_step = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = next_step, left = inner, right = one });
    push_instruction(h, Instruction.Multiply { target = next_step, left = next_step, right = eight });
    push_instruction(h, Instruction.Add { target = next_slot, left = entries_data, right = next_step });
    push_instruction(h, Instruction.Copy { target = current_bits, source = current });
    push_instruction(h, Instruction.RawStore64 { address = next_slot, offset = 0, value = current_bits });
    push_instruction(h, Instruction.Subtract { target = inner, left = inner, right = one });
    push_instruction(h, Instruction.Jump { label = 21 });
    push_instruction(h, Instruction.Label { label = 24 });
    int place_slot = new_temporary(h, NativeType.Int);
    int place_step = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = place_step, left = inner, right = one });
    push_instruction(h, Instruction.Multiply { target = place_step, left = place_step, right = eight });
    push_instruction(h, Instruction.Add { target = place_slot, left = entries_data, right = place_step });
    push_instruction(h, Instruction.Copy { target = key_bits, source = key });
    push_instruction(h, Instruction.RawStore64 { address = place_slot, offset = 0, value = key_bits });
    push_instruction(h, Instruction.Add { target = outer, left = outer, right = one });
    push_instruction(h, Instruction.Jump { label = 19 });

    // Label 25: ListDirectoryResult.Ok { entries }.
    push_instruction(h, Instruction.Label { label = 25 });
    int[] ok_alloc = new int[1];
    ok_alloc[0] = twenty_four;
    int ok_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_raw, function = alloc, arguments = ok_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 8, value = zero });
    int array_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = array_bits, source = array });
    push_instruction(h, Instruction.RawStore64 { address = ok_raw, offset = 16, value = array_bits });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_raw });
    push_instruction(h, Instruction.Return { value = ok_result });

    // Label 26: ListDirectoryResult.Failed { message }.
    push_instruction(h, Instruction.Label { label = 26 });
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    message = concat_twice(h, string_concat, prefix, 0, colon, reason);
    int[] failed_alloc = new int[1];
    failed_alloc[0] = twenty_four;
    int failed_raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_raw, function = alloc, arguments = failed_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 8, value = one });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = message });
    push_instruction(h, Instruction.RawStore64 { address = failed_raw, offset = 24, value = message_bits });
    int failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failed_result, source = failed_raw });
    push_instruction(h, Instruction.Return { value = failed_result });
    return shell;
}

// add_string_join_path_shell registers "$string_join_path": join two path
// pieces with exactly one separator between them.
public fn add_string_join_path_shell(NativeScene scene, int string_concat) -> int {
    int join = add_function(scene, "$string_join_path", NativeType.Ref, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, join);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int slash = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = slash, value = 47 });
    int left_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = left_length, address = 0, offset = 8 });
    int left_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = left_data, address = 0, offset = 16 });
    int has_separator = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.ConstBool { target = has_separator, value = false });
    int last_index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = last_index, left = left_length, right = one });
    int last_address = new_temporary(h, NativeType.Int);
    int last_byte = new_temporary(h, NativeType.Int);
    int positive = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = positive, left = zero, right = left_length });
    push_instruction(h, Instruction.Branch { condition = positive, label_true = 2, label_false = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Add { target = last_address, left = left_data, right = last_index });
    push_instruction(h, Instruction.RawLoad8 { target = last_byte, address = last_address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = has_separator, left = last_byte, right = slash });
    push_instruction(h, Instruction.Label { label = 0 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Branch { condition = has_separator, label_true = 1, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 1 });
    int[] joined_args = new int[2];
    joined_args[0] = 0;
    joined_args[1] = 1;
    push_instruction(h, Instruction.Call { target = result, function = string_concat, arguments = joined_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 3 });
    int separator = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = separator, blob = add_blob(scene, "/") });
    int[] middle_args = new int[2];
    middle_args[0] = 0;
    middle_args[1] = separator;
    int middle = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = middle, function = string_concat, arguments = middle_args, argument_count = 2 });
    int[] full_args = new int[2];
    full_args[0] = middle;
    full_args[1] = 1;
    push_instruction(h, Instruction.Call { target = result, function = string_concat, arguments = full_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = result });
    return join;
}

// add_valid_temp_prefix_shell registers "$valid_temp_prefix": the C
// runtime's 1..64-byte [A-Za-z0-9._-] prefix rule, with ".." rejected.
public fn add_valid_temp_prefix_shell(NativeScene scene) -> int {
    int check = add_function(scene, "$valid_temp_prefix", NativeType.Bool, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, check);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int sixty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixty_four, value = 64 });
    int dot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = dot, value = 46 });
    int lower_a = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = lower_a, value = 97 });
    int lower_z = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = lower_z, value = 122 });
    int upper_a = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = upper_a, value = 65 });
    int upper_z = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = upper_z, value = 90 });
    int digit_zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = digit_zero, value = 48 });
    int digit_nine = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = digit_nine, value = 57 });
    int underscore = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = underscore, value = 95 });
    int hyphen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = hyphen, value = 45 });

    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int result = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.ConstBool { target = result, value = false });
    int below = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = below, left = length, right = one });
    push_instruction(h, Instruction.Branch { condition = below, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    int above = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = above, left = sixty_four, right = length });
    push_instruction(h, Instruction.Branch { condition = above, label_true = 0, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    int is_two = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_two, left = length, right = two });
    push_instruction(h, Instruction.Branch { condition = is_two, label_true = 3, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 3 });
    int first = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = first, address = data, offset = 0 });
    int first_dot = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = first_dot, left = first, right = dot });
    push_instruction(h, Instruction.Branch { condition = first_dot, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    int second_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = second_address, left = data, right = one });
    int second = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = second, address = second_address, offset = 0 });
    int second_dot = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = second_dot, left = second, right = dot });
    push_instruction(h, Instruction.Branch { condition = second_dot, label_true = 0, label_false = 5 });

    push_instruction(h, Instruction.Label { label = 5 });
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });
    push_instruction(h, Instruction.Label { label = 6 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = index, right = length });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 7, label_false = 8 });
    push_instruction(h, Instruction.Label { label = 7 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = address, left = data, right = index });
    int octet = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = octet, address = address, offset = 0 });
    int low = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = low, left = octet, right = digit_zero });
    push_instruction(h, Instruction.Branch { condition = low, label_true = 10, label_false = 11 });
    push_instruction(h, Instruction.Label { label = 11 });
    int high = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = high, left = digit_nine, right = octet });
    push_instruction(h, Instruction.Branch { condition = high, label_true = 12, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 12 });
    int low2 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = low2, left = octet, right = upper_a });
    push_instruction(h, Instruction.Branch { condition = low2, label_true = 10, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 13 });
    int high2 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = high2, left = upper_z, right = octet });
    push_instruction(h, Instruction.Branch { condition = high2, label_true = 14, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 14 });
    int low3 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = low3, left = octet, right = lower_a });
    push_instruction(h, Instruction.Branch { condition = low3, label_true = 10, label_false = 15 });
    push_instruction(h, Instruction.Label { label = 15 });
    int high3 = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = high3, left = lower_z, right = octet });
    push_instruction(h, Instruction.Branch { condition = high3, label_true = 16, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 16 });
    push_instruction(h, Instruction.Jump { label = 10 });
    push_instruction(h, Instruction.Label { label = 10 });
    int is_dot = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_dot, left = octet, right = dot });
    push_instruction(h, Instruction.Branch { condition = is_dot, label_true = 9, label_false = 17 });
    push_instruction(h, Instruction.Label { label = 17 });
    int is_underscore = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_underscore, left = octet, right = underscore });
    push_instruction(h, Instruction.Branch { condition = is_underscore, label_true = 9, label_false = 18 });
    push_instruction(h, Instruction.Label { label = 18 });
    int is_hyphen = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_hyphen, left = octet, right = hyphen });
    push_instruction(h, Instruction.Branch { condition = is_hyphen, label_true = 9, label_false = 0 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Jump { label = 6 });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.ConstBool { target = result, value = true });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Return { value = result });
    return check;
}

// add_temp_failed_shell registers "$temp_failed": build
// TempDirectoryResult.Failed (tag 1, message at offset 24).
public fn add_temp_failed_shell(NativeScene scene, int alloc) -> int {
    int fail = add_function(scene, "$temp_failed", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, fail);
    int one = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int[] alloc_args = new int[1];
    alloc_args[0] = twenty_four;
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = one });
    int message_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = message_bits, source = 0 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 24, value = message_bits });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = raw });
    push_instruction(h, Instruction.Return { value = result });
    return fail;
}

// add_try_create_temp_directory_shell registers
// "$try_create_temp_directory": validate the prefix, resolve the base from
// $TMPDIR or /tmp, replace the template's six `X` bytes with random
// alphanumerics, and mkdir with mode 0700, retrying on EEXIST. Labels:
// 0 invalid, 1 proceed, 2 /tmp, 3 value, 4 absolute check, 5 absolute,
// 6 relative, 7 build template, 8 cwd failed, 9 join, 10 retry,
// 11 fill head, 12 fill body, 13 mkdir, 14 success, 15 failure dispatch,
// 16 missing-code stat, 17 stat failed, 18 stat prefix, 19 mkdir prefix,
// 20 failure builder, 21 stat not-dir, 22 mkdir not-exists, 23 mkdir not-dir.
public fn add_try_create_temp_directory_shell(NativeScene scene, int alloc, int copy_bytes, int c_path, int errno_reason, int string_concat, int getenv, int current_directory, int join_path, int valid_prefix, int temp_failed) -> int {
    int shell = add_function(scene, "$try_create_temp_directory", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int six = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = six, value = 6 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int mode = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mode, value = 448 });
    int mkdir_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = mkdir_number, value = 83 });
    int stat_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_number, value = 4 });
    int getrandom_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = getrandom_number, value = 318 });
    int umask_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = umask_number, value = 95 });
    int stat_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = stat_size, value = 144 });
    int exists_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = exists_code, value = 17 });
    int no_entry_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = no_entry_code, value = 2 });
    int not_directory_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = not_directory_code, value = 20 });
    int slash = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = slash, value = 47 });
    int charset = add_blob(scene, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789");
    int charset_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = charset_size, value = 62 });

    int[] prefix_args = new int[1];
    prefix_args[0] = 0;
    int valid = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Call { target = valid, function = valid_prefix, arguments = prefix_args, argument_count = 1 });
    push_instruction(h, Instruction.Branch { condition = valid, label_true = 1, label_false = 0 });

    push_instruction(h, Instruction.Label { label = 1 });
    int tmpdir_name = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = tmpdir_name, blob = add_blob(scene, "TMPDIR") });
    int[] env_args = new int[1];
    env_args[0] = tmpdir_name;
    int env = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = env, function = getenv, arguments = env_args, argument_count = 1 });
    int env_tag = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = env_tag, address = env, offset = 8 });
    // EnvResult.Set is tag 0 and EnvResult.Unset is tag 1; the unset test
    // must compare against one, or the value field is read from a set-less
    // union.
    int env_unset = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = env_unset, left = env_tag, right = one });
    int base = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Branch { condition = env_unset, label_true = 2, label_false = 3 });

    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.ConstRefData { target = base, blob = add_blob(scene, "/tmp") });
    push_instruction(h, Instruction.Jump { label = 7 });

    push_instruction(h, Instruction.Label { label = 3 });
    int value_string = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = value_string, address = env, offset = 16 });
    int value_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = value_length, address = value_string, offset = 8 });
    int value_empty = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = value_empty, left = value_length, right = zero });
    push_instruction(h, Instruction.Branch { condition = value_empty, label_true = 2, label_false = 4 });

    push_instruction(h, Instruction.Label { label = 4 });
    int value_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = value_data, address = value_string, offset = 16 });
    int value_first = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = value_first, address = value_data, offset = 0 });
    int absolute = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = absolute, left = value_first, right = slash });
    push_instruction(h, Instruction.Branch { condition = absolute, label_true = 5, label_false = 6 });

    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Copy { target = base, source = value_string });
    push_instruction(h, Instruction.Jump { label = 7 });

    push_instruction(h, Instruction.Label { label = 6 });
    int cwd = new_temporary(h, NativeType.Ref);
    int[] no_args = new int[0];
    push_instruction(h, Instruction.Call { target = cwd, function = current_directory, arguments = no_args, argument_count = 0 });
    int cwd_tag = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = cwd_tag, address = cwd, offset = 8 });
    int cwd_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = cwd_failed, left = cwd_tag, right = one });
    push_instruction(h, Instruction.Branch { condition = cwd_failed, label_true = 8, label_false = 9 });

    push_instruction(h, Instruction.Label { label = 8 });
    int cwd_message = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = cwd_message, address = cwd, offset = 24 });
    int[] cwd_fail_args = new int[1];
    cwd_fail_args[0] = cwd_message;
    int cwd_failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = cwd_failed_result, function = temp_failed, arguments = cwd_fail_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = cwd_failed_result });

    push_instruction(h, Instruction.Label { label = 9 });
    int cwd_path = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = cwd_path, address = cwd, offset = 16 });
    int[] join_args = new int[2];
    join_args[0] = cwd_path;
    join_args[1] = value_string;
    push_instruction(h, Instruction.Call { target = base, function = join_path, arguments = join_args, argument_count = 2 });
    push_instruction(h, Instruction.Jump { label = 7 });

    push_instruction(h, Instruction.Label { label = 7 });
    int joined = new_temporary(h, NativeType.Ref);
    int[] base_args = new int[2];
    base_args[0] = base;
    base_args[1] = 0;
    push_instruction(h, Instruction.Call { target = joined, function = join_path, arguments = base_args, argument_count = 2 });
    int suffix_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = suffix_text, blob = add_blob(scene, ".XXXXXX") });
    int template = new_temporary(h, NativeType.Ref);
    int[] suffix_args = new int[2];
    suffix_args[0] = joined;
    suffix_args[1] = suffix_text;
    push_instruction(h, Instruction.Call { target = template, function = string_concat, arguments = suffix_args, argument_count = 2 });
    int template_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = template_length, address = template, offset = 8 });
    int template_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = template_data, address = template, offset = 16 });
    int mutable_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = mutable_request, left = template_length, right = one });
    int[] mutable_alloc = new int[1];
    mutable_alloc[0] = mutable_request;
    int mutable = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = mutable, function = alloc, arguments = mutable_alloc, argument_count = 1 });
    int mutable_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = mutable_data, left = mutable, right = eight });
    int[] mutable_copy = new int[3];
    mutable_copy[0] = mutable_data;
    mutable_copy[1] = template_data;
    mutable_copy[2] = template_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = mutable_copy, argument_count = 3 });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = terminator, left = mutable_data, right = template_length });
    push_instruction(h, Instruction.RawStore8 { address = terminator, offset = 0, value = zero });
    int suffix_start = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = suffix_start, left = template_length, right = six });
    int suffix_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = suffix_address, left = mutable_data, right = suffix_start });

    push_instruction(h, Instruction.Label { label = 10 });
    int[] random_args = new int[3];
    random_args[0] = suffix_address;
    random_args[1] = six;
    random_args[2] = zero;
    int random_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = random_result, number = getrandom_number, arguments = random_args, argument_count = 3 });
    int fill = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = fill, value = 0 });
    push_instruction(h, Instruction.Label { label = 11 });
    int fill_more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = fill_more, left = fill, right = six });
    push_instruction(h, Instruction.Branch { condition = fill_more, label_true = 12, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 12 });
    int fill_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = fill_address, left = suffix_address, right = fill });
    int random_byte = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = random_byte, address = fill_address, offset = 0 });
    int char_index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = char_index, left = random_byte, right = charset_size });
    int charset_object = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = charset_object, blob = charset });
    int charset_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = charset_data, address = charset_object, offset = 16 });
    int char_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = char_address, left = charset_data, right = char_index });
    int char_value = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = char_value, address = char_address, offset = 0 });
    push_instruction(h, Instruction.RawStore8 { address = fill_address, offset = 0, value = char_value });
    push_instruction(h, Instruction.Add { target = fill, left = fill, right = one });
    push_instruction(h, Instruction.Jump { label = 11 });

    push_instruction(h, Instruction.Label { label = 13 });
    int[] umask_zero = new int[1];
    umask_zero[0] = zero;
    int previous_umask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = previous_umask, number = umask_number, arguments = umask_zero, argument_count = 1 });
    int[] mkdir_args = new int[2];
    mkdir_args[0] = mutable_data;
    mkdir_args[1] = mode;
    int made = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = made, number = mkdir_number, arguments = mkdir_args, argument_count = 2 });
    int[] umask_restore = new int[1];
    umask_restore[0] = previous_umask;
    int restore_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = restore_ignored, number = umask_number, arguments = umask_restore, argument_count = 1 });
    int succeeded = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = succeeded, left = made, right = zero });
    push_instruction(h, Instruction.Branch { condition = succeeded, label_true = 14, label_false = 15 });

    push_instruction(h, Instruction.Label { label = 14 });
    int string_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = string_request, left = template_length, right = sixteen });
    int[] string_alloc = new int[1];
    string_alloc[0] = string_request;
    int text = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = text, function = alloc, arguments = string_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 8, value = template_length });
    int text_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = text_data, left = text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 16, value = text_data });
    int[] text_copy = new int[3];
    text_copy[0] = text_data;
    text_copy[1] = mutable_data;
    text_copy[2] = template_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = text_copy, argument_count = 3 });
    int ok_union = new_temporary(h, NativeType.Int);
    int[] ok_alloc = new int[1];
    ok_alloc[0] = twenty_four;
    push_instruction(h, Instruction.Call { target = ok_union, function = alloc, arguments = ok_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 8, value = zero });
    int text_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = text_bits, source = text });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 16, value = text_bits });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_union });
    push_instruction(h, Instruction.Return { value = ok_result });

    push_instruction(h, Instruction.Label { label = 15 });
    int error_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = error_code, value = made });
    int already_exists = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = already_exists, left = error_code, right = exists_code });
    push_instruction(h, Instruction.Branch { condition = already_exists, label_true = 10, label_false = 22 });

    push_instruction(h, Instruction.Label { label = 22 });
    int missing = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = missing, left = error_code, right = no_entry_code });
    push_instruction(h, Instruction.Branch { condition = missing, label_true = 16, label_false = 23 });

    push_instruction(h, Instruction.Label { label = 23 });
    int not_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = not_directory, left = error_code, right = not_directory_code });
    push_instruction(h, Instruction.Branch { condition = not_directory, label_true = 16, label_false = 19 });

    push_instruction(h, Instruction.Label { label = 16 });
    int[] base_path_args = new int[1];
    base_path_args[0] = base;
    int base_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = base_buffer, function = c_path, arguments = base_path_args, argument_count = 1 });
    int base_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = base_data, left = base_buffer, right = eight });
    int[] stat_alloc = new int[1];
    stat_alloc[0] = stat_size;
    int stat_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = stat_buffer, function = alloc, arguments = stat_alloc, argument_count = 1 });
    int stat_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = stat_data, left = stat_buffer, right = eight });
    int[] stat_args = new int[2];
    stat_args[0] = base_data;
    stat_args[1] = stat_data;
    int stat_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = stat_result, number = stat_number, arguments = stat_args, argument_count = 2 });
    int stat_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = stat_failed, left = stat_result, right = zero });
    push_instruction(h, Instruction.Branch { condition = stat_failed, label_true = 17, label_false = 19 });

    push_instruction(h, Instruction.Label { label = 17 });
    int stat_error = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = stat_error, value = stat_result });
    int stat_missing = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = stat_missing, left = stat_error, right = no_entry_code });
    push_instruction(h, Instruction.Branch { condition = stat_missing, label_true = 18, label_false = 21 });

    push_instruction(h, Instruction.Label { label = 21 });
    int stat_not_directory = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = stat_not_directory, left = stat_error, right = not_directory_code });
    push_instruction(h, Instruction.Branch { condition = stat_not_directory, label_true = 18, label_false = 19 });

    push_instruction(h, Instruction.Label { label = 18 });
    int stat_prefix = new_temporary(h, NativeType.Ref);
    int failure_path = new_temporary(h, NativeType.Ref);
    int failure_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstRefData { target = stat_prefix, blob = add_blob(scene, "stat ") });
    push_instruction(h, Instruction.Copy { target = failure_path, source = base });
    push_instruction(h, Instruction.Copy { target = failure_code, source = stat_error });
    push_instruction(h, Instruction.Jump { label = 20 });

    push_instruction(h, Instruction.Label { label = 19 });
    int mkdir_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = mkdir_prefix, blob = add_blob(scene, "mkdir ") });
    push_instruction(h, Instruction.Copy { target = failure_path, source = template });
    push_instruction(h, Instruction.Copy { target = failure_code, source = error_code });

    push_instruction(h, Instruction.Label { label = 20 });
    int[] reason_args = new int[1];
    reason_args[0] = failure_code;
    int reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    int first_part = new_temporary(h, NativeType.Ref);
    int[] first_args = new int[2];
    first_args[0] = stat_prefix;
    first_args[1] = failure_path;
    push_instruction(h, Instruction.Call { target = first_part, function = string_concat, arguments = first_args, argument_count = 2 });
    int second_part = new_temporary(h, NativeType.Ref);
    int[] second_args = new int[2];
    second_args[0] = first_part;
    second_args[1] = colon;
    push_instruction(h, Instruction.Call { target = second_part, function = string_concat, arguments = second_args, argument_count = 2 });
    int failure_message = new_temporary(h, NativeType.Ref);
    int[] third_args = new int[2];
    third_args[0] = second_part;
    third_args[1] = reason;
    push_instruction(h, Instruction.Call { target = failure_message, function = string_concat, arguments = third_args, argument_count = 2 });
    int[] failed_args = new int[1];
    failed_args[0] = failure_message;
    int failure_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = failure_result, function = temp_failed, arguments = failed_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = failure_result });

    push_instruction(h, Instruction.Label { label = 0 });
    int invalid_message = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = invalid_message, blob = add_blob(scene, "invalid temporary directory prefix") });
    int[] invalid_args = new int[1];
    invalid_args[0] = invalid_message;
    int invalid_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = invalid_result, function = temp_failed, arguments = invalid_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = invalid_result });
    return shell;
}

// add_try_run_shell registers "$try_run": build a NUL-terminated argv,
// fork, execve with the inherited environment, detect exec failure through a
// close-on-exec pipe, wait, and map the status into RunResult. Labels:
// 0 child, 1 parent, 2 after read, 3 wait failed, 4 exec failed, 5 failure
// builder, 6 success path, 7 exited, 8 signaled, 9 Ok, 10 fork failed,
// 11 after fork check.
public fn add_try_run_shell(NativeScene scene, int alloc, int c_path, int errno_reason, int string_concat, int env_blob) -> int {
    int shell = add_function(scene, "$try_run", NativeType.Ref, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, shell);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = four, value = 4 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int thirty_two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_two, value = 32 });
    int close_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = close_number, value = 3 });
    int read_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = read_number, value = 0 });
    int write_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = write_number, value = 1 });
    int fork_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = fork_number, value = 57 });
    int execve_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = execve_number, value = 59 });
    int wait4_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = wait4_number, value = 61 });
    int pipe2_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = pipe2_number, value = 293 });
    int exit_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = exit_number, value = 231 });
    int cloexec = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = cloexec, value = 524288 });
    int low7 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = low7, value = 127 });
    int byte_mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = byte_mask, value = 255 });
    int word_mask = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = word_mask, value = 4294967295 });
    int five = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = five, value = 5 });
    int one_hundred_twenty_seven = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one_hundred_twenty_seven, value = 127 });

    int argument_count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = argument_count, address = 1, offset = 8 });
    int argument_data_object = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = argument_data_object, address = 1, offset = 24 });
    int argument_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = argument_data, left = argument_data_object, right = eight });
    int pointer_count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = pointer_count, left = argument_count, right = one });
    int argv_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = argv_bytes, left = pointer_count, right = eight });
    int[] argv_alloc = new int[1];
    argv_alloc[0] = argv_bytes;
    int argv_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = argv_buffer, function = alloc, arguments = argv_alloc, argument_count = 1 });
    int argv = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = argv, left = argv_buffer, right = eight });
    int roots_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = roots_bytes, left = argument_count, right = eight });
    int[] roots_alloc = new int[1];
    roots_alloc[0] = roots_bytes;
    int roots_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = roots_buffer, function = alloc, arguments = roots_alloc, argument_count = 1 });
    int roots = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = roots, left = roots_buffer, right = eight });

    int[] program_args = new int[1];
    program_args[0] = 0;
    int program_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = program_buffer, function = c_path, arguments = program_args, argument_count = 1 });
    int program_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = program_data, left = program_buffer, right = eight });
    push_instruction(h, Instruction.RawStore64 { address = argv, offset = 0, value = program_data });

    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });
    int argument = new_temporary(h, NativeType.Ref);
    int argument_buffer = new_temporary(h, NativeType.Int);
    int argument_address = new_temporary(h, NativeType.Int);
    int slot = new_temporary(h, NativeType.Int);
    int slot_step = new_temporary(h, NativeType.Int);
    int root_slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = index, right = argument_count });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 12, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 12 });
    push_instruction(h, Instruction.Multiply { target = slot_step, left = index, right = eight });
    push_instruction(h, Instruction.Add { target = argument_address, left = argument_data, right = slot_step });
    push_instruction(h, Instruction.RawLoad64 { target = argument, address = argument_address, offset = 0 });
    int[] argument_args = new int[1];
    argument_args[0] = argument;
    push_instruction(h, Instruction.Call { target = argument_buffer, function = c_path, arguments = argument_args, argument_count = 1 });
    push_instruction(h, Instruction.Add { target = root_slot, left = roots, right = slot_step });
    push_instruction(h, Instruction.RawStore64 { address = root_slot, offset = 0, value = argument_buffer });
    push_instruction(h, Instruction.Add { target = slot, left = index, right = one });
    push_instruction(h, Instruction.Multiply { target = slot, left = slot, right = eight });
    push_instruction(h, Instruction.Add { target = slot, left = argv, right = slot });
    int argument_data_pointer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = argument_data_pointer, left = argument_buffer, right = eight });
    push_instruction(h, Instruction.RawStore64 { address = slot, offset = 0, value = argument_data_pointer });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 13 });
    int terminator_slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = terminator_slot, left = pointer_count, right = eight });
    push_instruction(h, Instruction.Add { target = terminator_slot, left = argv, right = terminator_slot });
    push_instruction(h, Instruction.RawStore64 { address = terminator_slot, offset = 0, value = zero });

    int[] fds_alloc = new int[1];
    fds_alloc[0] = eight;
    int fds_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = fds_buffer, function = alloc, arguments = fds_alloc, argument_count = 1 });
    int fds = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = fds, left = fds_buffer, right = eight });
    int[] pipe_args = new int[2];
    pipe_args[0] = fds;
    pipe_args[1] = cloexec;
    int pipe_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = pipe_result, number = pipe2_number, arguments = pipe_args, argument_count = 2 });
    int packed = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = packed, address = fds, offset = 0 });
    int read_fd = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = read_fd, left = packed, right = word_mask });
    int shifted = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ShiftRight { target = shifted, left = packed, count = thirty_two });
    int write_fd = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = write_fd, left = shifted, right = word_mask });
    int[] error_alloc = new int[1];
    error_alloc[0] = eight;
    int error_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = error_buffer, function = alloc, arguments = error_alloc, argument_count = 1 });
    int error_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = error_data, left = error_buffer, right = eight });
    int[] status_alloc = new int[1];
    status_alloc[0] = eight;
    int status_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = status_buffer, function = alloc, arguments = status_alloc, argument_count = 1 });
    int status_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = status_data, left = status_buffer, right = eight });
    int envp = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = envp, blob = env_blob, offset = 24 });

    int child = new_temporary(h, NativeType.Int);
    int[] fork_arguments = new int[0];
    push_instruction(h, Instruction.RawSyscall { target = child, number = fork_number, arguments = fork_arguments, argument_count = 0 });
    int fork_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = fork_failed, left = child, right = zero });
    push_instruction(h, Instruction.Branch { condition = fork_failed, label_true = 10, label_false = 11 });

    int error_code = new_temporary(h, NativeType.Int);
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.Negate { target = error_code, value = child });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "fork/exec ") });
    push_instruction(h, Instruction.Jump { label = 5 });

    push_instruction(h, Instruction.Label { label = 11 });
    int is_child = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_child, left = child, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_child, label_true = 14, label_false = 1 });

    // Child: exec, and on failure write the errno to the pipe and exit 127.
    push_instruction(h, Instruction.Label { label = 14 });
    int[] child_close = new int[1];
    child_close[0] = read_fd;
    int child_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = child_close_ignored, number = close_number, arguments = child_close, argument_count = 1 });
    int[] exec_args = new int[3];
    exec_args[0] = program_data;
    exec_args[1] = argv;
    exec_args[2] = envp;
    int exec_result = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = exec_result, number = execve_number, arguments = exec_args, argument_count = 3 });
    int child_error = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = child_error, value = exec_result });
    push_instruction(h, Instruction.RawStore64 { address = error_data, offset = 0, value = child_error });
    int[] child_write = new int[3];
    child_write[0] = write_fd;
    child_write[1] = error_data;
    child_write[2] = four;
    int child_written = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = child_written, number = write_number, arguments = child_write, argument_count = 3 });
    int[] child_exit = new int[1];
    child_exit[0] = one_hundred_twenty_seven;
    int child_exit_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = child_exit_ignored, number = exit_number, arguments = child_exit, argument_count = 1 });
    int child_return = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = child_return, source = zero });
    push_instruction(h, Instruction.Return { value = child_return });

    // Parent: close the write end, read any exec error, then wait.
    push_instruction(h, Instruction.Label { label = 1 });
    int[] parent_close = new int[1];
    parent_close[0] = write_fd;
    int parent_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = parent_close_ignored, number = close_number, arguments = parent_close, argument_count = 1 });
    int[] read_args = new int[3];
    read_args[0] = read_fd;
    read_args[1] = error_data;
    read_args[2] = four;
    int received = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = received, number = read_number, arguments = read_args, argument_count = 3 });
    int[] read_close = new int[1];
    read_close[0] = read_fd;
    int read_close_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = read_close_ignored, number = close_number, arguments = read_close, argument_count = 1 });
    int[] wait_args = new int[4];
    wait_args[0] = child;
    wait_args[1] = status_data;
    wait_args[2] = zero;
    wait_args[3] = zero;
    int waited = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = waited, number = wait4_number, arguments = wait_args, argument_count = 4 });
    int wait_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = wait_failed, left = waited, right = zero });
    push_instruction(h, Instruction.Branch { condition = wait_failed, label_true = 3, label_false = 2 });

    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Negate { target = error_code, value = waited });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "wait ") });
    push_instruction(h, Instruction.Jump { label = 5 });

    push_instruction(h, Instruction.Label { label = 2 });
    int exec_failed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = exec_failed, left = zero, right = received });
    push_instruction(h, Instruction.Branch { condition = exec_failed, label_true = 4, label_false = 6 });

    push_instruction(h, Instruction.Label { label = 4 });
    int raw_child_error = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = raw_child_error, address = error_data, offset = 0 });
    push_instruction(h, Instruction.BitAnd { target = error_code, left = raw_child_error, right = word_mask });
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = add_blob(scene, "fork/exec ") });
    push_instruction(h, Instruction.Jump { label = 5 });

    // Label 5: RunResult.Failed { message }.
    push_instruction(h, Instruction.Label { label = 5 });
    int[] reason_args = new int[1];
    reason_args[0] = error_code;
    int reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    int first_part = new_temporary(h, NativeType.Ref);
    int[] first_args = new int[2];
    first_args[0] = prefix;
    first_args[1] = 0;
    push_instruction(h, Instruction.Call { target = first_part, function = string_concat, arguments = first_args, argument_count = 2 });
    int second_part = new_temporary(h, NativeType.Ref);
    int[] second_args = new int[2];
    second_args[0] = first_part;
    second_args[1] = colon;
    push_instruction(h, Instruction.Call { target = second_part, function = string_concat, arguments = second_args, argument_count = 2 });
    int failure_message = new_temporary(h, NativeType.Ref);
    int[] third_args = new int[2];
    third_args[0] = second_part;
    third_args[1] = reason;
    push_instruction(h, Instruction.Call { target = failure_message, function = string_concat, arguments = third_args, argument_count = 2 });
    int[] failure_alloc = new int[1];
    failure_alloc[0] = twenty_four;
    int failure_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failure_union, function = alloc, arguments = failure_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failure_union, offset = 8, value = one });
    int failure_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = failure_bits, source = failure_message });
    push_instruction(h, Instruction.RawStore64 { address = failure_union, offset = 24, value = failure_bits });
    int failure_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failure_result, source = failure_union });
    push_instruction(h, Instruction.Return { value = failure_result });

    // Label 6: success path. Decode the wait status.
    push_instruction(h, Instruction.Label { label = 6 });
    int wait_status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = wait_status, address = status_data, offset = 0 });
    int signal_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = signal_bits, left = wait_status, right = low7 });
    int exited = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = exited, left = signal_bits, right = zero });
    push_instruction(h, Instruction.Branch { condition = exited, label_true = 7, label_false = 8 });

    int exit_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 7 });
    int shifted_status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ShiftRight { target = shifted_status, left = wait_status, count = eight });
    push_instruction(h, Instruction.BitAnd { target = exit_code, left = shifted_status, right = byte_mask });
    push_instruction(h, Instruction.Jump { label = 9 });

    push_instruction(h, Instruction.Label { label = 8 });
    int signal = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = signal, left = wait_status, right = low7 });
    push_instruction(h, Instruction.Add { target = exit_code, left = signal, right = one_hundred_twenty_seven });
    push_instruction(h, Instruction.Add { target = exit_code, left = exit_code, right = one });

    push_instruction(h, Instruction.Label { label = 9 });
    int[] ok_alloc = new int[1];
    ok_alloc[0] = twenty_four;
    int ok_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_union, function = alloc, arguments = ok_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 8, value = zero });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 16, value = exit_code });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_union });
    push_instruction(h, Instruction.Return { value = ok_result });
    return shell;
}

// add_decimal_string_shell registers "$decimal_string": a non-negative int
// as a fresh decimal string (used by capture failure offsets).
public fn add_decimal_string_shell(NativeScene scene, int alloc, int copy_bytes) -> int {
    int convert = add_function(scene, "$decimal_string", NativeType.Ref, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, convert);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int ten = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = ten, value = 10 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int thirty_two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_two, value = 32 });
    int thirty_one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_one, value = 31 });
    int digit_zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = digit_zero, value = 48 });
    int[] alloc_args = new int[1];
    alloc_args[0] = thirty_two;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = alloc, arguments = alloc_args, argument_count = 1 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = data, left = buffer, right = eight });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = length, value = 0 });
    int value = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = value, source = 0 });
    int is_zero = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_zero, left = value, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_zero, label_true = 3, label_false = 0 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.RawStore8 { address = data, offset = 0, value = digit_zero });
    push_instruction(h, Instruction.Copy { target = length, source = one });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 0 });
    int done = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = done, left = value, right = zero });
    push_instruction(h, Instruction.Branch { condition = done, label_true = 2, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    int digit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = digit, left = value, right = ten });
    push_instruction(h, Instruction.WholeDivide { target = value, left = value, right = ten });
    int position = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = position, left = thirty_one, right = length });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = address, left = data, right = position });
    int character = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = character, left = digit, right = digit_zero });
    push_instruction(h, Instruction.RawStore8 { address = address, offset = 0, value = character });
    push_instruction(h, Instruction.Add { target = length, left = length, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    int start = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = start, left = thirty_two, right = length });
    int source = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = source, left = data, right = start });
    int text_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = text_request, left = length, right = sixteen });
    int[] text_alloc = new int[1];
    text_alloc[0] = text_request;
    int text = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = text, function = alloc, arguments = text_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 8, value = length });
    int text_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = text_data, left = text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 16, value = text_data });
    int[] copy_args = new int[3];
    copy_args[0] = text_data;
    copy_args[1] = source;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = text });
    push_instruction(h, Instruction.Return { value = result });
    return convert;
}

// add_first_nul_shell registers "$first_nul": the index of the first zero
// byte in a range, or -1.
public fn add_first_nul_shell(NativeScene scene) -> int {
    int find = add_function(scene, "$first_nul", NativeType.Int, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, find);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int minus_one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = minus_one, value = -1 });
    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });
    int result = new_temporary(h, NativeType.Int);
    int more = new_temporary(h, NativeType.Bool);
    int address = new_temporary(h, NativeType.Int);
    int octet = new_temporary(h, NativeType.Int);
    int found = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.LessThan { target = more, left = index, right = 1 });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Add { target = address, left = 0, right = index });
    push_instruction(h, Instruction.RawLoad8 { target = octet, address = address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = found, left = octet, right = zero });
    push_instruction(h, Instruction.Branch { condition = found, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Jump { label = 4 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Copy { target = result, source = minus_one });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Copy { target = result, source = index });
    push_instruction(h, Instruction.Return { value = result });
    return find;
}

// add_run_failure_shell registers "$run_failure": prefix + program + ": " +
// errno reason, the shared failure text for run/wait/fork/exec.
public fn add_run_failure_shell(NativeScene scene, int errno_reason, int string_concat) -> int {
    int fail = add_function(scene, "$run_failure", NativeType.Ref, ref_ref_int_parameters(), 3);
    NativeFunction h = function_at(scene, fail);
    int[] reason_args = new int[1];
    reason_args[0] = 2;
    int reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = reason, function = errno_reason, arguments = reason_args, argument_count = 1 });
    int colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = colon, blob = add_blob(scene, ": ") });
    int first = new_temporary(h, NativeType.Ref);
    int[] first_args = new int[2];
    first_args[0] = 0;
    first_args[1] = 1;
    push_instruction(h, Instruction.Call { target = first, function = string_concat, arguments = first_args, argument_count = 2 });
    int second = new_temporary(h, NativeType.Ref);
    int[] second_args = new int[2];
    second_args[0] = first;
    second_args[1] = colon;
    push_instruction(h, Instruction.Call { target = second, function = string_concat, arguments = second_args, argument_count = 2 });
    int message = new_temporary(h, NativeType.Ref);
    int[] third_args = new int[2];
    third_args[0] = second;
    third_args[1] = reason;
    push_instruction(h, Instruction.Call { target = message, function = string_concat, arguments = third_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = message });
    return fail;
}

// add_build_argv_shell registers "$build_argv": build a NUL-terminated argv
// and a roots array, returning a three-word metadata object (argv, roots,
// program C string) whose payload keeps every buffer visible to the collector.
public fn add_build_argv_shell(NativeScene scene, int alloc, int c_path) -> int {
    int build = add_function(scene, "$build_argv", NativeType.Int, two_ref_parameters(), 2);
    NativeFunction h = function_at(scene, build);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int argument_count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = argument_count, address = 1, offset = 8 });
    int data_object = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data_object, address = 1, offset = 24 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = data, left = data_object, right = eight });
    int pointer_count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = pointer_count, left = argument_count, right = one });
    int argv_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = argv_bytes, left = pointer_count, right = eight });
    int[] argv_alloc = new int[1];
    argv_alloc[0] = argv_bytes;
    int argv_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = argv_buffer, function = alloc, arguments = argv_alloc, argument_count = 1 });
    int argv = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = argv, left = argv_buffer, right = eight });
    int roots_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = roots_bytes, left = argument_count, right = eight });
    int[] roots_alloc = new int[1];
    roots_alloc[0] = roots_bytes;
    int roots_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = roots_buffer, function = alloc, arguments = roots_alloc, argument_count = 1 });
    int roots = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = roots, left = roots_buffer, right = eight });
    int[] program_args = new int[1];
    program_args[0] = 0;
    int program_buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = program_buffer, function = c_path, arguments = program_args, argument_count = 1 });
    int program_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = program_data, left = program_buffer, right = eight });
    push_instruction(h, Instruction.RawStore64 { address = argv, offset = 0, value = program_data });

    int index = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = index, value = 0 });
    int argument = new_temporary(h, NativeType.Ref);
    int argument_buffer = new_temporary(h, NativeType.Int);
    int step = new_temporary(h, NativeType.Int);
    int address = new_temporary(h, NativeType.Int);
    int slot = new_temporary(h, NativeType.Int);
    int roots_slot = new_temporary(h, NativeType.Int);
    int argument_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Label { label = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = index, right = argument_count });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Multiply { target = step, left = index, right = eight });
    push_instruction(h, Instruction.Add { target = address, left = data, right = step });
    push_instruction(h, Instruction.RawLoad64 { target = argument, address = address, offset = 0 });
    int[] argument_args = new int[1];
    argument_args[0] = argument;
    push_instruction(h, Instruction.Call { target = argument_buffer, function = c_path, arguments = argument_args, argument_count = 1 });
    push_instruction(h, Instruction.Add { target = roots_slot, left = roots, right = step });
    push_instruction(h, Instruction.RawStore64 { address = roots_slot, offset = 0, value = argument_buffer });
    push_instruction(h, Instruction.Add { target = slot, left = argv, right = step });
    push_instruction(h, Instruction.Add { target = slot, left = slot, right = eight });
    push_instruction(h, Instruction.Add { target = argument_data, left = argument_buffer, right = eight });
    push_instruction(h, Instruction.RawStore64 { address = slot, offset = 0, value = argument_data });
    push_instruction(h, Instruction.Add { target = index, left = index, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    int terminator = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = terminator, left = pointer_count, right = eight });
    push_instruction(h, Instruction.Add { target = terminator, left = argv, right = terminator });
    push_instruction(h, Instruction.RawStore64 { address = terminator, offset = 0, value = zero });
    int[] meta_alloc = new int[1];
    meta_alloc[0] = twenty_four;
    int meta = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = meta, function = alloc, arguments = meta_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = meta, offset = 8, value = argv });
    push_instruction(h, Instruction.RawStore64 { address = meta, offset = 16, value = roots });
    push_instruction(h, Instruction.RawStore64 { address = meta, offset = 24, value = program_data });
    push_instruction(h, Instruction.Return { value = meta });
    return build;
}

// add_read_stream_shell registers "$read_stream": one non-blocking read,
// returning 0 appended, 1 EOF, 2 limit exceeded, 3 read error. The new
// length (or the errno) is written to the state word at offset 0.
public fn add_read_stream_shell(NativeScene scene, int copy_bytes) -> int {
    NativeType[] shapes = new NativeType[7];
    shapes[0] = NativeType.Int;
    shapes[1] = NativeType.Int;
    shapes[2] = NativeType.Int;
    shapes[3] = NativeType.Int;
    shapes[4] = NativeType.Int;
    shapes[5] = NativeType.Int;
    shapes[6] = NativeType.Int;
    int read = add_function(scene, "$read_stream", NativeType.Int, shapes, 7);
    NativeFunction h = function_at(scene, read);
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int three = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = three, value = 3 });
    int read_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = read_number, value = 0 });
    int result = new_temporary(h, NativeType.Int);
    int count = new_temporary(h, NativeType.Int);
    int bad = new_temporary(h, NativeType.Bool);
    int empty = new_temporary(h, NativeType.Bool);
    int new_length = new_temporary(h, NativeType.Int);
    int over = new_temporary(h, NativeType.Bool);
    int address = new_temporary(h, NativeType.Int);
    int[] read_args = new int[3];
    read_args[0] = 0;
    read_args[1] = 4;
    read_args[2] = 5;
    push_instruction(h, Instruction.RawSyscall { target = count, number = read_number, arguments = read_args, argument_count = 3 });
    push_instruction(h, Instruction.LessThan { target = bad, left = count, right = zero });
    push_instruction(h, Instruction.Branch { condition = bad, label_true = 0, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 0 });
    int error = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = error, value = count });
    push_instruction(h, Instruction.RawStore64 { address = 6, offset = 0, value = error });
    push_instruction(h, Instruction.Copy { target = result, source = three });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Equal { target = empty, left = count, right = zero });
    push_instruction(h, Instruction.Branch { condition = empty, label_true = 1, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Copy { target = result, source = one });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Add { target = new_length, left = 2, right = count });
    push_instruction(h, Instruction.LessThan { target = over, left = 3, right = new_length });
    push_instruction(h, Instruction.Branch { condition = over, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Copy { target = result, source = two });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Add { target = address, left = 1, right = 2 });
    int[] copy_args = new int[3];
    copy_args[0] = address;
    copy_args[1] = 4;
    copy_args[2] = count;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.RawStore64 { address = 6, offset = 0, value = new_length });
    push_instruction(h, Instruction.Copy { target = result, source = zero });
    push_instruction(h, Instruction.Return { value = result });
    return read;
}

