// add_string_at_shell registers "$string_at": a null string reads as the
// empty string, the index is checked against the length word, and the payload
// byte is read as an unsigned int.
fn add_string_at_shell(NativeScene scene, int fail_string_index) -> int {
    int at = add_function(scene, "$string_at", NativeType.Int, ref_int_parameters(), 2);
    NativeFunction h = function_at(scene, at);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = length, value = 0 });
    int loaded_label = 0;
    int length_ready = 1;
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = length_ready, label_false = loaded_label });
    push_instruction(h, Instruction.Label { label = loaded_label });
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    push_instruction(h, Instruction.Label { label = length_ready });

    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = 1, right = zero });
    int fail_index = 2;
    int ok_index = 3;
    push_instruction(h, Instruction.Branch { condition = negative, label_true = fail_index, label_false = ok_index });
    push_instruction(h, Instruction.Label { label = ok_index });
    int valid = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = valid, left = 1, right = length });
    int value_label = 4;
    push_instruction(h, Instruction.Branch { condition = valid, label_true = value_label, label_false = fail_index });
    push_instruction(h, Instruction.Label { label = fail_index });
    int[] fail_args = new int[2];
    fail_args[0] = 1;
    fail_args[1] = length;
    push_instruction(h, Instruction.CallVoid { function = fail_string_index, arguments = fail_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = zero });
    push_instruction(h, Instruction.Label { label = value_label });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int byte_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = byte_address, left = data, right = 1 });
    int value = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad8 { target = value, address = byte_address, offset = 0 });
    push_instruction(h, Instruction.Return { value = value });
    return at;
}

// add_substring_shell registers "$substring": null reads as empty, the range
// is checked, and a fresh string object receives the copied bytes.
fn add_substring_shell(NativeScene scene, int alloc, int copy_bytes, int fail_substring) -> int {
    int slice = add_function(scene, "$substring", NativeType.Ref, ref_int_int_parameters(), 3);
    NativeFunction h = function_at(scene, slice);

    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = zero });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = length, value = 0 });
    int loaded_label = 0;
    int length_ready = 1;
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = length_ready, label_false = loaded_label });
    push_instruction(h, Instruction.Label { label = loaded_label });
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    push_instruction(h, Instruction.Label { label = length_ready });

    int fail_label = 2;
    int start_ok = 3;
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = 1, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = fail_label, label_false = start_ok });
    push_instruction(h, Instruction.Label { label = start_ok });
    int order_bad = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = order_bad, left = 2, right = 1 });
    int end_ok = 4;
    push_instruction(h, Instruction.Branch { condition = order_bad, label_true = fail_label, label_false = end_ok });
    push_instruction(h, Instruction.Label { label = end_ok });
    int end_bad = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = end_bad, left = length, right = 2 });
    int range_ok = 5;
    push_instruction(h, Instruction.Branch { condition = end_bad, label_true = fail_label, label_false = range_ok });

    push_instruction(h, Instruction.Label { label = fail_label });
    int[] fail_args = new int[3];
    fail_args[0] = 1;
    fail_args[1] = 2;
    fail_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = fail_substring, arguments = fail_args, argument_count = 3 });
    push_instruction(h, Instruction.Return { value = result });

    push_instruction(h, Instruction.Label { label = range_ok });
    int count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = count, left = 2, right = 1 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = count, right = sixteen });
    int[] alloc_args = new int[1];
    alloc_args[0] = request;
    int obj = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = obj, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = obj, offset = 8, value = count });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = obj, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = obj, offset = 16, value = payload });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int source = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = source, left = data, right = 1 });
    int[] copy_args = new int[3];
    copy_args[0] = payload;
    copy_args[1] = source;
    copy_args[2] = count;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.Copy { target = result, source = obj });
    push_instruction(h, Instruction.Return { value = result });
    return slice;
}

// add_fail_shift_shell registers "$fail_shift": the shift-count range error
// with its signed decimal count, then status 1.
fn add_fail_shift_shell(NativeScene scene, int prefix_blob, int middle_blob, int newline_blob, int write_blob_fd, int write_int_fd) -> int {
    int fail = add_function(scene, "$fail_shift", NativeType.Void, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, fail);
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = prefix_blob });
    int[] prefix_args = new int[2];
    prefix_args[0] = two;
    prefix_args[1] = prefix;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = prefix_args, argument_count = 2 });
    int[] count_args = new int[2];
    count_args[0] = two;
    count_args[1] = 0;
    push_instruction(h, Instruction.CallVoid { function = write_int_fd, arguments = count_args, argument_count = 2 });
    int middle = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = middle, blob = middle_blob });
    int[] middle_args = new int[2];
    middle_args[0] = two;
    middle_args[1] = middle;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = middle_args, argument_count = 2 });
    int newline = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = newline, blob = newline_blob });
    int[] newline_args = new int[2];
    newline_args[0] = two;
    newline_args[1] = newline;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = newline_args, argument_count = 2 });
    int exit_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = exit_number, value = 60 });
    int status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = status, value = 1 });
    int[] exit_args = new int[1];
    exit_args[0] = status;
    int ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = ignored, number = exit_number, arguments = exit_args, argument_count = 1 });
    push_instruction(h, Instruction.ReturnVoid);
    return fail;
}

// add_zero_bytes_shell registers "$zero_bytes": write zero to count bytes
// starting at address, one byte per iteration.
fn add_zero_bytes_shell(NativeScene scene) -> int {
    int zero = add_function(scene, "$zero_bytes", NativeType.Void, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, zero);

    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int value = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = value, value = 0 });
    push_instruction(h, Instruction.Label { label = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = 1 });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = address, left = 0, right = i });
    push_instruction(h, Instruction.RawStore8 { address = address, offset = 0, value = value });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    return zero;
}

// ArrayShell carries the array runtime's function indices.
public struct ArrayShell {
    int new_array;
    int at;
    int length;
    int push;
    int zero_bytes;
    int string_to_bytes;
    int bytes_to_string;
    int string_at;
    int substring;
    int fail_shift;
    int fail_blob;
    int write_blob_fd;
    int write_int_fd;
    int eprint_space;
    int eprint_newline;
    int eprint_true;
    int eprint_false;
}

// add_array_new_shell registers "$array_new": length and element size in,
// one array object out. The object is [size][length][element_size][data
// base]; the data buffer is a separate GC object whose base is stored so the
// conservative heap scan marks it, and its payload (base+8) is zeroed.
fn add_array_new_shell(NativeScene scene, int alloc, int zero_bytes, int fail_blob, int negative_blob, int element_blob, int too_large_blob) -> int {
    int create = add_function(scene, "$array_new", NativeType.Ref, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, create);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int thirty_two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = thirty_two, value = 32 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int max = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = max, value = 9223372036854775807 });
    int array = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = array, source = zero });

    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = 0, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int negative_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = negative_text, blob = negative_blob });
    int[] negative_args = new int[1];
    negative_args[0] = negative_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = negative_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = array });

    push_instruction(h, Instruction.Label { label = 1 });
    int nonpositive = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = nonpositive, left = 1, right = one });
    push_instruction(h, Instruction.Branch { condition = nonpositive, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    int element_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = element_text, blob = element_blob });
    int[] element_args = new int[1];
    element_args[0] = element_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = element_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = array });

    push_instruction(h, Instruction.Label { label = 3 });
    int limit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = limit, left = max, right = 1 });
    int too_large = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = too_large, left = limit, right = 0 });
    push_instruction(h, Instruction.Branch { condition = too_large, label_true = 4, label_false = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    int large_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = large_text, blob = too_large_blob });
    int[] large_args = new int[1];
    large_args[0] = large_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = large_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = array });

    push_instruction(h, Instruction.Label { label = 5 });
    int[] object_arguments = new int[1];
    object_arguments[0] = thirty_two;
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = raw, function = alloc, arguments = object_arguments, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 8, value = 0 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 16, value = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 24, value = zero });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 32, value = 0 });
    push_instruction(h, Instruction.Copy { target = array, source = raw });

    int bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = bytes, left = 0, right = 1 });
    int empty = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = empty, left = bytes, right = zero });
    push_instruction(h, Instruction.Branch { condition = empty, label_true = 6, label_false = 7 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.ConstInt { target = bytes, value = 1 });
    push_instruction(h, Instruction.Label { label = 7 });
    int[] data_arguments = new int[1];
    data_arguments[0] = bytes;
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = data, function = alloc, arguments = data_arguments, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = raw, offset = 24, value = data });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = data, right = eight });
    int[] zero_arguments = new int[2];
    zero_arguments[0] = payload;
    zero_arguments[1] = bytes;
    push_instruction(h, Instruction.CallVoid { function = zero_bytes, arguments = zero_arguments, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = array });
    return create;
}

// add_array_length_shell registers "$array_length": the length word at
// offset 8, with a null reference reaching the C runtime's exact error.
fn add_array_length_shell(NativeScene scene, int fail_blob, int null_blob) -> int {
    int length = add_function(scene, "$array_length", NativeType.Int, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, length);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });
    push_instruction(h, Instruction.Label { label = 1 });
    int len = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = len, address = 0, offset = 8 });
    push_instruction(h, Instruction.Return { value = len });
    return length;
}

// add_array_push_shell registers "$array_push": append one element and answer
// the new length. The value arrives as an int whose low bytes are stored; every
// native element is one or eight bytes. A full array doubles its data buffer,
// copying the live prefix into a fresh GC object, so the array keeps its
// identity and every alias observes the append.
fn add_array_push_shell(NativeScene scene, int alloc, int copy_bytes, int fail_blob, int null_blob, int large_blob) -> int {
    int push = add_function(scene, "$array_push", NativeType.Int, ref_int_parameters(), 2);
    NativeFunction h = function_at(scene, push);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int max = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = max, value = 9223372036854775807 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });

    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });

    push_instruction(h, Instruction.Label { label = 1 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int element_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = element_size, address = 0, offset = 16 });
    int capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = capacity, address = 0, offset = 32 });

    int full = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = full, left = length, right = capacity });
    push_instruction(h, Instruction.Branch { condition = full, label_true = 2, label_false = 8 });

    push_instruction(h, Instruction.Label { label = 2 });
    int next_capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = next_capacity, source = capacity });
    int empty = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = empty, left = capacity, right = one });
    push_instruction(h, Instruction.Branch { condition = empty, label_true = 3, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Copy { target = next_capacity, source = one });
    push_instruction(h, Instruction.Jump { label = 5 });
    push_instruction(h, Instruction.Label { label = 4 });
    int doubled = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = doubled, left = capacity, right = capacity });
    push_instruction(h, Instruction.Copy { target = next_capacity, source = doubled });
    push_instruction(h, Instruction.Label { label = 5 });

    int limit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = limit, left = max, right = element_size });
    int too_large = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = too_large, left = limit, right = next_capacity });
    push_instruction(h, Instruction.Branch { condition = too_large, label_true = 6, label_false = 7 });
    push_instruction(h, Instruction.Label { label = 6 });
    int large_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = large_text, blob = large_blob });
    int[] large_args = new int[1];
    large_args[0] = large_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = large_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });
    push_instruction(h, Instruction.Label { label = 7 });

    int bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = bytes, left = next_capacity, right = element_size });
    int[] alloc_args = new int[1];
    alloc_args[0] = bytes;
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = data, function = alloc, arguments = alloc_args, argument_count = 1 });

    int live_bytes = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = live_bytes, left = length, right = element_size });
    int old_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = old_data, address = 0, offset = 24 });
    // Both stored data pointers are block bases; the elements start one
    // header word later, so the copy moves the live payload, not the headers.
    int new_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = new_payload, left = data, right = eight });
    int old_payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = old_payload, left = old_data, right = eight });
    int[] copy_args = new int[3];
    copy_args[0] = new_payload;
    copy_args[1] = old_payload;
    copy_args[2] = live_bytes;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 24, value = data });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 32, value = next_capacity });

    push_instruction(h, Instruction.Label { label = 8 });
    int data_now = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data_now, address = 0, offset = 24 });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = data_now, right = eight });
    int offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = offset, left = length, right = element_size });
    int slot = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = slot, left = payload, right = offset });

    int single = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = single, left = element_size, right = one });
    push_instruction(h, Instruction.Branch { condition = single, label_true = 9, label_false = 10 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.RawStore8 { address = slot, offset = 0, value = 1 });
    push_instruction(h, Instruction.Jump { label = 11 });
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.RawStore64 { address = slot, offset = 0, value = 1 });
    push_instruction(h, Instruction.Label { label = 11 });

    int new_length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = new_length, left = length, right = one });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 8, value = new_length });
    push_instruction(h, Instruction.Return { value = new_length });
    return push;
}

// add_array_at_shell registers "$array_at": null and bounds checks, then the
// element address, data base + 8 + index * element_size. The stored data
// pointer is the buffer's block base so the collector sees a header.
fn add_array_at_shell(NativeScene scene, int fail_blob, int fail_bounds, int null_blob) -> int {
    int at = add_function(scene, "$array_at", NativeType.Int, ref_int_parameters(), 2);
    NativeFunction h = function_at(scene, at);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });

    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = zero });

    push_instruction(h, Instruction.Label { label = 1 });
    int len = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = len, address = 0, offset = 8 });
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = 1, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    int valid = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = valid, left = 1, right = len });
    push_instruction(h, Instruction.Branch { condition = valid, label_true = 4, label_false = 2 });

    push_instruction(h, Instruction.Label { label = 2 });
    int[] bounds_args = new int[2];
    bounds_args[0] = 1;
    bounds_args[1] = len;
    push_instruction(h, Instruction.CallVoid { function = fail_bounds, arguments = bounds_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = zero });

    push_instruction(h, Instruction.Label { label = 4 });
    int size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = size, address = 0, offset = 16 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 24 });
    int offset = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Multiply { target = offset, left = 1, right = size });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = base, left = data, right = eight });
    int element = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = element, left = base, right = offset });
    push_instruction(h, Instruction.Return { value = element });
    return at;
}

// add_string_to_bytes_shell registers "$string_to_bytes": allocate an
// element-size-one array of the string's byte length and copy its bytes.
fn add_string_to_bytes_shell(NativeScene scene, int array_new, int copy_bytes) -> int {
    int convert = add_function(scene, "$string_to_bytes", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, convert);

    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int[] array_args = new int[2];
    array_args[0] = length;
    array_args[1] = one;
    int array = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = array, function = array_new, arguments = array_args, argument_count = 2 });
    int raw = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = raw, address = array, offset = 24 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int dest = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = dest, left = raw, right = eight });
    int[] copy_args = new int[3];
    copy_args[0] = dest;
    copy_args[1] = data;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.Return { value = array });
    return convert;
}

// add_bytes_to_string_shell registers "$bytes_to_string": reject a null
// array or a non-unit element size, scan for the first NUL (with its exact
// index in the message), then allocate one length-carrying string object and
// copy the bytes.
fn add_bytes_to_string_shell(NativeScene scene, int alloc, int copy_bytes, int fail_blob, int fail_nul, int null_blob, int size_blob) -> int {
    int convert = add_function(scene, "$bytes_to_string", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, convert);

    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = zero });

    int address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = address, source = 0 });
    int is_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_null, left = address, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_null, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int null_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = null_text, blob = null_blob });
    int[] null_args = new int[1];
    null_args[0] = null_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = null_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });

    push_instruction(h, Instruction.Label { label = 1 });
    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 0, offset = 8 });
    int element_size = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = element_size, address = 0, offset = 16 });
    int unit = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = unit, left = element_size, right = one });
    push_instruction(h, Instruction.Branch { condition = unit, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    int size_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = size_text, blob = size_blob });
    int[] size_args = new int[1];
    size_args[0] = size_text;
    push_instruction(h, Instruction.CallVoid { function = fail_blob, arguments = size_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });

    push_instruction(h, Instruction.Label { label = 2 });
    int data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 24 });
    int src = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = src, left = data, right = eight });
    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    int octet = new_temporary(h, NativeType.Int);
    int octet_address = new_temporary(h, NativeType.Int);
    int is_zero = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = length });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 5, label_false = 6 });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Add { target = octet_address, left = src, right = i });
    push_instruction(h, Instruction.RawLoad8 { target = octet, address = octet_address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = is_zero, left = octet, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_zero, label_true = 7, label_false = 8 });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 4 });
    push_instruction(h, Instruction.Label { label = 7 });
    int[] nul_args = new int[1];
    nul_args[0] = i;
    push_instruction(h, Instruction.CallVoid { function = fail_nul, arguments = nul_args, argument_count = 1 });
    push_instruction(h, Instruction.Return { value = result });

    push_instruction(h, Instruction.Label { label = 6 });
    int request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = request, left = length, right = sixteen });
    int[] alloc_args = new int[1];
    alloc_args[0] = request;
    int obj = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = obj, function = alloc, arguments = alloc_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = obj, offset = 8, value = length });
    int payload = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = payload, left = obj, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = obj, offset = 16, value = payload });
    int[] copy_args = new int[3];
    copy_args[0] = payload;
    copy_args[1] = src;
    copy_args[2] = length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    push_instruction(h, Instruction.Copy { target = result, source = obj });
    push_instruction(h, Instruction.Return { value = result });
    return convert;
}

// add_arrays registers the array runtime and its failure writers. The fixed
// messages are the C runtime's exact spellings; the bounds message is built
// from its prefix, the index, its middle, the length, and a newline.
public fn add_arrays(NativeScene scene, int alloc, int copy_bytes) -> ArrayShell {
    ArrayShell shell = ArrayShell { new_array = 0, at = 0, length = 0, push = 0, zero_bytes = 0, string_to_bytes = 0, bytes_to_string = 0, string_at = 0, substring = 0, fail_shift = 0, fail_blob = 0, write_blob_fd = 0, write_int_fd = 0, eprint_space = 0, eprint_newline = 0, eprint_true = 0, eprint_false = 0 };

    int prefix_blob = add_blob(scene, "purr: ");
    int newline_blob = add_blob(scene, "\n");
    int index_blob = add_blob(scene, "purr: array index ");
    int middle_blob = add_blob(scene, " is out of range for length ");
    int negative_blob = add_blob(scene, "array length cannot be negative");
    int element_blob = add_blob(scene, "array element size must be positive");
    int large_blob = add_blob(scene, "array allocation is too large");
    int null_access_blob = add_blob(scene, "array access on a null array reference");
    int null_length_blob = add_blob(scene, "length of a null array reference");
    int null_append_blob = add_blob(scene, "append to a null array reference");
    int nul_blob = add_blob(scene, "purr: byte array contains a NUL byte at index ");
    int null_bytes_blob = add_blob(scene, "byte array is null");
    int size_blob = add_blob(scene, "byte array element size is not 1");
    int string_index_blob = add_blob(scene, "purr: string index ");
    int substring_blob = add_blob(scene, "purr: substring range ");
    int shift_prefix_blob = add_blob(scene, "purr: shift count ");
    int shift_middle_blob = add_blob(scene, " is outside 0..63");
    int dots_blob = add_blob(scene, "..");
    int eprint_space_blob = add_blob(scene, " ");
    int eprint_true_blob = add_blob(scene, "true");
    int eprint_false_blob = add_blob(scene, "false");
    int scratch_blob = add_blob(scene, "0");

    int write_byte_fd = add_write_byte_fd_shell(scene, scratch_blob);
    int write_blob_fd = add_write_blob_fd_shell(scene);
    int write_digits_fd = add_write_digits_fd_shell(scene, write_byte_fd);
    int write_int_fd = add_write_int_fd_shell(scene, write_byte_fd, write_digits_fd);
    int fail_blob = add_fail_blob_shell(scene, prefix_blob, newline_blob, write_blob_fd);
    int fail_bounds = add_fail_bounds_shell(scene, index_blob, middle_blob, newline_blob, write_blob_fd, write_int_fd);
    int fail_nul = add_fail_nul_shell(scene, nul_blob, newline_blob, write_blob_fd, write_int_fd);
    int fail_string_index = add_fail_string_index_shell(scene, string_index_blob, middle_blob, newline_blob, write_blob_fd, write_int_fd);
    int fail_substring = add_fail_substring_shell(scene, substring_blob, dots_blob, middle_blob, newline_blob, write_blob_fd, write_int_fd);
    int fail_shift = add_fail_shift_shell(scene, shift_prefix_blob, shift_middle_blob, newline_blob, write_blob_fd, write_int_fd);
    int zero_bytes = add_zero_bytes_shell(scene);

    shell.new_array = add_array_new_shell(scene, alloc, zero_bytes, fail_blob, negative_blob, element_blob, large_blob);
    shell.length = add_array_length_shell(scene, fail_blob, null_length_blob);
    shell.push = add_array_push_shell(scene, alloc, copy_bytes, fail_blob, null_append_blob, large_blob);
    shell.at = add_array_at_shell(scene, fail_blob, fail_bounds, null_access_blob);
    shell.zero_bytes = zero_bytes;
    shell.string_to_bytes = add_string_to_bytes_shell(scene, shell.new_array, copy_bytes);
    shell.bytes_to_string = add_bytes_to_string_shell(scene, alloc, copy_bytes, fail_blob, fail_nul, null_bytes_blob, size_blob);
    shell.string_at = add_string_at_shell(scene, fail_string_index);
    shell.substring = add_substring_shell(scene, alloc, copy_bytes, fail_substring);
    shell.fail_shift = fail_shift;
    shell.fail_blob = fail_blob;
    shell.write_blob_fd = write_blob_fd;
    shell.write_int_fd = write_int_fd;
    shell.eprint_space = eprint_space_blob;
    shell.eprint_newline = newline_blob;
    shell.eprint_true = eprint_true_blob;
    shell.eprint_false = eprint_false_blob;
    return shell;
}

// FloatPrintShell carries the float print shells' function indices.
public struct FloatPrintShell {
    int print_float;
    int print_float_raw;
}

// four_int_parameters returns a shape list holding exactly four ints.
fn four_int_parameters() -> NativeType[] {
    NativeType[] shapes = new NativeType[4];
    shapes[0] = NativeType.Int;
    shapes[1] = NativeType.Int;
    shapes[2] = NativeType.Int;
    shapes[3] = NativeType.Int;
    return shapes;
}

// --- The %g float formatter (Phase 10.8) ------------------------------------

// The formatter prints doubles with C's %g spelling through shell groups in
// this file. Its big integers are allocated objects holding 16-bit limbs:
// [header word @0][limb count @8][limb slots @16, 8 bytes each], each limb
// value fitting 0..65535. Every writer fills the whole limb array its count
// names, so no zero-fill pass is needed, and the count is the smallest limb
// count the value needs ("0" is count 1 with limb 0 at zero). Limb products
// never exceed 32 bits, so WholeDivide and WholeRemainder by 65536 recover
// both halves with plain scene arithmetic. The value being printed lives on
// the shell's own stack, so every intermediate bigint is a GC-visible root.

// bn_new registers "$bn_new": one big integer object of the limb count in
// parameter 0, the count sealed at offset 8, the limb slots left for the
// caller's writer. Locals: 3.
fn add_bn_new_shell(NativeScene scene, int alloc) -> int {
    int shell = add_function(scene, "$bn_new", NativeType.Int, one_int_parameter(), 1);
    NativeFunction bn_function = function_at(scene, shell);

    int eight = new_temporary(bn_function, NativeType.Int);
    push_instruction(bn_function, Instruction.ConstInt { target = eight, value = 8 });
    int stride = new_temporary(bn_function, NativeType.Int);
    push_instruction(bn_function, Instruction.Multiply { target = stride, left = 0, right = eight });
    int request = new_temporary(bn_function, NativeType.Int);
    push_instruction(bn_function, Instruction.Add { target = request, left = stride, right = eight });
    push_instruction(bn_function, Instruction.Add { target = request, left = request, right = eight });
    int obj = new_temporary(bn_function, NativeType.Int);
    int[] alloc_arguments = new int[1];
    alloc_arguments[0] = request;
    push_instruction(bn_function, Instruction.Call { target = obj, function = alloc, arguments = alloc_arguments, argument_count = 1 });
    push_instruction(bn_function, Instruction.RawStore64 { address = obj, offset = 0, value = request });
    push_instruction(bn_function, Instruction.RawStore64 { address = obj, offset = 8, value = 0 });
    push_instruction(bn_function, Instruction.Return { value = obj });
    return shell;
}

// bn_get registers "$bn_get": limb i (parameter 1) of the object (parameter
// 0), read from byte offset 16 + 8i. Locals: 5.
fn add_bn_get_shell(NativeScene scene) -> int {
    int shell = add_function(scene, "$bn_get", NativeType.Int, two_int_parameters(), 2);
    NativeFunction get_function = function_at(scene, shell);

    int eight = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.ConstInt { target = eight, value = 8 });
    int stride = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.Multiply { target = stride, left = 1, right = eight });
    int sixteen = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.ConstInt { target = sixteen, value = 16 });
    int offset = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.Add { target = offset, left = stride, right = sixteen });
    int addr = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.Add { target = addr, left = 0, right = offset });
    int limb = new_temporary(get_function, NativeType.Int);
    push_instruction(get_function, Instruction.RawLoad64 { target = limb, address = addr, offset = 0 });
    push_instruction(get_function, Instruction.Return { value = limb });
    return shell;
}

// bn_set registers "$bn_set": parameter 2 stores into limb i of parameter 0.
// Locals: 5.
fn add_bn_set_shell(NativeScene scene) -> int {
    int shell = add_function(scene, "$bn_set", NativeType.Void, three_int_parameters(), 3);
    NativeFunction set_function = function_at(scene, shell);

    int eight = new_temporary(set_function, NativeType.Int);
    push_instruction(set_function, Instruction.ConstInt { target = eight, value = 8 });
    int stride = new_temporary(set_function, NativeType.Int);
    push_instruction(set_function, Instruction.Multiply { target = stride, left = 1, right = eight });
    int sixteen = new_temporary(set_function, NativeType.Int);
    push_instruction(set_function, Instruction.ConstInt { target = sixteen, value = 16 });
    int offset = new_temporary(set_function, NativeType.Int);
    push_instruction(set_function, Instruction.Add { target = offset, left = stride, right = sixteen });
    int addr = new_temporary(set_function, NativeType.Int);
    push_instruction(set_function, Instruction.Add { target = addr, left = 0, right = offset });
    push_instruction(set_function, Instruction.RawStore64 { address = addr, offset = 0, value = 2 });
    push_instruction(set_function, Instruction.ReturnVoid);
    return shell;
}

// bn_count registers "$bn_count": the limb count at offset 8. Locals: 1.
fn add_bn_count_shell(NativeScene scene) -> int {
    int shell = add_function(scene, "$bn_count", NativeType.Int, one_int_parameter(), 1);
    NativeFunction count_function = function_at(scene, shell);
    int count = new_temporary(count_function, NativeType.Int);
    push_instruction(count_function, Instruction.RawLoad64 { target = count, address = 0, offset = 8 });
    push_instruction(count_function, Instruction.Return { value = count });
    return shell;
}

// bn_cmp registers "$bn_cmp": -1, 0, or 1 as parameter 0 stands to
// parameter 1. Unequal counts decide first (counts stay trimmed); equal
// counts walk the limbs from the most significant one down. Locals: 9.
fn add_bn_cmp_shell(NativeScene scene, int bn_get) -> int {
    int shell = add_function(scene, "$bn_cmp", NativeType.Int, two_int_parameters(), 2);
    NativeFunction cmp_function = function_at(scene, shell);

    int zero = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.ConstInt { target = one, value = 1 });
    int minus_one = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.ConstInt { target = minus_one, value = -1 });
    int count_a = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.RawLoad64 { target = count_a, address = 0, offset = 8 });
    int count_b = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.RawLoad64 { target = count_b, address = 1, offset = 8 });
    int smaller = new_temporary(cmp_function, NativeType.Bool);
    push_instruction(cmp_function, Instruction.LessThan { target = smaller, left = count_a, right = count_b });
    push_instruction(cmp_function, Instruction.Branch { condition = smaller, label_true = 0, label_false = 1 });
    push_instruction(cmp_function, Instruction.Label { label = 0 });
    push_instruction(cmp_function, Instruction.Return { value = minus_one });
    push_instruction(cmp_function, Instruction.Label { label = 1 });
    int bigger = new_temporary(cmp_function, NativeType.Bool);
    push_instruction(cmp_function, Instruction.LessThan { target = bigger, left = count_b, right = count_a });
    push_instruction(cmp_function, Instruction.Branch { condition = bigger, label_true = 2, label_false = 3 });
    push_instruction(cmp_function, Instruction.Label { label = 2 });
    push_instruction(cmp_function, Instruction.Return { value = one });
    push_instruction(cmp_function, Instruction.Label { label = 3 });
    // Walk from the top limb down: labels 4 (top), 5 (under), 6 (step body),
    // 7 (bigger step), 8 (smaller step).
    push_instruction(cmp_function, Instruction.Subtract { target = count_a, left = count_a, right = one });
    push_instruction(cmp_function, Instruction.Label { label = 4 });
    push_instruction(cmp_function, Instruction.LessThan { target = smaller, left = count_a, right = zero });
    push_instruction(cmp_function, Instruction.Branch { condition = smaller, label_true = 5, label_false = 6 });
    push_instruction(cmp_function, Instruction.Label { label = 5 });
    push_instruction(cmp_function, Instruction.Return { value = zero });
    push_instruction(cmp_function, Instruction.Label { label = 6 });
    int[] get_a = new int[2];
    get_a[0] = 0;
    get_a[1] = count_a;
    int limb_a = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.Call { target = limb_a, function = bn_get, arguments = get_a, argument_count = 2 });
    int[] get_b = new int[2];
    get_b[0] = 1;
    get_b[1] = count_a;
    int limb_b = new_temporary(cmp_function, NativeType.Int);
    push_instruction(cmp_function, Instruction.Call { target = limb_b, function = bn_get, arguments = get_b, argument_count = 2 });
    push_instruction(cmp_function, Instruction.LessThan { target = bigger, left = limb_b, right = limb_a });
    push_instruction(cmp_function, Instruction.Branch { condition = bigger, label_true = 2, label_false = 7 });
    push_instruction(cmp_function, Instruction.Label { label = 7 });
    push_instruction(cmp_function, Instruction.LessThan { target = smaller, left = limb_a, right = limb_b });
    push_instruction(cmp_function, Instruction.Branch { condition = smaller, label_true = 0, label_false = 8 });
    push_instruction(cmp_function, Instruction.Label { label = 8 });
    push_instruction(cmp_function, Instruction.Subtract { target = count_a, left = count_a, right = one });
    push_instruction(cmp_function, Instruction.Jump { label = 4 });
    push_instruction(cmp_function, Instruction.Return { value = zero });
    return shell;
}

// bn_mul_small registers "$bn_mul_small": a fresh big integer holding
// parameter 0 times factor parameter 1 (which fits a limb). Walks the limbs
// with a carry, stores the carry limb at the top, then trims any zero top
// limbs so the count stays minimal. Locals: 14.
fn add_bn_mul_small_shell(NativeScene scene, int bn_new, int bn_get, int bn_set) -> int {
    int shell = add_function(scene, "$bn_mul_small", NativeType.Int, two_int_parameters(), 2);
    NativeFunction mul_function = function_at(scene, shell);

    int count_a = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.RawLoad64 { target = count_a, address = 0, offset = 8 });
    int zero = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.ConstInt { target = one, value = 1 });
    int count_out = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.Add { target = count_out, left = count_a, right = one });
    int out = new_temporary(mul_function, NativeType.Int);
    int[] new_arguments = new int[1];
    new_arguments[0] = count_out;
    push_instruction(mul_function, Instruction.Call { target = out, function = bn_new, arguments = new_arguments, argument_count = 1 });
    int carry = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.ConstInt { target = carry, value = 0 });
    int base = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.ConstInt { target = base, value = 65536 });
    int i = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.ConstInt { target = i, value = 0 });
    int more = new_temporary(mul_function, NativeType.Bool);
    push_instruction(mul_function, Instruction.Label { label = 0 });
    push_instruction(mul_function, Instruction.LessThan { target = more, left = i, right = count_a });
    push_instruction(mul_function, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(mul_function, Instruction.Label { label = 1 });
    int[] load_arguments = new int[2];
    load_arguments[0] = 0;
    load_arguments[1] = i;
    int limb = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.Call { target = limb, function = bn_get, arguments = load_arguments, argument_count = 2 });
    int product = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.Multiply { target = product, left = limb, right = 1 });
    push_instruction(mul_function, Instruction.Add { target = product, left = product, right = carry });
    int stores = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.WholeRemainder { target = stores, left = product, right = base });
    push_instruction(mul_function, Instruction.WholeDivide { target = carry, left = product, right = base });
    int[] set_arguments = new int[3];
    set_arguments[0] = out;
    set_arguments[1] = i;
    set_arguments[2] = stores;
    push_instruction(mul_function, Instruction.CallVoid { function = bn_set, arguments = set_arguments, argument_count = 3 });
    push_instruction(mul_function, Instruction.Add { target = i, left = i, right = one });
    push_instruction(mul_function, Instruction.Jump { label = 0 });
    push_instruction(mul_function, Instruction.Label { label = 2 });
    int[] top_arguments = new int[3];
    top_arguments[0] = out;
    top_arguments[1] = count_a;
    top_arguments[2] = carry;
    push_instruction(mul_function, Instruction.CallVoid { function = bn_set, arguments = top_arguments, argument_count = 3 });
    push_instruction(mul_function, Instruction.Label { label = 3 });
    push_instruction(mul_function, Instruction.LessThan { target = more, left = one, right = count_out });
    push_instruction(mul_function, Instruction.Branch { condition = more, label_true = 4, label_false = 5 });
    push_instruction(mul_function, Instruction.Label { label = 4 });
    int top_index = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.Subtract { target = top_index, left = count_out, right = one });
    int[] read_top = new int[2];
    read_top[0] = out;
    read_top[1] = top_index;
    int top_limb = new_temporary(mul_function, NativeType.Int);
    push_instruction(mul_function, Instruction.Call { target = top_limb, function = bn_get, arguments = read_top, argument_count = 2 });
    push_instruction(mul_function, Instruction.Equal { target = more, left = top_limb, right = zero });
    push_instruction(mul_function, Instruction.Branch { condition = more, label_true = 6, label_false = 5 });
    push_instruction(mul_function, Instruction.Label { label = 6 });
    push_instruction(mul_function, Instruction.Subtract { target = count_out, left = count_out, right = one });
    push_instruction(mul_function, Instruction.Jump { label = 3 });
    push_instruction(mul_function, Instruction.Label { label = 5 });
    push_instruction(mul_function, Instruction.RawStore64 { address = out, offset = 8, value = count_out });
    push_instruction(mul_function, Instruction.Return { value = out });
    return shell;
}

// bn_sub_into registers "$bn_sub_into": parameter 0 loses parameter 1 in
// place (parameter 0 stands at or above parameter 1). Limb borrows walk up
// in arithmetic order, the two loops split at the shorter count (the tail
// borrows alone), and the count is trimmed back down afterwards. Locals:
// 14.
fn add_bn_sub_into_shell(NativeScene scene, int bn_get, int bn_set) -> int {
    int shell = add_function(scene, "$bn_sub_into", NativeType.Void, two_int_parameters(), 2);
    NativeFunction sub_function = function_at(scene, shell);

    int count_a = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.RawLoad64 { target = count_a, address = 0, offset = 8 });
    int count_b = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.RawLoad64 { target = count_b, address = 1, offset = 8 });
    int zero = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.ConstInt { target = one, value = 1 });
    int base = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.ConstInt { target = base, value = 65536 });
    int borrow = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.ConstInt { target = borrow, value = 0 });
    int i = new_temporary(sub_function, NativeType.Int);
    push_instruction(sub_function, Instruction.ConstInt { target = i, value = 0 });
    int[] store = new int[3];
    store[0] = 0;
    store[1] = i;
    store[2] = zero;
    int[] args = new int[2];
    args[0] = 0;
    args[1] = i;
    int d = new_temporary(sub_function, NativeType.Int);
    int more = new_temporary(sub_function, NativeType.Bool);
    int negative = new_temporary(sub_function, NativeType.Bool);
    int limb_a = new_temporary(sub_function, NativeType.Int);
    int limb_b = new_temporary(sub_function, NativeType.Int);

    // Shared walk: both objects have a limb at i.
    push_instruction(sub_function, Instruction.Label { label = 0 });
    push_instruction(sub_function, Instruction.LessThan { target = more, left = i, right = count_b });
    push_instruction(sub_function, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(sub_function, Instruction.Label { label = 1 });
    args[0] = 1;
    args[1] = i;
    push_instruction(sub_function, Instruction.Call { target = limb_b, function = bn_get, arguments = args, argument_count = 2 });
    args[0] = 0;
    args[1] = i;
    push_instruction(sub_function, Instruction.Call { target = limb_a, function = bn_get, arguments = args, argument_count = 2 });
    push_instruction(sub_function, Instruction.Subtract { target = d, left = limb_a, right = limb_b });
    push_instruction(sub_function, Instruction.Subtract { target = d, left = d, right = borrow });
    push_instruction(sub_function, Instruction.LessThan { target = negative, left = d, right = zero });
    push_instruction(sub_function, Instruction.Branch { condition = negative, label_true = 3, label_false = 4 });
    push_instruction(sub_function, Instruction.Label { label = 3 });
    push_instruction(sub_function, Instruction.Add { target = d, left = d, right = base });
    push_instruction(sub_function, Instruction.Copy { target = borrow, source = one });
    push_instruction(sub_function, Instruction.Jump { label = 5 });
    push_instruction(sub_function, Instruction.Label { label = 4 });
    push_instruction(sub_function, Instruction.Copy { target = borrow, source = zero });
    push_instruction(sub_function, Instruction.Label { label = 5 });
    store[1] = i;
    store[2] = d;
    push_instruction(sub_function, Instruction.CallVoid { function = bn_set, arguments = store, argument_count = 3 });
    push_instruction(sub_function, Instruction.Add { target = i, left = i, right = one });
    push_instruction(sub_function, Instruction.Jump { label = 0 });

    // Borrow-only tail: a has limbs past b's.
    push_instruction(sub_function, Instruction.Label { label = 2 });
    push_instruction(sub_function, Instruction.LessThan { target = more, left = i, right = count_a });
    push_instruction(sub_function, Instruction.Branch { condition = more, label_true = 6, label_false = 7 });
    push_instruction(sub_function, Instruction.Label { label = 6 });
    args[0] = 0;
    args[1] = i;
    push_instruction(sub_function, Instruction.Call { target = limb_a, function = bn_get, arguments = args, argument_count = 2 });
    push_instruction(sub_function, Instruction.Subtract { target = d, left = limb_a, right = borrow });
    push_instruction(sub_function, Instruction.LessThan { target = negative, left = d, right = zero });
    push_instruction(sub_function, Instruction.Branch { condition = negative, label_true = 8, label_false = 9 });
    push_instruction(sub_function, Instruction.Label { label = 8 });
    push_instruction(sub_function, Instruction.Add { target = d, left = d, right = base });
    push_instruction(sub_function, Instruction.Copy { target = borrow, source = one });
    push_instruction(sub_function, Instruction.Jump { label = 10 });
    push_instruction(sub_function, Instruction.Label { label = 9 });
    push_instruction(sub_function, Instruction.Copy { target = borrow, source = zero });
    push_instruction(sub_function, Instruction.Label { label = 10 });
    store[1] = i;
    store[2] = d;
    push_instruction(sub_function, Instruction.CallVoid { function = bn_set, arguments = store, argument_count = 3 });
    push_instruction(sub_function, Instruction.Add { target = i, left = i, right = one });
    push_instruction(sub_function, Instruction.Jump { label = 2 });

    // Trim: drop zero top limbs.
    push_instruction(sub_function, Instruction.Label { label = 7 });
    push_instruction(sub_function, Instruction.Label { label = 11 });
    push_instruction(sub_function, Instruction.LessThan { target = more, left = one, right = count_a });
    push_instruction(sub_function, Instruction.Branch { condition = more, label_true = 12, label_false = 13 });
    push_instruction(sub_function, Instruction.Label { label = 12 });
    push_instruction(sub_function, Instruction.Subtract { target = i, left = count_a, right = one });
    args[0] = 0;
    args[1] = i;
    push_instruction(sub_function, Instruction.Call { target = limb_a, function = bn_get, arguments = args, argument_count = 2 });
    push_instruction(sub_function, Instruction.Equal { target = negative, left = limb_a, right = zero });
    push_instruction(sub_function, Instruction.Branch { condition = negative, label_true = 14, label_false = 13 });
    push_instruction(sub_function, Instruction.Label { label = 14 });
    push_instruction(sub_function, Instruction.Subtract { target = count_a, left = count_a, right = one });
    push_instruction(sub_function, Instruction.Jump { label = 11 });
    push_instruction(sub_function, Instruction.Label { label = 13 });
    push_instruction(sub_function, Instruction.RawStore64 { address = 0, offset = 8, value = count_a });
    push_instruction(sub_function, Instruction.ReturnVoid);
    return shell;
}

// bn_mul10 registers "$bn_mul10": parameter 0 times ten, fresh (the digit
// loop's step). Locals: 5.
fn add_bn_mul10_shell(NativeScene scene, int bn_mul_small) -> int {
    int shell = add_function(scene, "$bn_mul10", NativeType.Int, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int ten = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = ten, value = 10 });
    int out = new_temporary(h, NativeType.Int);
    int[] args = new int[2];
    args[0] = 0;
    args[1] = ten;
    push_instruction(h, Instruction.Call { target = out, function = bn_mul_small, arguments = args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = out });
    return shell;
}

// bn_copy_into registers "$bn_copy_into": parameter 0's limbs take
// parameter 1's value. Every source limb is written, so the destination's
// current count never truncates a value that grew by a limb; the count is
// then sealed to the source count. The destination must have the capacity
// the source count needs, which "$bn_pad" guarantees for the digit loop.
// Locals: 5.
fn add_bn_copy_into_shell(NativeScene scene, int bn_get, int bn_set, int bn_count) -> int {
    int shell = add_function(scene, "$bn_copy_into", NativeType.Void, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int src_count = new_temporary(h, NativeType.Int);
    int[] count_args = new int[1];
    count_args[0] = 1;
    push_instruction(h, Instruction.Call { target = src_count, function = bn_count, arguments = count_args, argument_count = 1 });
    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int[] get_args = new int[2];
    get_args[0] = 1;
    get_args[1] = i;
    int[] set_args = new int[3];
    set_args[0] = 0;
    set_args[1] = i;
    set_args[2] = zero;
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = src_count });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Call { target = set_args[2], function = bn_get, arguments = get_args, argument_count = 2 });
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 8, value = src_count });
    push_instruction(h, Instruction.ReturnVoid);
    return shell;
}

// bn_pad registers "$bn_pad": a fresh big integer holding parameter 0's
// value with at least parameter 1 limbs of capacity. The digit loop copies a
// remainder that can be one limb wider than the numerator it replaces, so
// the numerator must be padded to the divisor's limb count first. Locals: 6.
fn add_bn_pad_shell(NativeScene scene, int bn_count, int bn_new, int bn_copy_into) -> int {
    int shell = add_function(scene, "$bn_pad", NativeType.Int, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, shell);

    int current = new_temporary(h, NativeType.Int);
    int[] count_args = new int[1];
    count_args[0] = 0;
    push_instruction(h, Instruction.Call { target = current, function = bn_count, arguments = count_args, argument_count = 1 });
    int minimum_wins = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = minimum_wins, left = current, right = 1 });
    int capacity = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Branch { condition = minimum_wins, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.Copy { target = capacity, source = 1 });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Copy { target = capacity, source = current });
    push_instruction(h, Instruction.Label { label = 2 });
    int[] new_args = new int[1];
    new_args[0] = capacity;
    int out = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = out, function = bn_new, arguments = new_args, argument_count = 1 });
    int[] copy_args = new int[2];
    copy_args[0] = out;
    copy_args[1] = 0;
    push_instruction(h, Instruction.CallVoid { function = bn_copy_into, arguments = copy_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = out });
    return shell;
}

// bn_digit registers "$bn_digit": the digit loop's step. Parameters: 0 the
// fraction numerator whose limbs the shell consumes and refills with the
// next digit's tail, 1 the denominator, 2 the multiplier (one for the
// value's leading digit, ten for every digit after). The step multiplies
// through "$bn_mul_small", counts denominator subtractions (one to ten),
// parks the remainder back into parameter 0's limbs through
// "$bn_copy_into", and returns the digit. Locals: 9.
fn add_bn_digit_shell(NativeScene scene, int bn_mul_small, int bn_cmp, int bn_sub_into, int bn_copy_into) -> int {
    int shell = add_function(scene, "$bn_digit", NativeType.Int, three_int_parameters(), 3);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int shifted = new_temporary(h, NativeType.Int);
    int[] mul_args = new int[2];
    mul_args[0] = 0;
    mul_args[1] = 2;
    push_instruction(h, Instruction.Call { target = shifted, function = bn_mul_small, arguments = mul_args, argument_count = 2 });
    int d = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = d, value = 0 });
    int[] cmp_args = new int[2];
    cmp_args[0] = shifted;
    cmp_args[1] = 1;
    push_instruction(h, Instruction.Label { label = 0 });
    int cmp = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = cmp, function = bn_cmp, arguments = cmp_args, argument_count = 2 });
    int low = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = low, left = cmp, right = zero });
    push_instruction(h, Instruction.Branch { condition = low, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.CallVoid { function = bn_sub_into, arguments = cmp_args, argument_count = 2 });
    push_instruction(h, Instruction.Add { target = d, left = d, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 1 });
    int[] copy_args = new int[2];
    copy_args[0] = 0;
    copy_args[1] = shifted;
    push_instruction(h, Instruction.CallVoid { function = bn_copy_into, arguments = copy_args, argument_count = 2 });
    push_instruction(h, Instruction.Return { value = d });
    return shell;
}

// bn_times10pow registers "$bn_times10pow": parameter 0 times ten to the
// parameter 1 power, through copies and "$bn_mul_small". A zero exponent
// answers a trimmed copy of the input. Locals: 9.
fn add_bn_times10pow_shell(NativeScene scene, int bn_count, int bn_new, int bn_copy_into, int bn_mul_small) -> int {
    int shell = add_function(scene, "$bn_times10pow", NativeType.Int, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int count = new_temporary(h, NativeType.Int);
    int[] count_args = new int[1];
    count_args[0] = 0;
    push_instruction(h, Instruction.Call { target = count, function = bn_count, arguments = count_args, argument_count = 1 });
    int[] new_args = new int[1];
    new_args[0] = count;
    int acc = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = acc, function = bn_new, arguments = new_args, argument_count = 1 });
    int[] copy_args = new int[2];
    copy_args[0] = acc;
    copy_args[1] = 0;
    push_instruction(h, Instruction.CallVoid { function = bn_copy_into, arguments = copy_args, argument_count = 2 });
    int ten = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = ten, value = 10 });
    int i = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    int[] mul_args = new int[2];
    mul_args[0] = acc;
    mul_args[1] = ten;
    push_instruction(h, Instruction.Label { label = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = 1 });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 2 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Call { target = acc, function = bn_mul_small, arguments = mul_args, argument_count = 2 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Return { value = acc });
    return shell;
}

// bn_bump registers "$bn_bump": the six digit limbs of parameter 0 take a
// one-up starting at the last digit with carries walking left.
// It answers 0 once the bump lands on the last digit, 1 when a carry moves
// to a higher digit, and 2 when the bump climbs past digit 0 (the digits
// become 1,0,0,0,0,0 and the caller bumps its decimal exponent).
// Locals: 10.
fn add_bn_bump_shell(NativeScene scene, int bn_get, int bn_set) -> int {
    int shell = add_function(scene, "$bn_bump", NativeType.Int, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int idx0 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = idx0, value = 0 });
    int idx1 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = idx1, value = 1 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int ten = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = ten, value = 10 });
    int six = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = six, value = 6 });
    int j = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = j, value = 5 });
    int digit = new_temporary(h, NativeType.Int);
    int result = new_temporary(h, NativeType.Int);
    int[] get_args = new int[2];
    get_args[0] = 0;
    get_args[1] = j;
    int[] set_args = new int[3];
    set_args[0] = 0;
    set_args[1] = j;
    set_args[2] = digit;
    int more = new_temporary(h, NativeType.Bool);
    // Walk digits from the last one left.
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = j, right = zero });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 3, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Call { target = digit, function = bn_get, arguments = get_args, argument_count = 2 });
    push_instruction(h, Instruction.Add { target = digit, left = digit, right = one });
    push_instruction(h, Instruction.LessThan { target = more, left = digit, right = ten });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 2, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 2 });
    // The digit stays single: the bump landed here.
    set_args[2] = digit;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    int probe = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Subtract { target = probe, left = j, right = zero });
    int landed = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = landed, left = probe, right = zero });
    push_instruction(h, Instruction.Branch { condition = landed, label_true = 5, label_false = 6 });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.ConstInt { target = result, value = 1 });
    push_instruction(h, Instruction.Return { value = result });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.ConstInt { target = result, value = 0 });
    push_instruction(h, Instruction.Return { value = result });
    // The digit wrapped: store zero, walk left.
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Copy { target = set_args[2], source = zero });
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    push_instruction(h, Instruction.Subtract { target = j, left = j, right = one });
    get_args[1] = j;
    set_args[1] = j;
    push_instruction(h, Instruction.Jump { label = 0 });
    // The roll: digit 0 to one, digits 1..5 to zero.
    push_instruction(h, Instruction.Label { label = 3 });
    set_args[1] = zero;
    push_instruction(h, Instruction.ConstInt { target = set_args[2], value = 1 });
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    set_args[1] = one;
    push_instruction(h, Instruction.Copy { target = set_args[2], source = zero });
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    push_instruction(h, Instruction.ConstInt { target = j, value = 2 });
    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.LessThan { target = more, left = j, right = six });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 8, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 8 });
    set_args[1] = j;
    push_instruction(h, Instruction.Copy { target = set_args[2], source = zero });
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    push_instruction(h, Instruction.Add { target = j, left = j, right = one });
    push_instruction(h, Instruction.Jump { label = 7 });
    push_instruction(h, Instruction.Label { label = 9 });
    push_instruction(h, Instruction.ConstInt { target = result, value = 2 });
    push_instruction(h, Instruction.Return { value = result });
    return shell;
}


// bn_trim registers "$bn_trim": drop zero top limbs in place (count stays
// at least 1; "0" stays count 1 with a zero top limb). Locals: 6.
fn add_bn_trim_shell(NativeScene scene, int bn_get) -> int {
    int shell = add_function(scene, "$bn_trim", NativeType.Void, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int[] get_args = new int[2];
    get_args[0] = 0;
    get_args[1] = zero;
    int count = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = count, address = 0, offset = 8 });
    int limb = new_temporary(h, NativeType.Int);
    int more = new_temporary(h, NativeType.Bool);
    int at_zero = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Label { label = 0 });
    push_instruction(h, Instruction.LessThan { target = more, left = one, right = count });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 1, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 1 });
    push_instruction(h, Instruction.Subtract { target = get_args[1], left = count, right = one });
    push_instruction(h, Instruction.Call { target = limb, function = bn_get, arguments = get_args, argument_count = 2 });
    push_instruction(h, Instruction.Equal { target = at_zero, left = limb, right = zero });
    push_instruction(h, Instruction.Branch { condition = at_zero, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Subtract { target = count, left = count, right = one });
    push_instruction(h, Instruction.Jump { label = 0 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.RawStore64 { address = 0, offset = 8, value = count });
    push_instruction(h, Instruction.ReturnVoid);
    return shell;
}

// bn_pow2 registers "$bn_pow2": two to parameter 0, through two-multiplication
// chains from a seeded one (the factor stays inside a limb). Locals: 8.
fn add_bn_pow2_shell(NativeScene scene, int bn_new, int bn_set, int bn_mul_small) -> int {
    int shell = add_function(scene, "$bn_pow2", NativeType.Int, one_int_parameter(), 1);
    NativeFunction h = function_at(scene, shell);

    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int seed = new_temporary(h, NativeType.Int);
    int[] new_args = new int[1];
    new_args[0] = one;
    push_instruction(h, Instruction.Call { target = seed, function = bn_new, arguments = new_args, argument_count = 1 });
    int idx0 = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = idx0, value = 0 });
    int[] set_args = new int[3];
    set_args[0] = seed;
    set_args[1] = idx0;
    set_args[2] = one;
    push_instruction(h, Instruction.CallVoid { function = bn_set, arguments = set_args, argument_count = 3 });
    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int pow = new_temporary(h, NativeType.Int);
