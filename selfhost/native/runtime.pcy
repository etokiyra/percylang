    push_instruction(h, Instruction.Call { target = nul_out_text, function = decimal_string, arguments = nul_out_text_args, argument_count = 1 });
    int[] nul_out_first_args = new int[2];
    nul_out_first_args[0] = run_prefix;
    nul_out_first_args[1] = 0;
    int nul_out_first = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = nul_out_first, function = string_concat, arguments = nul_out_first_args, argument_count = 2 });
    int nul_out_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = nul_out_colon, blob = add_blob(scene, ": ") });
    int nul_out_second = new_temporary(h, NativeType.Ref);
    int[] nul_out_second_args = new int[2];
    nul_out_second_args[0] = nul_out_first;
    nul_out_second_args[1] = nul_out_colon;
    push_instruction(h, Instruction.Call { target = nul_out_second, function = string_concat, arguments = nul_out_second_args, argument_count = 2 });
    int nul_out_reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = nul_out_reason, blob = add_blob(scene, "stdout contains a NUL byte at offset ") });
    int nul_out_third = new_temporary(h, NativeType.Ref);
    int[] nul_out_third_args = new int[2];
    nul_out_third_args[0] = nul_out_second;
    nul_out_third_args[1] = nul_out_reason;
    push_instruction(h, Instruction.Call { target = nul_out_third, function = string_concat, arguments = nul_out_third_args, argument_count = 2 });
    int[] nul_out_last_args = new int[2];
    nul_out_last_args[0] = nul_out_third;
    nul_out_last_args[1] = nul_out_text;
    push_instruction(h, Instruction.Call { target = failure_message, function = string_concat, arguments = nul_out_last_args, argument_count = 2 });
    push_instruction(h, Instruction.Jump { label = 39 });

    push_instruction(h, Instruction.Label { label = 36 });
    int[] nul_err_args = new int[2];
    nul_err_args[0] = err_data;
    nul_err_args[1] = err_length;
    int nul_err = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = nul_err, function = first_nul, arguments = nul_err_args, argument_count = 2 });
    int no_nul_err = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = no_nul_err, left = nul_err, right = zero });
    push_instruction(h, Instruction.Branch { condition = no_nul_err, label_true = 38, label_false = 37 });

    push_instruction(h, Instruction.Label { label = 37 });
    int[] nul_err_text_args = new int[1];
    nul_err_text_args[0] = nul_err;
    int nul_err_text = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = nul_err_text, function = decimal_string, arguments = nul_err_text_args, argument_count = 1 });
    int[] nul_err_first_args = new int[2];
    nul_err_first_args[0] = run_prefix;
    nul_err_first_args[1] = 0;
    int nul_err_first = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Call { target = nul_err_first, function = string_concat, arguments = nul_err_first_args, argument_count = 2 });
    int nul_err_colon = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = nul_err_colon, blob = add_blob(scene, ": ") });
    int nul_err_second = new_temporary(h, NativeType.Ref);
    int[] nul_err_second_args = new int[2];
    nul_err_second_args[0] = nul_err_first;
    nul_err_second_args[1] = nul_err_colon;
    push_instruction(h, Instruction.Call { target = nul_err_second, function = string_concat, arguments = nul_err_second_args, argument_count = 2 });
    int nul_err_reason = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = nul_err_reason, blob = add_blob(scene, "stderr contains a NUL byte at offset ") });
    int nul_err_third = new_temporary(h, NativeType.Ref);
    int[] nul_err_third_args = new int[2];
    nul_err_third_args[0] = nul_err_second;
    nul_err_third_args[1] = nul_err_reason;
    push_instruction(h, Instruction.Call { target = nul_err_third, function = string_concat, arguments = nul_err_third_args, argument_count = 2 });
    int[] nul_err_last_args = new int[2];
    nul_err_last_args[0] = nul_err_third;
    nul_err_last_args[1] = nul_err_text;
    push_instruction(h, Instruction.Call { target = failure_message, function = string_concat, arguments = nul_err_last_args, argument_count = 2 });
    push_instruction(h, Instruction.Jump { label = 39 });

    // Label 38: CapturedRunResult.Ok.
    push_instruction(h, Instruction.Label { label = 38 });
    int out_text_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = out_text_request, left = out_length, right = sixteen });
    int[] out_text_alloc = new int[1];
    out_text_alloc[0] = out_text_request;
    int out_text = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = out_text, function = alloc, arguments = out_text_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = out_text, offset = 8, value = out_length });
    int out_text_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = out_text_data, left = out_text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = out_text, offset = 16, value = out_text_data });
    int[] out_text_copy = new int[3];
    out_text_copy[0] = out_text_data;
    out_text_copy[1] = out_data;
    out_text_copy[2] = out_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = out_text_copy, argument_count = 3 });
    int err_text_request = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = err_text_request, left = err_length, right = sixteen });
    int[] err_text_alloc = new int[1];
    err_text_alloc[0] = err_text_request;
    int err_text = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = err_text, function = alloc, arguments = err_text_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = err_text, offset = 8, value = err_length });
    int err_text_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = err_text_data, left = err_text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = err_text, offset = 16, value = err_text_data });
    int[] err_text_copy = new int[3];
    err_text_copy[0] = err_text_data;
    err_text_copy[1] = err_data;
    err_text_copy[2] = err_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = err_text_copy, argument_count = 3 });
    int wait_status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = wait_status, address = status_data, offset = 0 });
    int signal_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = signal_bits, left = wait_status, right = low7 });
    int capture_exited = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = capture_exited, left = signal_bits, right = zero });
    push_instruction(h, Instruction.Branch { condition = capture_exited, label_true = 52, label_false = 53 });
    push_instruction(h, Instruction.Label { label = 52 });
    int shifted_status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ShiftRight { target = shifted_status, left = wait_status, count = eight });
    int exit_code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = exit_code, left = shifted_status, right = byte_mask });
    push_instruction(h, Instruction.Jump { label = 54 });
    push_instruction(h, Instruction.Label { label = 53 });
    int signal = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.BitAnd { target = signal, left = wait_status, right = low7 });
    push_instruction(h, Instruction.Add { target = exit_code, left = signal, right = one_hundred_twenty_seven });
    push_instruction(h, Instruction.Add { target = exit_code, left = exit_code, right = one });
    push_instruction(h, Instruction.Label { label = 54 });
    int[] capture_ok_alloc = new int[1];
    capture_ok_alloc[0] = forty;
    int ok_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = ok_union, function = alloc, arguments = capture_ok_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 8, value = zero });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 16, value = exit_code });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 24, value = out_text });
    push_instruction(h, Instruction.RawStore64 { address = ok_union, offset = 32, value = err_text });
    int ok_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = ok_result, source = ok_union });
    push_instruction(h, Instruction.Return { value = ok_result });

    // Label 39: kill the child, reap it, and return Failed.
    push_instruction(h, Instruction.Label { label = 39 });
    int[] kill_args = new int[2];
    kill_args[0] = child;
    kill_args[1] = kill_signal;
    int kill_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = kill_ignored, number = kill_number, arguments = kill_args, argument_count = 2 });
    int[] reap_args = new int[4];
    reap_args[0] = child;
    reap_args[1] = status_data;
    reap_args[2] = zero;
    reap_args[3] = zero;
    int reap_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = reap_ignored, number = wait4_number, arguments = reap_args, argument_count = 4 });
    int[] fail_close_out = new int[1];
    fail_close_out[0] = out_r;
    int fail_close_out_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = fail_close_out_ignored, number = close_number, arguments = fail_close_out, argument_count = 1 });
    int[] fail_close_err = new int[1];
    fail_close_err[0] = err_r;
    int fail_close_err_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = fail_close_err_ignored, number = close_number, arguments = fail_close_err, argument_count = 1 });
    int[] fail_close_error = new int[1];
    fail_close_error[0] = error_r;
    int fail_close_error_ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = fail_close_error_ignored, number = close_number, arguments = fail_close_error, argument_count = 1 });
    int[] capture_failed_alloc = new int[1];
    capture_failed_alloc[0] = forty;
    int failed_union = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = failed_union, function = alloc, arguments = capture_failed_alloc, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = failed_union, offset = 8, value = one });
    int failure_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = failure_bits, source = failure_message });
    push_instruction(h, Instruction.RawStore64 { address = failed_union, offset = 40, value = failure_bits });
    int failed_result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = failed_result, source = failed_union });
    push_instruction(h, Instruction.Return { value = failed_result });

    // Label 46: setup failure (open or pipe).
    push_instruction(h, Instruction.Label { label = 47 });
    int setup_prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = setup_prefix, blob = add_blob(scene, "run ") });
    int[] setup_fail_args = new int[3];
    setup_fail_args[0] = setup_prefix;
    setup_fail_args[1] = 0;
    setup_fail_args[2] = error_code;
    push_instruction(h, Instruction.Call { target = failure_message, function = run_failure, arguments = setup_fail_args, argument_count = 3 });
    push_instruction(h, Instruction.Jump { label = 39 });
    return shell;
}

// add_try_getenv_shell registers "$try_getenv": walk the saved envp array,
// compare each NAME= prefix byte for byte, and build EnvResult. Labels:
// 0 next entry, 1 Unset, 2 prefix start, 3 prefix body, 4 separator,
// 5 match, 6 entry setup, 7 next entry, 8 prefix continue.
public fn add_try_getenv_shell(NativeScene scene, int alloc, int copy_bytes, int c_strlen, int env_blob) -> int {
    int lookup = add_function(scene, "$try_getenv", NativeType.Ref, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, lookup);
    int zero = new_temporary(h, NativeType.Int);
    int twenty_four = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = twenty_four, value = 24 });
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int eight = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = eight, value = 8 });
    int sixteen = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = sixteen, value = 16 });
    int equals = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = equals, value = 61 });
    int result = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.Copy { target = result, source = zero });

    int name_address = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = name_address, source = 0 });
    int name_null = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = name_null, left = name_address, right = zero });
    push_instruction(h, Instruction.Branch { condition = name_null, label_true = 1, label_false = 9 });
    push_instruction(h, Instruction.Label { label = 9 });
    int name_len = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = name_len, address = 0, offset = 8 });
    int name_data = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = name_data, address = 0, offset = 16 });
    int empty_name = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = empty_name, left = name_len, right = zero });
    // The envp pointer must be loaded before the branch's false target
    // (label 0) is placed: a jump to label 0 must find `entry` already
    // initialized, so it has to precede the empty-name branch.
    int entry = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.GetStatic { target = entry, blob = env_blob, offset = 24 });
    push_instruction(h, Instruction.Branch { condition = empty_name, label_true = 1, label_false = 10 });

    int pointer = new_temporary(h, NativeType.Int);
    int i = new_temporary(h, NativeType.Int);
    int env_octet = new_temporary(h, NativeType.Int);
    int name_octet = new_temporary(h, NativeType.Int);
    int same = new_temporary(h, NativeType.Bool);
    int more = new_temporary(h, NativeType.Bool);
    int address = new_temporary(h, NativeType.Int);
    int separator = new_temporary(h, NativeType.Int);
    int is_separator = new_temporary(h, NativeType.Bool);
    int scan_index = new_temporary(h, NativeType.Int);
    int scan_more = new_temporary(h, NativeType.Bool);
    int scan_octet = new_temporary(h, NativeType.Int);
    int is_equals = new_temporary(h, NativeType.Bool);
    int value_pointer = new_temporary(h, NativeType.Int);
    int value_length = new_temporary(h, NativeType.Int);
    int request = new_temporary(h, NativeType.Int);
    int text = new_temporary(h, NativeType.Int);
    int payload = new_temporary(h, NativeType.Int);
    int[] strlen_args = new int[1];
    int[] copy_args = new int[3];
    int[] union_args = new int[1];

    // A name containing `=` can never match an environment entry (the OS
    // stores `NAME=value`), and the C runtime rejects it before calling
    // getenv; scan the name for a separator and return Unset if one appears.
    push_instruction(h, Instruction.Label { label = 10 });
    push_instruction(h, Instruction.ConstInt { target = scan_index, value = 0 });
    push_instruction(h, Instruction.Label { label = 11 });
    push_instruction(h, Instruction.LessThan { target = scan_more, left = scan_index, right = name_len });
    push_instruction(h, Instruction.Branch { condition = scan_more, label_true = 12, label_false = 0 });
    push_instruction(h, Instruction.Label { label = 12 });
    push_instruction(h, Instruction.Add { target = address, left = name_data, right = scan_index });
    push_instruction(h, Instruction.RawLoad8 { target = scan_octet, address = address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = is_equals, left = scan_octet, right = equals });
    push_instruction(h, Instruction.Branch { condition = is_equals, label_true = 1, label_false = 13 });
    push_instruction(h, Instruction.Label { label = 13 });
    push_instruction(h, Instruction.Add { target = scan_index, left = scan_index, right = one });
    push_instruction(h, Instruction.Jump { label = 11 });

    push_instruction(h, Instruction.Label { label = 0 });
    int no_entry = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = no_entry, left = entry, right = zero });
    push_instruction(h, Instruction.Branch { condition = no_entry, label_true = 1, label_false = 6 });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.RawLoad64 { target = pointer, address = entry, offset = 0 });
    // The environment vector's terminator is a NULL pointer in the last slot,
    // not an absent slot: stop on the loaded pointer, not the slot address.
    int no_pointer = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = no_pointer, left = pointer, right = zero });
    push_instruction(h, Instruction.Branch { condition = no_pointer, label_true = 1, label_false = 14 });
    push_instruction(h, Instruction.Label { label = 14 });
    push_instruction(h, Instruction.ConstInt { target = i, value = 0 });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.LessThan { target = more, left = i, right = name_len });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 3, label_false = 4 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.Add { target = address, left = pointer, right = i });
    push_instruction(h, Instruction.RawLoad8 { target = env_octet, address = address, offset = 0 });
    push_instruction(h, Instruction.Add { target = address, left = name_data, right = i });
    push_instruction(h, Instruction.RawLoad8 { target = name_octet, address = address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = same, left = env_octet, right = name_octet });
    push_instruction(h, Instruction.Branch { condition = same, label_true = 8, label_false = 7 });
    push_instruction(h, Instruction.Label { label = 8 });
    push_instruction(h, Instruction.Add { target = i, left = i, right = one });
    push_instruction(h, Instruction.Jump { label = 2 });
    push_instruction(h, Instruction.Label { label = 4 });
    push_instruction(h, Instruction.Add { target = address, left = pointer, right = name_len });
    push_instruction(h, Instruction.RawLoad8 { target = separator, address = address, offset = 0 });
    push_instruction(h, Instruction.Equal { target = is_separator, left = separator, right = equals });
    push_instruction(h, Instruction.Branch { condition = is_separator, label_true = 5, label_false = 7 });

    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Add { target = value_pointer, left = pointer, right = name_len });
    push_instruction(h, Instruction.Add { target = value_pointer, left = value_pointer, right = one });
    strlen_args[0] = value_pointer;
    push_instruction(h, Instruction.Call { target = value_length, function = c_strlen, arguments = strlen_args, argument_count = 1 });
    push_instruction(h, Instruction.Add { target = request, left = value_length, right = sixteen });
    union_args[0] = request;
    push_instruction(h, Instruction.Call { target = text, function = alloc, arguments = union_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 8, value = value_length });
    push_instruction(h, Instruction.Add { target = payload, left = text, right = twenty_four });
    push_instruction(h, Instruction.RawStore64 { address = text, offset = 16, value = payload });
    copy_args[0] = payload;
    copy_args[1] = value_pointer;
    copy_args[2] = value_length;
    push_instruction(h, Instruction.CallVoid { function = copy_bytes, arguments = copy_args, argument_count = 3 });
    int set_union = new_temporary(h, NativeType.Int);
    union_args[0] = sixteen;
    push_instruction(h, Instruction.Call { target = set_union, function = alloc, arguments = union_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = set_union, offset = 8, value = zero });
    int text_bits = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Copy { target = text_bits, source = text });
    push_instruction(h, Instruction.RawStore64 { address = set_union, offset = 16, value = text_bits });
    push_instruction(h, Instruction.Copy { target = result, source = set_union });
    push_instruction(h, Instruction.Return { value = result });

    push_instruction(h, Instruction.Label { label = 7 });
    push_instruction(h, Instruction.Add { target = entry, left = entry, right = eight });
    push_instruction(h, Instruction.Jump { label = 0 });

    push_instruction(h, Instruction.Label { label = 1 });
    int unset = new_temporary(h, NativeType.Int);
    union_args[0] = sixteen;
    push_instruction(h, Instruction.Call { target = unset, function = alloc, arguments = union_args, argument_count = 1 });
    push_instruction(h, Instruction.RawStore64 { address = unset, offset = 8, value = one });
    push_instruction(h, Instruction.Copy { target = result, source = unset });
    push_instruction(h, Instruction.Return { value = result });
    return lookup;
}

// --- The array runtime's failure writers ------------------------------------

// add_write_byte_fd_shell registers "$write_byte_fd": set the scratch blob's
// one payload byte and write it to the file descriptor in parameter 0.
fn add_write_byte_fd_shell(NativeScene scene, int scratch_blob) -> int {
    int writer = add_function(scene, "$write_byte_fd", NativeType.Void, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, writer);

    push_instruction(h, Instruction.SetStatic { blob = scratch_blob, offset = 24, value = 1 });
    int reference = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = reference, blob = scratch_blob });
    int data = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = reference, offset = 16 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int[] arguments = new int[3];
    arguments[0] = 0;
    arguments[1] = data;
    arguments[2] = one;
    int written = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = written, number = one, arguments = arguments, argument_count = 3 });
    push_instruction(h, Instruction.ReturnVoid);
    return writer;
}

// add_write_blob_fd_shell registers "$write_blob_fd": write one string
// object's payload to the file descriptor in parameter 0.
fn add_write_blob_fd_shell(NativeScene scene) -> int {
    int writer = add_function(scene, "$write_blob_fd", NativeType.Void, int_ref_parameters(), 2);
    NativeFunction h = function_at(scene, writer);

    int length = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawLoad64 { target = length, address = 1, offset = 8 });
    int data = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 1, offset = 16 });
    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int[] arguments = new int[3];
    arguments[0] = 0;
    arguments[1] = data;
    arguments[2] = length;
    int written = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = written, number = one, arguments = arguments, argument_count = 3 });
    push_instruction(h, Instruction.ReturnVoid);
    return writer;
}

// add_write_digits_fd_shell registers "$write_digits_fd": the decimal digits
// of a negative magnitude, one byte at a time to parameter 0's descriptor.
// "$write_int_fd" handles zero and the sign; this routine only walks value,
// value/10, and -value%10, so INT64_MIN never needs a positive counterpart.
fn add_write_digits_fd_shell(NativeScene scene, int write_byte_fd) -> int {
    int digits = add_function(scene, "$write_digits_fd", NativeType.Void, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, digits);

    int ten = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = ten, value = 10 });
    int stepped = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeDivide { target = stepped, left = 1, right = ten });
    int remainder = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.WholeRemainder { target = remainder, left = 1, right = ten });
    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int more = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = more, left = stepped, right = zero });
    push_instruction(h, Instruction.Branch { condition = more, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    int[] again = new int[2];
    again[0] = 0;
    again[1] = stepped;
    push_instruction(h, Instruction.CallVoid { function = digits, arguments = again, argument_count = 2 });
    push_instruction(h, Instruction.Label { label = 0 });
    int digit = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = digit, value = remainder });
    int base = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = base, value = 48 });
    int code = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Add { target = code, left = digit, right = base });
    int[] emit = new int[2];
    emit[0] = 0;
    emit[1] = code;
    push_instruction(h, Instruction.CallVoid { function = write_byte_fd, arguments = emit, argument_count = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    return digits;
}

// add_write_int_fd_shell registers "$write_int_fd": zero, then the sign for
// a negative value, then "$write_digits_fd" over the negative magnitude.
fn add_write_int_fd_shell(NativeScene scene, int write_byte_fd, int write_digits_fd) -> int {
    int writer = add_function(scene, "$write_int_fd", NativeType.Void, two_int_parameters(), 2);
    NativeFunction h = function_at(scene, writer);

    int zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = zero, value = 0 });
    int is_zero = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.Equal { target = is_zero, left = 1, right = zero });
    push_instruction(h, Instruction.Branch { condition = is_zero, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int glyph_zero = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = glyph_zero, value = 48 });
    int[] zero_args = new int[2];
    zero_args[0] = 0;
    zero_args[1] = glyph_zero;
    push_instruction(h, Instruction.CallVoid { function = write_byte_fd, arguments = zero_args, argument_count = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    push_instruction(h, Instruction.Label { label = 1 });
    int negative = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = negative, left = 1, right = zero });
    push_instruction(h, Instruction.Branch { condition = negative, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 2 });
    int glyph_minus = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = glyph_minus, value = 45 });
    int[] minus_args = new int[2];
    minus_args[0] = 0;
    minus_args[1] = glyph_minus;
    push_instruction(h, Instruction.CallVoid { function = write_byte_fd, arguments = minus_args, argument_count = 2 });
    int[] negative_digits = new int[2];
    negative_digits[0] = 0;
    negative_digits[1] = 1;
    push_instruction(h, Instruction.CallVoid { function = write_digits_fd, arguments = negative_digits, argument_count = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    push_instruction(h, Instruction.Label { label = 3 });
    int magnitude = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Negate { target = magnitude, value = 1 });
    int[] positive_digits = new int[2];
    positive_digits[0] = 0;
    positive_digits[1] = magnitude;
    push_instruction(h, Instruction.CallVoid { function = write_digits_fd, arguments = positive_digits, argument_count = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    return writer;
}

// add_fail_blob_shell registers "$fail_blob": the C runtime's exact fatal
// spelling — "purr: ", the message, a newline, standard error — then exit
// status 1. It never returns.
fn add_fail_blob_shell(NativeScene scene, int prefix_blob, int newline_blob, int write_blob_fd) -> int {
    int fail = add_function(scene, "$fail_blob", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, fail);

    int two = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = two, value = 2 });
    int prefix = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = prefix, blob = prefix_blob });
    int[] prefix_args = new int[2];
    prefix_args[0] = two;
    prefix_args[1] = prefix;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = prefix_args, argument_count = 2 });
    int[] message_args = new int[2];
    message_args[0] = two;
    message_args[1] = 0;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = message_args, argument_count = 2 });
    int newline = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.ConstRefData { target = newline, blob = newline_blob });
    int[] newline_args = new int[2];
    newline_args[0] = two;
    newline_args[1] = newline;
    push_instruction(h, Instruction.CallVoid { function = write_blob_fd, arguments = newline_args, argument_count = 2 });
    int exit_number = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = exit_number, value = 60 });
    int status = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = status, value = 1 });
    int[] exit_args = new int[1];
    exit_args[0] = status;
    int ignored = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = ignored, number = exit_number, arguments = exit_args, argument_count = 1 });
    push_instruction(h, Instruction.ReturnVoid);
    return fail;
}

