// float_num registers "$float_num": the P of M * 2^E. M is written as four
// limbs split by divide/remainder chains by 65536, the seeded object is
// trimmed to M's own limb count, and a positive E shifts it up through
// "$bn_shift_up". Locals: 14.
fn add_float_num_shell(NativeScene scene, int bn_new, int bn_set, int bn_trim, int float_mantissa, int float_e, int bn_shift_up) -> int {
    int shell = add_function(scene, "$float_num", NativeType.Int, one_float_parameter(), 1);
    NativeFunction h = function_at(scene, shell);

    int zero = new_temporary(h, NativeType.Int);
