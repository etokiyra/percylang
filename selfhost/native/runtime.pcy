    int b = new_temporary(h, NativeType.Bool);
    push_instruction(h, Instruction.LessThan { target = b, left = zero_c, right = sign });
    push_instruction(h, Instruction.Branch { condition = b, label_true = 0, label_false = 1 });
    push_instruction(h, Instruction.Label { label = 0 });
    int[] minus_args = new int[1];
    minus_args[0] = glyph_minus;
    push_instruction(h, Instruction.CallVoid { function = float_wchar, arguments = minus_args, argument_count = 1 });
    push_instruction(h, Instruction.Label { label = 1 });
    int[] value_args2 = new int[1];
    value_args2[0] = 0;
    push_instruction(h, Instruction.CallVoid { function = float_write_special, arguments = value_args2, argument_count = 1 });
    push_instruction(h, Instruction.Equal { target = b, left = zb, right = zero_c });
    push_instruction(h, Instruction.Branch { condition = b, label_true = 2, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 3 });
    push_instruction(h, Instruction.ReturnVoid);
    push_instruction(h, Instruction.Label { label = 2 });
    push_instruction(h, Instruction.Equal { target = b, left = special, right = zero_c });
    push_instruction(h, Instruction.Branch { condition = b, label_true = 4, label_false = 3 });
    push_instruction(h, Instruction.Label { label = 4 });
    int num = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = num, function = float_num, arguments = value_args, argument_count = 1 });
    int den = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = den, function = float_den, arguments = value_args, argument_count = 1 });
    int[] px_args = new int[3];
    px_args[0] = 0;
    px_args[1] = num;
    px_args[2] = den;
    int x = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = x, function = float_px, arguments = px_args, argument_count = 3 });
    int[] new_args = new int[1];
    new_args[0] = six_c;
    int buffer = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = buffer, function = bn_new, arguments = new_args, argument_count = 1 });
    int[] digit_args = new int[4];
    digit_args[0] = num;
    digit_args[1] = den;
    digit_args[2] = x;
    digit_args[3] = buffer;
    int round = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.Call { target = round, function = float_digits, arguments = digit_args, argument_count = 4 });
    int[] write_args = new int[2];
    write_args[0] = buffer;
    write_args[1] = x;
    // roll (round == 2): X += 1
    push_instruction(h, Instruction.LessThan { target = b, left = one_c, right = round });
    push_instruction(h, Instruction.Branch { condition = b, label_true = 5, label_false = 6 });
    push_instruction(h, Instruction.Label { label = 5 });
    push_instruction(h, Instruction.Add { target = write_args[1], left = x, right = one_c });
    push_instruction(h, Instruction.Label { label = 6 });
    push_instruction(h, Instruction.CallVoid { function = float_write, arguments = write_args, argument_count = 2 });
    push_instruction(h, Instruction.ReturnVoid);
    return shell;
}


// add_write_one_shell_for_float registers the float prints' own one-byte
// write shell: the same shape "$write1" gives the integer print, kept
// separate so the float-only programs carry their own set.
fn add_write_one_shell_for_float(NativeScene scene) -> int {
    int writer = add_function(scene, "$fwrite1", NativeType.Void, one_ref_parameter(), 1);
    NativeFunction h = function_at(scene, writer);

    int one = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.ConstInt { target = one, value = 1 });
    int data = new_temporary(h, NativeType.Ref);
    push_instruction(h, Instruction.RawLoad64 { target = data, address = 0, offset = 16 });
    int[] arguments = new int[3];
    arguments[0] = one;
    arguments[1] = data;
    arguments[2] = one;
    int written = new_temporary(h, NativeType.Int);
    push_instruction(h, Instruction.RawSyscall { target = written, number = one, arguments = arguments, argument_count = 3 });
    push_instruction(h, Instruction.ReturnVoid);
    return writer;
}

// add_print_float_wrapper registers "$print_float": the raw %g writer plus
// the shared newline tail.
fn add_print_float_wrapper(NativeScene scene, int print_float_raw, int tail) -> int {
    int shell = add_function(scene, "$print_float", NativeType.Void, one_float_parameter(), 1);
    NativeFunction h = function_at(scene, shell);
    int[] raw_arguments = new int[1];
    raw_arguments[0] = 0;
    push_instruction(h, Instruction.CallVoid { function = print_float_raw, arguments = raw_arguments, argument_count = 1 });
    int[] no_arguments = new int[0];
    push_instruction(h, Instruction.CallVoid { function = tail, arguments = no_arguments, argument_count = 0 });
    push_instruction(h, Instruction.ReturnVoid);
    return shell;
}

// add_float_print registers the %g float print shells into a scene, after
// the allocator and newline shells, wired through the same builders the
// lowering and the probe use. It returns the wrapper and raw indexes.
public fn add_float_print(NativeScene scene, int alloc, int tail) -> FloatPrintShell {
    FloatPrintShell shell = FloatPrintShell { print_float = 0, print_float_raw = 0 };
    int bn_new = add_bn_new_shell(scene, alloc);
    int bn_get = add_bn_get_shell(scene);
    int bn_set = add_bn_set_shell(scene);
    int bn_count = add_bn_count_shell(scene);
    int bn_cmp = add_bn_cmp_shell(scene, bn_get);
    int bn_mul_small = add_bn_mul_small_shell(scene, bn_new, bn_get, bn_set);
    int bn_sub_into = add_bn_sub_into_shell(scene, bn_get, bn_set);
    int bn_copy_into = add_bn_copy_into_shell(scene, bn_get, bn_set, bn_count);
    int bn_pad = add_bn_pad_shell(scene, bn_count, bn_new, bn_copy_into);
    int bn_digit = add_bn_digit_shell(scene, bn_mul_small, bn_cmp, bn_sub_into, bn_copy_into);
    int bn_times10pow = add_bn_times10pow_shell(scene, bn_count, bn_new, bn_copy_into, bn_mul_small);
    int bn_bump = add_bn_bump_shell(scene, bn_get, bn_set);
    int bn_pow2 = add_bn_pow2_shell(scene, bn_new, bn_set, bn_mul_small);
    int bn_trim = add_bn_trim_shell(scene, bn_get);
    int float_sign = add_float_sign_shell(scene);
    int float_special = add_float_special_shell(scene);
    int float_zero_bits = add_float_zero_bits_shell(scene);
    int float_mantissa = add_float_mantissa_shell(scene);
    int float_e = add_float_e_shell(scene);
    int bn_shift_up = add_bn_shift_up_shell(scene, bn_mul_small);
    int float_num = add_float_num_shell(scene, bn_new, bn_set, bn_trim, float_mantissa, float_e, bn_shift_up);
    int float_den = add_float_den_shell(scene, bn_pow2, float_e);
    int px_probe = add_px_probe_shell(scene, bn_count, bn_new, bn_copy_into, bn_times10pow, bn_cmp);
    int float_px = add_float_px_shell(scene, px_probe, float_e, float_mantissa);
    int float_pack = add_float_pack_shell(scene, bn_new, bn_set, bn_times10pow, bn_count, bn_pad);
    int float_round = add_float_round_shell(scene, bn_mul_small, bn_cmp, bn_get, bn_bump);
    int scratch_blob = add_blob(scene, "0");
    int fwrite1 = add_write_one_shell_for_float(scene);
    int float_wchar = add_float_wchar_shell(scene, scratch_blob, fwrite1);
    int float_wdigit = add_float_wdigit_shell(scene, bn_get, float_wchar);
    int float_last = add_float_last_shell(scene, bn_get);
    int float_wdigits = add_float_wdigits_shell(scene, float_wdigit);
    int float_digits = add_float_digits_shell(scene, float_pack, bn_digit, bn_set, float_round);
    int float_write_scientific = add_float_write_scientific_shell(scene, float_last, float_wdigits, float_wdigit, float_wchar);
    int float_write_fixed = add_float_write_fixed_shell(scene, float_last, float_wdigits, float_wchar);
    int float_write = add_float_write_shell(scene, float_write_fixed, float_write_scientific);
    int float_write_special = add_float_write_special_shell(scene, float_zero_bits, float_special, float_wchar);
    int print_float_raw = add_print_float_shell(scene, float_sign, float_zero_bits, float_special, float_write_special, float_num, float_den, float_px, bn_new, float_digits, float_write, float_wchar);
    int print_float = add_print_float_wrapper(scene, print_float_raw, tail);
    shell.print_float = print_float;
    shell.print_float_raw = print_float_raw;
    return shell;
}
