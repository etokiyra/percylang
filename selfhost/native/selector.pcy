// selector.pcy - lower the scene to x86-64 machine code.
//
// Phase 10.2's skeleton slice, from
// proposals/zero-dependency-toolchain.md Section 9 step 1: static ELF, the
// write and exit syscalls, and string-literal printing, with no GC and no C.
// Phase 10.3 added the scalar arithmetic, comparisons, and control flow of
// step 2: add, subtract, multiply, guarded divide and remainder, negate,
// equal, less_than, jump, branch, and label, still with no allocation.
// The selector walks a scene that passed check_scene and emits machine code
// plus a data section into raw byte arrays, recording every address that is
// not known until layout: call targets patch as relative displacements, data
// references patch as RIP-relative displacements, data-section pointer
// slots patch as absolute 64-bit values, and branch and jump targets patch
// as relative displacements once their labels' offsets are known. Byte
// arrays are mutable, so patches write their four or eight displacement
// bytes in place and every earlier fixup keeps its position.
//
// The emitted calling convention is the proposal's first internal one
// (Section 5.2): every argument is one caller-allocated 8-byte stack slot,
// pushed in reverse declaration order; the callee reads parameter k at
// rbp+16+8k; results return in rax; the caller pops the argument slots.
// Locals live at rbp-8 and downwards inside the frame, carving sub rsp out
// of the prologue, so the slice's one-byte displacement form bounds both
// tables; the selector fails with a deterministic message when a frame
// would not fit. Stack-alignment refinement and register allocation remain
// later slices.
//
// Division follows SPEC's defined arithmetic rules (Phase 8.1): a zero
// divisor halts with the C runtime's exact fatal text `purr: integer
// division by zero` and status 1, and a minus-one divisor's quotient and
// remainder take the wrap path (INT64_MIN / -1 is INT64_MIN, % -1 is 0) so
// idiv can never trap.
//
// Phase 10.6 landed the runtime foundations: GetStatic and SetStatic reach
// a data blob's payload through one RIP-relative slot each, FailOOM jumps to
// a shared out-of-memory paragraph, and every blob — including the private
// failure messages — is laid out on the proposal Section 5.3 header ABI
// (SPEC Section 19.10): an eight-byte header word carrying the whole size,
// an eight-byte length, an eight-byte payload pointer, and the payload.

import "ir.pcy";

// Segment geometry, decided once and fixed for the slice: the text segment
// holds the ELF header, both program headers, and the code, so code begins
// at file offset header_size(); the data segment is page aligned at its own
// base.
public fn text_base() -> int {
    return 0x400000;
}

public fn data_base() -> int {
    return 0xf00000;
}

public fn header_size() -> int {
    return 176;
}

public fn page_size() -> int {
    return 0x1000;
}

// Bytes is a mutable growable raw byte buffer. Positions are simply indices:
// a patch writes in place, so no recorded position ever moves.
public struct Bytes {
    byte[] data;
    int count;
    int capacity;
}

public fn new_bytes() -> Bytes {
    return Bytes {
        data = new byte[256],
        count = 0,
        capacity = 256
    };
}

fn bytes_grow(Bytes list) {
    int capacity = list.capacity * 2;
    byte[] grown = new byte[capacity];
    int index = 0;
    while (index < list.count) {
        grown[index] = list.data[index];
        index++;
    }
    list.data = grown;
    list.capacity = capacity;
}

// push_byte appends one byte, masking to its 8-bit pattern.
public fn push_byte(Bytes list, int value) {
    if (list.count == list.capacity) {
        bytes_grow(list);
    }
    list.data[list.count] = byte_from_int(value & 255);
    list.count++;
}

// push_hex appends the bytes a readable space-separated hex list spells, so
// every encoder shows its encoding at its site.
public fn push_hex(Bytes list, string spelling) {
    int index = 0;
    int size = length(spelling);
    int high = -1;
    while (index < size) {
        int character = spelling[index];
        int nibble = -1;
        if (character >= 48 && character <= 57) {
            nibble = character - 48;
        } else if (character >= 97 && character <= 102) {
            nibble = character - 87;
        } else if (character >= 65 && character <= 70) {
            nibble = character - 55;
        }
        if (nibble < 0) {
            // Separators flush a pending high nibble.
            if (high >= 0) {
                push_byte(list, high);
                high = -1;
            }
        } else if (high < 0) {
            high = nibble;
        } else {
            push_byte(list, high * 16 + nibble);
            high = -1;
        }
        index++;
    }
    if (high >= 0) {
        push_byte(list, high);
    }
}

// push_int appends value as count little-endian bytes, reading bit patterns:
// the mask takes the low byte and the arithmetic shift walks the rest, so
// negative values produce their two's-complement byte pattern.
public fn push_int(Bytes list, int value, int count) {
    int index = 0;
    while (index < count) {
        push_byte(list, value & 255);
        value = value >> 8;
        index++;
    }
}

// push_zeros appends count zero bytes.
public fn push_zeros(Bytes list, int count) {
    int index = 0;
    while (index < count) {
        push_byte(list, 0);
        index++;
    }
}

// push_string appends a string's raw bytes, NUL bytes included; scene data
// and payload bytes flow through the length-carrying string unchanged.
public fn push_string(Bytes list, string value) {
    byte[] raw = string_to_bytes(value);
    int index = 0;
    int size = length(raw);
    while (index < size) {
        push_byte(list, int_from_byte(raw[index]));
        index++;
    }
}

// to_array copies the list's live bytes into an exactly sized array, ready
// for the byte writer.
public fn to_array(Bytes list) -> byte[] {
    byte[] exact = new byte[list.count];
    int index = 0;
    while (index < list.count) {
        exact[index] = list.data[index];
        index++;
    }
    return exact;
}

// decimal renders a non-negative integer in decimal for messages.
fn decimal(int value) -> string {
    if (value == 0) {
        return "0";
    }
    string result = "";
    while (value > 0) {
        int digit = value % 10;
        result = substring("0123456789", digit, digit + 1) + result;
        value = value / 10;
    }
    return result;
}

// CallFixup is one e8 displacement slot to patch once function addresses
// are known.
struct CallFixup {
    int position;
    int callee;
}

// DisplacementFixup is one RIP-relative data reference to patch: the blob's
// index plus the reference's raw byte offset inside that blob's whole size,
// so GetStatic and SetStatic can reach a blob's payload while a literal's lea
// reaches the object's start.
struct DisplacementFixup {
    int position;
    int blob;
    int offset;
}

// LabelJump is one forward jump to a label inside the function being
// emitted: position is the first displacement byte, kind is the opcode's
// byte length (one for e9, two for 0f 85), and the slot patches once the
// label's offset is known.
struct LabelJump {
    int position;
    int label;
}

// FailJump is one conditional jump to the division-failure paragraph, whose
// offset is known only after every function has been emitted.
struct FailJump {
    int position;
}

// OOMJump is one unconditional jump to the out-of-memory paragraph, whose
// offset is known only after every function has been emitted.
struct OOMJump {
    int position;
}

// NegateFloatMask is one RIP-relative displacement into the selector's
// private sign-mask data, whose offset is known only after layout. The
// lowerings' negate-in-refusal steps load the mask through `movsd` and flip
// the bit inside the register, so unaligned xmm data never enters the
// encoding.
struct NegateFloatMask {
    int position;
}

// Lowering accumulates one select_scene run.
struct Lowering {
    Bytes code;
    Bytes data;
    int[] function_offsets;
    CallFixup[] call_fixups;
    int call_count;
    int call_capacity;
    DisplacementFixup[] displacement_fixups;
    int displacement_count;
    int displacement_capacity;
    int[] blob_offsets;
    LabelJump[] label_jumps;
    int label_jump_count;
    int label_jump_capacity;
    FailJump[] fail_jumps;
    int fail_jump_count;
    int fail_jump_capacity;
    int[] label_positions;
    int fail_blob_offset;
    int fail_lea_position;
    OOMJump[] oom_jumps;
    int oom_jump_count;
    int oom_jump_capacity;
    int oom_blob_offset;
    int oom_lea_position;
    NegateFloatMask[] negate_masks;
    int negate_count;
    int negate_capacity;
    // rax_binding is the straight-line register cache: the binding whose
    // current value sits in rax, or -1 when nothing is known. It is reset at
    // every label, jump, branch, call, and memory write.
    int rax_binding;
}

// Function offsets are indexed by scene function index; the table is exactly
// sized to the scene's function count.
fn new_lowering(NativeScene scene) -> Lowering {
    return Lowering {
        code = new_bytes(),
        data = new_bytes(),
        function_offsets = new int[scene.function_count],
        call_fixups = new CallFixup[16],
        call_count = 0,
        call_capacity = 16,
        displacement_fixups = new DisplacementFixup[16],
        displacement_count = 0,
        displacement_capacity = 16,
        blob_offsets = new int[scene.blob_count],
        label_jumps = new LabelJump[16],
        label_jump_count = 0,
        label_jump_capacity = 16,
        fail_jumps = new FailJump[4],
        fail_jump_count = 0,
        fail_jump_capacity = 4,
        label_positions = new int[0],
        fail_blob_offset = 0,
        fail_lea_position = 0,
        oom_jumps = new OOMJump[4],
        oom_jump_count = 0,
        oom_jump_capacity = 4,
        oom_blob_offset = 0,
        oom_lea_position = 0,
        negate_masks = new NegateFloatMask[4],
        negate_count = 0,
        negate_capacity = 4,
        rax_binding = -1
    };
}

fn grow_calls(Lowering lowering) {
    int capacity = lowering.call_capacity * 2;
    CallFixup[] grown = new CallFixup[capacity];
    int index = 0;
    while (index < lowering.call_count) {
        grown[index] = lowering.call_fixups[index];
        index++;
    }
    lowering.call_fixups = grown;
    lowering.call_capacity = capacity;
}

fn grow_displacements(Lowering lowering) {
    int capacity = lowering.displacement_capacity * 2;
    DisplacementFixup[] grown = new DisplacementFixup[capacity];
    int index = 0;
    while (index < lowering.displacement_count) {
        grown[index] = lowering.displacement_fixups[index];
        index++;
    }
    lowering.displacement_fixups = grown;
    lowering.displacement_capacity = capacity;
}

fn grow_label_jumps(Lowering lowering) {
    int capacity = lowering.label_jump_capacity * 2;
    LabelJump[] grown = new LabelJump[capacity];
    int index = 0;
    while (index < lowering.label_jump_count) {
        grown[index] = lowering.label_jumps[index];
        index++;
    }
    lowering.label_jumps = grown;
    lowering.label_jump_capacity = capacity;
}

fn grow_fail_jumps(Lowering lowering) {
    int capacity = lowering.fail_jump_capacity * 2;
    FailJump[] grown = new FailJump[capacity];
    int index = 0;
    while (index < lowering.fail_jump_count) {
        grown[index] = lowering.fail_jumps[index];
        index++;
    }
    lowering.fail_jumps = grown;
    lowering.fail_jump_capacity = capacity;
}

fn grow_oom_jumps(Lowering lowering) {
    int capacity = lowering.oom_jump_capacity * 2;
    OOMJump[] grown = new OOMJump[capacity];
    int index = 0;
    while (index < lowering.oom_jump_count) {
        grown[index] = lowering.oom_jumps[index];
        index++;
    }
    lowering.oom_jumps = grown;
    lowering.oom_jump_capacity = capacity;
}

fn grow_negate_masks(Lowering lowering) {
    int capacity = lowering.negate_capacity * 2;
    NegateFloatMask[] grown = new NegateFloatMask[capacity];
    int index = 0;
    while (index < lowering.negate_count) {
        grown[index] = lowering.negate_masks[index];
        index++;
    }
    lowering.negate_masks = grown;
    lowering.negate_capacity = capacity;
}

// add_negate_mask records one RIP-relative displacement slot to the
// selector's sign-mask data, whose offset is known after layout.
fn add_negate_mask(Lowering lowering) {
    if (lowering.negate_count == lowering.negate_capacity) {
        grow_negate_masks(lowering);
    }
    lowering.negate_masks[lowering.negate_count] = NegateFloatMask {
        position = lowering.code.count + 4
    };
    lowering.negate_count++;
}

// add_function_offset records one function's code offset.
fn add_function_offset(Lowering lowering, int index, int offset) {
    lowering.function_offsets[index] = offset;
}

// add_call records an e8 slot: the callee's scene index and the position of
// its four displacement bytes, one byte after the opcode.
fn add_call(Lowering lowering, int callee) {
    if (lowering.call_count == lowering.call_capacity) {
        grow_calls(lowering);
    }
    lowering.call_fixups[lowering.call_count] = CallFixup {
        position = lowering.code.count + 1,
        callee = callee
    };
    lowering.call_count++;
}

// add_displacement records one RIP-relative slot: the blob's index and the
// raw byte offset inside the blob, plus the position of the four displacement
// bytes. A lea needs its displacement three bytes into the opcode; GetStatic
// and SetStatic put it at the same depth under their mov opcodes.
fn add_displacement(Lowering lowering, int blob, int offset) {
    if (lowering.displacement_count == lowering.displacement_capacity) {
        grow_displacements(lowering);
    }
    lowering.displacement_fixups[lowering.displacement_count] = DisplacementFixup {
        position = lowering.code.count + 3,
        blob = blob,
        offset = offset
    };
    lowering.displacement_count++;
}

// add_label_jump records one forward jump's displacement slot: position is
// the first displacement byte and kind is the opcode's byte length, one for
// a plain e9 jmp and two for a 0f 85 conditional jump.
fn add_label_jump(Lowering lowering, int kind, int label) {
    if (lowering.label_jump_count == lowering.label_jump_capacity) {
        grow_label_jumps(lowering);
    }
    lowering.label_jumps[lowering.label_jump_count] = LabelJump {
        position = lowering.code.count + kind,
        label = label
    };
    lowering.label_jump_count++;
}

// add_fail_jump records one conditional jump's displacement slot to the
// division-failure paragraph.
fn add_fail_jump(Lowering lowering) {
    if (lowering.fail_jump_count == lowering.fail_jump_capacity) {
        grow_fail_jumps(lowering);
    }
    lowering.fail_jumps[lowering.fail_jump_count] = FailJump {
        position = lowering.code.count + 2
    };
    lowering.fail_jump_count++;
}

// add_oom_jump records one unconditional jump's displacement slot to the
// out-of-memory paragraph.
fn add_oom_jump(Lowering lowering) {
    if (lowering.oom_jump_count == lowering.oom_jump_capacity) {
        grow_oom_jumps(lowering);
    }
    lowering.oom_jumps[lowering.oom_jump_count] = OOMJump {
        position = lowering.code.count + 1
    };
    lowering.oom_jump_count++;
}

// fail_message is the division-failure text, byte for byte the C runtime's
// pcy_rt_fail("integer division by zero") output: the toolchain prefix, the
// message, and the newline.
fn fail_message() -> string {
    return "purr: integer division by zero\n";
}

// oom_message is the allocation-failure text, byte for byte the C runtime's
// pcy_rt_fail("out of memory") output: the toolchain prefix, the message,
// and the newline.
fn oom_message() -> string {
    return "purr: out of memory\n";
}

// frame_slot_limit bounds one function's parameters and locals. The frame
// uses disp32 and imm32 beyond the one-byte range, so the limit is a stack
// budget rather than an encoding one: 8192 slots is a 64 KiB frame, well
// inside the host stack, and large enough for the compiler's biggest builder
// (the capture shell's expression temporaries).
fn frame_slot_limit() -> int {
    return 8192;
}

// frame_fits checks that a function's frame stays inside the slot budget.
fn frame_fits(NativeFunction function) -> string {
    if (function.parameter_count > frame_slot_limit()) {
        return "function @" + function.name + ": " + decimal(function.parameter_count) + " parameters do not fit the slice's frame layout";
    }
    int locals = function.binding_count - function.parameter_count;
    if (locals > frame_slot_limit()) {
        return "function @" + function.name + ": " + decimal(locals) + " locals do not fit the slice's frame layout";
    }
    return "";
}

// slot_disp returns a binding's rbp-relative displacement. Parameters sit in
// the caller's argument area at rbp+16 and up; locals sit below the frame,
// inside the 8n bytes the prologue carved with sub rsp. frame_fits gates the
// bound.
fn slot_disp(NativeFunction function, int binding) -> int {
    if (binding < function.parameter_count) {
        return 16 + 8 * binding;
    }
    return -8 * (binding - function.parameter_count + 1);
}

// slot_disp_fits8 reports whether the one-byte displacement form covers the
// slot. The sign-extended disp8 range is -128 through 127.
fn slot_disp_fits8(int displacement) -> bool {
    return displacement >= -128 && displacement <= 127;
}

// push_slot_operand appends the rbp-relative ModRM byte and displacement for
// an instruction whose opcode prefix is already written. The two spellings
// carry the same reg field with mod=01/disp8 and mod=10/disp32, so callers
// pass both prebuilt bytes.
fn push_slot_operand(Bytes list, int displacement, string modrm8, string modrm32) {
    if (slot_disp_fits8(displacement)) {
        push_hex(list, modrm8);
        push_int(list, displacement, 1);
    } else {
        push_hex(list, modrm32);
        push_int(list, displacement, 4);
    }
}

// mov_rax_slot loads a slot into rax: mov rax, [rbp+disp].
fn mov_rax_slot(Bytes list, int displacement) {
    push_hex(list, "48 8b");
    push_slot_operand(list, displacement, "45", "85");
}

// mov_rax_slot_other loads a slot into rcx: mov rcx, [rbp+disp]. Raw
// address/value pairs use one register each, rax for the value and rcx for
// the address.
fn mov_rax_slot_other(Bytes list, int displacement) {
    push_hex(list, "48 8b");
    push_slot_operand(list, displacement, "4d", "8d");
}

// mov_slot_rax stores rax into a slot: mov [rbp+disp], rax.
fn mov_slot_rax(Bytes list, int displacement) {
    push_hex(list, "48 89");
    push_slot_operand(list, displacement, "45", "85");
}

// load_rax loads a binding into rax unless the straight-line cache already
// holds it. The cache only survives across instructions inside one basic
// block; every join, call, and memory write clears it.
fn load_rax(Lowering lowering, NativeFunction function, int binding) {
    if (lowering.rax_binding == binding) {
        return;
    }
    mov_rax_slot(lowering.code, slot_disp(function, binding));
    lowering.rax_binding = binding;
}

// store_rax writes rax to a binding's slot and records that rax still holds
// that binding.
fn store_rax(Lowering lowering, NativeFunction function, int binding) {
    mov_slot_rax(lowering.code, slot_disp(function, binding));
    lowering.rax_binding = binding;
}

// invalidate_rax forgets the cache after a clobber or a join.
fn invalidate_rax(Lowering lowering) {
    lowering.rax_binding = -1;
}

// mov_slot_rdx stores rdx into a slot: mov [rbp+disp], rdx.
fn mov_slot_rdx(Bytes list, int displacement) {
    push_hex(list, "48 89");
    push_slot_operand(list, displacement, "55", "95");
}

// mov_byte_slot stores an immediate byte into a slot:
// mov byte [rbp+disp], value.
fn mov_byte_slot(Bytes list, int displacement, int value) {
    push_hex(list, "c6");
    push_slot_operand(list, displacement, "45", "85");
    push_int(list, value, 1);
}

// cmp_rax_slot compares rax with a slot: cmp rax, [rbp+disp].
fn cmp_rax_slot(Bytes list, int displacement) {
    push_hex(list, "48 3b");
    push_slot_operand(list, displacement, "45", "85");
}

// cmp_qword_slot_imm8 compares a slot's qword with a sign-extended byte:
// cmp qword [rbp+disp], value.
fn cmp_qword_slot_imm8(Bytes list, int displacement, int value) {
    push_hex(list, "48 83");
    push_slot_operand(list, displacement, "7d", "bd");
    push_int(list, value, 1);
}

// cmp_byte_slot_imm8 compares a slot's low byte with a byte:
// cmp byte [rbp+disp], value.
fn cmp_byte_slot_imm8(Bytes list, int displacement, int value) {
    push_hex(list, "80");
    push_slot_operand(list, displacement, "7d", "bd");
    push_int(list, value, 1);
}

// idiv_slot divides rdx:rax by a slot: idiv qword [rbp+disp].
fn idiv_slot(Bytes list, int displacement) {
    push_hex(list, "48 f7");
    push_slot_operand(list, displacement, "7d", "bd");
}

// lea_rax_data emits lea rax, [rip+disp] with a zero-filled slot to patch.
fn lea_rax_data(Lowering lowering, int blob) {
    add_displacement(lowering, blob, 0);
    push_hex(lowering.code, "48 8d 05 00 00 00 00");
}

// call_rel32 emits call [disp] with a zero-filled slot to patch.
fn call_rel32(Lowering lowering, int callee) {
    add_call(lowering, callee);
    push_hex(lowering.code, "e8 00 00 00 00");
}

// emit_object_blob lays one runtime object into the data area and returns
// its byte offset. The shape is the object-header ABI (SPEC Section 19.10):
// an eight-byte header word carrying the object's whole size, the eight-byte
// payload length, an eight-byte payload pointer, and the payload rounded up
// to eight. The pointer needs no fixup list: the offset is known the moment
// the blob started, so the slot stores its absolute address in place.
fn emit_object_blob(Lowering lowering, string payload) -> int {
    int offset = lowering.data.count;
    int size = length(payload);
    int size_up = 24 + size;
    int pad = (8 - size_up % 8) % 8;
    int total = size_up + pad;
    push_int(lowering.data, total, 8);
    push_int(lowering.data, size, 8);
    int pointer_slot = lowering.data.count;
    push_zeros(lowering.data, 8);
    push_string(lowering.data, payload);
    push_zeros(lowering.data, pad);
    patch64(lowering.data, pointer_slot, data_base() + offset + 24);
    return offset;
}

// Selection is the selector's output: the patched code, the patched data,
// and the entry function's index, from which the ELF writer fixes the entry
// point.
public struct Selection {
    Bytes code;
    Bytes data;
    int entry_function;
}

public union SelectionResult {
    Ok { Selection selection; }
    Failed { string message; }
}

// selector_fail packs one message into the Failed result.
fn selector_fail(string message) -> SelectionResult {
    return SelectionResult.Failed { message = message };
}

// frame_size rounds a frame's local bytes up to a multiple of sixteen so
// rsp stays 16-byte aligned after the prologue. The System V entry contract
// leaves rsp at 8 mod 16 inside a callee (the return address is pushed), and
// push rbp moves it to 0; the aligned subtraction preserves that.
fn frame_size(int locals) -> int {
    int bytes = 8 * locals;
    int remainder = bytes % 16;
    if (remainder == 0) {
        return bytes;
    }
    return bytes + (16 - remainder);
}

// frame_prologue opens the frame and reserves the local slots: push rbp,
// mov rbp, rsp, then sub rsp by the sixteen-byte-aligned slot size through
// the imm8 or imm32 form.
fn frame_prologue(Bytes list, NativeFunction function) {
    push_hex(list, "55");
    push_hex(list, "48 89 e5");
    int locals = function.binding_count - function.parameter_count;
    if (locals > 0) {
        int size = frame_size(locals);
        if (size <= 127) {
            push_hex(list, "48 83 ec");
            push_int(list, size, 1);
        } else {
            push_hex(list, "48 81 ec");
            push_int(list, size, 4);
        }
    }
}

// frame_epilogue restores the frame and returns: add rsp back, pop rbp, ret.
fn frame_epilogue(Bytes list, NativeFunction function) {
    int locals = function.binding_count - function.parameter_count;
    if (locals > 0) {
        int size = frame_size(locals);
        if (size <= 127) {
            push_hex(list, "48 83 c4");
            push_int(list, size, 1);
        } else {
            push_hex(list, "48 81 c4");
            push_int(list, size, 4);
        }
    }
    push_hex(list, "5d c3");
}

// release_arguments pops a call's caller-allocated argument slots through
// the imm8 or imm32 form.
fn release_arguments(Bytes list, int argument_count) {
    if (argument_count > 0) {
        int size = 8 * argument_count;
        if (size <= 127) {
            push_hex(list, "48 83 c4");
            push_int(list, size, 1);
        } else {
            push_hex(list, "48 81 c4");
            push_int(list, size, 4);
        }
    }
}

// lower_binary emits one binary integer operation: load the left slot into
// rax, combine with the right slot, and store the full 64-bit result. The
// ops' byte patterns ride through op_hex; reading happens strictly before
// the store, so a target aliasing an operand stays correct.
fn lower_binary(Lowering lowering, NativeFunction function, int target, int left, int right, string op_hex) {
    load_rax(lowering, function, left);
    push_hex(lowering.code, op_hex);
    push_slot_operand(lowering.code, slot_disp(function, right), "45", "85");
    store_rax(lowering, function, target);
}

// lower_compare emits Equal or LessThan: load the left slot, compare against
// the right slot, materialize the one-bit result through a setCC, zero-extend
// it to the full 64-bit pattern, and store. The bool slot therefore always
// holds a normalized zero or one in all eight bytes.
fn lower_compare(Lowering lowering, NativeFunction function, int target, int left, int right, string set_hex) {
    load_rax(lowering, function, left);
    cmp_rax_slot(lowering.code, slot_disp(function, right));
    push_hex(lowering.code, set_hex);
    push_hex(lowering.code, "0f b6 c0");
    store_rax(lowering, function, target);
}

// lower_divide emits WholeDivide and WholeRemainder on SPEC's defined
// arithmetic rules, so idiv can never trap:
//
//     mov rax, [rbp+left]
//     cmp qword [rbp+right], 0       ; zero divisor
//     je   -> the fail paragraph
//     cmp qword [rbp+right], -1      ; divisor minus one
//     jne  slow
//     quotient:  neg rax             ; the wrap keeps INT64_MIN intact
//     remainder: xor edx, edx        ; a minus-one remainder is zero
//     jmp  done
//   slow:
//     cqo
//     idiv qword [rbp+right]         ; cannot trap: 0 and MIN/-1 ruled out
//   done:
//     target slot <- rax (quotient) or rdx (remainder)
fn lower_divide(Lowering lowering, NativeFunction function, int target, int left, int right, bool quotient) {
    load_rax(lowering, function, left);
    cmp_qword_slot_imm8(lowering.code, slot_disp(function, right), 0);
    add_fail_jump(lowering);
    push_hex(lowering.code, "0f 84 00 00 00 00");
    cmp_qword_slot_imm8(lowering.code, slot_disp(function, right), 255);
    int slow_site = lowering.code.count + 2;
    push_hex(lowering.code, "0f 85 00 00 00 00");
    if (quotient) {
        push_hex(lowering.code, "48 f7 d8");
    } else {
        push_hex(lowering.code, "31 d2");
    }
    int done_site = lowering.code.count + 1;
    push_hex(lowering.code, "e9 00 00 00 00");
    patch32(lowering.code, slow_site, lowering.code.count - slow_site - 4);
    push_hex(lowering.code, "48 99");
    idiv_slot(lowering.code, slot_disp(function, right));
    patch32(lowering.code, done_site, lowering.code.count - done_site - 4);
    if (quotient) {
        store_rax(lowering, function, target);
    } else {
        mov_slot_rdx(lowering.code, slot_disp(function, target));
        invalidate_rax(lowering);
    }
}

// lower_branch emits one decision: compare the condition's byte against
// zero, jump conditionally to the true label, and fall through a plain jump
// to the false label. Bool slots read as one byte, so garbage upper bytes
// in a ConstBool slot can never steer a branch.
fn lower_branch(Lowering lowering, NativeFunction function, int condition, int label_true, int label_false) {
    cmp_byte_slot_imm8(lowering.code, slot_disp(function, condition), 0);
    add_label_jump(lowering, 2, label_true);
    push_hex(lowering.code, "0f 85 00 00 00 00");
    add_label_jump(lowering, 1, label_false);
    push_hex(lowering.code, "e9 00 00 00 00");
}

// movsd_slot_xmm loads a slot into xmm0: movsd xmm0, [rbp+disp].
fn movsd_slot_xmm(Bytes list, NativeFunction function, int binding) {
    push_hex(list, "f2 0f 10");
    push_slot_operand(list, slot_disp(function, binding), "45", "85");
}

// movsd_xmm_slot stores xmm0 into a slot: movsd [rbp+disp], xmm0.
fn movsd_xmm_slot(Bytes list, NativeFunction function, int binding) {
    push_hex(list, "f2 0f 11");
    push_slot_operand(list, slot_disp(function, binding), "45", "85");
}

// ucomisd_slot compares xmm0 with a slot: ucomisd xmm0, [rbp+disp].
fn ucomisd_slot(Bytes list, int displacement) {
    push_hex(list, "66 0f 2f");
    push_slot_operand(list, displacement, "45", "85");
}

// lower_float_binary emits one SSE2 binary double operation exactly the
// way lower_binary does for ints: load the left slot, fold the right slot
// in, and store the 8-byte result. Reading happens strictly before the
// store, so a target that aliases an operand stays correct.
fn lower_float_binary(Lowering lowering, NativeFunction function, int target, int left, int right, string op_hex) {
    movsd_slot_xmm(lowering.code, function, left);
    push_hex(lowering.code, op_hex);
    push_slot_operand(lowering.code, slot_disp(function, right), "45", "85");
    movsd_xmm_slot(lowering.code, function, target);
    invalidate_rax(lowering);
}

// lower_float_compare emits EqualFloat, GreaterFloat, and
// LessOrEqualFloat. The setCC family carries the exact C semantics over
// unordered values: `seta` and `setae` read the carry flag, which an
// unordered compare sets, so those two forms answer false on NaN exactly
// as the C generators' `(a op b)` does; the equality form pairs `sete`
// with `setnp` and the two results are ANDed, which does the same.
fn lower_float_compare(Lowering lowering, NativeFunction function, int target, int left, int right, bool swap, string set_hex) {
    int loaded = left;
    int against = right;
    if (swap) {
        loaded = right;
        against = left;
    }
    movsd_slot_xmm(lowering.code, function, loaded);
    ucomisd_slot(lowering.code, slot_disp(function, against));
    push_hex(lowering.code, set_hex);
    push_hex(lowering.code, "0f b6 c0");
    store_rax(lowering, function, target);
}

// lower_equal_float emits EqualFloat: the ordered-and-equal test takes the
// parity flag along, because an unordered compare also sets the zero flag.
fn lower_equal_float(Lowering lowering, NativeFunction function, int target, int left, int right) {
    movsd_slot_xmm(lowering.code, function, left);
    ucomisd_slot(lowering.code, slot_disp(function, right));
    push_hex(lowering.code, "0f 9b c0");
    push_hex(lowering.code, "0f 94 c2");
    push_hex(lowering.code, "22 c2");
    push_hex(lowering.code, "0f b6 c0");
    store_rax(lowering, function, target);
}

// lower_halt_paragraph emits one shared failure halt — write(2) the fatal
// message through its object protocol, then exit_group(1) — and returns the
// lea's recorded displacement position. Every paragraph is byte-identical
// apart from the message blob, so the callers keep only positions.
//
//     bf 02 00 00 00        mov edi, 2                (stderr)
//     48 8d 05 00000000     lea rax, [rip+...]        the message object
//     48 8b 70 10           mov rsi, [rax+16]         the payload pointer
//     48 8b 50 08           mov rdx, [rax+8]          the payload length
//     b8 01 00 00 00        mov eax, 1
//     0f 05                                            write
//     bf 01 00 00 00        mov edi, 1
//     b8 3c 00 00 00        mov eax, 60 (exit_group)
//     0f 05                                            syscall
fn lower_halt_paragraph(Lowering lowering) -> int {
    push_hex(lowering.code, "bf 02 00 00 00");
    int lea_position = lowering.code.count + 3;
    push_hex(lowering.code, "48 8d 05 00 00 00 00");
    push_hex(lowering.code, "48 8b 70 10");
    push_hex(lowering.code, "48 8b 50 08");
    push_hex(lowering.code, "b8 01 00 00 00");
    push_hex(lowering.code, "0f 05");
    push_hex(lowering.code, "bf 01 00 00 00");
    push_hex(lowering.code, "b8 3c 00 00 00");
    push_hex(lowering.code, "0f 05");
    return lea_position;
}

// lower_call pushes the argument slots in reverse declaration order, emits
// the call, and pops the caller-allocated slots. An odd argument count is
// padded with one eight-byte slot below the arguments so rsp is 16-byte
// aligned at the call, as the System V ABI requires; the pad sits below the
// arguments and never shifts a parameter's [rbp+16+8k] position.
fn lower_call(Lowering lowering, NativeFunction function, int callee, int[] arguments, int argument_count) {
    bool pad = argument_count % 2 == 1;
    if (pad) {
        push_hex(lowering.code, "48 83 ec 08");
    }
    int index = argument_count - 1;
    while (index >= 0) {
        load_rax(lowering, function, arguments[index]);
        push_hex(lowering.code, "50");
        index--;
    }
    call_rel32(lowering, callee);
    invalidate_rax(lowering);
    release_arguments(lowering.code, argument_count);
    if (pad) {
        push_hex(lowering.code, "48 83 c4 08");
    }
}

// syscall_argument_register is the six-register argument spelling the Linux
// syscall ABI fixes: rdi, rsi, rdx, r10, r8, r9. The last three give their
// register number through the r/m field with REX.B set (0x49), since
// r10/r8/r9 have no register-field spelling.
fn syscall_argument_register(Bytes list, int index) {
    if (index == 0) {
        push_hex(list, "48 89 c7");
    } else if (index == 1) {
        push_hex(list, "48 89 c6");
    } else if (index == 2) {
        push_hex(list, "48 89 c2");
    } else if (index == 3) {
        push_hex(list, "49 89 c2");
    } else if (index == 4) {
        push_hex(list, "49 89 c0");
    } else {
        push_hex(list, "49 89 c8");
    }
}

// lower_start is the file's opening paragraph: save argc/argv from the
// initial stack when the program uses argv(), call the entry function, then
// exit with status 0 through the exit_group syscall.
fn lower_start(Lowering lowering, int entry, int args_blob, int stack_top_blob, int env_blob) {
    if (stack_top_blob >= 0) {
        // mov rax, rsp ; the whole process stack's upper bound for the
        // collector's conservative scan.
        push_hex(lowering.code, "48 89 e0");
        add_displacement(lowering, stack_top_blob, 24);
        push_hex(lowering.code, "48 89 05 00 00 00 00");
    }
    if (args_blob >= 0) {
        // mov rax, [rsp] ; argc
        push_hex(lowering.code, "48 8b 04 24");
        add_displacement(lowering, args_blob, 24);
        push_hex(lowering.code, "48 89 05 00 00 00 00");
        // lea rax, [rsp+8] ; argv
        push_hex(lowering.code, "48 8d 44 24 08");
        add_displacement(lowering, args_blob, 32);
        push_hex(lowering.code, "48 89 05 00 00 00 00");
    }
    if (env_blob >= 0) {
        // mov rax, [rsp] ; argc
        push_hex(lowering.code, "48 8b 04 24");
        // lea rcx, [rsp+8] ; argv
        push_hex(lowering.code, "48 8d 4c 24 08");
        // lea rdx, [rcx+rax*8+8] ; envp
        push_hex(lowering.code, "48 8d 54 c1 08");
        add_displacement(lowering, env_blob, 24);
        push_hex(lowering.code, "48 89 15 00 00 00 00");
    }
    call_rel32(lowering, entry);
    push_hex(lowering.code, "31 ff");
    push_hex(lowering.code, "b8 3c 00 00 00");
    push_hex(lowering.code, "0f 05");
}

// lower_instruction emits one instruction. Every form the scene union
// carries is encoded; adding a later instruction kind grows this match with
// its lowering.
fn lower_instruction(Lowering lowering, NativeFunction function, Instruction instruction) {
    match (instruction) {
        ConstInt(target, value) {
            // The constant reaches the slot through rax as a full 64-bit
            // pattern: mov rax, imm64, then store.
            movabs_rax(lowering.code, value);
            store_rax(lowering, function, target);
        }
        ConstBool(target, value) {
            int pattern = 0;
            if (value) {
                pattern = 1;
            }
            mov_byte_slot(lowering.code, slot_disp(function, target), pattern);
            invalidate_rax(lowering);
        }
        ConstRefData(target, blob) {
            lea_rax_data(lowering, blob);
            store_rax(lowering, function, target);
        }
        Copy(target, source) {
            load_rax(lowering, function, source);
            store_rax(lowering, function, target);
        }
        Call(target, callee, arguments, argument_count) {
            lower_call(lowering, function, callee, arguments, argument_count);
            if (type_name(function.binding_types[target]) == type_name(NativeType.Float)) {
                movsd_xmm_slot(lowering.code, function, target);
                invalidate_rax(lowering);
            } else {
                store_rax(lowering, function, target);
            }
        }
        CallVoid(callee, arguments, argument_count) {
            lower_call(lowering, function, callee, arguments, argument_count);
            invalidate_rax(lowering);
        }
        RawLoad64(target, address, offset) {
            load_rax(lowering, function, address);
            push_hex(lowering.code, "48 8b 40");
            push_int(lowering.code, offset, 1);
            store_rax(lowering, function, target);
        }
        RawSyscall(target, number, arguments, argument_count) {
            int argument = 0;
            while (argument < argument_count) {
                load_rax(lowering, function, arguments[argument]);
                syscall_argument_register(lowering.code, argument);
                argument++;
            }
            load_rax(lowering, function, number);
            push_hex(lowering.code, "0f 05");
            store_rax(lowering, function, target);
        }
        GetStatic(target, blob, offset) {
            // mov rax, [rip+disp] reads eight bytes straight from the blob,
            // then the usual slot store.
            add_displacement(lowering, blob, offset);
            push_hex(lowering.code, "48 8b 05 00 00 00 00");
            store_rax(lowering, function, target);
        }
        SetStatic(blob, offset, value) {
            // mov rax, [rbp+slot], then mov [rip+disp], rax.
            load_rax(lowering, function, value);
            add_displacement(lowering, blob, offset);
            push_hex(lowering.code, "48 89 05 00 00 00 00");
        }
        FailOOM {
            // One unconditional jump to the shared out-of-memory paragraph.
            add_oom_jump(lowering);
            push_hex(lowering.code, "e9 00 00 00 00");
            invalidate_rax(lowering);
        }
        RawStore64(address, offset, value) {
            // mov rax, [rbp+slot], mov rcx, [rbp+slot], mov [rcx+disp8], rax —
            // the store side of RawLoad64, mirrored byte for byte.
            load_rax(lowering, function, value);
            mov_rax_slot_other(lowering.code, slot_disp(function, address));
            push_hex(lowering.code, "48 89 41");
            push_int(lowering.code, offset, 1);
            invalidate_rax(lowering);
        }
        RawLoad8(target, address, offset) {
            // mov rax, [rbp+slot]; movzx rax, byte [rax+disp8]; store.
            load_rax(lowering, function, address);
            push_hex(lowering.code, "48 0f b6 40");
            push_int(lowering.code, offset, 1);
            store_rax(lowering, function, target);
        }
        RawStore8(address, offset, value) {
            // mov rax, [rbp+slot]; mov rcx, [rbp+slot]; mov [rcx+disp8], al.
            load_rax(lowering, function, value);
            mov_rax_slot_other(lowering.code, slot_disp(function, address));
            push_hex(lowering.code, "88 41");
            push_int(lowering.code, offset, 1);
            invalidate_rax(lowering);
        }
        StackPointer(target) {
            // mov rax, rsp, then the usual slot store: the collector's one
            // look at the current frame chain, taken while mapping.
            push_hex(lowering.code, "48 89 e0");
            store_rax(lowering, function, target);
        }
        FloatBits(target, value) {
            // movsd xmm0, [rbp+slot]; movq rax, xmm0; store: the double's
            // raw bit pattern moves through an int slot intact, which is
            // what lets the formatter decompose it with divide/remainder.
            movsd_slot_xmm(lowering.code, function, value);
            push_hex(lowering.code, "66 48 0f 7e c0");
            store_rax(lowering, function, target);
        }
        BitsFloat(target, value) {
            // mov rax, [rbp+slot]; movq xmm0, rax; movsd [rbp+target], xmm0:
            // the inverse boundary for an array's float element load.
            load_rax(lowering, function, value);
            push_hex(lowering.code, "66 48 0f 6e c0");
            movsd_xmm_slot(lowering.code, function, target);
            invalidate_rax(lowering);
        }
        Return(value) {
            if (type_name(function.result) == type_name(NativeType.Float)) {
                movsd_slot_xmm(lowering.code, function, value);
            } else {
                load_rax(lowering, function, value);
            }
            frame_epilogue(lowering.code, function);
        }
        ReturnVoid {
            frame_epilogue(lowering.code, function);
        }
        Add(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 03");
        }
        Subtract(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 2b");
        }
        Multiply(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 0f af");
        }
        WholeDivide(target, left, right) {
            lower_divide(lowering, function, target, left, right, true);
        }
        WholeRemainder(target, left, right) {
            lower_divide(lowering, function, target, left, right, false);
        }
        ConstFloat(target, bits) {
            // The constant's bit pattern reaches the slot through rax and
            // xmm0: movabs rax, imm64; movq xmm0, rax; store.
            movabs_rax(lowering.code, bits);
            push_hex(lowering.code, "66 48 0f 6e c0");
            movsd_xmm_slot(lowering.code, function, target);
            invalidate_rax(lowering);
        }
        AddFloat(target, left, right) {
            lower_float_binary(lowering, function, target, left, right, "f2 0f 58");
        }
        SubtractFloat(target, left, right) {
            lower_float_binary(lowering, function, target, left, right, "f2 0f 5c");
        }
        MultiplyFloat(target, left, right) {
            lower_float_binary(lowering, function, target, left, right, "f2 0f 59");
        }
        DivideFloat(target, left, right) {
            // IEEE division, with no zero guard: a zero divisor produces
            // infinity or NaN exactly as the C pipeline's generated
            // division over doubles does.
            lower_float_binary(lowering, function, target, left, right, "f2 0f 5e");
        }
        NegateFloat(target, value) {
            movsd_slot_xmm(lowering.code, function, value);
            add_negate_mask(lowering);
            push_hex(lowering.code, "f2 0f 10 0d 00 00 00 00");
            push_hex(lowering.code, "66 0f 57 c1");
            movsd_xmm_slot(lowering.code, function, target);
            invalidate_rax(lowering);
        }
        EqualFloat(target, left, right) {
            lower_equal_float(lowering, function, target, left, right);
        }
        GreaterFloat(target, left, right) {
            lower_float_compare(lowering, function, target, left, right, false, "0f 97 c0");
        }
        LessOrEqualFloat(target, left, right) {
            lower_float_compare(lowering, function, target, left, right, true, "0f 93 c0");
        }
        Negate(target, value) {
            load_rax(lowering, function, value);
            push_hex(lowering.code, "48 f7 d8");
            store_rax(lowering, function, target);
        }
        BitAnd(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 23");
        }
        BitOr(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 0b");
        }
        BitXor(target, left, right) {
            lower_binary(lowering, function, target, left, right, "48 33");
        }
        BitNot(target, value) {
            load_rax(lowering, function, value);
            push_hex(lowering.code, "48 f7 d0");
            store_rax(lowering, function, target);
        }
        ShiftLeft(target, left, count) {
            load_rax(lowering, function, left);
            mov_rax_slot_other(lowering.code, slot_disp(function, count));
            push_hex(lowering.code, "48 d3 e0");
            store_rax(lowering, function, target);
        }
        ShiftRight(target, left, count) {
            load_rax(lowering, function, left);
            mov_rax_slot_other(lowering.code, slot_disp(function, count));
            push_hex(lowering.code, "48 d3 f8");
            store_rax(lowering, function, target);
        }
        Equal(target, left, right) {
            lower_compare(lowering, function, target, left, right, "0f 94 c0");
        }
        LessThan(target, left, right) {
            lower_compare(lowering, function, target, left, right, "0f 9c c0");
        }
        Jump(label) {
            add_label_jump(lowering, 1, label);
            push_hex(lowering.code, "e9 00 00 00 00");
            invalidate_rax(lowering);
        }
        Branch(condition, label_true, label_false) {
            lower_branch(lowering, function, condition, label_true, label_false);
            invalidate_rax(lowering);
        }
        Label(label) {
            // A label carries no bytes; its offset is what the patch pass
            // needs, and the label-position table holds it.
            lowering.label_positions[label] = lowering.code.count;
            invalidate_rax(lowering);
        }
    }
}

// ends_with_return reports whether a function's body ends with a return, so
// the selector knows whether to append a defensive epilogue.
fn ends_with_return(NativeFunction function) -> bool {
    if (function.instruction_count == 0) {
        return false;
    }
    Instruction last = function.instructions[function.instruction_count - 1];
    match (last) {
        Return(value) {
            return true;
        }
        ReturnVoid {
            return true;
        }
        ConstInt(n, v) { return false; }
        ConstBool(n, v) { return false; }
        ConstRefData(n, b) { return false; }
        ConstFloat(n, v) { return false; }
        Copy(n, s) { return false; }
        Add(n, l, r) { return false; }
        Subtract(n, l, r) { return false; }
        Multiply(n, l, r) { return false; }
        WholeDivide(n, l, r) { return false; }
        WholeRemainder(n, l, r) { return false; }
        AddFloat(n, l, r) { return false; }
        SubtractFloat(n, l, r) { return false; }
        MultiplyFloat(n, l, r) { return false; }
        DivideFloat(n, l, r) { return false; }
        Negate(n, v) { return false; }
        NegateFloat(n, v) { return false; }
        BitAnd(n, l, r) { return false; }
        BitOr(n, l, r) { return false; }
        BitXor(n, l, r) { return false; }
        BitNot(n, v) { return false; }
        ShiftLeft(n, l, c) { return false; }
        ShiftRight(n, l, c) { return false; }
        Equal(n, l, r) { return false; }
        LessThan(n, l, r) { return false; }
        EqualFloat(n, l, r) { return false; }
        GreaterFloat(n, l, r) { return false; }
        LessOrEqualFloat(n, l, r) { return false; }
        Call(n, c, a, count) { return false; }
        CallVoid(c, a, count) { return false; }
        RawLoad64(n, a, o) { return false; }
        GetStatic(n, b, o) { return false; }
        SetStatic(b, o, v) { return false; }
        FailOOM { return false; }
        RawStore64(a, o, v) { return false; }
        RawLoad8(n, a, o) { return false; }
        RawStore8(a, o, v) { return false; }
        StackPointer(n) { return false; }
        FloatBits(n, v) { return false; }
        BitsFloat(n, v) { return false; }
        RawSyscall(n, m, a, count) { return false; }
        Jump(l) { return false; }
        Branch(c, t, f) { return false; }
        Label(l) { return false; }
    }
    return false;
}

// select_scene lowers the whole scene: the program's opening paragraph,
// every function in order, the blob data layout, and then one pass over all
// recorded fixups.
public fn select_scene(NativeScene scene) -> SelectionResult {
    Lowering lowering = new_lowering(scene);

    // _start occupies code offset zero; the table rows are scene functions.
    lower_start(lowering, scene.entry, scene.args_blob, scene.stack_top_blob, scene.env_blob);

    int function = 0;
    while (function < scene.function_count) {
        NativeFunction handle = function_at(scene, function);
        add_function_offset(lowering, function, lowering.code.count);

        string frame_failure = frame_fits(handle);
        if (length(frame_failure) != 0) {
            return selector_fail(frame_failure);
        }

        frame_prologue(lowering.code, handle);

        lowering.label_positions = new int[handle.label_count];
        lowering.rax_binding = -1;
        int instruction_index = 0;
        while (instruction_index < handle.instruction_count) {
            Instruction instruction = handle.instructions[instruction_index];
            lower_instruction(lowering, handle, instruction);
            instruction_index++;
        }
        if (!ends_with_return(handle)) {
            frame_epilogue(lowering.code, handle);
        }

        // The function's labels are all defined; patch its forward jumps.
        // Label positions are absolute code-buffer indices, so the target
        // needs no function offset.
        int jump = 0;
        while (jump < lowering.label_jump_count) {
            LabelJump fixup = lowering.label_jumps[jump];
            int target = text_base() + header_size() + lowering.label_positions[fixup.label];
            int site = text_base() + header_size() + fixup.position + 4;
            patch32(lowering.code, fixup.position, target - site);
            jump++;
        }
        lowering.label_jump_count = 0;
        function++;
    }

    // The divide-failure paragraph follows the functions and is reached
    // only by the guards, so it exists only when some guard was emitted.
    if (lowering.fail_jump_count > 0) {
        lowering.fail_lea_position = lower_halt_paragraph(lowering);
    }

    // The out-of-memory paragraph reaches every FailOOM the shells emitted.
    if (lowering.oom_jump_count > 0) {
        lowering.oom_lea_position = lower_halt_paragraph(lowering);
    }

    // Data layout: one object per blob, eight-aligned, on the object-header
    // ABI (SPEC Section 19.10): an eight-byte header word carrying the
    // whole size, the payload length, the payload pointer, and the payload.
    int blob = 0;
    while (blob < scene.blob_count) {
        lowering.blob_offsets[blob] = emit_object_blob(lowering, scene.blobs[blob].bytes);
        blob++;
    }

    // The selector's private failure-message objects, laid out exactly like
    // a scene blob and addressed through their offsets alone.
    if (lowering.fail_jump_count > 0) {
        lowering.fail_blob_offset = emit_object_blob(lowering, fail_message());
    }
    if (lowering.oom_jump_count > 0) {
        lowering.oom_blob_offset = emit_object_blob(lowering, oom_message());
    }

    int call_index = 0;
    while (call_index < lowering.call_count) {
        CallFixup fixup = lowering.call_fixups[call_index];
        int target = text_base() + header_size() + lowering.function_offsets[fixup.callee];
        int site = text_base() + header_size() + fixup.position + 4;
        patch32(lowering.code, fixup.position, target - site);
        call_index++;
    }

    int displacement = 0;
    while (displacement < lowering.displacement_count) {
        DisplacementFixup fixup = lowering.displacement_fixups[displacement];
        int target = data_base() + lowering.blob_offsets[fixup.blob] + fixup.offset;
        int site = text_base() + header_size() + fixup.position + 4;
        patch32(lowering.code, fixup.position, target - site);
        displacement++;
    }

    // The fail paragraph's RIP-relative reference and the guards'
    // conditional jumps, whose target paragraph offset is now known.
    if (lowering.fail_jump_count > 0) {
        int target = data_base() + lowering.fail_blob_offset;
        int site = text_base() + header_size() + lowering.fail_lea_position + 4;
        patch32(lowering.code, lowering.fail_lea_position, target - site);
        int fail_jump = 0;
        while (fail_jump < lowering.fail_jump_count) {
            FailJump fixup = lowering.fail_jumps[fail_jump];
            int paragraph = text_base() + header_size() + lowering.fail_lea_position - 8;
            int jump_site = text_base() + header_size() + fixup.position + 4;
            patch32(lowering.code, fixup.position, paragraph - jump_site);
            fail_jump++;
        }
    }

    // The out-of-memory paragraph's own reference and jumps.
    if (lowering.oom_jump_count > 0) {
        int target = data_base() + lowering.oom_blob_offset;
        int site = text_base() + header_size() + lowering.oom_lea_position + 4;
        patch32(lowering.code, lowering.oom_lea_position, target - site);
        int oom_jump = 0;
        while (oom_jump < lowering.oom_jump_count) {
            OOMJump fixup = lowering.oom_jumps[oom_jump];
            int paragraph = text_base() + header_size() + lowering.oom_lea_position - 8;
            int jump_site = text_base() + header_size() + fixup.position + 4;
            patch32(lowering.code, fixup.position, paragraph - jump_site);
            oom_jump++;
        }
    }

    // The sign mask for NegateFloat, appended once when some negate reach
    // was emitted; its single RIP-relative reference patch lands here.
    if (lowering.negate_count > 0) {
        int mask_offset = lowering.data.count;
        // movsd requires no alignment; the mask bytes are the double's
        // sign bit in the low quad, the high quad zero.
        push_hex(lowering.data, "00 00 00 00 00 00 00 80");
        int mask_site = text_base() + header_size();
        int index = 0;
        while (index < lowering.negate_count) {
            NegateFloatMask fixup = lowering.negate_masks[index];
            int target = data_base() + mask_offset;
            int site = mask_site + fixup.position + 4;
            patch32(lowering.code, fixup.position, target - site);
            index++;
        }
    }

    return SelectionResult.Ok {
        selection = Selection {
            code = lowering.code,
            data = lowering.data,
            entry_function = scene.entry
        }
    };
}

// movabs_rax loads a 64-bit constant into rax: mov rax, imm64.
fn movabs_rax(Bytes list, int value) {
    push_hex(list, "48 b8");
    push_int(list, value, 8);
}

// patch32 rewrites four displacement bytes in place.
fn patch32(Bytes list, int position, int displacement) {
    int index = 0;
    while (index < 4) {
        list.data[position + index] = byte_from_int((displacement >> (8 * index)) & 255);
        index++;
    }
}

// patch64 rewrites eight pointer bytes in place.
fn patch64(Bytes list, int position, int pointer) {
    int index = 0;
    while (index < 8) {
        list.data[position + index] = byte_from_int((pointer >> (8 * index)) & 255);
        index++;
    }
}
