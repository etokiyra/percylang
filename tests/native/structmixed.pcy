struct Mixed {
    byte tag;
    int count;
    bool ready;
    string label;
    int[] values;
    float ratio;
}

fn main() {
    int[] values = new int[2];
    values[0] = 11;
    values[1] = 22;
    Mixed mixed = Mixed {
        ratio = 0.25,
        label = "mixed",
        values = values,
        ready = true,
        count = 9,
        tag = byte_from_int(7)
    };
    print(mixed.tag);
    print(mixed.count);
    print(mixed.ready);
    print(mixed.label);
    print(mixed.values[0] + mixed.values[1]);
    print(mixed.ratio);
    mixed.tag = byte_from_int(200);
    mixed.ready = false;
    mixed.label = "changed";
    print(mixed.tag);
    print(mixed.ready);
    print(mixed.label);
}
